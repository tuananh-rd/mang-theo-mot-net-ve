---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'Dự án “Mang Theo Một Nét Vẽ” của nhóm Lăng Kính (7 sinh viên lớp AI2015, học phần SSG105, Đại học FPT Hà Nội).',
  currentPath = '/',
} = Astro.props;

const pageTitle = `${title} | Mang Theo Một Nét Vẽ - Lăng Kính`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Chuyển đến nội dung chính</a>

    <!-- Top Preview Banner -->
    <aside class="preview-banner" role="status" aria-label="Thông báo bản xem trước">
      <strong>Bản xem trước</strong> — Nội dung theo đề xuất dự án, chờ xác nhận chính thức từ nhóm và Mái ấm.
    </aside>

    <Header currentPath={currentPath} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  #main-content:focus {
    outline: none;
  }
</style>
