---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { PRODUCTS, PRODUCT_FAQS, SALES_PLAN } from '../data/campaign';
import { formatProductPrice } from '../lib/finance';

const craft = PRODUCTS.filter((p) => p.category === 'craft');
const food = PRODUCTS.filter((p) => p.category === 'food' && p.isBaseRevenueItem !== false);
const combos = PRODUCTS.filter((p) => p.isBaseRevenueItem === false);

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Sản phẩm' }];
---

<Layout
  title="Sản phẩm gây quỹ"
  description="Chuồn chuồn tre, móc khóa và đồ ăn do nhóm Lăng Kính chuẩn bị để gây quỹ mua quà cho Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/san-pham"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Sản phẩm gây quỹ"
    chip={{ kind: 'cho-xac-nhan', label: 'Chưa mở bán' }}
    title="Mua một món, góp một phần quà"
    titleId="products-heading"
    lead="Đồ thủ công và đồ ăn do nhóm Lăng Kính tự chuẩn bị, bán tại FPT Hòa Lạc."
    description="Giá dưới đây là giá tham khảo. Mẫu, giá chính thức và cách đặt hàng sẽ được công bố tại trang này khi mở bán."
  />

  <section class="section" aria-labelledby="craft-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Đồ thủ công</span>
        <h2 id="craft-heading">Quà lưu niệm</h2>
        <p>Nhóm chuẩn bị 50 chuồn chuồn tre: 30 bộ kèm đế để bán, 20 chiếc để lại cho Mái ấm.</p>
      </div>
      <ProductGrid products={craft} />
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="food-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Đồ ăn</span>
        <h2 id="food-heading">Đồ ăn gây quỹ</h2>
        <p>Làm theo đơn, bán theo đợt nhỏ và chỉ khi đáp ứng điều kiện an toàn thực phẩm.</p>
      </div>
      <ProductGrid products={food} />

      <div class="combos reveal">
        <p class="combos-title">Có thể bổ sung</p>
        <ul class="combos-list">
          {
            combos.map((c) => (
              <li>
                <span>{c.name}</span>
                <span class="combos-price">{formatProductPrice(c)}</span>
              </li>
            ))
          }
        </ul>
        <p class="combos-note">Các combo nem lẻ đang được cân nhắc; thực đơn chính thức sẽ công bố khi mở bán.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="buy-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">Mua hàng</span>
          <h2 id="buy-heading" class="col-title">Khi mở bán</h2>
          <ul class="check-list">
            {SALES_PLAN.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="reveal">
          <span class="eyebrow">Nguồn gốc</span>
          <h3 class="col-title col-title--sm">Ai làm sản phẩm</h3>
          <ul class="check-list">
            <li>Nhóm Lăng Kính chuẩn bị và hoàn thiện toàn bộ hàng bán, kiểm tra trước khi giao.</li>
            <li>Các em ở Mái ấm không phải làm hàng. Tranh của các em chỉ được in lên móc khóa khi có sự đồng ý phù hợp.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion items={PRODUCT_FAQS} idPrefix="product-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="products-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="products-cta-heading">Tiền bán hàng được dùng thế nào?</h2>
        <p>Chi phí dự kiến và phần dành mua quà cho Mái ấm.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch thu chi</a>
        <a href="/dong-hanh" class="link-arrow">Cách đồng hành <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .combos {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
  }

  .combos-title {
    margin: 0 0 var(--space-2);
    font-weight: 700;
    color: var(--ink);
  }

  .combos-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .combos-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .combos-price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .combos-note {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  @media (max-width: 767px) {
    .combos {
      padding: var(--space-4);
    }
  }
</style>
