---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { PRODUCTS, PRODUCT_FAQS, SALES_PLAN } from '../data/campaign';

const craft = PRODUCTS.filter((p) => p.category === 'craft');
const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Quà lưu niệm' }];
---

<Layout
  title="Quà lưu niệm gây quỹ"
  description="Chuồn chuồn tre và móc khóa do nhóm Lăng Kính tự làm để gây quỹ tặng quà cho Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/san-pham"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Quà lưu niệm"
    chip={{ kind: 'cho-xac-nhan', label: 'Chưa mở bán' }}
    title="Mua một món, góp một phần quà"
    titleId="products-heading"
    lead="Chuồn chuồn tre và móc khóa do nhóm Lăng Kính tự làm, bán tại FPT Hòa Lạc."
    description="Tiền bán quà được ghi sổ cùng các khoản ủng hộ và dùng cho buổi chơi, quà tặng Mái ấm."
  />

  <section class="section" aria-labelledby="craft-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Sản phẩm</span>
        <h2 id="craft-heading">Hai món quà nhỏ</h2>
        <p>Nhóm chuẩn bị 50 chuồn chuồn tre: 30 bộ kèm đế để bán, 20 chiếc để lại cho các em tại Mái ấm.</p>
      </div>
      <ProductGrid products={craft} />
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="buy-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">Mua hàng</span>
          <h2 id="buy-heading" class="col-title">Khi mở bán</h2>
          <ul class="check-list">
            {SALES_PLAN.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="reveal">
          <span class="eyebrow">Nguồn gốc</span>
          <h3 class="col-title col-title--sm">Ai làm sản phẩm</h3>
          <ul class="check-list">
            <li>Nhóm Lăng Kính chuẩn bị và hoàn thiện toàn bộ hàng bán, kiểm tra trước khi giao.</li>
            <li>Các em ở Mái ấm không phải làm hàng. Tranh của các em chỉ được in lên móc khóa khi có sự đồng ý phù hợp.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion items={PRODUCT_FAQS} idPrefix="product-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="products-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="products-cta-heading">Chưa mua được quà? Bạn vẫn có thể góp sức</h2>
        <p>Ủng hộ qua chuyển khoản, sao kê công khai từng khoản.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
        <a href="/minh-bach" class="link-arrow">Xem minh bạch <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }
</style>
