---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { PRODUCTS, PRODUCT_FAQS } from '../data/campaign';
import { formatProductPrice, formatProductQuantity } from '../lib/finance';

const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const foodProducts = PRODUCTS.filter((p) => p.category === 'food');
---

<Layout
  title="Sản phẩm gây quỹ dự kiến"
  description="Danh mục sản phẩm thủ công và thực đơn ẩm thực gây quỹ dự kiến trong chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/san-pham"
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Sản phẩm</span>
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Header / Hero Section -->
  <section class="products-hero" aria-labelledby="products-heading">
    <div class="container">
      <div class="products-hero-card">
        <div class="badge-row">
          <span class="status-badge">Kế hoạch gây quỹ</span>
          <span class="status-summary-pill">7 món &bull; Giá tham khảo &bull; Chưa mở bán</span>
        </div>

        <h1 id="products-heading" class="products-title">
          Sản phẩm gây quỹ dự kiến
        </h1>

        <p class="products-lead">
          Các sản phẩm thủ công và phương án ẩm thực nằm trong kế hoạch gây quỹ của chiến dịch, nhằm bù đắp chi phí vật tư và tạo nguồn lực trao tặng theo nhu cầu thực tế.
        </p>

        <!-- Notice Box Quan Trọng -->
        <div class="product-section-notice">
          <p>
            <strong>Lưu ý:</strong> Trạng thái mở bán chưa được xác nhận. Bản xem trước nhằm lấy ý kiến đóng góp cho đề xuất dự án, chưa nhận đơn hàng hoặc tiền ủng hộ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Danh mục sản phẩm -->
  <section class="section section-soft" aria-labelledby="catalog-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Danh mục đề xuất</span>
        <h2 id="catalog-heading">Sản phẩm trong kế hoạch đề xuất</h2>
        <p class="section-lead">
          Kế hoạch gây quỹ gồm 2 sản phẩm lưu niệm thủ công và 5 món ẩm thực sinh viên dự kiến nhằm bù đắp chi phí vật tư và tạo nguồn lực trao tặng.
        </p>
      </div>

      <!-- Group 1: Thủ công (2 cột desktop) -->
      <div class="catalog-group">
        <div class="group-title-row">
          <h3 class="catalog-subheading">1. Sản phẩm lưu niệm thủ công</h3>
          <span class="group-badge">2 sản phẩm &bull; Nhóm Lăng Kính hoàn thiện mẫu</span>
        </div>
        <div class="products-grid products-grid-craft">
          {
            craftProducts.map((product) => (
              <ProductCard product={product} ratio="16:9" />
            ))
          }
        </div>
      </div>

      <!-- Group 2: Thực đơn ẩm thực (3 cột desktop) -->
      <div class="catalog-group food-catalog-group">
        <div class="food-group-header">
          <div class="group-title-row">
            <h3 class="catalog-subheading">2. Thực đơn ẩm thực gây quỹ dự kiến</h3>
            <span class="food-condition-badge">
              Chỉ triển khai khi chốt địa điểm, an toàn &amp; lịch nhận
            </span>
          </div>
        </div>
        <p class="food-group-desc">
          Mục tiêu doanh thu ẩm thực là con số giả định trong đề xuất (trang 18), chưa có bảng phân bổ số lượng chi tiết cho từng món và còn khoảng chênh khi đối chiếu với số set đồ ăn giả định (xem <a href="/minh-bach#doi-chieu-do-an" class="food-reconcile-link">bảng đối chiếu chi tiết tại trang Minh bạch</a>). Dưới đây là các mức giá tham khảo theo từng món và combo trong đề xuất dự án (trang 24):
        </p>
        <div class="products-grid products-grid-food">
          {
            foodProducts.map((product) => (
              <ProductCard product={product} ratio="16:9" />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Kế hoạch số lượng dự kiến -->
  <section class="section" aria-labelledby="quantity-plan-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Kế hoạch phát hành</span>
        <h2 id="quantity-plan-heading">Bảng tổng hợp kế hoạch số lượng</h2>
        <p class="section-lead">
          Số lượng dự kiến theo kịch bản dự toán đề xuất; tách bạch rõ ràng giữa kế hoạch chuẩn bị và thực tế phát hành.
        </p>
      </div>

      <!-- Desktop Table view (>= 1024px) -->
      <div class="table-container card table-desktop">
        <div class="table-responsive">
          <table class="plan-table">
            <caption class="sr-only">Bảng tổng hợp kế hoạch số lượng và giá tham khảo 7 sản phẩm</caption>
            <thead>
              <tr>
                <th scope="col">Sản phẩm</th>
                <th scope="col">Giá tham khảo</th>
                <th scope="col">Số lượng kế hoạch</th>
                <th scope="col">Nguồn gốc &amp; Ghi chú</th>
                <th scope="col">Trạng thái bán</th>
              </tr>
            </thead>
            <tbody>
              {
                PRODUCTS.map((p) => (
                  <tr>
                    <td class="col-name">
                      <strong>{p.name}</strong>
                    </td>
                    <td class="col-price">
                      {formatProductPrice(p)}
                    </td>
                    <td class="col-qty">
                      {formatProductQuantity(p)}
                    </td>
                    <td class="col-notes">
                      {p.planNotes || p.notes}
                    </td>
                    <td class="col-status">
                      <span class="plan-status-badge">
                        {p.saleStatus === 'unconfirmed' ? 'Chưa xác nhận' : p.saleStatus}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="table-disclaimer">
          <p>
            Ghi chú: Toàn bộ số lượng và mức giá trên thuộc kịch bản dự toán ban đầu trong đề xuất dự án. Số lượng tồn kho thực tế chưa được xác nhận.
          </p>
        </div>
      </div>

      <!-- Mobile/Tablet Collapsible Details (< 1024px) -->
      <div class="table-mobile-collapse-wrap">
        <details class="plan-mobile-details card" id="mobile-plan-details">
          <summary class="plan-mobile-summary">
            <span class="summary-text">Xem bảng tổng hợp kế hoạch (đầy đủ 7 món)</span>
            <span class="summary-badge">Mở để xem chi tiết</span>
            <span class="summary-icon" aria-hidden="true">&darr;</span>
          </summary>

          <div class="plan-mobile-content">
            <p class="table-scroll-hint" id="mobile-table-scroll-hint">
              <span aria-hidden="true">&harr;</span> Cuộn ngang để xem đầy đủ 5 cột thông tin kế hoạch
            </p>
            <div
              class="table-responsive"
              tabindex="0"
              role="region"
              aria-label="Bảng tổng hợp kế hoạch 7 sản phẩm"
              aria-describedby="mobile-table-scroll-hint"
            >
              <table class="plan-table mobile-expanded-table">
                <thead>
                  <tr>
                    <th scope="col">Sản phẩm</th>
                    <th scope="col">Giá tham khảo</th>
                    <th scope="col">Số lượng</th>
                    <th scope="col">Nguồn gốc / Ghi chú</th>
                    <th scope="col">Trạng thái</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    PRODUCTS.map((p) => (
                      <tr>
                        <td class="col-name">
                          <strong>{p.name}</strong>
                          <span class="col-subnote">{p.originText}</span>
                        </td>
                        <td class="col-price">
                          {formatProductPrice(p)}
                        </td>
                        <td class="col-qty">
                          {formatProductQuantity(p)}
                        </td>
                        <td class="col-notes">
                          {p.planNotes || p.notes}
                        </td>
                        <td class="col-status">
                          <span class="plan-status-badge">
                            {p.saleStatus === 'unconfirmed' ? 'Chưa xác nhận' : p.saleStatus}
                          </span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <div class="table-disclaimer">
              <p>
                Ghi chú: Toàn bộ số lượng và mức giá trên thuộc kịch bản dự toán ban đầu trong đề xuất dự án. Số lượng tồn kho thực tế chưa được xác nhận.
              </p>
            </div>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Section 3: FAQ -->
  <section class="section section-soft" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Giải đáp thắc mắc</span>
        <h2 id="faq-heading">Hỏi đáp về sản phẩm và gây quỹ</h2>
        <p class="section-lead">
          Những câu hỏi thường gặp về định giá tham khảo, quá trình hoàn thiện và nguyên tắc sử dụng nguồn thu.
        </p>
      </div>

      <div class="faq-wrap">
        <FaqAccordion items={PRODUCT_FAQS} idPrefix="product-faq" />
      </div>
    </div>
  </section>

  <!-- Section 4: CTA điều hướng -->
  <section class="section section-cta" aria-labelledby="products-cta-heading">
    <div class="container">
      <div class="products-cta-card card">
        <h2 id="products-cta-heading" class="cta-title">
          Tìm hiểu thêm về chiến dịch
        </h2>
        <p class="cta-desc">
          Khám phá nguyên tắc minh bạch tài chính dự toán hoặc tìm hiểu các phương thức đồng hành cùng Mái ấm.
        </p>
        <div class="cta-actions">
          <a href="/dong-hanh" class="btn btn-primary">
            Cách đồng hành &rarr;
          </a>
          <a href="/minh-bach" class="btn btn-secondary">
            Xem dự toán minh bạch
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Breadcrumb Bar */
  .breadcrumb-bar {
    background-color: var(--color-surface-card);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-brand-primary);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Hero Section */
  .products-hero {
    padding: var(--space-8) 0 var(--space-6);
  }

  .products-hero-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .status-summary-pill {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    background-color: var(--color-canvas-soft);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    font-weight: 500;
  }

  .products-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0;
  }

  .products-lead {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 800px;
  }

  .product-section-notice {
    background-color: #fffdf5;
    border: 1px solid #fef3c7;
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }

  .product-section-notice p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Catalog Groups */
  .catalog-group {
    margin-bottom: var(--space-8);
  }

  .catalog-group:last-child {
    margin-bottom: 0;
  }

  .group-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .catalog-subheading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .group-badge {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .food-condition-badge {
    font-size: 0.875rem;
    color: #c2410c;
    background-color: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .food-group-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }

  .food-reconcile-link {
    color: var(--color-brand-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .food-reconcile-link:hover {
    color: var(--color-brand-hover);
  }

  /* Products Grids */
  .products-grid {
    display: grid;
    gap: var(--space-5);
  }

  /* Craft Grid: 2 columns desktop */
  .products-grid-craft {
    grid-template-columns: repeat(2, 1fr);
  }

  /* Food Grid: 3 columns desktop, 2 columns tablet */
  .products-grid-food {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Table Container */
  .table-container {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .plan-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    text-align: left;
  }

  .plan-table th,
  .plan-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .plan-table th {
    background-color: var(--color-canvas-soft);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .col-name {
    min-width: 160px;
  }

  .col-subnote {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: normal;
    margin-top: 2px;
  }

  .col-price {
    white-space: nowrap;
    color: var(--color-text-accent);
    font-weight: 600;
  }

  .col-qty {
    white-space: nowrap;
  }

  .col-notes {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .col-status {
    white-space: nowrap;
  }

  .plan-status-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    background-color: #fff7ed;
    color: #c2410c;
    border: 1px solid #fed7aa;
  }

  .table-disclaimer {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-border-subtle);
  }

  .table-disclaimer p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Responsive Display Rules for Table (< 1024px collapsible) */
  .table-desktop {
    display: block;
  }

  .table-mobile-collapse-wrap {
    display: none;
  }

  .plan-mobile-details {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .plan-mobile-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    list-style: none;
    user-select: none;
    background-color: var(--color-canvas-soft);
  }

  .plan-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .plan-mobile-summary:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: -2px;
  }

  .summary-text {
    flex: 1;
    text-align: left;
  }

  .summary-badge {
    font-size: 0.875rem;
    color: var(--color-brand-primary);
    font-weight: 600;
  }

  .summary-icon {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .plan-mobile-details[open] .summary-icon {
    transform: rotate(180deg);
  }

  .plan-mobile-content {
    border-top: 1px solid var(--color-border);
  }

  .table-scroll-hint {
    padding: var(--space-2) var(--space-4);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-border-subtle);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .table-responsive:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: -2px;
  }

  .mobile-expanded-table th,
  .mobile-expanded-table td {
    padding: var(--space-3) var(--space-2);
    font-size: 0.875rem;
  }

  /* FAQ Wrap */
  .faq-wrap {
    max-width: 860px;
    margin: 0 auto;
  }

  /* CTA Section */
  .products-cta-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .cta-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .cta-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1023px) {
    .table-desktop {
      display: none !important;
    }

    .table-mobile-collapse-wrap {
      display: block !important;
    }

    .products-grid-food {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .products-hero {
      padding: var(--space-4) 0;
    }

    .products-hero-card {
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .products-grid-craft,
    .products-grid-food {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .products-cta-card {
      padding: var(--space-5) var(--space-4);
      text-align: left;
      align-items: flex-start;
    }

    .products-lead,
    .cta-desc {
      text-align: left;
    }

    .cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .cta-actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
