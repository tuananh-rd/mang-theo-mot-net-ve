---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { PRODUCTS, PRODUCT_FAQS, SALES_PLAN } from '../data/campaign';
import { CRAFT_PRODUCT_DETAILS, getEffectiveProductSaleModel } from '../lib/products';

const craft = PRODUCTS.filter((p) => p.category === 'craft');
const craftSaleModels = craft.map((p) => getEffectiveProductSaleModel(p));
const anyPreorderOpen = craftSaleModels.some((m) => m.preorderOpen);
const allPreorderOpen = craftSaleModels.length > 0 && craftSaleModels.every((m) => m.preorderOpen);
const heroChip = anyPreorderOpen
  ? { kind: 'da-xac-nhan' as const, label: allPreorderOpen ? 'Đang nhận đặt trước' : 'Có món đang nhận đặt trước' }
  : { kind: 'cho-xac-nhan' as const, label: 'Chưa mở bán' };

// Ảnh/chú thích của sản phẩm đang chọn trong biểu mẫu lấy từ nguồn chung CRAFT_PRODUCT_DETAILS (cùng nguồn với danh mục và trang chi tiết).
const preorderMedia = Object.fromEntries(CRAFT_PRODUCT_DETAILS.map((d) => [d.product.id, d.image
  ? { name: d.product.name, src: d.image.src, alt: d.image.alt, width: d.image.width, height: d.image.height, caption: d.image.caption, fit: d.image.fit ?? 'cover' }
  : { name: d.product.name, src: null }]));

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Quà lưu niệm' }];
---

<Layout
  title="Quà lưu niệm gây quỹ"
  description="Chuồn chuồn tre và móc khóa do nhóm Lăng Kính tự làm để gây quỹ tặng quà cho Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/san-pham"
>
  <PageHero
    variant="plain"
    breadcrumbs={breadcrumbs}
    eyebrow="Quà lưu niệm gây quỹ"
    chip={heroChip}
    title="Mua một món, góp một phần quà"
    titleId="products-heading"
    lead="Nhóm đang nhận đặt trước chuồn chuồn tre và móc khóa. Đặt trước chưa phải thanh toán."
    description="Toàn bộ tiền bán quà lưu niệm được quản lý và ghi sổ riêng với tiền ủng hộ qua chuyển khoản. Lãi thu được dùng cho buổi chơi và quà tặng Mái ấm."
    image={{ src: '/images/trang/san-pham-480.webp', srcset: '/images/trang/san-pham-480.webp 480w, /images/trang/san-pham-730.webp 730w', sizes: '730px', alt: 'Hai em nhỏ đứng bên giàn hoa; ảnh do chủ dự án cung cấp.', position: '50% 40%', width: 730, height: 548, compact: true, layout: 'product' }}
  >
    <a class="btn btn-primary" href="#preorder-heading">Đăng ký nhận quà lưu niệm</a>
  </PageHero>

  <section class="section section-catalogue" aria-labelledby="craft-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Danh mục</span>
        <h2 id="craft-heading">Hai món quà nhỏ sẻ chia</h2>
        <p>Nhóm dự kiến chuẩn bị 50 chuồn chuồn tre (30 bộ kèm đế bán gây quỹ, 20 chiếc tặng các em) và móc khóa lưu niệm.</p>
      </div>
      <ProductGrid products={craft} />
    </div>
  </section>

  <section id="dat-truoc" class="section section-preorder" aria-labelledby="preorder-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Đặt trước</span>
        <h2 id="preorder-heading">Đăng ký nhận quà lưu niệm</h2>
        <p>Đây là đặt trước, chưa thanh toán. Nhóm sẽ liên hệ để xác nhận đơn và lịch nhận hàng. </p>
      </div>
      <p id="preorderAvailability" role="status" aria-live="polite">Đang kiểm tra sản phẩm nhận đặt trước…</p>
      <form id="preorderForm" hidden>
        <div class="form-group">
          <label for="preorderProduct">Sản phẩm</label>
          <select id="preorderProduct" name="productId" required></select>
          <figure id="preorderProductPreview" class="preorder-preview" hidden>
            <img id="preorderProductImage" alt="" loading="lazy" decoding="async" />
            <figcaption id="preorderProductCaption"></figcaption>
          </figure>
        </div>
        <div class="form-group">
          <label for="preorderQuantity">Số lượng</label>
          <input id="preorderQuantity" name="quantity" type="number" min="1" max="50" value="1" required>
        </div>
        <div class="form-group">
          <label for="preorderName">Họ tên</label>
          <input id="preorderName" name="name" type="text" minlength="2" maxlength="100" autocomplete="name" required>
        </div>
        <div class="form-group">
          <label for="preorderEmail">Email nhận xác nhận đơn</label>
          <input id="preorderEmail" name="email" type="email" autocomplete="email" maxlength="254" required>
        </div>
        <div class="form-group">
          <label for="preorderPhone">Số điện thoại</label>
          <input id="preorderPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required aria-describedby="preorderPhoneHint">
          <p id="preorderPhoneHint" class="field-hint">Nhóm dùng số này để xác nhận đơn và hẹn lịch nhận hàng. Ví dụ: 0984 441 726 hoặc +84 984 441 726.</p>
        </div>
        <div class="form-group">
          <label for="preorderPickup">Cách nhận hàng</label>
          <select id="preorderPickup" name="pickup" required></select>
        </div>
        <div class="form-group">
          <label for="preorderNote">Ghi chú (không bắt buộc)</label>
          <textarea id="preorderNote" name="note" maxlength="240" rows="3"></textarea>
        </div>
        <div class="form-group honeypot" aria-hidden="true">
          <label for="preorderWebsite">Để trống trường này</label>
          <input id="preorderWebsite" name="website" tabindex="-1" autocomplete="off">
        </div>
        <label class="consent-label"><input name="consent" type="checkbox" required> Tôi đồng ý để nhóm Lăng Kính sử dụng thông tin liên hệ này nhằm xử lý đơn đặt trước và liên hệ về việc nhận hàng.</label>
        {craftSaleModels.some((model) => model.officialPrice === null) && (<p id="preorderPriceNote" class="preorder-price-note" hidden>Giá đang hiển thị có thể là giá tham khảo. Khi chưa có giá chốt, nhóm sẽ xác nhận khi liên hệ.</p>)}
        <p id="preorderError" role="alert" aria-live="assertive"></p>
        <button id="preorderSubmit" class="btn btn-primary" type="submit">Gửi đăng ký đặt trước</button>
      </form>
      <div id="preorderSuccess" role="status" aria-live="polite" tabindex="-1" hidden></div>
      <script type="application/json" id="preorderMediaData" set:html={JSON.stringify(preorderMedia)} />
    </div>
  </section>

  <!-- Dải 3 bước khi mở bán & Nguyên tắc ai làm sản phẩm -->
  <section class="section section-soft" aria-labelledby="buy-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quy trình</span>
        <h2 id="buy-heading">Khi mở bán chính thức</h2>
        <p>Quy trình đăng ký, xác nhận và giao nhận quà lưu niệm minh bạch.</p>
      </div>

      <div class="sales-steps-grid">
        {
          SALES_PLAN.map((step, idx) => (
            <div class="sales-step-card">
              <span class="sales-step-badge">0{idx + 1}</span>
              <p class="sales-step-content">{step}</p>
            </div>
          ))
        }
      </div>

      <div class="craft-principles-callout">
        <h3 class="principles-callout-title">Nguồn gốc sản phẩm và nguyên tắc vì trẻ em</h3>
        <ul class="check-list">
          <li>Nhóm sinh viên Lăng Kính tự chịu trách nhiệm chuẩn bị và hoàn thiện toàn bộ sản phẩm gây quỹ, kiểm tra chất lượng trước khi giao.</li>
          <li>Hoạt động tại Mái ấm hoàn toàn là buổi chơi vui vẻ và sáng tạo, tuyệt đối không gắn với sản xuất hàng bán; các em giữ lại toàn bộ sản phẩm do mình làm ra. Móc khóa in tranh do nhóm chuẩn bị hoặc có quyền sử dụng, không dùng tranh của các em trong buổi sinh hoạt.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion items={PRODUCT_FAQS} idPrefix="product-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="products-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="products-cta-heading">Chưa mua được quà? Bạn vẫn có thể góp sức</h2>
        <p>Ủng hộ qua chuyển khoản, sao kê công khai từng khoản.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
        <a href="/minh-bach" class="link-arrow">Xem minh bạch <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#preorderForm');
  const availability = document.querySelector<HTMLElement>('#preorderAvailability');
  const success = document.querySelector<HTMLElement>('#preorderSuccess');
  const error = document.querySelector<HTMLElement>('#preorderError');
  const productSelect = document.querySelector<HTMLSelectElement>('#preorderProduct');
  const pickupSelect = document.querySelector<HTMLSelectElement>('#preorderPickup');
  const priceNote = document.querySelector<HTMLElement>('#preorderPriceNote');
  const phoneInput = document.querySelector<HTMLInputElement>('#preorderPhone');
  const preview = document.querySelector<HTMLElement>('#preorderProductPreview');
  const previewImage = document.querySelector<HTMLImageElement>('#preorderProductImage');
  const previewCaption = document.querySelector<HTMLElement>('#preorderProductCaption');
  const mediaByProduct: Record<string, { src: string | null; alt?: string; width?: number; height?: number; caption?: string; fit?: string }> = JSON.parse(document.querySelector('#preorderMediaData')?.textContent || '{}');
  function updateProductPreview() {
    const media = mediaByProduct[productSelect?.value || ''];
    if (!preview || !previewImage || !previewCaption) return;
    if (!media?.src) { preview.hidden = true; return; }
    previewImage.src = media.src; previewImage.alt = media.alt || '';
    if (media.width) previewImage.width = media.width;
    if (media.height) previewImage.height = media.height;
    preview.classList.toggle('preorder-preview--contain', media.fit === 'contain');
    previewCaption.textContent = media.caption || '';
    preview.hidden = false;
  }
  // Quy tắc số điện thoại dùng chung với API (apps/studio/src/preorders/service.ts): bỏ dấu cách . - ( ), chấp nhận 0xxxxxxxxx(x), +84…, 84… hoặc số quốc tế +E.164.
  function normalizePhone(value: string): string | null {
    const raw = value.trim();
    if (!raw || /[^\d\s.\-()+]/.test(raw) || raw.indexOf('+') > 0 || (raw.match(/\+/g) || []).length > 1) return null;
    const compact = raw.replace(/[\s.\-()]/g, '');
    if (/^0\d{9,10}$/.test(compact)) return compact;
    if (/^84\d{9,10}$/.test(compact)) return '+' + compact;
    if (/^\+[1-9]\d{7,14}$/.test(compact)) return compact;
    return null;
  }
  function phoneProblem(value: string): string {
    if (!value.trim()) return 'Vui lòng nhập số điện thoại để nhóm liên hệ xác nhận đơn.';
    return normalizePhone(value) ? '' : 'Số điện thoại chưa hợp lệ. Ví dụ: 0984 441 726 hoặc +84 984 441 726.';
  }
  phoneInput?.addEventListener('input', () => phoneInput.setCustomValidity(''));
  phoneInput?.addEventListener('invalid', () => { if (!phoneInput.validationMessage || phoneInput.validity.valueMissing) phoneInput.setCustomValidity(phoneProblem(phoneInput.value)); });
  const apiBase = ['localhost', '127.0.0.1'].includes(window.location.hostname)
    ? 'http://127.0.0.1:4331/api/preorders'
    : '/api/preorders';
  const newIdempotencyKey = () => crypto.randomUUID ? crypto.randomUUID() : Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, '0')).join('');
  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character] || character));
  let idempotencyKey = newIdempotencyKey();
  let products: Array<{ productId: string; name: string; officialPrice: number | null; pickup: string | null }> = [];

  const requestedProduct = new URLSearchParams(window.location.search).get('sanpham');

  async function loadPreorderConfig() {
    try {
      const response = await fetch(apiBase + '/config', { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok || !Array.isArray(data.products)) throw new Error('Không thể tải danh sách đặt trước.');
      products = data.products;
      if (!products.length) {
        if (availability) availability.textContent = 'Hiện chưa mở nhận đặt trước. Vui lòng quay lại sau.';
        return;
      }
      if (productSelect) productSelect.innerHTML = products.map((item) => `<option value="${escapeHtml(item.productId)}">${escapeHtml(item.name)}${item.officialPrice === null ? ' — giá tham khảo' : ` — ${new Intl.NumberFormat('vi-VN').format(item.officialPrice)}đ`}</option>`).join('');
      if (productSelect && requestedProduct && products.some((item) => item.productId === requestedProduct)) productSelect.value = requestedProduct;
      updatePickupOptions();
      updateProductPreview();
      if (form) form.hidden = false;
      if (availability) availability.textContent = 'Đang nhận đăng ký đặt trước.';
      if (requestedProduct) {
        document.querySelector('#dat-truoc')?.scrollIntoView({ block: 'start' });
        productSelect?.focus({ preventScroll: true });
      }
    } catch {
      if (availability) availability.textContent = 'Biểu mẫu đặt trước hiện chưa sẵn sàng. Vui lòng thử lại sau.';
    }
  }
  function updatePickupOptions() {
    const product = products.find((item) => item.productId === productSelect?.value);
    if (priceNote) priceNote.hidden = typeof product?.officialPrice === 'number' && product.officialPrice > 0;
    if (!pickupSelect) return;
    pickupSelect.innerHTML = product?.pickup ? `<option value="${escapeHtml(product.pickup)}">${escapeHtml(product.pickup)}</option>` : '<option value="Nhóm xác nhận cách nhận hàng khi liên hệ">Nhóm xác nhận cách nhận hàng khi liên hệ</option>';
    if (!product?.pickup) pickupSelect.value = 'Nhóm xác nhận cách nhận hàng khi liên hệ';
  }
  productSelect?.addEventListener('change', () => { updatePickupOptions(); updateProductPreview(); });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (phoneInput) phoneInput.setCustomValidity(phoneProblem(phoneInput.value));
    if (!form.reportValidity()) return;
    const submit = document.querySelector<HTMLButtonElement>('#preorderSubmit');
    if (submit) { submit.disabled = true; submit.textContent = 'Đang gửi…'; }
    if (error) error.textContent = '';
    try {
      const fields = new FormData(form);
      const response = await fetch(apiBase, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': idempotencyKey },
        body: JSON.stringify({
          productId: fields.get('productId'), quantity: Number(fields.get('quantity')), name: fields.get('name'),
          email: fields.get('email'), phone: normalizePhone(String(fields.get('phone') ?? '')) ?? '', pickup: fields.get('pickup'),
          note: fields.get('note'), consent: fields.get('consent') === 'on', website: fields.get('website'),
        }),
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || 'Không thể gửi đăng ký.');
      form.hidden = true;
      if (availability) availability.textContent = '';
      if (success) {
        success.hidden = false;
        success.textContent = `Đã ghi nhận đăng ký ${data.preorder.orderCode}. Đây là đặt trước, chưa thanh toán; nhóm sẽ liên hệ để xác nhận lịch nhận hàng.${data.emailStatus === 'sent' ? ' Email xác nhận đã được gửi.' : ' Nếu không thấy email xác nhận, nhóm sẽ liên hệ bạn.'}`;
      }
      success?.scrollIntoView({ block: 'center' });
      success?.focus({ preventScroll: true });
      idempotencyKey = newIdempotencyKey();
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : 'Không thể gửi đăng ký.';
    } finally {
      if (submit) { submit.disabled = false; submit.textContent = 'Gửi đăng ký đặt trước'; }
    }
  });
  loadPreorderConfig();
</script>

<style>
  .section-preorder { background: #f7f8f8; }
  .preorder-preview { margin: var(--space-2) 0 0; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-alt); overflow: hidden; }
  .preorder-preview img { display: block; width: 100%; height: auto; max-height: 280px; object-fit: cover; }
  .preorder-preview--contain img { object-fit: contain; max-height: 320px; margin-inline: auto; }
  .preorder-preview figcaption { padding: var(--space-2) var(--space-3); font-size: var(--font-size-small); color: var(--ink-2); border-top: 1px solid var(--line); background: #fff; }
  .field-hint { margin: 6px 0 0; font-size: var(--font-size-small); color: var(--ink-2); }
  .section-preorder form { display: grid; gap: var(--space-4); }
  /* display:grid ở trên ghi đè thuộc tính hidden; giữ form ẩn thật sự khi chưa sẵn sàng hoặc sau khi gửi thành công. */
  .section-preorder form[hidden] { display: none; }
  #preorderSuccess { padding: var(--space-4); border: 1px solid var(--line); border-radius: 6px; background: #fff; }
  #preorderSuccess:focus { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .section-preorder .form-group { display: grid; gap: 6px; }
  .section-preorder input, .section-preorder select, .section-preorder textarea { width: 100%; border: 1px solid var(--line); border-radius: 6px; padding: 12px; font: inherit; color: var(--ink); background: #fff; }
  .contact-fields { display: grid; grid-template-columns: minmax(130px, .7fr) minmax(0, 1.3fr); gap: var(--space-4); }
  .consent-label { display: flex; align-items: flex-start; gap: 10px; }
  .consent-label input { width: auto; margin-top: 5px; }
  .preorder-price-note { color: var(--ink-muted); }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  #preorderError { color: #9a1b1b; }
  @media (max-width: 600px) { .contact-fields { grid-template-columns: 1fr; } }
  .section-catalogue {
    background: #ffffff;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  /* Sales Steps 3 cột trên desktop */
  .sales-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .sales-step-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
  }

  .sales-step-badge {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand);
    line-height: 1;
    display: inline-block;
  }

  .sales-step-content {
    font-size: var(--font-size-body);
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  /* Callout nguyên tắc viền trái cam mơ */
  .craft-principles-callout {
    background: #ffffff;
    border-left: 4px solid var(--cta);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: var(--space-6);
  }

  .principles-callout-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--ink);
    margin: 0 0 var(--space-4) 0;
    font-weight: 700;
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  @media (max-width: 900px) {
    .sales-steps-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
