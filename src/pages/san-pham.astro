---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import PlaceholderIllustration from '../components/PlaceholderIllustration.astro';
import { PRODUCTS, PRODUCT_FAQS } from '../data/campaign';
import { formatProductPrice, formatProductQuantity } from '../lib/finance';

const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const foodProducts = PRODUCTS.filter((p) => p.category === 'food');

const getIllustrationType = (id: string) => {
  if (id === 'chuon-chuon-tre-kem-de') return 'chuon-chuon' as const;
  if (id === 'moc-khoa') return 'moc-khoa' as const;
  if (id === 'set-do-an') return 'set-do-an' as const;
  if (id === 'combo-nem-gion' || id === 'combo-nem-xu' || id === 'combo-nem-pho-mai') return 'combo-nem' as const;
  if (id === 'banh-su-kem') return 'banh-su-kem' as const;
  return 'chuon-chuon' as const;
};
---

<Layout
  title="Sản phẩm gây quỹ dự kiến"
  description="Danh mục sản phẩm thủ công và thực đơn ẩm thực gây quỹ dự kiến trong chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/san-pham"
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Sản phẩm</span>
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Header / Hero Section -->
  <section class="products-hero" aria-labelledby="products-heading">
    <div class="container">
      <div class="products-hero-card">
        <div class="badge-row">
          <span class="status-badge">Kế hoạch gây quỹ</span>
        </div>

        <h1 id="products-heading" class="products-title">
          Sản phẩm gây quỹ dự kiến
        </h1>

        <p class="products-lead">
          Các sản phẩm thủ công và phương án ẩm thực nằm trong kế hoạch gây quỹ của chiến dịch, nhằm bù đắp chi phí vật tư và tạo nguồn lực trao tặng theo nhu cầu thực tế.
        </p>

        <!-- Notice Box Quan Trọng -->
        <div class="product-section-notice">
          <p>
            <strong>Lưu ý:</strong> Trạng thái mở bán chưa được xác nhận. Bản xem trước chưa nhận đơn/tiền.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Danh mục sản phẩm -->
  <section class="section section-soft" aria-labelledby="catalog-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Danh mục đề xuất</span>
        <h2 id="catalog-heading">Sản phẩm trong kế hoạch đề xuất</h2>
        <p class="section-lead">
          Kế hoạch gây quỹ gồm 2 sản phẩm lưu niệm thủ công và thực đơn ẩm thực sinh viên dự kiến nhằm bù đắp chi phí vật tư và tạo nguồn lực trao tặng.
        </p>
      </div>

      <div class="catalog-group">
        <h3 class="catalog-subheading">1. Sản phẩm lưu niệm thủ công</h3>
        <div class="products-grid products-grid-craft">
          {
            craftProducts.map((product) => (
              <ProductCard
                product={product}
                illustrationType={getIllustrationType(product.id)}
              />
            ))
          }
        </div>
      </div>

      <div class="catalog-group food-catalog-group">
        <div class="food-group-header">
          <h3 class="catalog-subheading">2. Thực đơn ẩm thực gây quỹ dự kiến</h3>
          <span class="food-condition-badge">
            Chỉ triển khai khi chốt địa điểm, an toàn & lịch nhận
          </span>
        </div>
        <p class="food-group-desc">
          Kế hoạch đồ ăn tương đương 50 set trong phương án mục tiêu doanh thu, chưa có phân bổ số lượng từng loại. Dưới đây là 5 mức giá tham khảo theo từng món và combo trong đề xuất dự án (trang 24):
        </p>
        <div class="food-items-grid">
          {
            foodProducts.map((p) => (
              <div class="food-item-card card">
                <div class="food-card-visual">
                  <PlaceholderIllustration
                    type={getIllustrationType(p.id)}
                    ratio="16:9"
                    caption={`Minh họa: ${p.name}`}
                  />
                </div>
                <div class="food-card-body">
                  <div class="food-card-top">
                    <h4 class="food-name">{p.name}</h4>
                    <span class="food-price">{formatProductPrice(p)}</span>
                  </div>
                  <p class="food-desc">{p.description}</p>
                  <div class="food-meta">
                    <span class="food-qty-label">Số lượng kế hoạch:</span>
                    <strong class="food-qty-val">{formatProductQuantity(p)}</strong>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Kế hoạch số lượng dự kiến -->
  <section class="section" aria-labelledby="quantity-plan-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Kế hoạch phát hành</span>
        <h2 id="quantity-plan-heading">Bảng tổng hợp kế hoạch số lượng</h2>
        <p class="section-lead">
          Số lượng dự kiến theo kịch bản dự toán đề xuất; tách bạch rõ ràng giữa kế hoạch chuẩn bị và thực tế phát hành.
        </p>
      </div>

      <!-- Desktop/Tablet Table view -->
      <div class="table-container card table-desktop">
        <div class="table-responsive">
          <table class="plan-table">
            <thead>
              <tr>
                <th scope="col">Sản phẩm</th>
                <th scope="col">Giá tham khảo</th>
                <th scope="col">Số lượng kế hoạch</th>
                <th scope="col">Nguồn gốc & Ghi chú</th>
                <th scope="col">Trạng thái bán</th>
              </tr>
            </thead>
            <tbody>
              {
                PRODUCTS.map((p) => (
                  <tr>
                    <td class="col-name">
                      <strong>{p.name}</strong>
                    </td>
                    <td class="col-price">
                      {formatProductPrice(p)}
                    </td>
                    <td class="col-qty">
                      {formatProductQuantity(p)}
                    </td>
                    <td class="col-notes">
                      {p.planNotes || p.notes}
                    </td>
                    <td class="col-status">
                      <span class="plan-status-badge">
                        {p.saleStatus === 'unconfirmed' ? 'Chờ xác nhận' : p.saleStatus}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="table-disclaimer">
          <p>
            Ghi chú: Toàn bộ số lượng và mức giá trên thuộc kịch bản dự toán ban đầu trong đề xuất dự án. Số lượng tồn kho thực tế chưa được xác nhận.
          </p>
        </div>
      </div>

      <!-- Mobile Vertical Cards view (không cần cuộn ngang) -->
      <div class="plan-mobile-list">
        {
          PRODUCTS.map((p) => (
            <div class="plan-mobile-card card">
              <div class="plan-mobile-header">
                <h3 class="plan-mobile-title">{p.name}</h3>
                <span class="plan-status-badge">
                  {p.saleStatus === 'unconfirmed' ? 'Chờ xác nhận' : p.saleStatus}
                </span>
              </div>
              <div class="plan-mobile-details">
                <div class="plan-mobile-row">
                  <span class="row-label">Số lượng kế hoạch:</span>
                  <strong class="row-val row-val-accent">
                    {formatProductQuantity(p)}
                  </strong>
                </div>
                <div class="plan-mobile-row">
                  <span class="row-label">Giá tham khảo trong đề xuất:</span>
                  <span class="row-val">
                    {formatProductPrice(p)}
                  </span>
                </div>
                <div class="plan-mobile-row">
                  <span class="row-label">Kế hoạch & Nguồn gốc:</span>
                  <span class="row-val-notes">{p.planNotes || p.notes}</span>
                </div>
              </div>
            </div>
          ))
        }

        <div class="table-disclaimer">
          <p>
            Ghi chú: Toàn bộ số lượng và mức giá trên thuộc kịch bản dự toán ban đầu trong đề xuất dự án. Số lượng tồn kho thực tế chưa được xác nhận.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: FAQ -->
  <section class="section section-soft" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Giải đáp thắc mắc</span>
        <h2 id="faq-heading">Hỏi đáp về sản phẩm và gây quỹ</h2>
        <p class="section-lead">
          Những câu hỏi thường gặp về định giá tham khảo, quá trình hoàn thiện và nguyên tắc sử dụng nguồn thu.
        </p>
      </div>

      <div class="faq-list">
        {
          PRODUCT_FAQS.map((faq) => (
            <div class="faq-item card">
              <h3 class="faq-question">{faq.question}</h3>
              <p class="faq-answer">{faq.answer}</p>
            </div>
          ))
        }
      </div>

      <div class="products-bottom-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary">
          Khám phá câu chuyện dự án
        </a>
        <a href="/minh-bach" class="btn btn-secondary">
          Xem nguyên tắc minh bạch thu chi
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: var(--space-2) 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Products Hero */
  .products-hero {
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
    background-color: var(--color-canvas);
  }

  .products-hero-card {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .badge-row {
    margin-bottom: var(--space-1);
  }

  .products-title {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .products-lead {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  /* Section Kicker & Lead */
  .section-kicker {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .section-lead {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Product Section Notice */
  .product-section-notice {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .product-section-notice p {
    margin: 0;
  }

  /* Catalog Groups */
  .catalog-group {
    margin-bottom: var(--space-8);
  }

  .catalog-subheading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .food-catalog-group {
    margin-top: var(--space-6);
  }

  .food-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .food-group-header .catalog-subheading {
    margin-bottom: 0;
  }

  .food-condition-badge {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    padding: 3px 12px;
    background-color: #fff8e6;
    color: #8c5b00;
    border: 1px solid #ffd591;
    border-radius: var(--radius-pill);
  }

  .food-group-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-5);
    max-width: 75ch;
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .products-grid-craft {
    grid-template-columns: repeat(2, 1fr);
    max-width: 800px;
  }

  /* Food Items Grid */
  .food-items-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .food-item-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .food-card-visual {
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .food-card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-2);
  }

  .food-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .food-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .food-price {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-accent);
    white-space: nowrap;
  }

  .food-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }

  .food-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--color-border-subtle);
    font-size: var(--font-size-sm);
  }

  .food-qty-label {
    color: var(--color-text-muted);
  }

  .food-qty-val {
    color: var(--color-text-primary);
  }

  /* Plan Table */
  .table-container {
    padding: var(--space-6);
    background-color: var(--color-surface-card);
  }

  .table-responsive {
    overflow-x: auto;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .plan-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9375rem;
  }

  .plan-table th {
    background-color: var(--color-canvas-soft);
    color: var(--color-text-primary);
    font-weight: 700;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }

  .plan-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: top;
    line-height: 1.5;
  }

  .col-name {
    color: var(--color-text-primary);
    min-width: 180px;
  }

  .col-price {
    font-weight: 700;
    color: var(--color-text-accent);
    white-space: nowrap;
  }

  .col-qty {
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .col-notes {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    min-width: 240px;
  }

  .col-status {
    white-space: nowrap;
  }

  .plan-status-badge {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: 2px 10px;
    background-color: var(--color-canvas-soft);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .table-disclaimer {
    margin-top: var(--space-4);
    border-top: 1px dashed var(--color-border-subtle);
    padding-top: var(--space-3);
  }

  .plan-mobile-list {
    display: none;
  }

  .table-disclaimer p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-sm);
    margin: 0;
  }

  /* FAQ List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .faq-question {
    font-size: 1.125rem;
    color: var(--color-text-primary);
  }

  .faq-answer {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .products-bottom-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .food-items-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .products-hero {
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }

    .products-title {
      font-size: 2rem;
      line-height: 1.15;
    }

    .products-lead {
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .products-grid-craft {
      grid-template-columns: 1fr;
    }

    .food-group-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .food-items-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .table-desktop {
      display: none !important;
    }

    .plan-mobile-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .plan-mobile-card {
      padding: var(--space-4) !important;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .plan-mobile-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-2);
      border-bottom: 1px solid var(--color-border-subtle);
      padding-bottom: var(--space-2);
    }

    .plan-mobile-title {
      font-size: 1.125rem;
      color: var(--color-text-primary);
      margin: 0;
    }

    .plan-mobile-details {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .plan-mobile-row {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: var(--font-size-sm);
    }

    .row-label {
      color: var(--color-text-muted);
    }

    .row-val {
      color: var(--color-text-primary);
      font-weight: 500;
    }

    .row-val-accent {
      color: var(--color-text-accent);
      font-size: 1rem;
      font-weight: 700;
    }

    .row-val-notes {
      color: var(--color-text-secondary);
      line-height: var(--line-height-sm);
    }

    .table-container {
      padding: var(--space-4) !important;
    }

    .plan-table th,
    .plan-table td {
      padding: var(--space-2) var(--space-3);
    }

    .faq-item {
      padding: var(--space-4) !important;
    }

    .products-bottom-actions {
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-6);
    }

    .products-bottom-actions .btn {
      width: 100%;
    }
  }
</style>
