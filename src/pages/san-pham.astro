---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sản phẩm gây quỹ"
  description="Danh mục sản phẩm thủ công gây quỹ dự kiến cho chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/san-pham"
>
  <div class="shell-container container section">
    <div class="shell-card card">
      <div class="badge-wrap">
        <span class="status-badge">Bản xem trước</span>
      </div>

      <h1 class="shell-title">Sản phẩm gây quỹ</h1>
      <p class="shell-subtitle">Chuồn chuồn tre kèm đế, túi bút vải và túi vải canvas</p>

      <div class="shell-notice">
        <p>
          <strong>Trang đang được hoàn thiện trong bản xem trước.</strong>
        </p>
        <p>
          Danh mục sản phẩm chi tiết, nguồn gốc từng món, hình ảnh mẫu thực tế và kênh đặt hàng chính thức sẽ được cập nhật sau khi hoàn tất đối soát và duyệt giá. Hiện tại sản phẩm chưa mở bán.
        </p>
      </div>

      <div class="shell-actions">
        <a href="/" class="btn btn-primary">
          &larr; Quay lại trang chủ
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .shell-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .shell-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .shell-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
  }

  .shell-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .shell-notice {
    background-color: var(--color-canvas-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .shell-actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .shell-card {
      padding: var(--space-5);
    }
  }
</style>
