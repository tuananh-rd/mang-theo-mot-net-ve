---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { PRODUCTS, PRODUCT_FAQS, SALES_PLAN } from '../data/campaign';
import { calculateBaseRevenue, formatVND } from '../lib/finance';

const baseRevenue = calculateBaseRevenue(PRODUCTS);

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Sản phẩm' }];

const summaryItems = [
  { label: 'Danh mục cơ sở', value: 'Chuồn chuồn tre, móc khóa, set đồ ăn, bánh su kem' },
  { label: 'Giá tham khảo', value: '10.000đ – 79.000đ theo đề xuất' },
  { label: 'Người hoàn thiện', value: 'Nhóm Lăng Kính; các em không có chỉ tiêu sản phẩm' },
  {
    label: 'Mở bán',
    value: 'Chưa mở, chưa nhận đơn',
    chip: { kind: 'cho-xac-nhan' as const, label: 'Chờ duyệt' },
  },
];
---

<Layout
  title="Sản phẩm gây quỹ dự kiến"
  description="Giá tham khảo, số lượng kế hoạch và nguồn gốc các sản phẩm gây quỹ dự kiến của dự án Mang Theo Một Nét Vẽ."
  currentPath="/san-pham"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Gây quỹ"
    chip={{ kind: 'cho-xac-nhan', label: 'Chưa mở bán' }}
    title="Sản phẩm gây quỹ dự kiến"
    titleId="products-heading"
    lead="Đồ thủ công và đồ ăn do nhóm chuẩn bị, bán tại FPT Hòa Lạc để có quỹ mua quà cho Mái ấm."
    description="Giá và số lượng dưới đây là kế hoạch trong đề xuất Final. Mẫu, giá chính thức và kênh đặt hàng sẽ được công bố khi kế hoạch bán được duyệt."
    summaryTitle="Tóm tắt"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="catalog-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Danh mục</span>
        <h2 id="catalog-heading">Giá tham khảo và số lượng kế hoạch</h2>
        <p>
          Bốn mặt hàng cơ sở tạo nên kịch bản doanh thu {formatVND(baseRevenue)}. Ba combo nem có trong đề xuất nhưng chưa được tính, vì hồ sơ chưa nói rõ bán thêm hay thay cho set đồ ăn.
        </p>
      </div>

      <ProductCatalog
        products={PRODUCTS}
        caption="Bảy mặt hàng gây quỹ: giá tham khảo, số lượng kế hoạch và doanh thu nếu bán đủ"
      />

      <p class="source-note">
        Theo đề xuất Final, trang 29–31. Ảnh mẫu thật sẽ bổ sung khi nhóm hoàn thiện sản phẩm. Số lượng là kế hoạch, không phải hàng tồn hay số đã bán.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="origin-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">Nguồn gốc</span>
          <h2 id="origin-heading" class="col-title">Ai làm và làm thế nào</h2>
          <ul class="check-list">
            <li>Nhóm Lăng Kính chuẩn bị và hoàn thiện mọi hàng bán; kiểm tra hình thức trước khi giao.</li>
            <li>Chuẩn bị 50 phôi chuồn chuồn: 30 bộ kèm đế dành bán, 20 chiếc để lại Mái ấm theo sắp xếp của cơ sở.</li>
            <li>Tranh của các em chỉ được in lên móc khóa khi có sự đồng ý phù hợp; nếu không, nhóm tự hoàn thiện.</li>
            <li>Tượng tô là hoạt động chơi tại Mái ấm, không phải hàng bán.</li>
          </ul>
        </div>
        <div>
          <span class="eyebrow">Kế hoạch bán</span>
          <h3 class="col-title">Khi nào và ở đâu</h3>
          <ul class="check-list">
            {SALES_PLAN.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="faq-heading">Câu hỏi về sản phẩm</h2>
      </div>
      <FaqAccordion items={PRODUCT_FAQS} idPrefix="product-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="products-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="products-cta-heading">Muốn biết tiền bán hàng dùng thế nào?</h2>
        <p>Dự toán chi, phép tính số dư và những điểm còn cần làm rõ.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch thu chi</a>
        <a href="/dong-hanh" class="link-arrow">Cách đồng hành →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  h3.col-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }
</style>
