---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GoalProgress from '../components/GoalProgress.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { TRANSPARENCY_FAQS, DONATION_ACCOUNT, DONATION_LEDGER, LEDGER_PROCESS } from '../data/campaign';
import { summarizeLedger, formatViDate } from '../lib/donations';
import { formatVND } from '../lib/finance';

const summary = summarizeLedger(DONATION_LEDGER, DONATION_ACCOUNT.goalAmount);

const moneyFlow = [
  { title: 'Tiếp nhận', text: 'Tiền ủng hộ được chuyển trực tiếp vào tài khoản ngân hàng của dự án. Toàn bộ tiền bán quà lưu niệm được quản lý và ghi sổ riêng biệt.' },
  { title: 'Đối soát', text: 'Thành viên phụ trách tài chính cùng một thành viên khác đối chiếu khớp từng giao dịch với sao kê ngân hàng chính thức trước khi cập nhật lên website.' },
  { title: 'Sử dụng', text: 'Toàn bộ nguồn quỹ dùng cho chi phí buổi chơi và mua quà tặng theo đúng danh mục nhu cầu do Mái ấm Thánh Tâm xác nhận.' },
  { title: 'Báo cáo', text: 'Sau khi hoàn thành buổi trao quà, nhóm công bố công khai tổng thu, hóa đơn chứng từ và biên bản bàn giao có xác nhận của Mái ấm.' },
];

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Minh bạch' }];

const partial = summary.scope === 'partial';
const ledgerStatusMeta = summary.reconciledAt
  ? `Cập nhật ngày ${formatViDate(summary.reconciledAt)}`
  : partial
    ? `Chưa có sổ đã đối soát đầy đủ; đã xác minh một phần ${summary.count} khoản ngày ${formatViDate(summary.coveredFrom)}–${formatViDate(summary.coveredTo)}`
    : 'Chưa có sổ đã đối soát chính thức';
const heroNote = partial
  ? 'Các khoản đã xác minh một phần đến từ ảnh sao kê do chủ dự án cung cấp; chưa phải đối soát toàn bộ tài khoản, không nêu số dư hay khoản chi.'
  : 'Website chỉ ghi nhận số liệu từ các dòng sổ đã đối soát với ngân hàng.';
---

<Layout
  title="Minh bạch tài chính"
  description="Cách nhóm Lăng Kính nhận, đối soát, công bố và sử dụng tiền ủng hộ dự án Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <PageHero
    variant="plain"
    breadcrumbs={breadcrumbs}
    eyebrow="Minh bạch tài chính"
    chip={{ kind: 'da-xac-nhan', label: 'Tài liệu công khai' }}
    title="Minh bạch tiền ủng hộ"
    titleId="transparency-heading"
    lead="Tài khoản tiếp nhận, quy trình đối soát, thời điểm công bố và mục đích sử dụng nguồn quỹ."
    description={`Trạng thái sổ: ${ledgerStatusMeta}. ${heroNote}`}
    image={{ src: '/images/trang/minh-bach-800.webp', srcset: '/images/trang/minh-bach-480.webp 480w, /images/trang/minh-bach-800.webp 800w, /images/trang/minh-bach-1153.webp 1153w', sizes: '(max-width: 1023px) 100vw, 100vw', alt: 'Bàn tay đang hái hoa cạnh một chiếc rổ xanh; ảnh do chủ dự án cung cấp.', position: '50% 80%', mobilePosition: '35% 62%', layout: 'transparency', width: 1153, height: 864 }}
  />

  <section class="section section-doc-layout">
    <div class="container doc-container">
      <!-- Cột Trái 3: Mục lục tài liệu (Sticky trên Desktop >= 1024px) -->
      <aside class="doc-sidebar">
        <nav class="doc-toc" aria-label="Mục lục trang">
          <p class="doc-toc-title">Mục lục tài liệu</p>
          <ul class="doc-toc-list">
            <li><a href="#tong-quan" class="doc-toc-link">1. Tổng quan và đối soát</a></li>
            <li><a href="#dong-tien" class="doc-toc-link">2. Bốn bước dòng tiền</a></li>
            <li><a href="#quy-trinh" class="doc-toc-link">3. Quy trình áp dụng</a></li>
            <li><a href="#bao-cao" class="doc-toc-link">4. Báo cáo và cam kết</a></li>
            <li><a href="#faq" class="doc-toc-link">5. Câu hỏi thường gặp</a></li>
          </ul>
        </nav>
      </aside>

      <!-- Cột Phải 9: Thân tài liệu -->
      <div class="doc-main">
        <!-- 1. Tổng quan & Bảng Kế hoạch / Thực tế -->
        <section id="tong-quan" class="doc-section" aria-labelledby="overview-heading">
          <div class="doc-section-header">
            <span class="eyebrow">Phần 1</span>
            <h2 id="overview-heading" class="doc-section-title">{partial ? 'Tổng quan chỉ tiêu và khoản đã xác minh một phần' : 'Tổng quan chỉ tiêu và thực tế đối soát'}</h2>
            <p>{partial ? 'Bảng so sánh mục tiêu ban đầu với các khoản đã xác minh một phần từ ảnh sao kê; chưa phải đối soát toàn bộ tài khoản ngân hàng dự án.' : 'Bảng tổng hợp đối chiếu giữa mục tiêu ban đầu và số liệu thực tế qua tài khoản ngân hàng dự án.'}</p>
          </div>

          <div class="data-table-wrap">
            <table class="data-table">
              <caption class="sr-only">Bảng so sánh kế hoạch và thực tế ủng hộ</caption>
              <thead>
                <tr>
                  <th scope="col" class="th-item">Hạng mục</th>
                  <th scope="col" class="th-plan">Kế hoạch</th>
                  <th scope="col" class="th-actual">{partial ? 'Đã xác minh một phần' : 'Thực tế (đã đối soát)'}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row" class="td-item">Mục tiêu tiếp nhận ủng hộ</th>
                  <td class="td-plan">{formatVND(DONATION_ACCOUNT.goalAmount)}</td>
                  <td class="td-actual">
                    <span class="cell-status-tag" title="Chỉ tiêu kế hoạch, không phải số thực tế đã đối soát">
                      Không áp dụng
                    </span>
                  </td>
                </tr>
                <tr>
                  <th scope="row" class="td-item">{partial ? 'Khoản đã xác minh một phần (không phải tổng đã nhận)' : 'Tổng tiền đã nhận (đối chiếu ngân hàng)'}</th>
                  <td class="td-plan">
                    <span class="cell-status-tag" title="Phụ thuộc vào các khoản ủng hộ thực tế">
                      — (Theo thực tế)
                    </span>
                  </td>
                  <td class="td-actual">
                    <strong>{summary.total !== null ? formatVND(summary.total) : 'Chưa cập nhật'}</strong>
                    {partial && <br />}
                    {partial && <span class="cell-status-tag">{summary.count} khoản, {formatViDate(summary.coveredFrom)}–{formatViDate(summary.coveredTo)}</span>}
                  </td>
                </tr>
                <tr>
                  <th scope="row" class="td-item">{partial ? 'Mốc đối soát đầy đủ gần nhất' : 'Mốc đối soát sao kê gần nhất'}</th>
                  <td class="td-plan">
                    <span class="cell-status-tag" title="Chưa có lịch đối soát cố định">
                      Chưa có lịch xác nhận
                    </span>
                  </td>
                  <td class="td-actual">
                    {summary.reconciledAt ? formatViDate(summary.reconciledAt) : partial ? `Chưa có (xác minh một phần ngày ${formatViDate(summary.verifiedAt)})` : 'Chưa có'}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="table-footnote">
            <p>
              <strong>Lưu ý quan trọng:</strong> Toàn bộ doanh thu bán quà lưu niệm được quản lý và ghi sổ riêng biệt với các khoản ủng hộ qua chuyển khoản. Tiền bán quà không tính gộp vào chỉ tiêu ủng hộ 7.000.000đ ở trên.
            </p>
          </div>

          <div class="overview-progress-card">
            <GoalProgress summary={summary} />
            <div class="progress-actions">
              <a href="/dong-hanh#sao-ke" class="link-arrow">
                {partial ? 'Xem các khoản đã xác minh một phần' : 'Xem sao kê từng khoản đã đối soát'} <span class="arrow" aria-hidden="true">→</span>
              </a>
              <a href="/dong-hanh#chuyen-khoan" class="btn btn-secondary">
                Thông tin tài khoản chuyển khoản
              </a>
            </div>
          </div>
        </section>

        <!-- 2. Bốn bước dòng tiền (Danh sách dọc số lớn, KHÔNG nền tối) -->
        <section id="dong-tien" class="doc-section" aria-labelledby="flow-heading">
          <div class="doc-section-header">
            <span class="eyebrow">Phần 2</span>
            <h2 id="flow-heading" class="doc-section-title">Bốn bước của một khoản ủng hộ</h2>
            <p>Vòng đời từ khi một khoản đóng góp được chuyển khoản đến lúc bàn giao hiện vật cho các em.</p>
          </div>

          <ol class="vertical-steps-list">
            {
              moneyFlow.map((f, i) => (
                <li class="vertical-step-item">
                  <div class="step-num-col">
                    <span class="step-large-num" aria-hidden="true">0{i + 1}</span>
                  </div>
                  <div class="step-text-col">
                    <h3 class="step-title">{f.title}</h3>
                    <p class="step-desc">{f.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- 3. Quy trình áp dụng (Ruled List chuẩn tài liệu) -->
        <section id="quy-trinh" class="doc-section" aria-labelledby="process-heading">
          <div class="doc-section-header">
            <span class="eyebrow">Phần 3</span>
            <h2 id="process-heading" class="doc-section-title">Quy trình quản lý và công bố sao kê</h2>
            <p>Quy tắc đối soát 2 người bắt buộc, bảo mật thông tin và cập nhật minh bạch lên website.</p>
          </div>

          <ul class="ruled-list">
            {
              LEDGER_PROCESS.map((p) => (
                <li>
                  <h3 class="ruled-title">{p.title}</h3>
                  <p class="ruled-desc">{p.description}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- 4. Báo cáo & Cam kết (Khối 2 cột trên nền surface-alt) -->
        <section id="bao-cao" class="doc-section" aria-labelledby="report-heading">
          <div class="doc-section-header">
            <span class="eyebrow">Phần 4</span>
            <h2 id="report-heading" class="doc-section-title">Báo cáo tổng kết và cam kết trách nhiệm</h2>
            <p>Các nội dung bắt buộc nhóm sẽ công khai sau khi hoàn thành buổi chơi tại Mái ấm Thánh Tâm.</p>
          </div>

          <div class="commitments-box">
            <div class="commit-col">
              <h3 class="commit-col-title">Hồ sơ báo cáo tổng kết</h3>
              <ul class="check-list">
                <li>Tổng tiền ủng hộ đã đối soát và tiền bán quà lưu niệm, ghi sổ riêng biệt.</li>
                <li>Danh sách vật phẩm, đồ dùng đã trao và biên bản có xác nhận của Mái ấm.</li>
                <li>Hóa đơn, chứng từ mua sắm đã che thông tin định danh cá nhân.</li>
                <li>Số dư còn lại (nếu có) và phương án xử lý thống nhất với Mái ấm.</li>
              </ul>
            </div>
            <div class="commit-col">
              <h3 class="commit-col-title">Nguyên tắc sử dụng nguồn quỹ</h3>
              <ul class="check-list">
                <li>Chỉ chi trong số tiền thực có; không ai ứng tiền cá nhân.</li>
                <li>Quà tặng mua đúng theo danh mục Mái ấm Thánh Tâm xác nhận.</li>
                <li>Tuyệt đối không dùng hình ảnh hay hoàn cảnh của các em để kêu gọi ủng hộ.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- 5. Câu hỏi thường gặp -->
        <section id="faq" class="doc-section" aria-labelledby="transparency-faq-heading">
          <div class="doc-section-header">
            <span class="eyebrow">Phần 5</span>
            <h2 id="transparency-faq-heading" class="doc-section-title">Câu hỏi thường gặp về tài chính</h2>
          </div>
          <FaqAccordion faqs={TRANSPARENCY_FAQS} idPrefix="finance-faq" />
        </section>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" aria-labelledby="finance-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="finance-cta-heading">Bạn muốn chung tay cùng dự án?</h2>
        <p>Mọi khoản đóng góp qua chuyển khoản đều được ghi nhận và sao kê công khai.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ qua chuyển khoản</a>
        <a href="/san-pham" class="link-arrow">Xem quà lưu niệm <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-doc-layout {
    background: #ffffff;
    padding-top: var(--space-8);
    padding-bottom: var(--space-18);
  }

  /* Grid 3 / 9 trên desktop */
  .doc-container {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  /* Sticky Sidebar Mục lục (>= 1024px) */
  .doc-sidebar {
    position: sticky;
    top: calc(var(--header-height, 64px) + var(--space-6));
    z-index: 10;
  }

  .doc-toc {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .doc-toc-title {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-3) 0;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .doc-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .doc-toc-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .doc-toc-link:hover {
    color: var(--brand);
    background: #ffffff;
    text-decoration: underline;
  }

  /* Main Document Column */
  .doc-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    max-width: 820px;
  }

  .doc-section {
    scroll-margin-top: calc(var(--header-height, 64px) + var(--space-6));
  }

  .doc-section-header {
    margin-bottom: var(--space-6);
  }

  .doc-section-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: 800;
    color: var(--ink);
    margin: var(--space-1) 0 var(--space-2) 0;
    letter-spacing: -0.01em;
  }

  .doc-section-header p {
    font-size: var(--font-size-body);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  /* Bảng Kế hoạch / Thực tế 3 cột */
  .data-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #ffffff;
    margin-bottom: var(--space-4);
    box-shadow: var(--shadow-sm);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--font-size-body);
  }

  .data-table th,
  .data-table td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .data-table tbody tr:last-child th,
  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table thead th {
    background: var(--surface-alt);
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--line);
  }

  .th-item {
    width: 45%;
  }

  .th-plan {
    width: 25%;
  }

  .th-actual {
    width: 30%;
  }

  .td-item {
    font-weight: 600;
    color: var(--ink);
  }

  .td-plan {
    color: var(--ink-2);
  }

  .td-actual {
    color: var(--ink);
  }

  .cell-status-tag {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    font-style: italic;
  }

  .table-footnote {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .overview-progress-card {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .progress-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }

  /* 4 Bước dòng tiền: danh sách dọc có số lớn (KHÔNG nền tối) */
  .vertical-steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .vertical-step-item {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--space-6);
    position: relative;
    padding-bottom: var(--space-8);
  }

  .vertical-step-item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 40px;
    top: 52px;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .step-large-num {
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    background: #ffffff;
    border: 2px solid var(--brand);
    color: var(--brand);
    font-size: 1.25rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .step-text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .step-title {
    font-size: 1.375rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .step-desc {
    font-size: var(--font-size-body);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  /* Khối 2 cột cam kết trên nền surface-alt */
  .commitments-box {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .commit-col-title {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-4) 0;
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--line);
  }

  @media (max-width: 1023px) {
    .doc-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .doc-sidebar {
      position: static;
    }

    .doc-toc-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .doc-toc-link {
      background: #ffffff;
      border: 1px solid var(--line);
      padding: var(--space-2) var(--space-3);
    }
  }

  @media (max-width: 767px) {
    .commitments-box {
      grid-template-columns: 1fr;
      padding: var(--space-5);
      gap: var(--space-6);
    }

    .vertical-step-item {
      grid-template-columns: 60px minmax(0, 1fr);
      gap: var(--space-3);
    }

    .vertical-step-item:not(:last-child)::after {
      left: 28px;
    }

