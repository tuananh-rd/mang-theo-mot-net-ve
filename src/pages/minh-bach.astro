---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StatusChip from '../components/StatusChip.astro';
import {
  PLANNED_EXPENSES,
  PRODUCTS,
  FINANCE_SCENARIOS,
  TRANSPARENCY_FAQS,
  ACTUAL_FINANCE,
  FINANCE_OVERVIEW,
} from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateFoodRevenue,
  calculateBaseRevenue,
  calculateScenario,
  calculateFoodReconciliation,
  calculateCraftReconciliation,
  groupPlannedExpensesByCategory,
  formatScenarioBalance,
  formatVND,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const expenseGroups = groupPlannedExpensesByCategory(PLANNED_EXPENSES);
const craftRevenue = calculateCraftRevenue(PRODUCTS);
const foodRevenue = calculateFoodRevenue(PRODUCTS);
const totalPlannedRevenue = calculateBaseRevenue(PRODUCTS);

const setDoAn = PRODUCTS.find((p) => p.id === 'set-do-an');
const banhSuKem = PRODUCTS.find((p) => p.id === 'banh-su-kem');
const foodExpensesGroup = expenseGroups.find((g) => g.category === 'Nguyên liệu gây quỹ');
const foodExpensesTotal = foodExpensesGroup?.subtotal ?? null;

const foodReconciliation = calculateFoodReconciliation(
  setDoAn?.plannedQuantity,
  setDoAn?.referencePrice,
  FINANCE_OVERVIEW.foodPlannedRevenueAssumption,
  craftRevenue,
  totalPlannedExpense,
  banhSuKem?.plannedQuantity,
  banhSuKem?.referencePrice,
  foodExpensesTotal,
  FINANCE_OVERVIEW.foodProfitQuote
);

const chuonTre = PRODUCTS.find((p) => p.id === 'chuon-chuon-tre-kem-de');
const mocKhoa = PRODUCTS.find((p) => p.id === 'moc-khoa');
const workshopExpensesGroup = expenseGroups.find((g) => g.category === 'Vật tư workshop & quà tặng');
const workshopExpensesTotal = workshopExpensesGroup?.subtotal ?? null;

const craftReconciliation = calculateCraftReconciliation(
  chuonTre?.plannedQuantity,
  chuonTre?.referencePrice,
  mocKhoa?.plannedQuantity,
  mocKhoa?.referencePrice,
  workshopExpensesTotal,
  FINANCE_OVERVIEW.craftProfitQuote
);

const totalCombinedExpenses =
  foodReconciliation.foodExpensesTotal !== null && craftReconciliation.workshopExpensesTotal !== null
    ? foodReconciliation.foodExpensesTotal + craftReconciliation.workshopExpensesTotal
    : null;

const totalCombinedRevenueMinusExpenses =
  foodReconciliation.foodRevenueMinusExpenses !== null && craftReconciliation.craftRevenueMinusExpenses !== null
    ? foodReconciliation.foodRevenueMinusExpenses + craftReconciliation.craftRevenueMinusExpenses
    : null;

const totalCombinedProfitQuote =
  foodReconciliation.foodProfitQuote !== null && craftReconciliation.craftProfitQuote !== null
    ? foodReconciliation.foodProfitQuote + craftReconciliation.craftProfitQuote
    : null;

const formatInSentence = (name: string) => (name ? name.charAt(0).toLowerCase() + name.slice(1) : '');
const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const craftFormulaText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)} × ${formatVND(p.referencePrice.value)}`)
  .join(' + ');
const craftSummaryText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)}`)
  .join(' và ');

const baseFoodProducts = PRODUCTS.filter((p) => p.category === 'food' && p.isBaseRevenueItem !== false);
const foodFormulaText = baseFoodProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)} × ${formatVND(p.referencePrice.value)}`)
  .join(' + ');

const scenarioResults = FINANCE_SCENARIOS.map((scenario) => {
  const result = calculateScenario(scenario, totalPlannedRevenue, totalPlannedExpense);
  return {
    scenario,
    result,
  };
});

const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro') || FINANCE_SCENARIOS[0];
const baseScenarioResult = baseScenario
  ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense)
  : null;
const baseBalanceDisplay = formatScenarioBalance(baseScenarioResult);

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Minh bạch' },
];

const summaryItems = [
  {
    label: 'Tổng dự toán chi',
    value: `${formatVND(totalPlannedExpense)} (${PLANNED_EXPENSES.length} khoản mục theo 3 nhóm)`,
    chip: {
      kind: 'ke-hoach' as const,
      label: 'Kế hoạch',
    },
  },
  {
    label: 'Thu kịch bản cơ sở',
    value: `${formatVND(totalPlannedRevenue)} (thủ công + ẩm thực cơ sở)`,
    chip: {
      kind: 'gia-dinh' as const,
      label: 'Giả định',
    },
  },
  {
    label: 'Số dư kịch bản cơ sở',
    value: `${baseBalanceDisplay.text} (trước tài trợ hiện vật)`,
    chip: {
      kind: 'gia-dinh' as const,
      label: 'Kịch bản',
    },
  },
  {
    label: 'Thu chi thực tế',
    value: 'Chưa có số liệu thực tế được xác nhận',
    chip: {
      kind: 'cho-xac-nhan' as const,
      label: 'Chờ xác nhận',
    },
  },
];
---

<Layout
  title="Minh bạch thu chi"
  description="Báo cáo dự toán chi phí, doanh thu kịch bản và nguyên tắc minh bạch tài chính của chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <!-- Shared PageHero (7 cột trái / 5 cột phải panel Tóm tắt kế hoạch) -->
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Tài chính dự kiến"
    chip={{
      kind: 'cho-xac-nhan',
      label: 'Chưa có số liệu thực tế được xác nhận',
    }}
    title="Minh bạch thu chi"
    titleId="transparency-heading"
    lead="Kế hoạch dự toán ngân sách, doanh thu kịch bản bán đủ hàng và các nguyên tắc quản trị tài chính minh bạch cho chiến dịch tại Mái ấm Thánh Tâm Xuy Xá."
    description="Toàn bộ số liệu dưới đây thuộc hồ sơ đề xuất dự án Final, phân định rõ ràng giữa kế hoạch dự toán và thực tế thực hiện. Website chưa tiếp nhận giao dịch tiền mặt, đơn đặt hàng hay tài trợ trực tuyến."
    summaryTitle="Tóm tắt kế hoạch"
    summaryItems={summaryItems}
  />

  <!-- Top Highlights: 3 KPI Cards + Cảnh báo đối chiếu + Chú giải trạng thái -->
  <section class="section section-highlights" aria-label="Các chỉ số kế hoạch nổi bật">
    <div class="container">
      <!-- Highlights Grid (3 KPI kế hoạch / giả định) -->
      <div class="highlights-grid" role="region" aria-label="3 chỉ số tài chính trọng tâm">
        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Chi dự kiến (kế hoạch)</span>
            <StatusChip kind="ke-hoach" label="Kế hoạch" />
          </div>
          <span class="highlight-value">{formatVND(totalPlannedExpense)}</span>
          <p class="highlight-condition">
            Dự toán {PLANNED_EXPENSES.length} khoản chi phí nguyên vật liệu, vật tư workshop, quà tặng và di chuyển theo đề xuất Final (trang 29, 30, 31).
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Doanh thu kịch bản (cơ sở)</span>
            <StatusChip kind="gia-dinh" label="Giả định" />
          </div>
          <span class="highlight-value">{formatVND(totalPlannedRevenue)}</span>
          <p class="highlight-condition">
            Gồm {formatVND(craftRevenue)} thủ công (bán đủ kế hoạch) và {formatVND(foodRevenue)} ẩm thực cơ sở (50 set đồ ăn + 50 bánh su kem).
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Số dư giả định (kịch bản cơ sở)</span>
            <StatusChip kind="gia-dinh" label="Giả định" />
          </div>
          <span class="highlight-value">
            {baseBalanceDisplay.text}
          </span>
          <p class="highlight-condition">
            Số dư mô phỏng khi chưa tính tài trợ hiện vật, dựa trên giả định bán đủ sản phẩm cơ sở theo giá tham khảo (trước khi mua quà tặng).
          </p>
        </div>
      </div>

      <!-- Cảnh báo đối chiếu cơ cấu ẩm thực & phân bổ lợi nhuận C06 -->
      <div class="transparency-gap-alert" role="note">
        <p class="gap-alert-text">
          <strong>Lưu ý đối chiếu cơ cấu ẩm thực &amp; phân bổ lợi nhuận đề xuất Final:</strong> Kế hoạch ẩm thực cơ sở gồm 50 set đồ ăn và 50 hộp bánh su kem ({formatVND(foodRevenue)}) đã giải thích trọn vẹn cơ cấu so với dự toán cũ. Ba combo nem (60 suất/món theo đề xuất) chưa tính vào kịch bản cơ sở do cần đối chiếu số lượng bổ sung hay thay thế; lãi từng nhóm sản phẩm trong hồ sơ có khoản chênh 400.000đ đang chờ thống nhất phân bổ chi phí nội bộ. Tổng số dư kịch bản toàn dự án (+1.680.000đ) vẫn khớp hoàn toàn giữa các phương pháp tính.
        </p>
        <a href="#doi-chieu-do-an" class="gap-alert-link">
          Xem bảng đối chiếu ẩm thực &amp; lợi nhuận chi tiết &darr;
        </a>
      </div>

      <!-- Chú giải trạng thái (Legend) -->
      <div class="finance-status-legend" role="region" aria-label="Giải thích các trạng thái số liệu">
        <span class="legend-title">Chú giải trạng thái:</span>
        <div class="legend-items">
          <div class="legend-item">
            <StatusChip kind="ke-hoach" label="Kế hoạch" />
            <span class="legend-desc">Dự toán {PLANNED_EXPENSES.length} khoản chi phí trong đề xuất</span>
          </div>
          <div class="legend-item">
            <StatusChip kind="gia-dinh" label="Giả định" />
            <span class="legend-desc">Mô phỏng doanh thu và số dư kịch bản</span>
          </div>
          <div class="legend-item">
            <StatusChip kind="cho-xac-nhan" label="Chờ xác nhận" />
            <span class="legend-desc">Chưa có số liệu thực tế được xác nhận</span>
          </div>
          <div class="legend-item">
            <span class="legend-neutral-text">(Xác nhận thực tế: Chưa có số liệu được xác nhận)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1 (LEDGER FIRST): Dự toán chi phí chi tiết (24 khoản mục) -->
  <section class="section section-soft" aria-labelledby="expenses-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dự toán ngân sách</span>
        <h2 id="expenses-heading" class="section-title">
          Dự toán chi phí chi tiết ({PLANNED_EXPENSES.length} khoản mục)
        </h2>
        <p class="section-subtitle">
          Danh mục chi tiết {PLANNED_EXPENSES.length} khoản mục chi phí được chia thành 3 nhóm phục vụ buổi chơi và hoạt động tại Mái ấm theo đề xuất Final.
        </p>
      </div>

      <!-- Desktop Table View (>= 768px) -->
      <div class="table-wrap desktop-only">
        <table class="data-table">
          <caption class="sr-only">Bảng phân bổ {PLANNED_EXPENSES.length} khoản mục chi phí dự toán kế hoạch theo 3 nhóm</caption>
          <thead>
            <tr>
              <th scope="col">Khoản mục</th>
              <th scope="col">Nhóm phân loại</th>
              <th scope="col" class="text-right">Dự toán (VND)</th>
              <th scope="col">Ghi chú &amp; Cơ sở tính</th>
            </tr>
          </thead>
          {
            expenseGroups.map((group) => (
              <tbody class="expense-group-body">
                <tr class="group-header-row">
                  <th scope="colgroup" colspan="2" class="group-header-title">
                    {group.category}
                  </th>
                  <td class="text-right font-bold group-header-subtotal">
                    {formatVND(group.subtotal)}
                  </td>
                  <td class="text-muted text-xs group-header-note">
                    Tổng phụ {group.items.length} khoản
                  </td>
                </tr>
                {
                  group.items.map((item) => (
                    <tr>
                      <td>
                        <strong>{item.title}</strong>
                        <div class="text-xs text-muted">{item.calculationText}</div>
                      </td>
                      <td>
                        <span class="category-tag">{item.category}</span>
                      </td>
                      <td class="text-right font-medium">
                        {formatVND(item.amount.value)}
                      </td>
                      <td class="text-muted">
                        {item.note}
                        {item.isEstimated && (
                          <span class="estimated-tag">Chi phí giả định</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            ))
          }
          <tfoot>
            <tr class="total-row">
              <th scope="row" colspan="2">Tổng dự toán chi kế hoạch ({PLANNED_EXPENSES.length} khoản)</th>
              <td class="text-right font-bold text-accent">
                {formatVND(totalPlannedExpense)}
              </td>
              <td class="text-muted">Dẫn xuất từ {PLANNED_EXPENSES.length} khoản mục dự toán trong đề xuất Final (trang 29, 30, 31), không phải chi phí thực tế</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Mobile Grouped Accordion (< 768px) -->
      <div class="mobile-only mobile-expense-groups" aria-label="Danh sách dự toán chi phí theo nhóm trên di động">
        {
          expenseGroups.map((group, gIdx) => (
            <details class="expense-group-accordion card" id={`expense-group-${gIdx}`}>
              <summary class="group-summary">
                <div class="group-summary-left">
                  <h3 class="group-summary-title">{group.category}</h3>
                  <span class="group-summary-count">{group.items.length} khoản mục</span>
                </div>
                <div class="group-summary-right font-bold text-accent">
                  <span class="group-subtotal-val">{formatVND(group.subtotal)}</span>
                  <span class="group-expand-cue" aria-hidden="true">
                    <svg
                      class="chevron-svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </div>
              </summary>

              <div class="group-items-list">
                {
                  group.items.map((item) => (
                    <div class="mobile-expense-item">
                      <div class="mobile-expense-top">
                        <div class="mobile-expense-main">
                          <h4 class="mobile-expense-title">{item.title}</h4>
                        </div>
                        <div class="mobile-expense-val-col">
                          <span class="mobile-expense-val text-accent font-bold">
                            {formatVND(item.amount.value)}
                          </span>
                          {item.isEstimated && (
                            <span class="estimated-tag">Giả định</span>
                          )}
                        </div>
                      </div>
                      <div class="mobile-expense-sub text-muted">
                        {item.calculationText && (
                          <span class="mobile-expense-calc">{item.calculationText}</span>
                        )}
                        {item.calculationText && item.note && (
                          <span class="mobile-sub-sep" aria-hidden="true">&bull;</span>
                        )}
                        {item.note && (
                          <span class="mobile-expense-note">{item.note}</span>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </details>
          ))
        }

        <div class="mobile-total-card card">
          <div class="mobile-total-header">Tổng dự toán chi kế hoạch ({PLANNED_EXPENSES.length} khoản)</div>
          <div class="mobile-total-amount">{formatVND(totalPlannedExpense)}</div>
          <p class="mobile-total-note">
            Dẫn xuất từ 3 nhóm dự toán trong đề xuất Final (trang 29, 30, 31); không phải chi phí thực tế đã thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Doanh thu kịch bản và phân tích số dư -->
  <section class="section" aria-labelledby="scenarios-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kịch bản tài chính</span>
        <h2 id="scenarios-heading" class="section-title">
          Doanh thu kịch bản và phân tích số dư
        </h2>
        <p class="section-subtitle">
          Tính toán doanh thu giả định khi hoàn thành các mục tiêu kế hoạch và đối sánh với dự toán chi phí.
        </p>
      </div>

      <!-- Calculation Breakdown Card -->
      <div class="formula-card card">
        <h3 class="formula-title">Cơ cấu doanh thu kịch bản bán đủ hàng ({formatVND(totalPlannedRevenue)})</h3>
        <div class="formula-breakdown">
          <div class="formula-part">
            <span class="formula-part-title">1. Sản phẩm lưu niệm thủ công:</span>
            <p class="formula-expression">{craftFormulaText} = <strong>{formatVND(craftRevenue)}</strong></p>
            <p class="formula-subnote">Giả định bán đủ {craftSummaryText} theo giá tham khảo trong đề xuất Final (trang 30).</p>
          </div>
          <div class="formula-part">
            <span class="formula-part-title">2. Phương án ẩm thực sinh viên cơ sở:</span>
            <p class="formula-expression">{foodFormulaText} = <strong>{formatVND(foodRevenue)}</strong></p>
            <p class="formula-subnote">Gồm 50 set đồ ăn (79.000đ/set) và 50 hộp bánh su kem (20.000đ/hộp) theo đề xuất Final (trang 29). Chưa gộp 3 combo nem vào doanh thu cơ sở do cần đối chiếu số lượng bổ sung hay thay thế (xem mục đối chiếu ẩm thực bên dưới).</p>
          </div>
        </div>
        <div class="formula-total">
          <span>Tổng doanh thu kịch bản cơ sở kết hợp:</span>
          <strong>{formatVND(craftRevenue)} (thủ công) + {formatVND(foodRevenue)} (ẩm thực cơ sở) = {formatVND(totalPlannedRevenue)}</strong>
        </div>
        <p class="formula-note">
          Doanh thu giả định tính trên giả thiết hoàn thành mục tiêu đề xuất và bán theo mức giá tham khảo. Trạng thái mở bán hiện chưa được xác nhận; bản xem trước chưa nhận đơn hoặc tiền.
        </p>
      </div>

      <!-- Food & Profit Reconciliation Card (#doi-chieu-do-an) -->
      <div id="doi-chieu-do-an" class="reconciliation-card card">
        <div class="reconciliation-header">
          <div class="badge-wrap">
            <span class="eyebrow">Đối chiếu kế hoạch đề xuất Final</span>
          </div>
          <h3 class="reconciliation-title">Đối chiếu cơ cấu ẩm thực và phân bổ lợi nhuận</h3>
        </div>

        <p class="reconciliation-lead">
          Hồ sơ đề xuất Final (trang 29–32) xác định doanh thu ẩm thực cơ sở là <strong>{formatVND(foodRevenue)}</strong> (50 set đồ ăn và 50 hộp bánh su kem). Dưới đây là phân tích đối chiếu chi tiết về cơ cấu ẩm thực, lưu ý về combo và khoản chênh lệch phân bổ chi phí 400.000đ giữa các nhóm sản phẩm:
        </p>

        <!-- Phần 1: Cơ cấu ẩm thực cơ sở -->
        <div class="reconciliation-sub-block">
          <h4 class="reconciliation-sub-title">1. Cơ cấu doanh thu ẩm thực cơ sở ({formatVND(foodRevenue)})</h4>
          <div class="reconciliation-grid">
            <div class="reconcile-item">
              <span class="reconcile-label">Set đồ ăn sinh viên (50 set)</span>
              <span class="reconcile-val">{foodReconciliation.hypotheticalSets} set &times; {formatVND(foodReconciliation.setUnitPrice)} = <strong>{formatVND(foodReconciliation.setsCalculatedRevenue)}</strong></span>
              <span class="reconcile-note">50 set đồ ăn (2 nem rán, 2 nem xù, 2 nem phô mai, dưa chuột, khoai tây, nước uống).</span>
            </div>

            <div class="reconcile-item">
              <span class="reconcile-label">Bánh su kem (50 hộp)</span>
              <span class="reconcile-val">{foodReconciliation.suKemQuantity} hộp &times; {formatVND(foodReconciliation.suKemUnitPrice)} = <strong>{formatVND(foodReconciliation.suKemCalculatedRevenue)}</strong></span>
              <span class="reconcile-note">50 hộp bánh su kem giá tham khảo 20.000đ/hộp (trang 29).</span>
            </div>

            <div class="reconcile-item reconcile-total-item">
              <span class="reconcile-label">Tổng doanh thu ẩm thực cơ sở</span>
              <span class="reconcile-val font-bold text-accent"><strong>{formatVND(foodRevenue)}</strong></span>
              <span class="reconcile-note">Đã giải thích đầy đủ cơ cấu doanh thu ẩm thực cơ sở; không còn khoản chênh chưa rõ nguồn.</span>
            </div>
          </div>
        </div>

