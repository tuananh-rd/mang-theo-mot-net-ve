---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GoalProgress from '../components/GoalProgress.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { TRANSPARENCY_FAQS, DONATION_ACCOUNT, DONATION_LEDGER, LEDGER_PROCESS } from '../data/campaign';
import { summarizeLedger } from '../lib/donations';

const summary = summarizeLedger(DONATION_LEDGER, DONATION_ACCOUNT.goalAmount);

const moneyFlow = [
  { title: 'Nhận', text: 'Tiền ủng hộ vào tài khoản dự án; tiền bán quà lưu niệm ghi sổ riêng.' },
  { title: 'Đối soát', text: 'Hai thành viên đối chiếu với sao kê ngân hàng rồi đăng lên website.' },
  { title: 'Sử dụng', text: 'Cho buổi chơi và quà theo danh mục Mái ấm xác nhận.' },
  { title: 'Báo cáo', text: 'Sau buổi trao quà, công bố tổng nhận, hóa đơn và biên bản bàn giao.' },
];

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Minh bạch' }];
---

<Layout
  title="Minh bạch"
  description="Cách nhóm Lăng Kính nhận, đối soát, công bố và sử dụng tiền ủng hộ dự án Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Minh bạch"
    title="Minh bạch tiền ủng hộ"
    titleId="transparency-heading"
    lead="Nhận vào đâu, đối soát thế nào, công bố khi nào và dùng cho việc gì."
    description="Tổng ủng hộ chỉ được tính từ sổ đã đối chiếu với ngân hàng; chưa có sổ đã đối soát thì website ghi “Chưa cập nhật”, không ghi 0đ."
  />

  <section class="section section-first" aria-labelledby="overview-heading">
    <div class="container">
      <h2 id="overview-heading" class="sr-only">Tiến độ ủng hộ</h2>
      <div class="overview reveal">
        <GoalProgress summary={summary} />
      </div>
      <div class="section-actions">
        <a href="/dong-hanh#sao-ke" class="link-arrow">Xem sao kê từng khoản <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/dong-hanh" class="link-arrow">Thông tin chuyển khoản <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="flow-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dòng tiền</span>
        <h2 id="flow-heading">Bốn bước của một khoản ủng hộ</h2>
      </div>
      <ol class="flow">
        {
          moneyFlow.map((f, i) => (
            <li class="flow-step lift">
              <span class="flow-num" aria-hidden="true">{i + 1}</span>
              <h3 class="flow-title">{f.title}</h3>
              <p class="flow-text">{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading" id="quy-trinh">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quy trình áp dụng</span>
        <h2 id="process-heading">Quản lý và công bố sao kê</h2>
        <p>Đây là quy trình nhóm áp dụng cho dự án. Kết quả từng lần đối soát sẽ hiển thị ở trang Ủng hộ.</p>
      </div>
      <ul class="ruled-list">
        {
          LEDGER_PROCESS.map((p) => (
            <li>
              <h3 class="ruled-title">{p.title}</h3>
              <p class="ruled-desc">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="report-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">Sau dự án</span>
          <h2 id="report-heading" class="col-title">Báo cáo cuối sẽ có</h2>
          <ul class="check-list">
            <li>Tổng tiền ủng hộ đã đối soát và tiền bán quà lưu niệm, ghi riêng.</li>
            <li>Danh sách vật phẩm đã trao và biên bản có xác nhận của Mái ấm.</li>
            <li>Hóa đơn, chứng từ đã che thông tin riêng tư.</li>
            <li>Số còn lại (nếu có) và cách xử lý.</li>
          </ul>
        </div>
        <div class="reveal">
          <span class="eyebrow">Cam kết</span>
          <h3 class="col-title col-title--sm">Nguyên tắc nhóm giữ</h3>
          <ul class="check-list">
            <li>Chỉ chi trong số tiền thực có; không ai ứng tiền cá nhân.</li>
            <li>Quà mua theo danh mục Mái ấm xác nhận.</li>
            <li>Không dùng hình ảnh hay hoàn cảnh của các em để kêu gọi ủng hộ.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="transparency-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="transparency-faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion faqs={TRANSPARENCY_FAQS} idPrefix="finance-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="finance-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="finance-cta-heading">Cùng góp một món quà</h2>
        <p>Quét mã QR và theo dõi khoản của bạn trong sao kê.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-first {
    padding-top: var(--space-10);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  .overview {
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .flow-num {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--brand-ink);
    color: #ffffff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .flow-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .flow-text {
    margin: 0;
  }

  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 1023px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .section-first {
      padding-top: var(--space-6);
    }

    .overview {
      padding: var(--space-4);
    }

    .flow {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .flow-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: 2px;
      padding: var(--space-4);
    }

    .flow-num {
      grid-row: span 2;
    }
  }
</style>
