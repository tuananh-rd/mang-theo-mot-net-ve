---
import Layout from '../layouts/Layout.astro';
import { FINANCE_OVERVIEW } from '../data/campaign';
---

<Layout
  title="Minh bạch thu chi"
  description="Báo cáo dự toán, nguồn tài trợ và nguyên tắc thu chi chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <div class="shell-container container section">
    <div class="shell-card card">
      <div class="badge-wrap">
        <span class="status-badge">Bản xem trước</span>
      </div>

      <h1 class="shell-title">Minh bạch thu chi</h1>
      <p class="shell-subtitle">Dự toán kế hoạch và nguyên tắc công khai tài chính</p>

      <div class="shell-notice">
        <p>
          <strong>{FINANCE_OVERVIEW.actualStatusNotice}</strong>
        </p>
        <p>
          Trang đang được hoàn thiện trong bản xem trước. Bảng dự toán chi tiết, danh mục tài trợ hiện vật, hóa đơn chứng từ mua sắm đã biên tập và biên bản đối soát bàn giao sẽ được công bố công khai tại đây sau khi hoàn tất các hoạt động.
        </p>
      </div>

      <div class="shell-actions">
        <a href="/" class="btn btn-primary">
          &larr; Quay lại trang chủ
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .shell-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .shell-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .shell-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
  }

  .shell-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .shell-notice {
    background-color: var(--color-canvas-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .shell-actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .shell-card {
      padding: var(--space-5);
    }
  }
</style>
