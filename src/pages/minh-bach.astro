---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Icon from '../components/Icon.astro';
import { PLANNED_EXPENSES, PRODUCTS, FINANCE_SCENARIOS, TRANSPARENCY_FAQS, ACTUAL_FINANCE } from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateFoodRevenue,
  calculateBaseRevenue,
  calculateScenario,
  groupPlannedExpensesByCategory,
  formatScenarioBalance,
  formatVND,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const expenseGroups = groupPlannedExpensesByCategory(PLANNED_EXPENSES);
const craftRevenue = calculateCraftRevenue(PRODUCTS);
const foodRevenue = calculateFoodRevenue(PRODUCTS);
const totalPlannedRevenue = calculateBaseRevenue(PRODUCTS);

const scenarioResults = FINANCE_SCENARIOS.map((scenario) => ({
  scenario,
  result: calculateScenario(scenario, totalPlannedRevenue, totalPlannedExpense),
}));
const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro') ?? FINANCE_SCENARIOS[0];
const baseBalance = formatScenarioBalance(calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense));

const groupLabel: Record<string, string> = {
  'Nguyên liệu gây quỹ': 'Nguyên liệu đồ ăn gây quỹ',
  'Vật tư workshop & quà tặng': 'Vật tư buổi chơi và quà',
  'Truyền thông & Di chuyển': 'Truyền thông và di chuyển',
};

const shortName: Record<string, string> = {
  'chuon-chuon-tre-kem-de': 'bộ chuồn chuồn',
  'moc-khoa': 'móc khóa',
  'set-do-an': 'set đồ ăn',
  'banh-su-kem': 'hộp su kem',
};
const formulaText = (category: 'craft' | 'food') =>
  PRODUCTS.filter((p) => p.category === category && p.isBaseRevenueItem !== false)
    .map((p) => `${p.plannedQuantity.value ?? '?'} ${shortName[p.id] ?? p.name} × ${formatVND(p.referencePrice.value)}`)
    .join(' + ');

const figures = [
  {
    label: 'Chi phí dự kiến',
    value: formatVND(totalPlannedExpense),
    chip: 'ke-hoach' as const,
    note: 'Nguyên liệu, vật tư buổi chơi, quà và di chuyển.',
  },
  {
    label: 'Doanh thu nếu bán hết',
    value: formatVND(totalPlannedRevenue),
    chip: 'gia-dinh' as const,
    note: 'Theo giá tham khảo của bốn sản phẩm chính.',
  },
  {
    label: 'Dự kiến dành mua quà',
    value: baseBalance.text,
    chip: 'gia-dinh' as const,
    note: 'Phần còn lại sau chi phí; chưa phải số tiền đã có.',
  },
  {
    label: 'Thu chi thực tế',
    value: formatVND(ACTUAL_FINANCE.actualCashBalance.value),
    chip: 'cho-xac-nhan' as const,
    chipLabel: 'Chưa có số liệu',
    note: 'Công bố sau khi dự án kết thúc và đối soát.',
    muted: true,
  },
];

const moneyFlow = [
  { title: 'Thu', text: 'Tiền bán hàng và tài trợ tiền, ghi sổ sau mỗi đợt bán.' },
  { title: 'Trả chi phí', text: 'Nguyên liệu, vật tư và di chuyển, mỗi khoản trừ một lần.' },
  { title: 'Mua quà', text: 'Phần còn lại mua vật phẩm theo danh mục Mái ấm xác nhận.' },
  { title: 'Công khai', text: 'Bảng thu chi, hóa đơn và biên bản bàn giao sau dự án.' },
];

const actualRows = [
  { label: 'Tiền đã nhận', fact: ACTUAL_FINANCE.actualCashReceived },
  { label: 'Tiền đã chi', fact: ACTUAL_FINANCE.actualCashSpent },
  { label: 'Số dư', fact: ACTUAL_FINANCE.actualCashBalance },
  { label: 'Hiện vật đã trao cho Mái ấm', fact: ACTUAL_FINANCE.actualInKindDelivered },
];
const formatActual = (value: number | null, unit: string) =>
  value === null ? 'Chưa xác nhận' : unit === 'đ' ? formatVND(value) : `${value} ${unit}`;
const cleanNote = (note: string) => note.replace(/\s*\(trang \d+\)\s*$/, '');

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Minh bạch' }];
---

<Layout
  title="Minh bạch thu chi"
  description="Kế hoạch tài chính của dự án Mang Theo Một Nét Vẽ: chi phí dự kiến, doanh thu nếu bán hết, phần dành mua quà và cách công khai thu chi."
  currentPath="/minh-bach"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Minh bạch"
    chip={{ kind: 'cho-xac-nhan', label: 'Chưa có số liệu thực tế' }}
    title="Minh bạch thu chi"
    titleId="transparency-heading"
    lead="Tiền gây quỹ được tính và sử dụng thế nào — từ kế hoạch đến báo cáo sau dự án."
    description="Các con số dưới đây là kế hoạch, chưa phải tiền đã thu hay đã chi. Số liệu thực tế sẽ được cập nhật tại đây sau khi đối soát."
  />

  <section class="section section-first" aria-labelledby="overview-heading">
    <div class="container">
      <h2 id="overview-heading" class="sr-only">Tổng quan kế hoạch tài chính</h2>
      <KeyFigures figures={figures} label="Bốn con số tài chính chính" />

      <div class="formula" aria-label="Cách tính phần dự kiến dành mua quà">
        <div class="formula-part">
          <span class="formula-label">Đồ thủ công</span>
          <span class="formula-value">{formatVND(craftRevenue)}</span>
          <span class="formula-sub">{formulaText('craft')}</span>
        </div>
        <span class="formula-op" aria-hidden="true">+</span>
        <div class="formula-part">
          <span class="formula-label">Đồ ăn</span>
          <span class="formula-value">{formatVND(foodRevenue)}</span>
          <span class="formula-sub">{formulaText('food')}</span>
        </div>
        <span class="formula-op" aria-hidden="true">−</span>
        <div class="formula-part">
          <span class="formula-label">Chi phí dự kiến</span>
          <span class="formula-value">{formatVND(totalPlannedExpense)}</span>
          <span class="formula-sub">{PLANNED_EXPENSES.length} khoản trong 3 nhóm</span>
        </div>
        <span class="formula-op" aria-hidden="true">=</span>
        <div class="formula-part formula-result">
          <span class="formula-label">Dành mua quà</span>
          <span class="formula-value">{baseBalance.text}</span>
          <span class="formula-sub">nếu bán hết, chưa tính tài trợ</span>
        </div>
      </div>
      <p class="source-note">
        Một số chi tiết như thực đơn combo bổ sung và cách phân bổ chi phí giữa các nhóm hàng đang được nhóm chốt, nên các con số có thể thay đổi.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="flow-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dòng tiền</span>
        <h2 id="flow-heading">Tiền sẽ đi đâu</h2>
      </div>
      <ol class="flow">
        {
          moneyFlow.map((f, i) => (
            <li class="flow-step lift">
              <span class="flow-num" aria-hidden="true">{i + 1}</span>
              <h3 class="flow-title">{f.title}</h3>
              <p class="flow-text">{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="expenses-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Chi phí</span>
        <h2 id="expenses-heading">Chi phí dự kiến</h2>
        <p>Mở từng nhóm để xem chi tiết. Đơn giá theo báo giá tham khảo, sẽ được xác nhận trước khi mua.</p>
      </div>

      <div class="ledger">
        {
          expenseGroups.map((group, gi) => (
            <details class="disclosure ledger-group" id={`nhom-chi-${gi + 1}`}>
              <summary>
                <span class="disclosure-label">
                  {groupLabel[group.category] ?? group.category}
                  <span class="disclosure-meta">{group.items.length} khoản</span>
                </span>
                <span class="disclosure-aside">
                  <span class="ledger-subtotal">{formatVND(group.subtotal)}</span>
                  <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
                </span>
              </summary>
              <div class="disclosure-body">
                <table class="data-table data-table--stack ledger-table">
                  <caption class="sr-only">Các khoản trong nhóm {groupLabel[group.category] ?? group.category}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Khoản</th>
                      <th scope="col">Cách tính</th>
                      <th scope="col" class="num">Dự kiến</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.items.map((item) => (
                      <tr>
                        <th scope="row">
                          {item.title}
                          {item.note && <span class="cell-sub">{cleanNote(item.note)}</span>}
                        </th>
                        <td class="ledger-calc" data-label="Cách tính">{item.calculationText}</td>
                        <td class="num" data-label="Dự kiến">{formatVND(item.amount.value)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))
        }
        <div class="ledger-total reveal">
          <span>Tổng chi phí dự kiến</span>
          <strong>{formatVND(totalPlannedExpense)}</strong>
        </div>

        <details class="disclosure scenarios">
          <summary>
            <span class="disclosure-label">
              Nếu có tài trợ hiện vật
              <span class="disclosure-meta">Hiện vật giảm đúng khoản chi tương ứng, không cộng vào doanh thu</span>
            </span>
            <span class="disclosure-aside">
              <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
            </span>
          </summary>
          <div class="disclosure-body">
            <table class="data-table data-table--stack scenario-table">
              <caption class="sr-only">Phần dự kiến dành mua quà theo từng kịch bản tài trợ hiện vật</caption>
              <thead>
                <tr>
                  <th scope="col">Nếu được tài trợ</th>
                  <th scope="col" class="num">Tiền còn phải chi</th>
                  <th scope="col" class="num">Dành mua quà</th>
                </tr>
              </thead>
              <tbody>
                {scenarioResults.map(({ scenario, result }) => (
                  <tr>
                    <th scope="row">
                      {scenario.id === 'chua-tinh-tai-tro' ? 'Không có tài trợ' : scenario.title.replace(/\s*\([\d.]+đ\)$/, '')}
                      <span class="cell-sub">
                        {formatVND(scenario.inKindReplacement.value)} hiện vật{scenario.allocationPending ? ' · danh mục cần xác nhận' : ''}
                      </span>
                    </th>
                    <td class="num" data-label="Tiền còn phải chi">{result ? formatVND(result.remainingCashExpense) : 'Chưa xác nhận'}</td>
                    <td class="num" data-label="Dành mua quà">{result ? formatScenarioBalance(result).text : 'Chưa xác nhận'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="source-note">
              Tất cả là giả định, chưa có cam kết tài trợ nào. Nếu chưa đủ đơn hoặc tài trợ trước buổi chơi, nhóm giảm vật liệu và không ứng tiền cá nhân.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="actual-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">Thực tế</span>
          <h2 id="actual-heading" class="col-title">Báo cáo sau dự án</h2>
          <p class="actual-intro">Các ô dưới đây sẽ được điền sau khi dự án kết thúc và hai thành viên tài chính đối soát xong.</p>
          <dl class="actual-list">
            {
              actualRows.map((r) => (
                <div class="actual-row">
                  <dt>{r.label}</dt>
                  <dd>{formatActual(r.fact.value, r.fact.unit)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="reveal">
          <span class="eyebrow">Nguyên tắc</span>
          <h3 class="col-title col-title--sm">Cách nhóm giữ tiền</h3>
          <ul class="check-list">
            <li>Tiền và hiện vật ghi hai sổ riêng; hai thành viên đối soát.</li>
            <li>Chỉ chi trong số tiền thực có; không ai ứng tiền cá nhân.</li>
            <li>Quà mua theo danh mục Mái ấm xác nhận, có hóa đơn và biên bản bàn giao.</li>
            <li>Chứng từ công bố bản đã che thông tin riêng tư.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="transparency-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="transparency-faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion faqs={TRANSPARENCY_FAQS} idPrefix="finance-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="finance-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="finance-cta-heading">Muốn góp sức cho dự án?</h2>
        <p>Các cách đồng hành và nguyên tắc tiếp nhận của nhóm.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Cách đồng hành</a>
        <a href="/san-pham" class="link-arrow">Sản phẩm gây quỹ <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-first {
    padding-top: var(--space-10);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  /* Phép tính */
  .formula {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .formula-part {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4);
    background: var(--surface-alt);
    border-radius: var(--radius-md);
  }

  .formula-result {
    background: var(--brand-ink);
  }

  .formula-result .formula-label,
  .formula-result .formula-sub {
    color: #c9d2dc;
  }

  .formula-result .formula-value {
    color: #ffffff;
  }

  .formula-label {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--ink-2);
  }

  .formula-value {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .formula-sub {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--ink-2);
  }

  .formula-op {
    align-self: center;
    font-size: var(--font-size-h3);
    font-weight: 700;
    color: var(--ink-2);
  }

  /* Dòng tiền */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    counter-reset: none;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .flow-num {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--brand-ink);
    color: #ffffff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .flow-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .flow-text {
    margin: 0;
  }

  /* Chi phí */
  .ledger-subtotal {
    font-weight: 700;
    color: var(--ink);
  }

  .ledger-table tbody th {
    width: 50%;
  }

  .ledger-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--brand-ink);
    color: #ffffff;
    border-radius: var(--radius-md);
    font-weight: 600;
  }

  .ledger-total strong {
    font-size: var(--font-size-h3);
    font-variant-numeric: tabular-nums;
  }

  .scenarios {
    margin-top: var(--space-6);
  }

  /* Thực tế */
  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-3);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  .actual-intro {
    margin-bottom: var(--space-4);
  }

  .actual-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .actual-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }

  .actual-row dt {
    color: var(--ink);
  }

  .actual-row dd {
    margin: 0;
    color: var(--status-pending-text);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .formula {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .formula-op {
      justify-self: center;
      line-height: 1;
    }

    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .section-first {
      padding-top: var(--space-6);
    }

    .formula-part {
      padding: var(--space-3) var(--space-4);
    }

    .flow {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .flow-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: 2px;
      padding: var(--space-4);
    }

    .flow-num {
      grid-row: span 2;
    }

    .ledger-table tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-4);
      row-gap: 2px;
    }

    .ledger-table tbody th {
      width: auto;
      grid-column: 1;
      grid-row: 1;
    }

    .ledger-table tbody td.num {
      grid-column: 2;
      grid-row: 1;
      font-weight: 600;
      color: var(--ink);
    }

    .ledger-table tbody td.num::before,
    .ledger-table tbody td.ledger-calc::before {
      display: none;
    }

    .ledger-table tbody td.ledger-calc {
      grid-column: 1 / -1;
      justify-content: flex-start;
      font-size: var(--font-size-small);
      line-height: var(--line-height-small);
      color: var(--ink-2);
    }

    .ledger-subtotal {
      font-size: var(--font-size-small);
    }

    .actual-row dd {
      white-space: normal;
      text-align: right;
    }
  }
</style>
