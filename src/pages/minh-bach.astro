---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StatusChip from '../components/StatusChip.astro';
import {
  PLANNED_EXPENSES,
  PRODUCTS,
  FINANCE_SCENARIOS,
  TRANSPARENCY_FAQS,
  ACTUAL_FINANCE,
  FINANCE_OVERVIEW,
} from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateCombinedPlannedRevenue,
  calculateScenario,
  calculateFoodReconciliation,
  groupPlannedExpensesByCategory,
  formatScenarioBalance,
  formatVND,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const expenseGroups = groupPlannedExpensesByCategory(PLANNED_EXPENSES);
const craftRevenue = calculateCraftRevenue(PRODUCTS);
const foodAssumption = FINANCE_OVERVIEW.foodPlannedRevenueAssumption.value;
const totalPlannedRevenue = calculateCombinedPlannedRevenue(craftRevenue, foodAssumption);

const setDoAn = PRODUCTS.find((p) => p.id === 'set-do-an');
const foodReconciliation = calculateFoodReconciliation(
  FINANCE_OVERVIEW.foodHypotheticalSets,
  setDoAn?.referencePrice,
  FINANCE_OVERVIEW.foodPlannedRevenueAssumption,
  craftRevenue,
  totalPlannedExpense
);

const formatInSentence = (name: string) => (name ? name.charAt(0).toLowerCase() + name.slice(1) : '');
const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const craftFormulaText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)} × ${formatVND(p.referencePrice.value)}`)
  .join(' + ');
const craftSummaryText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)}`)
  .join(' và ');

const scenarioResults = FINANCE_SCENARIOS.map((scenario) => {
  const result = calculateScenario(scenario, totalPlannedRevenue, totalPlannedExpense);
  return {
    scenario,
    result,
  };
});

const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro') || FINANCE_SCENARIOS[0];
const baseScenarioResult = baseScenario
  ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense)
  : null;
const baseBalanceDisplay = formatScenarioBalance(baseScenarioResult);

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Minh bạch' },
];

const summaryItems = [
  {
    label: 'Tổng dự toán chi',
    value: `${formatVND(totalPlannedExpense)} (19 khoản mục theo 3 nhóm)`,
    chip: {
      kind: 'ke-hoach' as const,
      label: 'Kế hoạch',
    },
  },
  {
    label: 'Thu kịch bản giả định',
    value: `${formatVND(totalPlannedRevenue)} (thủ công + ẩm thực)`,
    chip: {
      kind: 'gia-dinh' as const,
      label: 'Giả định',
    },
  },
  {
    label: 'Số dư kịch bản cơ sở',
    value: `${baseBalanceDisplay.text} (trước tài trợ hiện vật)`,
    chip: {
      kind: 'gia-dinh' as const,
      label: 'Kịch bản',
    },
  },
  {
    label: 'Thu chi thực tế',
    value: 'Chưa có số liệu thực tế được xác nhận',
    chip: {
      kind: 'cho-xac-nhan' as const,
      label: 'Chờ xác nhận',
    },
  },
];
---

<Layout
  title="Minh bạch thu chi"
  description="Báo cáo dự toán chi phí, doanh thu kịch bản và nguyên tắc minh bạch tài chính của chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <!-- Shared PageHero (7 cột trái / 5 cột phải panel Tóm tắt kế hoạch) -->
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Tài chính dự kiến"
    chip={{
      kind: 'cho-xac-nhan',
      label: 'Chưa có số liệu thực tế được xác nhận',
    }}
    title="Minh bạch thu chi"
    titleId="transparency-heading"
    lead="Kế hoạch dự toán ngân sách, doanh thu kịch bản bán đủ hàng và các nguyên tắc quản trị tài chính minh bạch cho chiến dịch tại Mái ấm Thánh Tâm Xuy Xá."
    description="Toàn bộ số liệu dưới đây thuộc hồ sơ đề xuất dự án, phân định rõ ràng giữa kế hoạch dự toán và thực tế thực hiện. Website chưa tiếp nhận giao dịch tiền mặt, đơn đặt hàng hay tài trợ trực tuyến."
    summaryTitle="Tóm tắt kế hoạch"
    summaryItems={summaryItems}
  />

  <!-- Top Highlights: 3 KPI Cards + Cảnh báo 550.000đ + Chú giải trạng thái -->
  <section class="section section-highlights" aria-label="Các chỉ số kế hoạch nổi bật">
    <div class="container">
      <!-- Highlights Grid (3 KPI kế hoạch / giả định) -->
      <div class="highlights-grid" role="region" aria-label="3 chỉ số tài chính trọng tâm">
        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Chi dự kiến (kế hoạch)</span>
            <StatusChip kind="ke-hoach" label="Kế hoạch" />
          </div>
          <span class="highlight-value">{formatVND(totalPlannedExpense)}</span>
          <p class="highlight-condition">
            Dự toán 19 khoản chi phí nguyên vật liệu, vật tư góc chơi, quà tặng và di chuyển theo đề xuất (trang 24, 25, 26).
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Doanh thu kịch bản (giả định)</span>
            <StatusChip kind="gia-dinh" label="Giả định" />
          </div>
          <span class="highlight-value">{formatVND(totalPlannedRevenue)}</span>
          <p class="highlight-condition">
            Gồm {formatVND(craftRevenue)} thủ công (bán đủ kế hoạch) và {formatVND(foodAssumption)} ẩm thực giả định (trang 18).
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-header">
            <span class="highlight-label">Số dư giả định (kịch bản cơ sở)</span>
            <StatusChip kind="gia-dinh" label="Giả định" />
          </div>
          <span class="highlight-value">
            {baseBalanceDisplay.text}
          </span>
          <p class="highlight-condition">
            Số dư mô phỏng khi chưa tính tài trợ hiện vật, dựa trên giả định bán hết sản phẩm theo giá tham khảo.
          </p>
        </div>
      </div>

      <!-- Cảnh báo dẫn xuất chênh 550.000đ và link đối chiếu -->
      <div class="transparency-gap-alert" role="note">
        <p class="gap-alert-text">
          <strong>Lưu ý đối soát mục tiêu ẩm thực:</strong> Hồ sơ đề xuất ghi mục tiêu ẩm thực <strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong> (trang 18) nhưng số set giả định tính theo đơn giá SKU là <strong>{formatVND(foodReconciliation.setsCalculatedRevenue)}</strong> ({foodReconciliation.hypotheticalSets} set &times; {formatVND(foodReconciliation.setUnitPrice)}). Khoản chênh <strong>{foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}</strong> chưa có bảng phân bổ số lượng chi tiết từng món.
        </p>
        <a href="#doi-chieu-do-an" class="gap-alert-link">
          Xem bảng đối chiếu ẩm thực &darr;
        </a>
      </div>

      <!-- Chú giải trạng thái (Legend) -->
      <div class="finance-status-legend" role="region" aria-label="Giải thích các trạng thái số liệu">
        <span class="legend-title">Chú giải trạng thái:</span>
        <div class="legend-items">
          <div class="legend-item">
            <StatusChip kind="ke-hoach" label="Kế hoạch" />
            <span class="legend-desc">Dự toán 19 khoản chi phí trong đề xuất</span>
          </div>
          <div class="legend-item">
            <StatusChip kind="gia-dinh" label="Giả định" />
            <span class="legend-desc">Mô phỏng doanh thu và số dư kịch bản</span>
          </div>
          <div class="legend-item">
            <StatusChip kind="cho-xac-nhan" label="Chờ xác nhận" />
            <span class="legend-desc">Chưa có số liệu thực tế được xác nhận</span>
          </div>
          <div class="legend-item">
            <span class="legend-neutral-text">(Xác nhận thực tế: Chưa có số liệu được xác nhận)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1 (LEDGER FIRST): Dự toán chi phí chi tiết (19 khoản mục) -->
  <section class="section section-soft" aria-labelledby="expenses-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dự toán ngân sách</span>
        <h2 id="expenses-heading" class="section-title">
          Dự toán chi phí chi tiết (19 khoản mục)
        </h2>
        <p class="section-subtitle">
          Danh mục chi tiết 19 khoản mục chi phí được chia thành 3 nhóm phục vụ buổi chơi và hoạt động tại Mái ấm.
        </p>
      </div>

      <!-- Desktop Table View (>= 768px) -->
      <div class="table-wrap desktop-only">
        <table class="data-table">
          <caption class="sr-only">Bảng phân bổ 19 khoản mục chi phí dự toán kế hoạch theo 3 nhóm</caption>
          <thead>
            <tr>
              <th scope="col">Khoản mục</th>
              <th scope="col">Nhóm phân loại</th>
              <th scope="col" class="text-right">Dự toán (VND)</th>
              <th scope="col">Ghi chú &amp; Cơ sở tính</th>
            </tr>
          </thead>
          {
            expenseGroups.map((group) => (
              <tbody class="expense-group-body">
                <tr class="group-header-row">
                  <th scope="colgroup" colspan="2" class="group-header-title">
                    {group.category}
                  </th>
                  <td class="text-right font-bold group-header-subtotal">
                    {formatVND(group.subtotal)}
                  </td>
                  <td class="text-muted text-xs group-header-note">
                    Tổng phụ {group.items.length} khoản
                  </td>
                </tr>
                {
                  group.items.map((item) => (
                    <tr>
                      <td>
                        <strong>{item.title}</strong>
                        <div class="text-xs text-muted">{item.calculationText}</div>
                      </td>
                      <td>
                        <span class="category-tag">{item.category}</span>
                      </td>
                      <td class="text-right font-medium">
                        {formatVND(item.amount.value)}
                      </td>
                      <td class="text-muted">
                        {item.note}
                        {item.isEstimated && (
                          <span class="estimated-tag">Chi phí giả định</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            ))
          }
          <tfoot>
            <tr class="total-row">
              <th scope="row" colspan="2">Tổng dự toán chi kế hoạch (19 khoản)</th>
              <td class="text-right font-bold text-accent">
                {formatVND(totalPlannedExpense)}
              </td>
              <td class="text-muted">Dẫn xuất từ 19 khoản mục dự toán trong đề xuất, không phải chi phí thực tế</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Mobile Grouped Accordion (< 768px) -->
      <div class="mobile-only mobile-expense-groups" aria-label="Danh sách dự toán chi phí theo nhóm trên di động">
        {
          expenseGroups.map((group, gIdx) => (
            <details class="expense-group-accordion card" id={`expense-group-${gIdx}`}>
              <summary class="group-summary">
                <div class="group-summary-left">
                  <h3 class="group-summary-title">{group.category}</h3>
                  <span class="group-summary-count">{group.items.length} khoản mục</span>
                </div>
                <div class="group-summary-right font-bold text-accent">
                  <span class="group-subtotal-val">{formatVND(group.subtotal)}</span>
                  <span class="group-expand-cue" aria-hidden="true">
                    <svg
                      class="chevron-svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </div>
              </summary>

              <div class="group-items-list">
                {
                  group.items.map((item) => (
                    <div class="mobile-expense-item">
                      <div class="mobile-expense-top">
                        <div class="mobile-expense-main">
                          <h4 class="mobile-expense-title">{item.title}</h4>
                        </div>
                        <div class="mobile-expense-val-col">
                          <span class="mobile-expense-val text-accent font-bold">
                            {formatVND(item.amount.value)}
                          </span>
                          {item.isEstimated && (
                            <span class="estimated-tag">Giả định</span>
                          )}
                        </div>
                      </div>
                      <div class="mobile-expense-sub text-muted">
                        {item.calculationText && (
                          <span class="mobile-expense-calc">{item.calculationText}</span>
                        )}
                        {item.calculationText && item.note && (
                          <span class="mobile-sub-sep" aria-hidden="true">&bull;</span>
                        )}
                        {item.note && (
                          <span class="mobile-expense-note">{item.note}</span>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </details>
          ))
        }

        <div class="mobile-total-card card">
          <div class="mobile-total-header">Tổng dự toán chi kế hoạch (19 khoản)</div>
          <div class="mobile-total-amount">{formatVND(totalPlannedExpense)}</div>
          <p class="mobile-total-note">
            Dẫn xuất từ 3 nhóm dự toán trong đề xuất ban đầu (trang 24, 25, 26); không phải chi phí thực tế đã thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Doanh thu kịch bản và phân tích số dư -->
  <section class="section" aria-labelledby="scenarios-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kịch bản tài chính</span>
        <h2 id="scenarios-heading" class="section-title">
          Doanh thu kịch bản và phân tích số dư
        </h2>
        <p class="section-subtitle">
          Tính toán doanh thu giả định khi hoàn thành các mục tiêu kế hoạch và đối sánh với dự toán chi phí.
        </p>
      </div>

      <!-- Calculation Breakdown Card -->
      <div class="formula-card card">
        <h3 class="formula-title">Cơ cấu doanh thu kịch bản bán đủ hàng ({formatVND(totalPlannedRevenue)})</h3>
        <div class="formula-breakdown">
          <div class="formula-part">
            <span class="formula-part-title">1. Sản phẩm lưu niệm thủ công:</span>
            <p class="formula-expression">{craftFormulaText} = <strong>{formatVND(craftRevenue)}</strong></p>
            <p class="formula-subnote">Giả định bán đủ {craftSummaryText} theo giá tham khảo trong đề xuất.</p>
          </div>
          <div class="formula-part">
            <span class="formula-part-title">2. Phương án ẩm thực sinh viên (giả định):</span>
            <p class="formula-expression">Mục tiêu doanh thu trong đề xuất (trang 18) = <strong>{formatVND(foodAssumption)}</strong></p>
            <p class="formula-subnote">Mục tiêu giả định trong đề xuất; chưa có bảng phân bổ số lượng từng món (xem mục đối chiếu ẩm thực bên dưới).</p>
          </div>
        </div>
        <div class="formula-total">
          <span>Tổng doanh thu kịch bản kết hợp:</span>
          <strong>{formatVND(craftRevenue)} (thủ công) + {formatVND(foodAssumption)} (ẩm thực giả định) = {formatVND(totalPlannedRevenue)}</strong>
        </div>
        <p class="formula-note">
          Doanh thu giả định tính trên giả thiết hoàn thành mục tiêu đề xuất và bán theo mức giá tham khảo. Trạng thái mở bán hiện chưa được xác nhận; bản xem trước chưa nhận đơn hoặc tiền.
        </p>
      </div>

      <!-- Food Reconciliation Card (#doi-chieu-do-an) -->
      <div id="doi-chieu-do-an" class="reconciliation-card card">
        <div class="reconciliation-header">
          <div class="badge-wrap">
            <span class="eyebrow">Đối chiếu kế hoạch đề xuất</span>
          </div>
          <h3 class="reconciliation-title">Đối chiếu mục tiêu doanh thu ẩm thực trong đề xuất</h3>
        </div>

        <p class="reconciliation-lead">
          Hồ sơ đề xuất ghi nhận mục tiêu ẩm thực là <strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong> (trang 18), đồng thời nêu kế hoạch tương đương <strong>{foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set` : 'set'}</strong> đồ ăn (trang 12) theo giá tham khảo <strong>{formatVND(foodReconciliation.setUnitPrice)}/set</strong> (trang 24):
        </p>

        <div class="reconciliation-grid">
          <div class="reconcile-item">
            <span class="reconcile-label">Doanh thu từ {foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set` : 'set'} giả định</span>
            <span class="reconcile-val">{foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set × ` : ''}{formatVND(foodReconciliation.setUnitPrice)} = <strong>{formatVND(foodReconciliation.setsCalculatedRevenue)}</strong></span>
            <span class="reconcile-note">Dẫn xuất từ số set giả định (trang 12) và giá SKU set đồ ăn (trang 24).</span>
          </div>

          <div class="reconcile-item">
            <span class="reconcile-label">Mục tiêu ghi trong đề xuất</span>
            <span class="reconcile-val"><strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong></span>
            <span class="reconcile-note">Chỉ tiêu tổng ẩm thực tại bảng mục tiêu tài chính (trang 18).</span>
          </div>

          <div class="reconcile-item reconcile-gap">
            <span class="reconcile-label">Khoản chênh chưa phân bổ</span>
            <span class="reconcile-val font-bold text-accent">{formatVND(foodReconciliation.targetFoodRevenue)} − {formatVND(foodReconciliation.setsCalculatedRevenue)} = <strong>{formatVND(foodReconciliation.unallocatedGap)}</strong></span>
            <span class="reconcile-note">Hồ sơ chưa có bảng phân bổ số lượng chi tiết để giải thích khoản chênh {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}.</span>
          </div>
        </div>

        <div class="reconciliation-analysis">
          <p class="reconciliation-analysis-title">
            <strong>Phân tích đối soát minh bạch:</strong>
          </p>
          <ul class="reconciliation-list">
            <li>
              Hồ sơ đề xuất đưa ra các mức giá tham khảo cho thực đơn (set đồ ăn, combo nem, bánh su kem) nhưng <em>chưa có bảng số lượng × giá từng món</em> để giải thích phần chênh lệch {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}.
            </li>
            <li>
              Cần làm rõ set đồ ăn và các phần combo nem / bánh su kem có bị trùng lặp khẩu phần hay không trước khi có thể chốt kế hoạch phát hành chính thức.
            </li>
            <li>
              Kịch bản cơ sở hiện tại giữ nguyên <strong>{formatVND(totalPlannedRevenue)}</strong> doanh thu và <strong>+{formatVND(FINANCE_OVERVIEW.unfundedProjectedBalance)}</strong> số dư giả định, được dán nhãn kế hoạch chưa kiểm chứng cơ cấu bán. Không tự ý phân bổ khoản chênh {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''} cho các combo nem hay bánh su kem khi chưa có quyết định từ nhóm.
            </li>
          </ul>
        </div>
      </div>

      <!-- Desktop & Tablet Scenarios Table -->
      <div class="table-wrap desktop-only">
        <table class="data-table">
          <caption class="sr-only">Bảng so sánh kịch bản tài chính kế hoạch</caption>
          <thead>
            <tr>
              <th scope="col">Kịch bản kế hoạch</th>
              <th scope="col" class="text-right">Hiện vật thay chi tiền</th>
              <th scope="col" class="text-right">Chi tiền còn lại</th>
              <th scope="col" class="text-right">Số dư giả định</th>
            </tr>
          </thead>
          <tbody>
            {
              scenarioResults.map(({ scenario, result }) => (
                <tr>
                  <td>
                    <strong>{scenario.title}</strong>
                    <div class="text-sm text-muted">{scenario.description}</div>
                  </td>
                  <td class="text-right">
                    {formatVND(scenario.inKindReplacement.value)}
                    <div class="text-xs text-muted">{scenario.note}</div>
                  </td>
                  <td class="text-right font-medium">
                    {result ? formatVND(result.remainingCashExpense) : 'Chưa rõ'}
                  </td>
                  <td class="text-right font-bold">
                    <span class={result?.isDeficit ? 'badge-deficit' : 'badge-surplus'}>
                      {result?.balanceText ?? 'Chưa rõ'}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Mobile Scenarios List -->
      <div class="mobile-only mobile-scenario-list" aria-label="Danh sách kịch bản tài chính trên di động">
        {
          scenarioResults.map(({ scenario, result }) => (
            <div class="mobile-scenario-card card">
              <h3 class="mobile-scenario-title">{scenario.title}</h3>
              <p class="mobile-scenario-desc">{scenario.description}</p>
              
              <div class="mobile-scenario-details">
                <div class="mobile-card-row">
                  <span class="mobile-row-label">Hiện vật thay chi:</span>
                  <span class="mobile-row-value">{formatVND(scenario.inKindReplacement.value)}</span>
                </div>
                <div class="mobile-card-row">
                  <span class="mobile-row-label">Chi tiền còn lại:</span>
                  <span class="mobile-row-value">{result ? formatVND(result.remainingCashExpense) : 'Chưa rõ'}</span>
                </div>
                <div class="mobile-card-row mobile-card-highlight">
                  <span class="mobile-row-label font-bold">Số dư giả định:</span>
                  <span class={`mobile-row-value font-bold ${result?.isDeficit ? 'badge-deficit' : 'badge-surplus'}`}>
                    {result?.balanceText ?? 'Chưa rõ'}
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 3: Báo cáo thực tế và nguyên tắc quản trị (5 dòng null) -->
  <section class="section section-soft" aria-labelledby="actual-governance-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Theo dõi thực tế</span>
        <h2 id="actual-governance-heading" class="section-title">
          Khung theo dõi dòng tiền thực tế
        </h2>
        <p class="section-subtitle">
          Thông tin thu chi thực tế sẽ được cập nhật sau khi đối soát và được phép công bố.
        </p>
      </div>

      <!-- Actual Ledger Compact (5 dòng gọn gàng, giữ null và chữ "Chưa xác nhận") -->
      <div class="actual-ledger-compact card" role="region" aria-label="Sổ theo dõi thực tế">
        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>1. Tiền thực nhận</strong>
              <StatusChip kind="cho-xac-nhan" label="Chờ đối soát" />
            </div>
            <p class="actual-col-desc">Doanh thu bán hàng và tài trợ tiền mặt thực tế đã ghi nhận vào tài khoản dự án.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>2. Tiền thực chi</strong>
              <StatusChip kind="cho-xac-nhan" label="Chờ đối soát" />
            </div>
            <p class="actual-col-desc">Tổng các khoản chi tiêu thực tế phục vụ chuẩn bị và tổ chức hoạt động.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>3. Tồn quỹ thực tế</strong>
              <StatusChip kind="cho-xac-nhan" label="Chờ đối soát" />
            </div>
            <p class="actual-col-desc">Số dư tiền mặt thực tế sau khi trừ toàn bộ các khoản đã chi.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>4. Hiện vật tiếp nhận &amp; bàn giao</strong>
              <StatusChip kind="cho-xac-nhan" label="Sổ riêng" />
            </div>
            <p class="actual-col-desc">Theo dõi riêng trong sổ hiện vật theo kế hoạch, không quy đổi gộp vào tiền mặt.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>5. Chứng từ &amp; Hóa đơn</strong>
              <StatusChip kind="cho-xac-nhan" label="Lưu trữ nội bộ" />
            </div>
            <p class="actual-col-desc">Kế hoạch lưu trữ đầy đủ hóa đơn, chứng từ; công bố bản biên tập bảo vệ riêng tư sau khi được duyệt.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>
      </div>

      <!-- Empty State Notice Box -->
      <div class="ledger-empty-notice card">
        <p>
          <strong>Trạng thái thực tế:</strong> {ACTUAL_FINANCE.statusNotice}
        </p>
        <p class="text-sm text-muted">
          {ACTUAL_FINANCE.disclaimer} Các báo cáo thu chi, tài trợ hiện vật và chứng từ minh bạch sẽ được đăng tải chi tiết sau khi có sự xác nhận chính thức từ các bên.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Nguyên tắc quản trị tài chính & Quỹ dự phòng (2 cột list) -->
  <section class="section" aria-labelledby="principles-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Nguyên tắc quản trị</span>
        <h2 id="principles-heading" class="section-title">
          Nguyên tắc quản trị ngân quỹ &amp; Xử lý rủi ro
        </h2>
        <p class="section-subtitle">
          Quy chuẩn quản lý dòng tiền và các phương án ứng phó rủi ro được đề xuất nhằm bảo đảm tính minh bạch và an toàn tuyệt đối cho dự án.
        </p>
      </div>

      <div class="governance-two-cols">
        <!-- Cột 1: 4 Nguyên tắc quản trị dòng tiền -->
        <div class="governance-col card">
          <h3 class="governance-col-title">Nguyên tắc quản trị dòng tiền</h3>
          <ul class="governance-list">
            <li>
              <strong>Công thức dòng tiền chuẩn xác:</strong> Số dư tiền = Số dư đầu kỳ + Doanh thu thực nhận + Tài trợ tiền thực nhận − Chi tiền thực trả. Hàng tồn kho và đơn chưa thanh toán không được ghi nhận là doanh thu đã thu.
            </li>
            <li>
              <strong>Tách bạch tiền mặt và hiện vật:</strong> Tiền mặt và hiện vật được quản lý trong hai hệ thống sổ sách độc lập. Tuyệt đối không gộp giá trị ước tính của hiện vật vào số dư tiền mặt của chiến dịch.
            </li>
            <li>
              <strong>Đối soát chéo hai thành viên:</strong> Mọi khoản thu chi phát sinh đều được đối soát độc lập bởi hai thành viên phụ trách tài chính nhằm đảm bảo tính chính xác và khách quan.
            </li>
            <li>
              <strong>Biên tập chứng từ bảo vệ riêng tư:</strong> Báo cáo tài chính và chứng từ gốc sau đối soát sẽ được biên tập che các thông tin cá nhân nhạy cảm trước khi công bố công khai.
            </li>
          </ul>
        </div>

        <!-- Cột 2: Dự phòng rủi ro & Phương án xử lý (contingency đúng trạng thái) -->
        <div class="governance-col card">
          <h3 class="governance-col-title">Phương án dự phòng &amp; Ứng phó rủi ro</h3>
          <ul class="governance-list">
            <li>
              <strong>Rủi ro bán hàng chậm hơn dự kiến:</strong> Ưu tiên bảo toàn vốn chuẩn bị đạo cụ và quà tặng thiết yếu; điều chỉnh quy mô mua sắm nếu doanh số chưa đạt mục tiêu.
            </li>
            <li>
              <strong>Rủi ro biến động thời tiết / địa điểm:</strong> Có phương án chuyển đổi hoạt động trong nhà, ưu tiên an toàn và sức khỏe của các em nhỏ tại Mái ấm.
            </li>
            <li>
              <strong>Rủi ro chi phí phát sinh:</strong> Quỹ dự phòng trong đề xuất chỉ giải ngân khi có sự đồng thuận của nhóm và lý do chính đáng được ghi nhận.
            </li>
            <li>
              <strong>Quy tắc giải ngân quà tặng:</strong> Việc mua sắm quà tặng cho các em dựa trên số dư thực tế sau đối soát và danh mục nhu cầu do đại diện Mái ấm xác nhận.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: FAQs -->
  <section class="section section-soft" aria-labelledby="transparency-faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Giải đáp thắc mắc</span>
        <h2 id="transparency-faq-heading" class="section-title">
          Câu hỏi thường gặp về tài chính
        </h2>
        <p class="section-subtitle">
          Giải thích rõ ràng các băn khoăn về dự toán chi, phân bổ doanh thu và kế hoạch công khai báo cáo.
        </p>
      </div>

      <FaqAccordion faqs={TRANSPARENCY_FAQS} />
    </div>
  </section>

  <!-- Section 6: Navigation CTA Section -->
  <section class="section navigation-cta-section" aria-labelledby="nav-cta-heading">
    <div class="container">
      <div class="navigation-cta-card card">
        <h2 id="nav-cta-heading" class="navigation-cta-title">
          Đồng hành và đóng góp hiện vật
        </h2>
        <p class="navigation-cta-desc">
          Khám phá các phương thức tiếp nhận đồng hành cùng dự án hoặc xem chi tiết câu chuyện và 4 góc chơi tại Mái ấm.
        </p>
        <div class="navigation-cta-actions">
          <a href="/dong-hanh" class="btn btn-primary">
            Cách đồng hành &rarr;
          </a>
          <a href="/san-pham" class="btn btn-secondary">
            Xem sản phẩm gây quỹ dự kiến
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Section Highlights */
  .section-highlights {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* Highlights Grid: 3 columns desktop, 1 column tablet/mobile */
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .highlight-card {
    background-color: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .highlight-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .highlight-label {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .highlight-value {
    font-size: var(--font-size-num-xl);
    font-weight: 700;
    color: var(--ink);
    line-height: var(--line-height-num-xl);
    font-variant-numeric: tabular-nums;
  }

  .highlight-condition {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    line-height: 1.45;
    margin: 0;
  }

  /* Gap Alert Box */
  .transparency-gap-alert {
    background-color: #fffdf5;
    border: 1px solid #fef3c7;
    border-left: 4px solid var(--brand);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
  }

  .gap-alert-text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }

  .gap-alert-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--brand);
    text-decoration: underline;
  }

  .gap-alert-link:hover {
    color: var(--ink);
  }

  /* Status Legend */
  .finance-status-legend {
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .legend-title {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .legend-items {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-small);
  }

  .legend-desc {
    color: var(--ink-2);
  }

  .legend-neutral-text {
    color: var(--ink-2);
    font-style: italic;
  }

  /* Tables: Desktop Data Table */
  .table-wrap {
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--space-6);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    text-align: left;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .data-table th {
    background-color: var(--surface-alt);
    font-weight: 600;
    color: var(--ink);
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .group-header-row {
    background-color: #f1ede5;
  }

  .group-header-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .group-header-subtotal {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .group-header-note {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .category-tag {
    display: inline-block;
    padding: 2px 8px;
    background-color: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .estimated-tag {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 1px 6px;
    background-color: var(--status-hypo-bg);
    color: var(--status-hypo-text);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Total Row: Tối màu, chữ contrast cao */
  .total-row {
    font-size: 1.0625rem;
    background-color: var(--brand-ink);
    color: #ffffff;
  }

  .total-row th,
  .total-row td {
    color: #ffffff;
    border-top: 2px solid var(--line-strong);
    padding: var(--space-4);
  }

  .total-row .text-accent {
    color: var(--cta);
    font-size: 1.25rem;
  }

  .total-row .text-muted {
    color: var(--line);
    font-size: var(--font-size-small);
  }

  /* Mobile Expense Groups Accordion (< 768px) */
  .mobile-expense-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .expense-group-accordion {
    padding: 0;
    overflow: hidden;
  }

  .group-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4);
    cursor: pointer;
    background-color: var(--surface-alt);
    gap: var(--space-2);
  }

  .group-summary:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -2px;
  }

  .group-summary-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .group-summary-count {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .group-summary-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .group-subtotal-val {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .group-expand-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    transition: transform var(--transition-fast);
  }

  details[open] .group-expand-cue {
    transform: rotate(180deg);
  }

  .group-items-list {
    padding: var(--space-2) var(--space-4) var(--space-4);
  }

  .mobile-expense-item {
    padding: var(--space-3) 0;
    border-bottom: 1px dashed var(--line);
  }

  .mobile-expense-item:last-child {
    border-bottom: none;
  }

  .mobile-expense-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .mobile-expense-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }

  .mobile-expense-val {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mobile-expense-sub {
    font-size: var(--font-size-small);
    line-height: 1.4;
  }

  .mobile-sub-sep {
    margin: 0 4px;
  }

  .mobile-total-card {
    background-color: var(--brand-ink);
    color: #ffffff;
    padding: var(--space-5);
    text-align: center;
    margin-top: var(--space-4);
  }

  .mobile-total-header {
    font-size: var(--font-size-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--line);
    margin-bottom: var(--space-2);
  }

  .mobile-total-amount {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--cta);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2);
  }

  .mobile-total-note {
    font-size: var(--font-size-small);
    color: var(--line);
    margin: 0;
    line-height: 1.45;
  }

  /* Formula Breakdown Card */
  .formula-card {
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    background-color: var(--surface-alt);
  }

  .formula-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-4);
  }

  .formula-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .formula-part-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
  }

  .formula-expression {
    font-size: 1rem;
    color: var(--ink);
    margin: var(--space-1) 0;
    font-variant-numeric: tabular-nums;
  }

  .formula-subnote {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
  }

  .formula-total {
    padding: var(--space-3);
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 0.9375rem;
    margin-bottom: var(--space-3);
  }

  .formula-total strong {
    color: var(--ink);
    font-size: 1.0625rem;
  }

  .formula-note {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
    line-height: 1.5;
  }

  /* Food Reconciliation Card */
  .reconciliation-card {
    padding: var(--space-6);
    margin-bottom: var(--space-6);
    background-color: var(--color-surface-card);
    border-left: 4px solid var(--cta);
  }

  .reconciliation-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: var(--space-2) 0;
  }

  .reconciliation-lead {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }

