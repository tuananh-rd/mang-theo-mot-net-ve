---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import {
  PLANNED_EXPENSES,
  PRODUCTS,
  FINANCE_SCENARIOS,
  TRANSPARENCY_FAQS,
  ACTUAL_FINANCE,
  FINANCE_OVERVIEW,
} from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateCombinedPlannedRevenue,
  calculateScenario,
  calculateFoodReconciliation,
  groupPlannedExpensesByCategory,
  formatScenarioBalance,
  formatVND,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const expenseGroups = groupPlannedExpensesByCategory(PLANNED_EXPENSES);
const craftRevenue = calculateCraftRevenue(PRODUCTS);
const foodAssumption = FINANCE_OVERVIEW.foodPlannedRevenueAssumption.value;
const totalPlannedRevenue = calculateCombinedPlannedRevenue(craftRevenue, foodAssumption);

const setDoAn = PRODUCTS.find((p) => p.id === 'set-do-an');
const foodReconciliation = calculateFoodReconciliation(
  FINANCE_OVERVIEW.foodHypotheticalSets,
  setDoAn?.referencePrice,
  FINANCE_OVERVIEW.foodPlannedRevenueAssumption,
  craftRevenue,
  totalPlannedExpense
);

const formatInSentence = (name: string) => (name ? name.charAt(0).toLowerCase() + name.slice(1) : '');
const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const craftFormulaText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)} × ${formatVND(p.referencePrice.value)}`)
  .join(' + ');
const craftSummaryText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)}`)
  .join(' và ');

const scenarioResults = FINANCE_SCENARIOS.map((scenario) => {
  const result = calculateScenario(scenario, totalPlannedRevenue, totalPlannedExpense);
  return {
    scenario,
    result,
  };
});

const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro') || FINANCE_SCENARIOS[0];
const baseScenarioResult = baseScenario
  ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense)
  : null;
const baseBalanceDisplay = formatScenarioBalance(baseScenarioResult);
---

<Layout
  title="Minh bạch thu chi"
  description="Báo cáo dự toán chi phí, doanh thu kịch bản và nguyên tắc minh bạch tài chính của chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Minh bạch</span>
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="transparency-hero" aria-labelledby="transparency-heading">
    <div class="container">
      <div class="transparency-hero-card">
        <div class="badge-row">
          <span class="status-badge">Dự toán trong đề xuất</span>
          <span class="status-badge status-badge-neutral">Chưa có số liệu thực tế được xác nhận</span>
        </div>

        <h1 id="transparency-heading" class="transparency-title">
          Minh bạch thu chi
        </h1>

        <p class="transparency-lead">
          Kế hoạch dự toán ngân sách, doanh thu kịch bản bán đủ hàng và các nguyên tắc quản trị tài chính minh bạch cho chiến dịch tại Mái ấm Thánh Tâm Xuy Xá.
        </p>

        <!-- Highlights Grid (3 KPI kế hoạch / giả định) -->
        <div class="highlights-grid" role="region" aria-label="Các chỉ số kế hoạch nổi bật">
          <div class="highlight-card">
            <span class="highlight-label">Chi dự kiến (kế hoạch)</span>
            <span class="highlight-value">{formatVND(totalPlannedExpense)}</span>
            <p class="highlight-condition">
              Dự toán 19 khoản chi phí nguyên vật liệu, vật tư góc chơi, quà tặng và di chuyển theo đề xuất (trang 24, 25, 26).
            </p>
          </div>

          <div class="highlight-card">
            <span class="highlight-label">Doanh thu kịch bản (giả định)</span>
            <span class="highlight-value">{formatVND(totalPlannedRevenue)}</span>
            <p class="highlight-condition">
              Gồm {formatVND(craftRevenue)} thủ công (bán đủ kế hoạch) và {formatVND(foodAssumption)} ẩm thực giả định (trang 18).
            </p>
          </div>

          <div class="highlight-card">
            <span class="highlight-label">Số dư giả định (kịch bản cơ sở)</span>
            <span class:list={['highlight-value', baseBalanceDisplay.diffClass === 'diff-positive' ? 'text-positive' : baseBalanceDisplay.diffClass === 'diff-negative' ? 'text-negative' : '']}>
              {baseBalanceDisplay.text}
            </span>
            <p class="highlight-condition">
              Số dư mô phỏng khi chưa tính tài trợ hiện vật, dựa trên giả định bán hết sản phẩm theo giá tham khảo.
            </p>
          </div>
        </div>

        <!-- Cảnh báo dẫn xuất chênh 550.000đ và link đối chiếu -->
        <div class="transparency-gap-alert" role="note">
          <p class="gap-alert-text">
            <strong>Lưu ý đối soát mục tiêu ẩm thực:</strong> Hồ sơ đề xuất ghi mục tiêu ẩm thực <strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong> (trang 18) nhưng số set giả định tính theo đơn giá SKU là <strong>{formatVND(foodReconciliation.setsCalculatedRevenue)}</strong> ({foodReconciliation.hypotheticalSets} set &times; {formatVND(foodReconciliation.setUnitPrice)}). Khoản chênh <strong>{foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}</strong> chưa có bảng phân bổ số lượng chi tiết từng món.
          </p>
          <a href="#doi-chieu-do-an" class="gap-alert-link">
            Xem bảng đối chiếu ẩm thực &darr;
          </a>
        </div>

        <!-- Section Notice -->
        <div class="transparency-notice">
          <p>
            <strong>Nguyên tắc trình bày:</strong> Bản xem trước phân định rõ giữa dự toán trong đề xuất và số liệu thực tế. Doanh thu dự kiến phản ánh mô phỏng kế hoạch theo giá tham khảo, không phải khoản tiền đã nhận hay mục tiêu gây quỹ chính thức.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Doanh thu kịch bản và phân tích số dư -->
  <section class="section section-soft" aria-labelledby="scenarios-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Kịch bản tài chính</span>
        </div>
        <h2 id="scenarios-heading" class="section-title">
          Doanh thu kịch bản và phân tích số dư
        </h2>
        <p class="section-subtitle">
          Tính toán doanh thu giả định khi hoàn thành các mục tiêu kế hoạch và đối sánh với dự toán chi phí.
        </p>
      </div>

      <!-- Calculation Breakdown Card -->
      <div class="formula-card card">
        <h3 class="formula-title">Cơ cấu doanh thu kịch bản bán đủ hàng ({formatVND(totalPlannedRevenue)})</h3>
        <div class="formula-breakdown">
          <div class="formula-part">
            <span class="formula-part-title">1. Sản phẩm lưu niệm thủ công:</span>
            <p class="formula-expression">{craftFormulaText} = <strong>{formatVND(craftRevenue)}</strong></p>
            <p class="formula-subnote">Giả định bán đủ {craftSummaryText} theo giá tham khảo trong đề xuất.</p>
          </div>
          <div class="formula-part">
            <span class="formula-part-title">2. Phương án ẩm thực sinh viên (giả định):</span>
            <p class="formula-expression">Mục tiêu doanh thu trong đề xuất (trang 18) = <strong>{formatVND(foodAssumption)}</strong></p>
            <p class="formula-subnote">Mục tiêu giả định trong đề xuất; chưa có bảng phân bổ số lượng từng món (xem mục đối chiếu ẩm thực bên dưới).</p>
          </div>
        </div>
        <div class="formula-total">
          <span>Tổng doanh thu kịch bản kết hợp:</span>
          <strong>{formatVND(craftRevenue)} (thủ công) + {formatVND(foodAssumption)} (ẩm thực giả định) = {formatVND(totalPlannedRevenue)}</strong>
        </div>
        <p class="formula-note">
          Doanh thu giả định tính trên giả thiết hoàn thành mục tiêu đề xuất và bán theo mức giá tham khảo. Trạng thái mở bán hiện chưa được xác nhận; bản xem trước chưa nhận đơn hoặc tiền.
        </p>
      </div>

      <!-- Food Reconciliation Card (#doi-chieu-do-an) -->
      <div id="doi-chieu-do-an" class="reconciliation-card card">
        <div class="reconciliation-header">
          <div class="badge-wrap">
            <span class="status-badge status-badge-warning">Đối chiếu kế hoạch đề xuất</span>
          </div>
          <h3 class="reconciliation-title">Đối chiếu mục tiêu doanh thu ẩm thực trong đề xuất</h3>
        </div>

        <p class="reconciliation-lead">
          Hồ sơ đề xuất ghi nhận mục tiêu ẩm thực là <strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong> (trang 18), đồng thời nêu kế hoạch tương đương <strong>{foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set` : 'set'}</strong> đồ ăn (trang 12) theo giá tham khảo <strong>{formatVND(foodReconciliation.setUnitPrice)}/set</strong> (trang 24):
        </p>

        <div class="reconciliation-grid">
          <div class="reconcile-item">
            <span class="reconcile-label">Doanh thu từ {foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set` : 'set'} giả định</span>
            <span class="reconcile-val">{foodReconciliation.hypotheticalSets ? `${foodReconciliation.hypotheticalSets} set × ` : ''}{formatVND(foodReconciliation.setUnitPrice)} = <strong>{formatVND(foodReconciliation.setsCalculatedRevenue)}</strong></span>
            <span class="reconcile-note">Dẫn xuất từ số set giả định (trang 12) và giá SKU set đồ ăn (trang 24).</span>
          </div>

          <div class="reconcile-item">
            <span class="reconcile-label">Mục tiêu ghi trong đề xuất</span>
            <span class="reconcile-val"><strong>{formatVND(foodReconciliation.targetFoodRevenue)}</strong></span>
            <span class="reconcile-note">Chỉ tiêu tổng ẩm thực tại bảng mục tiêu tài chính (trang 18).</span>
          </div>

          <div class="reconcile-item reconcile-gap">
            <span class="reconcile-label">Khoản chênh chưa phân bổ</span>
            <span class="reconcile-val font-bold text-accent">{formatVND(foodReconciliation.targetFoodRevenue)} − {formatVND(foodReconciliation.setsCalculatedRevenue)} = <strong>{formatVND(foodReconciliation.unallocatedGap)}</strong></span>
            <span class="reconcile-note">Hồ sơ chưa có bảng phân bổ số lượng chi tiết để giải thích khoản chênh {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}.</span>
          </div>
        </div>

        <div class="reconciliation-analysis">
          <p class="reconciliation-analysis-title">
            <strong>Phân tích đối soát minh bạch:</strong>
          </p>
          <ul class="reconciliation-list">
            <li>
              Hồ sơ đề xuất đưa ra các mức giá tham khảo cho thực đơn (set đồ ăn, combo nem, bánh su kem) nhưng <em>chưa có bảng số lượng × giá từng món</em> để giải thích phần chênh lệch {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''}.
            </li>
            <li>
              Cần làm rõ set đồ ăn và các phần combo nem / bánh su kem có bị trùng lặp khẩu phần hay không trước khi có thể chốt kế hoạch phát hành chính thức.
            </li>
            <li>
              Kịch bản cơ sở hiện tại giữ nguyên <strong>{formatVND(totalPlannedRevenue)}</strong> doanh thu và <strong>+{formatVND(FINANCE_OVERVIEW.unfundedProjectedBalance)}</strong> số dư giả định, được dán nhãn kế hoạch chưa kiểm chứng cơ cấu bán. Không tự ý phân bổ khoản chênh {foodReconciliation.unallocatedGap !== null ? formatVND(foodReconciliation.unallocatedGap) : ''} cho các combo nem hay bánh su kem khi chưa có quyết định từ nhóm.
            </li>
          </ul>
        </div>
      </div>

      <!-- Desktop & Tablet Scenarios Table -->
      <div class="table-wrap desktop-only">
        <table class="data-table">
          <caption class="sr-only">Bảng so sánh kịch bản tài chính kế hoạch</caption>
          <thead>
            <tr>
              <th scope="col">Kịch bản kế hoạch</th>
              <th scope="col" class="text-right">Hiện vật thay chi tiền</th>
              <th scope="col" class="text-right">Chi tiền còn lại</th>
              <th scope="col" class="text-right">Số dư giả định</th>
            </tr>
          </thead>
          <tbody>
            {
              scenarioResults.map(({ scenario, result }) => (
                <tr>
                  <td>
                    <strong>{scenario.title}</strong>
                    <div class="text-sm text-muted">{scenario.description}</div>
                  </td>
                  <td class="text-right">
                    {formatVND(scenario.inKindReplacement.value)}
                    <div class="text-xs text-muted">{scenario.note}</div>
                  </td>
                  <td class="text-right font-medium">
                    {result ? formatVND(result.remainingCashExpense) : 'Chưa rõ'}
                  </td>
                  <td class="text-right font-bold">
                    <span class={result?.isDeficit ? 'badge-deficit' : 'badge-surplus'}>
                      {result?.balanceText ?? 'Chưa rõ'}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Mobile Scenarios List (Không cuộn ngang) -->
      <div class="mobile-only mobile-scenario-list" aria-label="Danh sách kịch bản tài chính trên di động">
        {
          scenarioResults.map(({ scenario, result }) => (
            <div class="mobile-scenario-card card">
              <h3 class="mobile-scenario-title">{scenario.title}</h3>
              <p class="mobile-scenario-desc">{scenario.description}</p>
              
              <div class="mobile-scenario-details">
                <div class="mobile-card-row">
                  <span class="mobile-row-label">Hiện vật thay chi:</span>
                  <span class="mobile-row-value">{formatVND(scenario.inKindReplacement.value)}</span>
                </div>
                <div class="mobile-card-row">
                  <span class="mobile-row-label">Chi tiền còn lại:</span>
                  <span class="mobile-row-value font-medium">
                    {result ? formatVND(result.remainingCashExpense) : 'Chưa rõ'}
                  </span>
                </div>
                <div class="mobile-card-row mobile-card-highlight">
                  <span class="mobile-row-label font-bold">Số dư giả định:</span>
                  <span class={result?.isDeficit ? 'badge-deficit' : 'badge-surplus'}>
                    {result?.balanceText ?? 'Chưa rõ'}
                  </span>
                </div>
              </div>
              <p class="mobile-scenario-note">{scenario.note}</p>
            </div>
          ))
        }
      </div>

      <!-- Policy Clarification Box -->
      <div class="clarification-box card">
        <h3 class="clarification-title">Lưu ý quan trọng về các kịch bản tài chính</h3>
        <ul class="clarification-list">
          <li>
            <strong>Nguyên tắc đối chiếu tài trợ hiện vật:</strong> Đề xuất dự án có nêu các giả định vận động hiện vật (như nguyên vật liệu góc chơi hoặc quà tặng). Tuy nhiên, các phương án này cần được đối chiếu cụ thể danh mục và phạm vi khoản thay chi trước khi áp dụng vào tính toán. Nhóm không công bố các số dư kịch bản chưa được đối soát chính thức.
          </li>
          <li>
            <strong>Nguyên tắc thay thế chi phí:</strong> “Hiện vật thay chi tiền” chỉ phát huy tác dụng khi hiện vật tiếp nhận đúng danh mục và thay thế trực tiếp khoản dự toán chi tương đương, tuyệt đối không quy đổi hiện vật thành tiền rồi cộng vào doanh thu.
          </li>
          <li>
            <strong>Mục đích sử dụng nguồn thu:</strong> Dự án không đưa ra cam kết “100% doanh thu mua quà”. Doanh thu bán sản phẩm dự kiến dùng để trang trải chi phí nguyên vật liệu và tổ chức. Số dư tiền thực tế (nếu có sau khi đối soát tất cả các khoản chi) dự kiến sẽ được dùng để hỗ trợ hiện vật đúng nhu cầu của Mái ấm.
          </li>
          <li>
            <strong>Bản chất kế hoạch:</strong> Toàn bộ các con số trên là mô phỏng kế hoạch trong đề xuất, không cấu thành cam kết tài trợ hay doanh thu tiền mặt thực tế đã phát sinh. Cơ cấu doanh thu đồ ăn và phạm vi tài trợ hiện vật đang được đối chiếu; dự toán không phải kết quả thực tế.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 2: Dự toán chi phí kế hoạch (19 khoản phân theo 3 nhóm) -->
  <section class="section" aria-labelledby="expenses-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Ngân sách dự kiến</span>
        </div>
        <h2 id="expenses-heading" class="section-title">
          Dự toán chi phí kế hoạch
        </h2>
        <p class="section-subtitle">
          Tổng hợp 19 khoản mục dự toán chi phí chuẩn bị vật tư các góc chơi, quà tặng, nguyên liệu và di chuyển theo đề xuất (trang 24, 25, 26), phân thành 3 nhóm có tổng phụ tính toán trực tiếp từ dữ liệu.
        </p>
      </div>

      <!-- Desktop & Tablet Table View (Phân nhóm có subtotal) -->
      <div class="table-wrap desktop-only">
        <table class="data-table">
          <caption class="sr-only">Bảng chi tiết các khoản dự toán chi phí kế hoạch theo 3 nhóm</caption>
          <thead>
            <tr>
              <th scope="col">Khoản dự toán</th>
              <th scope="col">Phân loại</th>
              <th scope="col" class="text-right">Thành tiền</th>
              <th scope="col">Ghi chú kế hoạch</th>
            </tr>
          </thead>
          {
            expenseGroups.map((group) => (
              <tbody class="expense-group-body">
                <tr class="group-header-row">
                  <th colspan="2" scope="colgroup" class="group-header-cell">
                    <span class="group-header-badge">{group.category}</span>
                    <span class="group-header-ref text-xs text-muted">({group.sourceRef.replace('proposal:page-', 'hồ sơ trang ')})</span>
                  </th>
                  <td class="text-right font-bold group-header-subtotal">
                    {formatVND(group.subtotal)}
                  </td>
                  <td class="text-muted text-xs group-header-note">
                    Tổng phụ {group.items.length} khoản
                  </td>
                </tr>
                {
                  group.items.map((item) => (
                    <tr>
                      <td>
                        <strong>{item.title}</strong>
                        <div class="text-xs text-muted">{item.calculationText}</div>
                      </td>
                      <td>
                        <span class="category-tag">{item.category}</span>
                      </td>
                      <td class="text-right font-medium">
                        {formatVND(item.amount.value)}
                      </td>
                      <td class="text-muted">
                        {item.note}
                        {item.isEstimated && (
                          <span class="estimated-tag">Chi phí giả định</span>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            ))
          }
          <tfoot>
            <tr class="total-row">
              <th scope="row" colspan="2">Tổng dự toán chi kế hoạch (19 khoản)</th>
              <td class="text-right font-bold text-accent">
                {formatVND(totalPlannedExpense)}
              </td>
              <td class="text-muted">Dẫn xuất từ 19 khoản mục dự toán trong đề xuất, không phải chi phí thực tế</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Mobile Grouped List View (Collapsible details với subtotal nhìn thấy khi đóng) -->
      <div class="mobile-only mobile-expense-grouped-container" aria-label="Danh sách khoản dự toán chi trên di động phân theo nhóm">
        {
          expenseGroups.map((group) => (
            <details class="mobile-expense-group-card card">
              <summary class="mobile-group-summary">
                <div class="group-summary-left">
                  <span class="group-summary-title">{group.category}</span>
                  <span class="group-summary-count text-xs text-muted">({group.items.length} khoản)</span>
                </div>
                <div class="group-summary-right font-bold text-accent">
                  <span class="group-subtotal-val">{formatVND(group.subtotal)}</span>
                  <span class="group-expand-cue" aria-hidden="true">
                    <svg
                      class="chevron-svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </div>
              </summary>

              <div class="group-items-list">
                {
                  group.items.map((item) => (
                    <div class="mobile-expense-item">
                      <div class="mobile-expense-top">
                        <div class="mobile-expense-main">
                          <h3 class="mobile-expense-title">{item.title}</h3>
                        </div>
                        <div class="mobile-expense-val-col">
                          <span class="mobile-expense-val text-accent font-bold">
                            {formatVND(item.amount.value)}
                          </span>
                          {item.isEstimated && (
                            <span class="estimated-tag">Giả định</span>
                          )}
                        </div>
                      </div>
                      <div class="mobile-expense-sub text-muted">
                        {item.calculationText && (
                          <span class="mobile-expense-calc">{item.calculationText}</span>
                        )}
                        {item.calculationText && item.note && (
                          <span class="mobile-sub-sep" aria-hidden="true">&bull;</span>
                        )}
                        {item.note && (
                          <span class="mobile-expense-note">{item.note}</span>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </details>
          ))
        }

        <div class="mobile-total-card card">
          <div class="mobile-total-header">Tổng dự toán chi kế hoạch (19 khoản)</div>
          <div class="mobile-total-amount">{formatVND(totalPlannedExpense)}</div>
          <p class="mobile-total-note">
            Dẫn xuất từ 3 nhóm dự toán trong đề xuất ban đầu (trang 24, 25, 26); không phải chi phí thực tế đã thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Báo cáo thực tế và nguyên tắc quản trị -->
  <section class="section section-soft" aria-labelledby="actual-governance-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge status-badge-neutral">Theo dõi thực tế</span>
        </div>
        <h2 id="actual-governance-heading" class="section-title">
          Báo cáo thực tế và nguyên tắc quản trị
        </h2>
        <p class="section-subtitle">
          Thông tin thu chi thực tế sẽ được cập nhật sau khi đối soát và được phép công bố.
        </p>
      </div>

      <!-- Actual Ledger Compact (5 dòng gọn gàng, giữ null và chữ "Chưa xác nhận") -->
      <div class="actual-ledger-compact card" role="region" aria-label="Sổ theo dõi thực tế">
        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>1. Tiền thực nhận</strong>
              <span class="actual-tag">Chờ đối soát</span>
            </div>
            <p class="actual-col-desc">Gồm doanh thu bán hàng thực tế và tài trợ tiền mặt thực nhận.</p>
          </div>
          <div class="actual-col-val">{formatVND(ACTUAL_FINANCE.actualCashReceived.value)}</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>2. Chi tiền thực trả</strong>
              <span class="actual-tag">Chờ đối soát</span>
            </div>
            <p class="actual-col-desc">Kế hoạch chi trả các khoản vật tư và vận hành; số chi thực tế chờ đối soát.</p>
          </div>
          <div class="actual-col-val">{formatVND(ACTUAL_FINANCE.actualCashSpent.value)}</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>3. Số dư tiền thực tế</strong>
              <span class="actual-tag">Chờ đối soát</span>
            </div>
            <p class="actual-col-desc">Số dư đầu kỳ + tiền thực nhận − chi tiền thực trả; số liệu phát sinh chờ đối soát.</p>
          </div>
          <div class="actual-col-val">{formatVND(ACTUAL_FINANCE.actualCashBalance.value)}</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>4. Hiện vật tiếp nhận &amp; bàn giao</strong>
              <span class="actual-tag">Sổ riêng</span>
            </div>
            <p class="actual-col-desc">Theo dõi riêng trong sổ hiện vật theo kế hoạch, không quy đổi gộp vào tiền mặt.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>

        <div class="actual-row">
          <div class="actual-col-main">
            <div class="actual-col-title">
              <strong>5. Chứng từ &amp; Hóa đơn</strong>
              <span class="actual-tag">Lưu trữ nội bộ</span>
            </div>
            <p class="actual-col-desc">Kế hoạch lưu trữ đầy đủ hóa đơn, chứng từ; công bố bản biên tập bảo vệ riêng tư sau khi được duyệt.</p>
          </div>
          <div class="actual-col-val">Chưa xác nhận</div>
        </div>
      </div>

      <!-- Empty State Notice Box -->
      <div class="ledger-empty-notice card">
        <p>
          <strong>Trạng thái thực tế:</strong> {ACTUAL_FINANCE.statusNotice}
        </p>
        <p class="text-sm text-muted">
          {ACTUAL_FINANCE.disclaimer} Các báo cáo thu chi, tài trợ hiện vật và chứng từ minh bạch sẽ được đăng tải chi tiết sau khi có sự xác nhận chính thức từ các bên.
        </p>
      </div>

      <!-- Governance Principles & Contingency Grid -->
      <div class="principles-grid">
        <div class="principle-card card">
          <div class="principle-number">01</div>
          <h3 class="principle-title">Công thức dòng tiền chuẩn xác</h3>
          <p class="principle-desc">
            Số dư tiền = Số dư đầu kỳ + Doanh thu thực nhận + Tài trợ tiền thực nhận − Chi tiền thực trả. Hàng tồn kho và đơn chưa thanh toán không được ghi nhận là doanh thu đã thu.
          </p>
        </div>

        <div class="principle-card card">
          <div class="principle-number">02</div>
          <h3 class="principle-title">Tách bạch tiền mặt và hiện vật</h3>
          <p class="principle-desc">
            Tiền mặt và hiện vật được quản lý trong hai hệ thống sổ sách độc lập. Tuyệt đối không gộp giá trị ước tính của hiện vật vào số dư tiền mặt của chiến dịch.
          </p>
        </div>

        <div class="principle-card card">
          <div class="principle-number">03</div>
          <h3 class="principle-title">Đối soát chéo hai thành viên</h3>
          <p class="principle-desc">
            Theo đề xuất, mọi khoản thu chi phát sinh đều được đối soát độc lập bởi hai thành viên phụ trách tài chính nhằm đảm bảo tính chính xác và khách quan.
          </p>
        </div>

        <div class="principle-card card">
          <div class="principle-number">04</div>
          <h3 class="principle-title">Biên tập chứng từ bảo vệ riêng tư</h3>
          <p class="principle-desc">
            Báo cáo tài chính và chứng từ gốc sau đối soát sẽ được biên tập che các thông tin cá nhân nhạy cảm trước khi công bố công khai theo quyền hạn được duyệt.
          </p>
        </div>

        <div class="principle-card card principle-card-wide">
          <div class="principle-number">05</div>
          <h3 class="principle-title">Phương án dự phòng và quản trị rủi ro</h3>
          <p class="principle-desc">
            Theo đề xuất, khi chưa đủ điều kiện phối hợp và kinh phí, nhóm cần điều chỉnh kế hoạch trước khi mua sắm lớn hoặc mở bán. Hàng tồn và thu chi được dự kiến theo dõi riêng; việc mua quà dựa trên số dư thực tế sau đối soát và nhu cầu được xác nhận.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: FAQs (Dùng FaqAccordion) -->
  <section class="section" aria-labelledby="transparency-faq-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Giải đáp thắc mắc</span>
        </div>
        <h2 id="transparency-faq-heading" class="section-title">
          Câu hỏi thường gặp về tài chính
        </h2>
        <p class="section-subtitle">
          Giải thích rõ ràng các băn khoăn về dự toán chi, phân bổ doanh thu và kế hoạch công khai báo cáo.
        </p>
      </div>

      <FaqAccordion faqs={TRANSPARENCY_FAQS} />
    </div>
  </section>

  <!-- Navigation CTA Section -->
  <section class="section section-soft navigation-cta-section" aria-labelledby="nav-cta-heading">
    <div class="container">
      <div class="navigation-cta-card card">
        <h2 id="nav-cta-heading" class="navigation-cta-title">
          Tìm hiểu thêm về chiến dịch
        </h2>
        <p class="navigation-cta-desc">
          Khám phá các phương thức tiếp nhận đồng hành cùng dự án hoặc xem chi tiết câu chuyện và 4 góc chơi tại Mái ấm.
        </p>
        <div class="navigation-cta-actions">
          <a href="/dong-hanh" class="btn btn-primary">
            Cách đồng hành &rarr;
          </a>
          <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-secondary">
            Xem chi tiết câu chuyện dự án
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
