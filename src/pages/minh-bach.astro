---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StatusChip from '../components/StatusChip.astro';
import Icon from '../components/Icon.astro';
import {
  PLANNED_EXPENSES,
  PRODUCTS,
  FINANCE_SCENARIOS,
  TRANSPARENCY_FAQS,
  ACTUAL_FINANCE,
  FINANCE_OVERVIEW,
} from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateFoodRevenue,
  calculateBaseRevenue,
  calculateScenario,
  calculateFoodReconciliation,
  calculateCraftReconciliation,
  groupPlannedExpensesByCategory,
  formatScenarioBalance,
  formatVND,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const expenseGroups = groupPlannedExpensesByCategory(PLANNED_EXPENSES);
const craftRevenue = calculateCraftRevenue(PRODUCTS);
const foodRevenue = calculateFoodRevenue(PRODUCTS);
const totalPlannedRevenue = calculateBaseRevenue(PRODUCTS);

const byId = (id: string) => PRODUCTS.find((p) => p.id === id);
const setDoAn = byId('set-do-an');
const banhSuKem = byId('banh-su-kem');
const chuonTre = byId('chuon-chuon-tre-kem-de');
const mocKhoa = byId('moc-khoa');

const foodGroup = expenseGroups.find((g) => g.category === 'Nguyên liệu gây quỹ');
const workshopGroup = expenseGroups.find((g) => g.category === 'Vật tư workshop & quà tặng');
const otherGroup = expenseGroups.find((g) => g.category === 'Truyền thông & Di chuyển');

const food = calculateFoodReconciliation(
  setDoAn?.plannedQuantity,
  setDoAn?.referencePrice,
  FINANCE_OVERVIEW.foodPlannedRevenueAssumption,
  craftRevenue,
  totalPlannedExpense,
  banhSuKem?.plannedQuantity,
  banhSuKem?.referencePrice,
  foodGroup?.subtotal ?? null,
  FINANCE_OVERVIEW.foodProfitQuote
);

const craft = calculateCraftReconciliation(
  chuonTre?.plannedQuantity,
  chuonTre?.referencePrice,
  mocKhoa?.plannedQuantity,
  mocKhoa?.referencePrice,
  workshopGroup?.subtotal ?? null,
  FINANCE_OVERVIEW.craftProfitQuote
);

const sumOrNull = (a: number | null, b: number | null) => (a !== null && b !== null ? a + b : null);
const diffOrNull = (a: number | null, b: number | null) => (a !== null && b !== null ? a - b : null);
const signed = (v: number | null) => (v === null ? formatVND(null) : `${v > 0 ? '+' : v < 0 ? '−' : ''}${formatVND(Math.abs(v))}`);

const scenarioResults = FINANCE_SCENARIOS.map((scenario) => ({
  scenario,
  result: calculateScenario(scenario, totalPlannedRevenue, totalPlannedExpense),
}));
const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro') ?? FINANCE_SCENARIOS[0];
const baseResult = calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense);
const baseBalance = formatScenarioBalance(baseResult);

const figures = [
  {
    label: 'Chi dự toán',
    value: formatVND(totalPlannedExpense),
    chip: 'ke-hoach' as const,
    note: `${PLANNED_EXPENSES.length} khoản trong 3 nhóm, theo báo giá cần xác nhận.`,
  },
  {
    label: 'Doanh thu nếu bán đủ',
    value: formatVND(totalPlannedRevenue),
    chip: 'gia-dinh' as const,
    note: 'Thủ công + đồ ăn cơ sở, theo giá tham khảo.',
  },
  {
    label: 'Còn lại trước khi mua quà',
    value: baseBalance.text,
    chip: 'gia-dinh' as const,
    note: 'Chưa tính tài trợ; không phải số tiền chắc chắn có.',
  },
  {
    label: 'Thu chi thực tế',
    value: formatVND(ACTUAL_FINANCE.actualCashBalance.value),
    chip: 'cho-xac-nhan' as const,
    chipLabel: 'Chưa có số liệu',
    note: 'Công bố sau khi đối soát và được phép.',
    muted: true,
  },
];

const actualRows = [
  { label: 'Tiền thực nhận (bán hàng, tài trợ tiền)', fact: ACTUAL_FINANCE.actualCashReceived },
  { label: 'Tiền thực chi', fact: ACTUAL_FINANCE.actualCashSpent },
  { label: 'Số dư tiền thực tế', fact: ACTUAL_FINANCE.actualCashBalance },
  { label: 'Hiện vật đã nhận (sổ riêng)', fact: ACTUAL_FINANCE.actualInKindReceived },
  { label: 'Hiện vật đã bàn giao cho Mái ấm', fact: ACTUAL_FINANCE.actualInKindDelivered },
];

const formatActual = (value: number | null, unit: string) =>
  value === null ? 'Chưa xác nhận' : unit === 'đ' ? formatVND(value) : `${value} ${unit}`;

const shortName: Record<string, string> = {
  'chuon-chuon-tre-kem-de': 'bộ chuồn chuồn',
  'moc-khoa': 'móc khóa',
  'set-do-an': 'set',
  'banh-su-kem': 'hộp su kem',
};
const formulaText = (category: 'craft' | 'food') =>
  PRODUCTS.filter((p) => p.category === category && p.isBaseRevenueItem !== false)
    .map((p) => `${p.plannedQuantity.value ?? '?'} ${shortName[p.id] ?? p.name} × ${formatVND(p.referencePrice.value)}`)
    .join(' + ');

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Minh bạch' }];
---

<Layout
  title="Minh bạch thu chi"
  description="Dự toán 24 khoản, kịch bản doanh thu, các điểm cần làm rõ và khung báo cáo thực tế của dự án Mang Theo Một Nét Vẽ."
  currentPath="/minh-bach"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Minh bạch"
    chip={{ kind: 'cho-xac-nhan', label: 'Chưa có số liệu thực tế' }}
    title="Minh bạch thu chi"
    titleId="transparency-heading"
    lead="Mọi con số dưới đây là kế hoạch trong đề xuất Final, chưa phải tiền đã thu hay đã chi."
    description="Trang này tách rõ dự toán, giả định doanh thu và số liệu thực tế, đồng thời nêu những điểm trong hồ sơ còn chờ nhóm làm rõ."
  />

  <section class="section section-first" aria-labelledby="overview-heading">
    <div class="container">
      <h2 id="overview-heading" class="sr-only">Tổng quan tài chính kế hoạch</h2>
      <KeyFigures figures={figures} label="Bốn con số tài chính chính" />

      <div class="formula" aria-label="Cách tính số dư trước khi mua quà">
        <div class="formula-part">
          <span class="formula-label">Thủ công</span>
          <span class="formula-value">{formatVND(craftRevenue)}</span>
          <span class="formula-sub">{formulaText('craft')}</span>
        </div>
        <span class="formula-op" aria-hidden="true">+</span>
        <div class="formula-part">
          <span class="formula-label">Đồ ăn cơ sở</span>
          <span class="formula-value">{formatVND(foodRevenue)}</span>
          <span class="formula-sub">{formulaText('food')}</span>
        </div>
        <span class="formula-op" aria-hidden="true">−</span>
        <div class="formula-part">
          <span class="formula-label">Chi dự toán</span>
          <span class="formula-value">{formatVND(totalPlannedExpense)}</span>
          <span class="formula-sub">{PLANNED_EXPENSES.length} khoản, mỗi khoản trừ một lần</span>
        </div>
        <span class="formula-op" aria-hidden="true">=</span>
        <div class="formula-part formula-result">
          <span class="formula-label">Còn lại trước quà</span>
          <span class="formula-value">{baseBalance.text}</span>
          <span class="formula-sub">Kịch bản bán đủ, chưa tài trợ</span>
        </div>
      </div>
      <p class="source-note">
        Ba combo nem (60 suất/món) không có trong phép tính vì chưa rõ bán thêm hay thay cho 50 set. Hàng tồn, đơn chưa thanh toán và hiện vật không được tính là tiền.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="expenses-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dự toán</span>
        <h2 id="expenses-heading">{PLANNED_EXPENSES.length} khoản chi theo 3 nhóm</h2>
        <p>Mở từng nhóm để xem đơn giá, số lượng và ghi chú. Tất cả là dự toán theo báo giá cần xác nhận, không phải khoản đã thanh toán.</p>
      </div>

      <div class="ledger">
        {
          expenseGroups.map((group, gi) => (
            <details class="disclosure ledger-group" id={`nhom-chi-${gi + 1}`}>
              <summary>
                <span class="disclosure-label">
                  {group.category}
                  <span class="disclosure-meta">
                    {group.items.length} khoản · đề xuất trang {group.sourceRef.replace('proposal-final:page-', '')}
                  </span>
                </span>
                <span class="disclosure-aside">
                  <span class="ledger-subtotal">{formatVND(group.subtotal)}</span>
                  <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
                </span>
              </summary>
              <div class="disclosure-body">
                <table class="data-table data-table--stack ledger-table">
                  <caption class="sr-only">Các khoản chi trong nhóm {group.category}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Khoản chi</th>
                      <th scope="col">Cơ sở tính</th>
                      <th scope="col" class="num">Dự toán</th>
                      <th scope="col">Ghi chú</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.items.map((item) => (
                      <tr>
                        <th scope="row">{item.title}</th>
                        <td class="ledger-calc" data-label="Cơ sở tính">{item.calculationText}</td>
                        <td class="num" data-label="Dự toán">{formatVND(item.amount.value)}</td>
                        <td class="cell-wide ledger-note">{item.note.replace(/\s*\(trang \d+\)\s*$/, '')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))
        }
        <div class="ledger-total">
          <span>Tổng dự toán chi</span>
          <strong>{formatVND(totalPlannedExpense)}</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="scenarios-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kịch bản hỗ trợ</span>
        <h2 id="scenarios-heading">Nếu có tài trợ hiện vật</h2>
        <p>
          Hiện vật chỉ thay đúng khoản chi tương ứng, làm giảm tiền phải chi; doanh thu giữ nguyên {formatVND(totalPlannedRevenue)}. Đây là các giả định riêng lẻ trong đề xuất (trang 32), chưa có cam kết tài trợ nào.
        </p>
      </div>

      <table class="data-table data-table--stack scenario-table">
        <caption class="sr-only">Kịch bản tài trợ hiện vật và số dư giả định</caption>
        <thead>
          <tr>
            <th scope="col">Kịch bản</th>
            <th scope="col" class="num">Hiện vật thay chi</th>
            <th scope="col" class="num">Tiền còn phải chi</th>
            <th scope="col" class="num">Còn lại trước quà</th>
          </tr>
        </thead>
        <tbody>
          {
            scenarioResults.map(({ scenario, result }) => (
              <tr>
                <th scope="row">
                  {scenario.title}
                  {scenario.allocationPending && (
                    <span class="cell-sub scenario-flag">
                      <StatusChip kind="can-lam-ro" label="Danh mục 500.000đ chưa rõ" />
                    </span>
                  )}
                </th>
                <td class="num" data-label="Hiện vật thay chi">{formatVND(scenario.inKindReplacement.value)}</td>
                <td class="num" data-label="Tiền còn phải chi">{result ? formatVND(result.remainingCashExpense) : 'Chưa xác nhận'}</td>
                <td class="num" data-label="Còn lại trước quà">{result ? formatScenarioBalance(result).text : 'Chưa xác nhận'}</td>
              </tr>
            ))
          }
          <tr>
            <th scope="row">Không đủ tài trợ hoặc đơn trước buổi 1</th>
            <td class="num" data-label="Hiện vật thay chi">—</td>
            <td class="num" data-label="Tiền còn phải chi">Chưa xác định</td>
            <td class="num" data-label="Còn lại trước quà">Không cam kết</td>
          </tr>
        </tbody>
      </table>
      <p class="source-note">
        Trường hợp cuối: nhóm giảm vật liệu, xin điều chỉnh và không ứng tiền cá nhân. Kịch bản 500.000đ: bảng chi chỉ có bánh kẹo 340.000đ và đồ tặng truyền thông 60.000đ, nên danh mục thay chi đủ 500.000đ còn chờ nhóm xác nhận.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="open-heading" id="can-lam-ro">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Cần làm rõ</span>
        <h2 id="open-heading">Những điểm hồ sơ chưa thống nhất</h2>
        <p>Website giữ nguyên số liệu nguồn và không tự chọn cách hiểu cho các điểm sau. Tổng số dư {baseBalance.text} không bị ảnh hưởng.</p>
      </div>

      <ul class="ruled-list open-list">
        <li>
          <h3 class="ruled-title">Ba combo nem 60 suất/món</h3>
          <p class="ruled-desc">Chưa rõ bán thêm hay thay cho 50 set. Lượng nem dự toán (300 chiếc) vừa khớp 50 set × 6 nem, nên combo chưa được cộng vào doanh thu.</p>
        </li>
        <li>
          <h3 class="ruled-title">Lãi theo từng nhóm sản phẩm</h3>
          <p class="ruled-desc">
            Hồ sơ ghi lãi đồ ăn {formatVND(food.foodProfitQuote)} và thủ công {formatVND(craft.craftProfitQuote)}; lấy doanh thu trừ chi theo nhóm được {formatVND(food.foodRevenueMinusExpenses)} và {formatVND(craft.craftRevenueMinusExpenses)}. Mỗi cặp lệch 400.000đ, bù trừ nhau. Phân bổ chi phí chưa được duyệt, nên không số nào là lãi sản phẩm chính thức.
          </p>
        </li>
        <li>
          <h3 class="ruled-title">Danh mục thay chi 500.000đ</h3>
          <p class="ruled-desc">Kịch bản tài trợ bánh kẹo/quà 500.000đ chưa khớp một nhóm khoản chi cụ thể trong bảng dự toán.</p>
        </li>
        <li>
          <h3 class="ruled-title">Quy cách một số nguyên liệu</h3>
          <p class="ruled-desc">Đơn vị của bột chiên xù, dầu ăn và cách chia đợt khoai tây, dưa chuột cần xác nhận trước khi mua.</p>
        </li>
      </ul>

      <details class="disclosure profit-detail">
        <summary>
          <span class="disclosure-label">
            Bảng đối chiếu lãi theo nhóm
            <span class="disclosure-meta">So sánh số ghi trong hồ sơ với doanh thu trừ chi phí theo nhóm</span>
          </span>
          <span class="disclosure-aside">
            <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
          </span>
        </summary>
        <div class="disclosure-body">
          <table class="data-table data-table--stack profit-table">
            <caption class="sr-only">Đối chiếu lãi theo nhóm sản phẩm</caption>
            <thead>
              <tr>
                <th scope="col">Nhóm</th>
                <th scope="col" class="num">Doanh thu cơ sở</th>
                <th scope="col" class="num">Chi theo nhóm</th>
                <th scope="col" class="num">Doanh thu − chi</th>
                <th scope="col" class="num">Hồ sơ ghi</th>
                <th scope="col" class="num">Chênh</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Đồ ăn</th>
                <td class="num" data-label="Doanh thu cơ sở">{formatVND(food.totalCoreFoodRevenue)}</td>
                <td class="num" data-label="Chi theo nhóm">{formatVND(food.foodExpensesTotal)}</td>
                <td class="num" data-label="Doanh thu − chi">{formatVND(food.foodRevenueMinusExpenses)}</td>
                <td class="num" data-label="Hồ sơ ghi">{formatVND(food.foodProfitQuote)}</td>
                <td class="num" data-label="Chênh">{signed(diffOrNull(food.foodProfitQuote, food.foodRevenueMinusExpenses))}</td>
              </tr>
              <tr>
                <th scope="row">Thủ công</th>
                <td class="num" data-label="Doanh thu cơ sở">{formatVND(craft.totalCraftRevenue)}</td>
                <td class="num" data-label="Chi theo nhóm">{formatVND(craft.workshopExpensesTotal)}</td>
                <td class="num" data-label="Doanh thu − chi">{formatVND(craft.craftRevenueMinusExpenses)}</td>
                <td class="num" data-label="Hồ sơ ghi">{formatVND(craft.craftProfitQuote)}</td>
                <td class="num" data-label="Chênh">{signed(diffOrNull(craft.craftProfitQuote, craft.craftRevenueMinusExpenses))}</td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Cộng hai nhóm</th>
                <td class="num" data-label="Doanh thu cơ sở">{formatVND(sumOrNull(food.totalCoreFoodRevenue, craft.totalCraftRevenue))}</td>
                <td class="num" data-label="Chi theo nhóm">{formatVND(sumOrNull(food.foodExpensesTotal, craft.workshopExpensesTotal))}</td>
                <td class="num" data-label="Doanh thu − chi">{formatVND(sumOrNull(food.foodRevenueMinusExpenses, craft.craftRevenueMinusExpenses))}</td>
                <td class="num" data-label="Hồ sơ ghi">{formatVND(sumOrNull(food.foodProfitQuote, craft.craftProfitQuote))}</td>
                <td class="num" data-label="Chênh">{signed(diffOrNull(sumOrNull(food.foodProfitQuote, craft.craftProfitQuote), sumOrNull(food.foodRevenueMinusExpenses, craft.craftRevenueMinusExpenses)))}</td>
              </tr>
            </tfoot>
          </table>
          <p class="source-note">
            Cộng hai nhóm trừ thêm truyền thông và di chuyển {formatVND(otherGroup?.subtotal ?? null)} cho cùng kết quả {baseBalance.text}. Trong bảng lãi theo mặt hàng (trang 30), khoản su kem 400.000đ xuất hiện ở cả dòng set lẫn dòng su kem; nhóm chưa xác nhận cách phân bổ.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="section" aria-labelledby="actual-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">Thực tế</span>
          <h2 id="actual-heading" class="col-title">Sổ thực tế</h2>
          <p class="actual-intro">{ACTUAL_FINANCE.statusNotice} {ACTUAL_FINANCE.disclaimer}</p>
          <dl class="actual-list">
            {
              actualRows.map((r) => (
                <div class="actual-row">
                  <dt>{r.label}</dt>
                  <dd>{formatActual(r.fact.value, r.fact.unit)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <span class="eyebrow">Khi có số liệu</span>
          <h3 class="col-title col-title--sm">Cách tính sẽ dùng</h3>
          <div class="calc-box">
            <p class="calc-name">Quỹ có thể dùng trước khi mua quà</p>
            <p class="calc-expr">Tiền bán hàng và tài trợ đã nhận − chi phí đã trả − chi phí còn phải trả − tiền khách đã trả cho đơn chưa hoàn tất</p>
          </div>
          <div class="calc-box">
            <p class="calc-name">Số dư sau bàn giao</p>
            <p class="calc-expr">Tổng tiền thực nhận − tổng tiền đã chi (gồm mua quà) − nghĩa vụ thanh toán và hoàn trả còn lại</p>
          </div>
          <ul class="check-list rules">
            <li>Tiền và hiện vật ghi hai sổ riêng; hai thành viên đối soát.</li>
            <li>Chỉ chi trong số tiền thực có; thành viên không ứng tiền cá nhân.</li>
            <li>Quà mua theo danh mục Mái ấm xác nhận, có hóa đơn và biên bản bàn giao.</li>
            <li>Chứng từ chỉ công bố bản đã che thông tin riêng tư.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="transparency-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="transparency-faq-heading">Câu hỏi về tài chính</h2>
      </div>
      <FaqAccordion faqs={TRANSPARENCY_FAQS} idPrefix="finance-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="finance-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="finance-cta-heading">Có thể hỗ trợ bằng hiện vật?</h2>
        <p>Xem các cách đồng hành và nguyên tắc tiếp nhận của nhóm.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Cách đồng hành</a>
