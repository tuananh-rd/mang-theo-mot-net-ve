---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ActivityList from '../components/ActivityList.astro';
import KeyFigures from '../components/KeyFigures.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import Timeline from '../components/Timeline.astro';
import StatusChip from '../components/StatusChip.astro';
import { CAMPAIGN_PROJECT, PRODUCTS, TEAM_INFO, PLANNED_EXPENSES, FINANCE_SCENARIOS } from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateBaseRevenue,
  calculateScenario,
  formatVND,
  formatScenarioBalance,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const totalPlannedRevenue = calculateBaseRevenue(PRODUCTS);
const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro');
const baseResult = baseScenario ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense) : null;
const balance = formatScenarioBalance(baseResult);

const figures = [
  {
    label: 'Chi dự toán',
    value: formatVND(totalPlannedExpense),
    chip: 'ke-hoach' as const,
    note: `${PLANNED_EXPENSES.length} khoản: nguyên liệu, vật tư buổi chơi, quà, di chuyển.`,
  },
  {
    label: 'Doanh thu nếu bán đủ',
    value: formatVND(totalPlannedRevenue),
    chip: 'gia-dinh' as const,
    note: 'Theo giá tham khảo và số lượng kế hoạch của 4 mặt hàng cơ sở.',
  },
  {
    label: 'Còn lại trước khi mua quà',
    value: balance.text,
    chip: 'gia-dinh' as const,
    note: 'Phép trừ kịch bản, chưa tính tài trợ; không phải số tiền đã có.',
  },
];
---

<Layout
  title="Trang chủ"
  description="Mang Theo Một Nét Vẽ — dự án của nhóm Lăng Kính (AI2015, SSG105, Đại học FPT Hà Nội): một buổi chơi có lựa chọn tại Mái ấm Thánh Tâm Xuy Xá và gây quỹ mua quà đúng nhu cầu."
  currentPath="/"
>
  <Hero />

  <section class="facts" aria-label="Thông tin chính của dự án">
    <div class="container">
      <dl class="facts-strip">
        <div class="fact">
          <dt>Nhóm thực hiện</dt>
          <dd>Lăng Kính · {TEAM_INFO.size} sinh viên lớp {TEAM_INFO.classId}</dd>
        </div>
        <div class="fact">
          <dt>Địa điểm dự kiến</dt>
          <dd>Mái ấm Thánh Tâm Xuy Xá; gây quỹ tại FPT Hòa Lạc</dd>
        </div>
        <div class="fact">
          <dt>Thời gian</dt>
          <dd>5 tuần học phần (tuần 5–9), 2 buổi tại Mái ấm</dd>
        </div>
        <div class="fact">
          <dt>Trạng thái</dt>
          <dd><StatusChip kind="cho-xac-nhan" label="Đề xuất, chờ xác nhận" /></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="play-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="play-heading">Mỗi em chọn cách tham gia của mình</h2>
        <p>
          Bốn góc hoạt động vừa sức. Các em có thể chơi, đổi góc, ngồi xem hoặc nghỉ bất cứ lúc nào; nhóm không đặt chỉ tiêu sản phẩm nào cho các em.
        </p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} />

      <div class="section-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="link-arrow">Xem kế hoạch buổi chơi →</a>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="money-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Gây quỹ và minh bạch</span>
        <h2 id="money-heading">Tiền gây quỹ được tính và dùng thế nào</h2>
        <p>
          Nhóm bán sản phẩm thủ công và đồ ăn tại FPT Hòa Lạc. Doanh thu trước hết bù chi phí; phần còn lại sau đối soát dùng mua hiện vật theo danh mục Mái ấm xác nhận.
        </p>
      </div>

      <KeyFigures figures={figures} label="Ba con số kế hoạch chính" />
      <p class="source-note">
        Số liệu theo đề xuất Final (trang 29–32). Chưa có thu chi thực tế; website chưa nhận đơn hàng hay tiền.
      </p>

      <h3 class="block-title home-products-title">Sản phẩm dự kiến</h3>
      <ProductCatalog
        products={PRODUCTS.filter((p) => p.isBaseRevenueItem !== false)}
        variant="summary"
        caption="Bốn mặt hàng cơ sở với giá tham khảo, số lượng kế hoạch và doanh thu nếu bán đủ"
      />

      <div class="section-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch thu chi</a>
        <a href="/san-pham" class="link-arrow">Xem đủ 7 mặt hàng →</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình</span>
        <h2 id="timeline-heading">Bốn chặng trong 5 tuần học phần</h2>
        <p>Gây quỹ diễn ra trước buổi chơi; quà chỉ được mua sau khi chốt quỹ và đối chiếu danh mục với Mái ấm.</p>
      </div>

      <Timeline stages={CAMPAIGN_PROJECT.plannedStages} showDescriptions={false} />

      <p class="source-note">
        Tuần 5–9 là tuần của học phần, chưa phải ngày cụ thể. Một số phần của đề xuất còn ghi 4 tuần; nhóm sẽ thống nhất lịch chính thức với Mái ấm.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="team-support-heading">
    <div class="container">
      <h2 id="team-support-heading" class="sr-only">Nhóm thực hiện và cách đồng hành</h2>
      <div class="two-col">
        <div class="home-col">
          <span class="eyebrow">Nhóm thực hiện</span>
          <h3 class="block-title">Lăng Kính — 7 sinh viên FPT Hà Nội</h3>
          <p>
            Nhóm lớp {TEAM_INFO.classId}, học phần SSG105. Bảy vai trò từ điều phối, tài chính, hậu cần đến truyền thông; hai thành viên đối soát mọi khoản thu chi.
          </p>
          <a href="/ve-nhom" class="link-arrow">Về nhóm →</a>
        </div>
        <div class="home-col">
          <span class="eyebrow">Đồng hành</span>
          <h3 class="block-title">Hỗ trợ đúng thứ Mái ấm cần</h3>
          <p>
            Vật tư theo danh mục được xác nhận, mua sản phẩm khi mở bán, hoặc chia sẻ câu chuyện dự án. Kênh liên hệ chính thức sẽ được công bố sau khi được duyệt.
          </p>
          <a href="/dong-hanh" class="link-arrow">Cách đồng hành →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .facts {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  .facts-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .fact {
    padding: var(--space-5) var(--space-6);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:first-child {
    border-left: none;
    padding-left: 0;
  }

  .fact dt {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .home-products-title {
    margin-top: var(--space-12);
  }

  .home-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .home-col p {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 767px) {
    .facts-strip {
      grid-template-columns: 1fr;
    }

    .fact,
    .fact:nth-child(3) {
      border-left: none;
      padding: var(--space-3) 0;
    }

    .fact + .fact {
      border-top: 1px solid var(--line);
    }

    .home-products-title {
      margin-top: var(--space-10);
    }
  }
</style>
