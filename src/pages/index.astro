---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ActivityCard from '../components/ActivityCard.astro';
import ProductCard from '../components/ProductCard.astro';
import StageCard from '../components/StageCard.astro';
import StatusChip from '../components/StatusChip.astro';
import {
  CAMPAIGN_PROJECT,
  PRODUCTS,
  TEAM_INFO,
  FINANCE_OVERVIEW,
  PLANNED_EXPENSES,
  FINANCE_SCENARIOS,
} from '../data/campaign';

import {
  sumPlannedExpenses,
  calculateCraftRevenue,
  calculateCombinedPlannedRevenue,
  calculateScenario,
  formatVND,
  formatScenarioBalance,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const craftPlannedRevenue = calculateCraftRevenue(PRODUCTS);
const foodPlannedAssumption = FINANCE_OVERVIEW.foodPlannedRevenueAssumption;
const totalPlannedRevenue = calculateCombinedPlannedRevenue(craftPlannedRevenue, foodPlannedAssumption);

const formatInSentence = (name: string) => (name ? name.charAt(0).toLowerCase() + name.slice(1) : '');
const craftProducts = PRODUCTS.filter((p) => p.category === 'craft');
const craftSummaryText = craftProducts
  .map((p) => `${p.plannedQuantity.value} ${formatInSentence(p.name)}`)
  .join(' và ');

const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro');
const baseScenarioResult = baseScenario
  ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense)
  : null;
const balanceDisplay = formatScenarioBalance(baseScenarioResult);

const activityIllustrationTypes = [
  'chuon-chuon',
  'to-tuong',
  'hat',
  'tro-choi',
] as const;

// 3 card sản phẩm đại diện trên trang chủ
const featuredProducts = [
  {
    product: PRODUCTS.find((p) => p.id === 'chuon-chuon-tre-kem-de')!,
    illustrationType: 'chuon-chuon' as const,
  },
  {
    product: PRODUCTS.find((p) => p.id === 'moc-khoa')!,
    illustrationType: 'moc-khoa' as const,
  },
  {
    product: PRODUCTS.find((p) => p.id === 'set-do-an')!,
    illustrationType: 'set-do-an' as const,
  },
];
---

<Layout
  title="Trang chủ"
  description="Dự án Mang Theo Một Nét Vẽ - Lăng Kính (lớp AI2015, SSG105, Đại học FPT Hà Nội) tại Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Quick Facts Strip: Dải thông tin có đường ngăn, tránh lồng card -->
  <section class="section-summary" aria-label="Tóm tắt nhanh dự án">
    <div class="container">
      <div class="quick-summary-strip" role="region" aria-label="4 thông tin cốt lõi">
        <div class="summary-item">
          <span class="summary-label">Nhóm thực hiện</span>
          <span class="summary-text">Nhóm Lăng Kính ({TEAM_INFO.size} sinh viên, lớp {TEAM_INFO.classId})</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Địa điểm dự kiến</span>
          <span class="summary-text">{CAMPAIGN_PROJECT.location}</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Trạng thái</span>
          <div class="summary-chip-wrap">
            <StatusChip kind="cho-xac-nhan" label={CAMPAIGN_PROJECT.statusNotice} />
          </div>
        </div>
        <div class="summary-item">
          <span class="summary-label">Nội dung xem trước</span>
          <span class="summary-text">4 góc chơi, 7 sản phẩm và dự toán minh bạch</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Buổi chơi có lựa chọn (4 góc chơi) -->
  <section class="section section-activities" aria-labelledby="activities-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Hoạt động buổi chơi</span>
        <h2 id="activities-heading">Buổi chơi có lựa chọn</h2>
        <p>
          Mỗi hoạt động được thiết kế để mang lại niềm vui vừa sức, an toàn. Người tham gia luôn có trọn vẹn quyền tự do lựa chọn tham gia góc chơi mình thích, quan sát bạn bè hoặc nghỉ ngơi.
        </p>
      </div>

      <div class="activities-grid">
        {
          CAMPAIGN_PROJECT.activities.map((act, index) => (
            <ActivityCard
              activity={act}
              illustrationType={activityIllustrationTypes[index]}
            />
          ))
        }
      </div>

      <div class="section-footer-note">
        <p>
          * Ghi chú bản xem trước: Biểu tượng minh họa hoạt động dự kiến. Mẫu chuồn chuồn, tượng và nhạc cụ thực tế chờ xác nhận; tô tượng không phải sản phẩm bán gây quỹ. Hoạt động hướng đến sự gần gũi, kết nối tinh thần; không tuyên bố tác động trị liệu và không đặt chỉ tiêu sản xuất cho các em nhỏ.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Minh bạch từ kế hoạch đến thực tế (Chuyển lên trước Sản phẩm và Hành trình) -->
  <section class="section section-soft section-transparency" aria-labelledby="transparency-heading">
    <div class="container">
      <div class="transparency-card">
        <div class="transparency-header">
          <div class="badge-row">
            <span class="eyebrow">Tài chính dự kiến</span>
            <StatusChip kind="ke-hoach" label="Nguyên tắc minh bạch" />
          </div>
          <h2 id="transparency-heading">Minh bạch từ kế hoạch đến thực tế</h2>
          <p class="transparency-status">
            <strong>{FINANCE_OVERVIEW.actualStatusNotice}</strong>
          </p>
        </div>

        <!-- Lưu ý đối soát 550.000đ -->
        <div class="product-section-notice" role="note">
          <p>
            <strong>Lưu ý đối soát ẩm thực:</strong> Kịch bản ẩm thực 4.500.000₫ trong đề xuất có chênh lệch 550.000₫ so với mức tính 50 set × 79.000₫ (3.950.000₫). Xem <a href="/minh-bach#doi-chieu-do-an" class="transparency-link">bảng đối soát chi tiết tại trang Minh bạch</a>.
          </p>
        </div>

        <div class="transparency-content">
          <div class="transparency-col">
            <h3 class="col-title">Dự toán kế hoạch trong đề xuất</h3>
            <ul class="data-list">
              <li>
                <span>Tổng chi phí dự toán (19 khoản):</span>
                <span class="data-val-group">
                  <strong>{formatVND(totalPlannedExpense)}</strong>
                  <StatusChip kind="ke-hoach" label="Kế hoạch" />
                </span>
              </li>
              <li>
                <span>Doanh thu kịch bản giả định:</span>
                <span class="data-val-group">
                  <strong>{formatVND(totalPlannedRevenue)}</strong>
                  <StatusChip kind="gia-dinh" label="Giả định" />
                </span>
              </li>
              <li>
                <span>Chênh lệch giả định (khi chưa có tài trợ):</span>
                <span class="data-val-group">
                  <span class={balanceDisplay.diffClass}>{balanceDisplay.text}</span>
                  <StatusChip kind="gia-dinh" label="Giả định" />
                </span>
              </li>
            </ul>
            <p class="transparency-sub">
              * Kịch bản giả định: Thủ công {formatVND(craftPlannedRevenue)} (bán đủ {craftSummaryText}) + đồ ăn {formatVND(foodPlannedAssumption.value)} (mục tiêu giả định trong hồ sơ đề xuất, chưa phân bổ số lượng bán từng món; xem <a href="/minh-bach#doi-chieu-do-an" class="transparency-link">đối chiếu chi tiết tại trang Minh bạch</a>).
            </p>
          </div>

          <div class="transparency-col">
            <h3 class="col-title">Nguyên tắc quản trị tài chính</h3>
            <p>
              Tài trợ hiện vật được ghi nhận riêng biệt với tiền mặt. Dự án không tuyên bố "100% doanh thu mua quà" vì có chi phí vật tư và vận hành trong dự toán.
            </p>
            <p class="transparency-sub">
              Báo cáo sau đối soát, biên tập và được phép công bố sẽ được cập nhật sau khi hoàn thành.
            </p>
          </div>
        </div>

        <div class="transparency-actions">
          <a href="/minh-bach" class="btn btn-secondary">
            Xem dự toán chi tiết
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Sản phẩm gây quỹ dự kiến (3 sản phẩm + link đến 7 SKU) -->
  <section class="section section-products" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Gây quỹ dự kiến</span>
        <h2 id="products-heading">Sản phẩm gây quỹ dự kiến</h2>
        <p>
          Các sản phẩm lưu niệm thủ công và suất ăn được nhóm lên kế hoạch chuẩn bị nhằm gây quỹ mua quà tặng và vật phẩm thiết yếu theo danh mục xác nhận của Mái ấm.
        </p>
      </div>

      <div class="product-section-notice" role="note">
        <p><strong>Lưu ý:</strong> Trạng thái mở bán chưa được xác nhận. Bản xem trước chưa nhận đơn hoặc tiền qua website.</p>
      </div>

      <div class="products-grid">
        {
          featuredProducts.map(({ product }) => (
            <ProductCard
              product={product}
            />
          ))
        }
      </div>

      <div class="section-action-center">
        <a href="/san-pham" class="btn btn-secondary">
          Xem toàn bộ 7 sản phẩm gây quỹ
        </a>
        <p class="action-note">
          Mọi thông tin giá là số liệu tham khảo trong hồ sơ đề xuất dự án.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Hành trình dự kiến (4 giai đoạn) -->
  <section class="section section-soft section-stages" aria-labelledby="stages-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình triển khai</span>
        <h2 id="stages-heading">Hành trình dự kiến</h2>
        <p>
          Bốn giai đoạn kế hoạch được nhóm vạch ra để triển khai dự án từng bước bài bản, minh bạch và có trách nhiệm.
        </p>
      </div>

      <div class="stages-grid">
        {
          CAMPAIGN_PROJECT.plannedStages.map((stage) => (
            <StageCard stage={stage} />
          ))
        }
      </div>

      <div class="section-footer-note">
        <p>
          * Ghi chú: Các giai đoạn dự kiến, lịch thực hiện chờ xác nhận. Lộ trình kế hoạch không đánh dấu hoàn thành trước khi diễn ra thực tế.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Khối hai cột "Nhóm thực hiện và cách đồng hành" -->
  <section class="section section-group-support" aria-labelledby="group-support-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kết nối &amp; Hỗ trợ</span>
        <h2 id="group-support-heading">Nhóm thực hiện &amp; Cách đồng hành</h2>
        <p>
          Thông tin tóm tắt về đội ngũ thực hiện dự án và các phương thức đồng hành cùng Mái ấm.
        </p>
      </div>

      <div class="home-group-support-grid">
        <!-- Cột 1: Nhóm thực hiện -->
        <div class="group-support-card">
          <div class="badge-row">
            <span class="eyebrow">Nhóm dự án</span>
          </div>
          <h3>Về nhóm {TEAM_INFO.name}</h3>
          <p>
            {TEAM_INFO.description}
          </p>
          <p class="team-meta-text">
            Lớp {TEAM_INFO.classId} &bull; {TEAM_INFO.course} &bull; {TEAM_INFO.size} sinh viên
          </p>
          <p class="text-xs text-muted">
            Tên, hình ảnh và phân công chi tiết của 7 thành viên chờ được xác nhận và cho phép công bố.
          </p>
          <div class="group-support-actions">
            <a href="/ve-nhom" class="btn btn-secondary">
              Tìm hiểu thêm về nhóm
            </a>
          </div>
        </div>

        <!-- Cột 2: Cách đồng hành -->
        <div class="group-support-card">
          <div class="badge-row">
            <span class="eyebrow">Tham gia</span>
          </div>
          <h3>Đồng hành đúng nhu cầu</h3>
          <p>
            Dự án ưu tiên tiếp nhận sự hỗ trợ thiết thực, đúng nhu cầu thực tế của Mái ấm qua 3 phương thức: hỗ trợ vật tư thiết yếu, tìm hiểu sản phẩm gây quỹ và lan tỏa thông điệp an toàn.
          </p>
          <p class="text-xs text-muted">
            Kênh tiếp nhận và thông tin liên hệ chính thức đang chờ đối soát; bản xem trước chưa mở nhận đơn hoặc đóng góp trực tuyến.
          </p>
          <div class="group-support-actions">
            <a href="/dong-hanh" class="btn btn-primary">
              Cách đồng hành &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Quick Summary Strip - Dải 4 cột có đường ngăn, nền surface-alt */
  .section-summary {
    padding: var(--space-4) 0;
  }

  .quick-summary-strip {
    background-color: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
  }

  .summary-item {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-right: 1px solid var(--line);
  }

  .summary-item:last-child {
    border-right: none;
  }

  .summary-label {
    font-size: var(--font-size-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
  }

  .summary-text {
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.45;
  }

  .summary-chip-wrap {
    display: inline-flex;
    margin-top: 2px;
  }

  /* Activities Grid */
  .activities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .section-footer-note {
    margin-top: var(--space-8);
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .section-action-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    text-align: center;
  }

  .action-note {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    max-width: 500px;
  }

  /* Stages Grid */
  .stages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  /* Transparency Panel */
  .transparency-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .transparency-header {
    margin-bottom: var(--space-6);
  }

  .transparency-header .badge-row {
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .transparency-status {
    margin-top: var(--space-2);
    color: var(--brand);
    font-size: 1.125rem;
  }

  .transparency-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .col-title {
    font-size: 1.125rem;
    margin-bottom: var(--space-4);
    color: var(--ink);
  }

  .data-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
  }

  .data-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.9375rem;
  }

  .data-val-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .diff-negative,
  .diff-positive,
  .diff-neutral {
    color: var(--ink);
    font-weight: 700;
  }

  .transparency-sub {
    font-size: 0.875rem;
    color: var(--ink-2);
    margin-top: var(--space-3);
    line-height: 1.5;
  }

  .transparency-link {
    color: var(--brand);
    text-decoration: underline;
    font-weight: 600;
  }

  .transparency-link:hover {
    color: var(--ink);
  }

  .transparency-actions {
    display: flex;
  }

  /* Two Column Group & Support Section */
  .home-group-support-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .group-support-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
  }

  .group-support-card h3 {
    font-size: 1.375rem;
    color: var(--ink);
    margin: 0;
  }

  .group-support-card p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
  }

  .team-meta-text {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    font-weight: 500;
    margin: 0;
  }

  .group-support-actions {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  /* Responsive Adjustments */
  @media (max-width: 1023px) {
    .quick-summary-strip {
      grid-template-columns: 1fr 1fr;
    }

    .summary-item:nth-child(2) {
      border-right: none;
    }

    .summary-item:nth-child(1),
    .summary-item:nth-child(2) {
      border-bottom: 1px solid var(--line);
    }

    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stages-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .transparency-content {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .quick-summary-strip {
      grid-template-columns: 1fr;
    }

    .summary-item {
      border-right: none !important;
      border-bottom: 1px solid var(--line);
      padding: var(--space-3) var(--space-4);
    }

    .summary-item:last-child {
      border-bottom: none;
    }

    .activities-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .stages-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .home-group-support-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .group-support-card {
      padding: var(--space-4);
      gap: var(--space-2);
    }

    .data-list li {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .transparency-card {
      padding: var(--space-4);
    }

    .transparency-content {
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-4);
    }

    .section-footer-note {
      margin-top: var(--space-5);
    }

    .section-action-center {
      margin-top: var(--space-5);
    }
  }
</style>
