---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ActivityList from '../components/ActivityList.astro';
import StatusChip from '../components/StatusChip.astro';
import Icon from '../components/Icon.astro';
import GoalProgress from '../components/GoalProgress.astro';
import ProjectProgress from '../components/ProjectProgress.astro';
import { CAMPAIGN_PROJECT, TEAM_INFO, DONATION_ACCOUNT, DONATION_LEDGER, PLANNED_SESSIONS, TEAM_MEMBERS } from '../data/campaign';
import { summarizeLedger, formatViDate } from '../lib/donations';
import { formatVND } from '../lib/finance';

const donationSummary = summarizeLedger(DONATION_LEDGER, DONATION_ACCOUNT.goalAmount);
const sessionText = PLANNED_SESSIONS.map((s) => formatViDate(s.date).slice(0, 5)).join(' và ');

const steps = [
  {
    icon: 'moc-khoa' as const,
    title: 'Gây quỹ',
    text: `Mục tiêu ${formatVND(DONATION_ACCOUNT.goalAmount)} từ ủng hộ qua chuyển khoản, cùng quà lưu niệm do nhóm tự làm. Sao kê đăng sau khi đối soát.`,
  },
  {
    icon: 'chuon-chuon' as const,
    title: 'Một buổi chơi tại Mái ấm',
    text: 'Chiều Thứ Bảy 24/10, khoảng 180 phút với bốn góc hoạt động. Em nào cũng chọn được cách chơi phù hợp, hoặc ngồi xem, nghỉ ngơi.',
  },
  {
    icon: 'banh' as const,
    title: 'Trao quà đúng nhu cầu',
    text: 'Chiều Thứ Bảy 31/10, trao vật phẩm theo danh mục Mái ấm xác nhận, kèm hóa đơn và biên bản bàn giao.',
  },
];
---

<Layout
  title="Trang chủ"
  description="Mang Theo Một Nét Vẽ — Nhóm Lăng Kính tổ chức một buổi vui chơi sáng tạo cho các em tại Mái ấm Thánh Tâm và gây quỹ trao tặng cho các em nhỏ tại Mái ấm."
  currentPath="/"
>
  <Hero />

  <section class="facts" aria-label="Thông tin chính của dự án">
    <div class="container">
      <dl class="facts-strip">
        <div class="fact">
          <dt>Ai thực hiện</dt>
          <dd>Nhóm Lăng Kính</dd>
        </div>
        <div class="fact">
          <dt>Dành cho</dt>
          <dd>Các em và các cụ tại Mái ấm Thánh Tâm Xuy Xá</dd>
        </div>
        <div class="fact">
          <dt>Hai buổi tại Mái ấm</dt>
          <dd>14:00 Thứ Bảy, {sessionText}/2026</dd>
        </div>
        <div class="fact">
          <dt>Trạng thái</dt>
          <dd><StatusChip kind="da-xac-nhan" label={CAMPAIGN_PROJECT.statusNotice} /></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="what-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dự án làm gì</span>
        <h2 id="what-heading">Ba việc, một mục tiêu</h2>
        <p>Mang niềm vui đến cho các em bằng một buổi chơi vừa sức, và mang đến Mái ấm những món quà thật sự cần.</p>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class={`step lift step--${['sun', 'rose', 'mint'][i]}`}>
              <div class="step-top">
                <span class="step-icon"><Icon name={s.icon} size={30} /></span>
                <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-soft section-tight" aria-labelledby="progress-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Tiến độ</span>
        <h2 id="progress-heading">Dự án đang ở đâu</h2>
      </div>
      <div class="reveal"><ProjectProgress /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="play-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="play-heading">Bốn góc, mỗi em một cách chơi</h2>
        <p>Các em được tự chọn góc mình thích, đổi lượt hoặc nghỉ bất cứ lúc nào. Không ai phải làm sản phẩm giống nhau.</p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} />

      <div class="section-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="link-arrow">Xem chi tiết dự án <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="donate-band" aria-labelledby="donate-heading">
    <div class="container donate-band-inner reveal">
      <div class="donate-text">
        <span class="eyebrow eyebrow--light">Ủng hộ</span>
        <h2 id="donate-heading">Cùng góp một món quà</h2>
        <p>
          Mục tiêu {formatVND(DONATION_ACCOUNT.goalAmount)} cho buổi chơi và quà tặng. Chuyển khoản qua mã QR; mỗi khoản được đối chiếu với ngân hàng rồi đăng công khai trong sao kê.
        </p>
        <div class="donate-actions">
          <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
          <a href="/dong-hanh#sao-ke" class="link-arrow link-arrow--light">Xem sao kê <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="donate-stats">
        <GoalProgress summary={donationSummary} tone="dark" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="team-heading">
    <div class="container">
      <h2 id="team-heading" class="sr-only">Nhóm thực hiện và quà lưu niệm</h2>
      <div class="two-col">
        <div class="home-col">
          <span class="eyebrow">Nhóm thực hiện</span>
          <h3 class="block-title">Lăng Kính</h3>
          <p>Nhóm Lăng Kính phụ trách điều phối, tài chính, hậu cần, truyền thông, thiết kế và đối ngoại.</p>
          <ul class="mini-team" aria-label="Thành viên nhóm">
            {TEAM_MEMBERS.map((m) => (
              <li><img src={m.photo} alt={m.name} width="48" height="60" loading="lazy" decoding="async" /></li>
            ))}
          </ul>
          <a href="/ve-nhom" class="link-arrow">Về nhóm <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="home-col">
          <span class="eyebrow">Quà lưu niệm</span>
          <h3 class="block-title">Chuồn chuồn tre và móc khóa</h3>
          <p>Nhóm tự làm để gây quỹ. Các em ở Mái ấm không phải làm hàng; đồ các em làm được giữ lại cho các em.</p>
          <a href="/san-pham" class="link-arrow">Xem quà lưu niệm <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .facts {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  .facts-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .fact {
    padding: var(--space-5) var(--space-6);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:first-child {
    border-left: none;
    padding-left: 0;
  }

  .fact dt {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  /* Mũi tên nối giữa các bước (desktop) */
  @media (min-width: 1024px) {
    .step:not(:last-child)::after {
      content: "→" / "";
      position: absolute;
      top: 50%;
      right: -22px;
      width: 32px;
      height: 32px;
      margin-top: -16px;
      border-radius: 50%;
      background: var(--cta);
      color: var(--ink);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      box-shadow: 0 0 0 4px #ffffff;
    }
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step--sun .step-icon { background: var(--tint-sun); color: var(--tint-sun-ink); }
  .step--rose .step-icon { background: var(--tint-rose); color: var(--tint-rose-ink); }
  .step--mint .step-icon { background: var(--tint-mint); color: var(--tint-mint-ink); }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .step:hover .step-icon {
      animation: pop 480ms var(--ease-out) 1;
    }
  }

  @keyframes pop {
    40% { transform: scale(1.12) rotate(-6deg); }
    100% { transform: none; }
  }

  .step-num {
    font-size: var(--font-size-h2);
    line-height: 1;
    font-weight: 700;
    color: var(--line);
    font-variant-numeric: tabular-nums;
  }

  .step-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .step-text {
    margin: 0;
  }

  .donate-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(40% 80% at 100% 0%, rgba(247, 201, 72, 0.16), transparent 70%),
      radial-gradient(35% 70% at 0% 100%, rgba(138, 34, 52, 0.35), transparent 70%),
      var(--brand-ink);
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .donate-band-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: center;
  }

  .donate-text h2 {
    color: #ffffff;
    margin-bottom: var(--space-3);
  }

  .donate-text p {
    color: #c9d2dc;
    max-width: 56ch;
  }

  .eyebrow--light {
    color: #f7c948;
  }

  .donate-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
  }

  .link-arrow--light {
    color: #ffffff;
  }

  .donate-actions .link-arrow--light:focus-visible {
    outline-color: #ffffff;
  }

  .donate-stats {
    padding: var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }

  .mini-team {
    list-style: none;
    margin: var(--space-2) 0 var(--space-1);
    padding: 0;
    display: flex;
  }

  .mini-team li + li {
    margin-left: -10px;
  }

  .mini-team img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 50%;
    border: 3px solid #ffffff;
    box-shadow: var(--shadow-subtle);
    display: block;
  }

  .home-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .home-col p {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .step {
      display: grid;
      grid-template-columns: 60px minmax(0, 1fr);
      column-gap: var(--space-5);
      row-gap: var(--space-1);
      padding: var(--space-5);
    }

    .step-top {
      grid-row: span 2;
      align-self: start;
    }

    .step-num {
      display: none;
    }

    .donate-band-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .facts-strip {
      grid-template-columns: 1fr;
    }

    .fact,
    .fact:nth-child(3) {
      border-left: none;
      padding: var(--space-3) 0;
    }

    .fact + .fact {
      border-top: 1px solid var(--line);
    }

    .step {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: var(--space-4);
      padding: var(--space-4);
    }

    .step-icon {
      width: 48px;
      height: 48px;
    }

    .donate-actions .btn {
      width: 100%;
    }

    .donate-stats {
      padding: var(--space-4);
    }
  }
</style>
