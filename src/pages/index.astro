---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ActivityList from '../components/ActivityList.astro';
import KeyFigures from '../components/KeyFigures.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Timeline from '../components/Timeline.astro';
import StatusChip from '../components/StatusChip.astro';
import { CAMPAIGN_PROJECT, PRODUCTS, TEAM_INFO, PLANNED_EXPENSES, FINANCE_SCENARIOS } from '../data/campaign';
import {
  sumPlannedExpenses,
  calculateBaseRevenue,
  calculateScenario,
  formatVND,
  formatScenarioBalance,
} from '../lib/finance';

const totalPlannedExpense = sumPlannedExpenses(PLANNED_EXPENSES);
const totalPlannedRevenue = calculateBaseRevenue(PRODUCTS);
const baseScenario = FINANCE_SCENARIOS.find((s) => s.id === 'chua-tinh-tai-tro');
const baseResult = baseScenario ? calculateScenario(baseScenario, totalPlannedRevenue, totalPlannedExpense) : null;
const balance = formatScenarioBalance(baseResult);

const figures = [
  {
    label: 'Chi dự toán',
    value: formatVND(totalPlannedExpense),
    chip: 'ke-hoach' as const,
    note: 'Nguyên liệu, vật tư buổi chơi, quà và di chuyển.',
  },
  {
    label: 'Doanh thu nếu bán đủ',
    value: formatVND(totalPlannedRevenue),
    chip: 'gia-dinh' as const,
    note: 'Nếu bán hết theo giá tham khảo.',
  },
  {
    label: 'Còn lại trước khi mua quà',
    value: balance.text,
    chip: 'gia-dinh' as const,
    note: 'Dự kiến dành mua quà; chưa phải số tiền đã có.',
  },
];
---

<Layout
  title="Trang chủ"
  description="Mang Theo Một Nét Vẽ — dự án của nhóm Lăng Kính (AI2015, SSG105, Đại học FPT Hà Nội): một buổi chơi có lựa chọn tại Mái ấm Thánh Tâm Xuy Xá và gây quỹ mua quà đúng nhu cầu."
  currentPath="/"
>
  <Hero />

  <section class="facts" aria-label="Thông tin chính của dự án">
    <div class="container">
      <dl class="facts-strip">
        <div class="fact">
          <dt>Nhóm thực hiện</dt>
          <dd>Lăng Kính · {TEAM_INFO.size} sinh viên FPT Hà Nội</dd>
        </div>
        <div class="fact">
          <dt>Địa điểm dự kiến</dt>
          <dd>Mái ấm Thánh Tâm Xuy Xá, Hà Nội</dd>
        </div>
        <div class="fact">
          <dt>Thời gian</dt>
          <dd>Khoảng 5 tuần · 2 buổi tại Mái ấm</dd>
        </div>
        <div class="fact">
          <dt>Trạng thái</dt>
          <dd><StatusChip kind="cho-xac-nhan" label="Đề xuất, chờ xác nhận" /></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="play-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="play-heading">Mỗi em chọn cách tham gia của mình</h2>
        <p>
          Bốn góc hoạt động vừa sức. Các em có thể chơi, đổi góc, ngồi xem hoặc nghỉ bất cứ lúc nào.
        </p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} />

      <div class="section-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="link-arrow">Xem buổi chơi diễn ra thế nào <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="money-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Gây quỹ và minh bạch</span>
        <h2 id="money-heading">Mỗi món hàng góp vào một món quà</h2>
        <p>
          Nhóm bán đồ thủ công và đồ ăn tại FPT Hòa Lạc. Sau khi trừ chi phí, phần còn lại dùng mua vật phẩm theo đúng danh mục Mái ấm cần.
        </p>
      </div>

      <h3 class="block-title">Sản phẩm dự kiến</h3>
      <ProductGrid products={PRODUCTS.filter((p) => p.isBaseRevenueItem !== false)} variant="compact" headingLevel="h4" />

      <h3 class="block-title home-figures-title">Kế hoạch tài chính</h3>
      <KeyFigures figures={figures} label="Ba con số kế hoạch chính" />
      <p class="source-note">Đây là số kế hoạch. Chưa có thu chi thực tế; website chưa nhận đơn hàng hay tiền.</p>

      <div class="section-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch thu chi</a>
        <a href="/san-pham" class="link-arrow">Xem sản phẩm <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình</span>
        <h2 id="timeline-heading">Bốn chặng của dự án</h2>
        <p>Gây quỹ trước, buổi chơi sau; quà chỉ được mua khi đã chốt quỹ và đối chiếu danh mục với Mái ấm.</p>
      </div>

      <Timeline stages={CAMPAIGN_PROJECT.plannedStages} />

      <p class="source-note">Lịch cụ thể sẽ được công bố sau khi thống nhất với Mái ấm.</p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="team-support-heading">
    <div class="container">
      <h2 id="team-support-heading" class="sr-only">Nhóm thực hiện và cách đồng hành</h2>
      <div class="two-col">
        <div class="home-col">
          <span class="eyebrow">Nhóm thực hiện</span>
          <h3 class="block-title">Lăng Kính — 7 sinh viên FPT Hà Nội</h3>
          <p>
            Bảy sinh viên lớp {TEAM_INFO.classId}, chia năm mảng việc từ điều phối, tài chính, hậu cần đến truyền thông. Hai thành viên đối soát mọi khoản thu chi.
          </p>
          <a href="/ve-nhom" class="link-arrow">Về nhóm <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="home-col">
          <span class="eyebrow">Đồng hành</span>
          <h3 class="block-title">Hỗ trợ đúng thứ Mái ấm cần</h3>
          <p>
            Góp vật tư theo danh mục Mái ấm cần, mua sản phẩm khi mở bán, hoặc chia sẻ câu chuyện của dự án.
          </p>
          <a href="/dong-hanh" class="link-arrow">Cách đồng hành <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .facts {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #ffffff;
  }

  .facts-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .fact {
    padding: var(--space-5) var(--space-6);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:first-child {
    border-left: none;
    padding-left: 0;
  }

  .fact dt {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
  }

  .home-figures-title {
    margin-top: var(--space-12);
  }

  .home-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .home-col p {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 767px) {
    .facts-strip {
      grid-template-columns: 1fr;
    }

    .fact,
    .fact:nth-child(3) {
      border-left: none;
      padding: var(--space-3) 0;
    }

    .fact + .fact {
      border-top: 1px solid var(--line);
    }

    .home-figures-title {
      margin-top: var(--space-10);
    }
  }
</style>
