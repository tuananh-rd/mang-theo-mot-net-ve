---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ActivityList from '../components/ActivityList.astro';
import StatusChip from '../components/StatusChip.astro';
import Icon from '../components/Icon.astro';
import GoalProgress from '../components/GoalProgress.astro';
import ProjectProgress from '../components/ProjectProgress.astro';
import { CAMPAIGN_PROJECT, DONATION_ACCOUNT, DONATION_LEDGER, PLANNED_SESSIONS, TEAM_MEMBERS } from '../data/campaign';
import { summarizeLedger, formatViDate } from '../lib/donations';
import { formatVND } from '../lib/finance';

const donationSummary = summarizeLedger(DONATION_LEDGER, DONATION_ACCOUNT.goalAmount);
const sessionText = PLANNED_SESSIONS.map((s) => formatViDate(s.date).slice(0, 5)).join(' và ');

const steps = [
  {
    icon: 'moc-khoa' as const,
    title: 'Gây quỹ',
    text: `Mục tiêu ${formatVND(DONATION_ACCOUNT.goalAmount)} từ ủng hộ qua chuyển khoản (sao kê công bố sau đối soát); tiền bán quà lưu niệm gây quỹ được ghi sổ riêng.`,
  },
  {
    icon: 'chuon-chuon' as const,
    title: 'Một buổi chơi tại Mái ấm',
    text: 'Dự kiến chiều Thứ Bảy 24/10, khoảng 180 phút với bốn góc hoạt động. Mỗi em có thể lựa chọn cách tham gia phù hợp với sở thích và thể trạng, quan sát hoặc nghỉ ngơi.',
  },
  {
    icon: 'banh' as const,
    title: 'Trao quà đúng nhu cầu',
    text: 'Dự kiến chiều Thứ Bảy 31/10, trao tặng vật phẩm theo danh mục Mái ấm xác nhận, kèm hóa đơn và biên bản bàn giao.',
  },
];
---

<Layout
  title="Trang chủ"
  description="Mang Theo Một Nét Vẽ — Nhóm Lăng Kính tổ chức một buổi vui chơi sáng tạo cho các em tại Mái ấm Thánh Tâm và gây quỹ trao tặng cho các em nhỏ tại Mái ấm."
  currentPath="/"
>
  <Hero />

  <section class="facts" aria-label="Thông tin chính của dự án">
    <div class="container">
      <dl class="facts-strip facts-card">
        <div class="fact">
          <dt>Ai thực hiện</dt>
          <dd>Nhóm Lăng Kính</dd>
        </div>
        <div class="fact">
          <dt>Dành cho</dt>
          <dd>Các em nhỏ và người cao tuổi tại Mái ấm Thánh Tâm Xuy Xá</dd>
        </div>
        <div class="fact">
          <dt>Hai buổi tại Mái ấm (dự kiến)</dt>
          <dd>14:00 Thứ Bảy, {sessionText}/2026</dd>
        </div>
        <div class="fact">
          <dt>Trạng thái</dt>
          <dd><StatusChip kind="da-xac-nhan" label={CAMPAIGN_PROJECT.statusNotice} /></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section-what" aria-labelledby="what-heading">
    <div class="container what-grid">
      <div class="section-header what-header">
        <span class="eyebrow">Dự án làm gì</span>
        <h2 id="what-heading">Ba việc, một mục tiêu</h2>
        <p>Mang niềm vui đến cho các em bằng buổi chơi vừa sức, và gửi tặng Mái ấm những vật phẩm thiết thực theo danh mục Mái ấm xác nhận.</p>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class={`step step--${['sun', 'rose', 'mint'][i]}`}>
              <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-body">
                <h3 class="step-title">
                  <span class="step-icon"><Icon name={s.icon} size={24} /></span>
                  {s.title}
                </h3>
                <p class="step-text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-soft section-tight" aria-labelledby="progress-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Tiến độ</span>
        <h2 id="progress-heading">Tiến độ dự án</h2>
      </div>
      <div class="reveal"><ProjectProgress /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="play-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="play-heading">Bốn góc, mỗi em một cách chơi</h2>
        <p>Các em có thể tự do chọn góc hoạt động, đổi lượt, quan sát hoặc nghỉ ngơi; không giao chỉ tiêu hoàn thành sản phẩm.</p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} />

      <div class="section-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="link-arrow">Xem chi tiết dự án <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="donate-band" aria-labelledby="donate-heading">
    <div class="container donate-band-inner reveal">
      <div class="donate-text">
        <span class="eyebrow eyebrow--light">Ủng hộ</span>
        <h2 id="donate-heading">Cùng góp một món quà</h2>
        <p>
          Mục tiêu {formatVND(DONATION_ACCOUNT.goalAmount)} từ nguồn ủng hộ chuyển khoản cho buổi chơi và quà tặng. Mỗi khoản được đối soát với sao kê ngân hàng rồi công bố minh bạch trên website.
        </p>
        <div class="donate-actions">
          <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
          <a href="/dong-hanh#sao-ke" class="link-arrow link-arrow--light">Xem sao kê <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="donate-stats">
        <GoalProgress summary={donationSummary} tone="dark" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gift-heading">
    <div class="container editorial-split">
      <figure class="split-figure reveal">
        <img
          src="/images/san-pham/chuon-chuon-tre.webp"
          alt="Những chú chuồn chuồn tre sơn nhiều màu đặt trên khay mây, có chân đế"
          width="1117"
          height="541"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Ảnh chuồn chuồn tre do nhóm cung cấp để tham khảo; mẫu thực tế có thể khác.</figcaption>
      </figure>
      <div class="split-text">
        <span class="eyebrow">Quà lưu niệm</span>
        <h2 id="gift-heading" class="split-title">Chuồn chuồn tre và móc khóa</h2>
        <p>Sản phẩm gây quỹ do nhóm tự làm. Hoạt động tại Mái ấm hoàn toàn là vui chơi sáng tạo; các em giữ lại sản phẩm do mình làm ra.</p>
        <a href="/san-pham" class="link-arrow">Xem quà lưu niệm <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="team-heading">
    <div class="container team-row">
      <div class="team-text">
        <span class="eyebrow">Nhóm thực hiện</span>
        <h2 id="team-heading" class="split-title">Lăng Kính</h2>
        <p>Nhóm Lăng Kính phụ trách điều phối, tài chính, hậu cần, truyền thông, thiết kế và đối ngoại.</p>
        <a href="/ve-nhom" class="link-arrow">Về nhóm <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="mini-team reveal" aria-label="Thành viên nhóm">
        {TEAM_MEMBERS.map((m) => (
          <li><img src={m.photo} alt={m.name} width="96" height="120" loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* Khối thông tin chính: trên desktop nổi chồng lên đáy hero */
  .facts {
    position: relative;
    z-index: 2;
    background: #ffffff;
  }

  .facts-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .facts-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
  }

  @media (min-width: 1024px) {
    .facts {
      background: transparent;
    }

    .facts .container {
      margin-top: -64px;
    }
  }

  .fact {
    padding: var(--space-6);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:first-child {
    border-left: none;
  }

  .fact dt {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  /* Ba việc: bố cục editorial, tiêu đề trái và danh sách đánh số lớn bên phải */
  .what-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: start;
  }

  .what-header {
    margin-bottom: 0;
  }

  .what-header p {
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .step {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
  }

  .step:last-child {
    border-bottom: 1px solid var(--line);
  }

  .step-num {
    font-size: 4rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .step-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  .step-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step--sun .step-icon { background: var(--tint-sun); color: var(--tint-sun-ink); }
  .step--rose .step-icon { background: var(--tint-rose); color: var(--tint-rose-ink); }
  .step--mint .step-icon { background: var(--tint-mint); color: var(--tint-mint-ink); }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .step:hover .step-icon {
      animation: pop 480ms var(--ease-out) 1;
    }
  }

  @keyframes pop {
    40% { transform: scale(1.12) rotate(-6deg); }
    100% { transform: none; }
  }

  .step-text {
    margin: 0;
    max-width: 60ch;
  }

  .donate-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--brand-ink);
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .donate-band-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: center;
  }

  .donate-text h2 {
    color: var(--on-dark);
    margin-bottom: var(--space-3);
  }

  .donate-text p {
    color: var(--on-dark-2);
    max-width: 56ch;
  }

  .eyebrow--light {
    color: var(--cta);
  }

  .donate-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
  }

  .link-arrow--light {
    color: var(--on-dark);
  }

  .donate-actions .link-arrow--light:focus-visible {
    outline-color: var(--on-dark);
  }

  .donate-stats {
    padding: var(--space-6);
    border: 1px solid var(--on-dark-line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Quà lưu niệm: ảnh lớn bên trái, chữ bên phải */
  .editorial-split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
  }

  .split-figure {
    margin: 0;
  }

  .split-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }

  .split-figure figcaption {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }

  .split-text,
  .team-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .split-text p,
  .team-text p {
    margin: 0;
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
  }

  .split-title {
    margin: 0;
  }

  .team-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: center;
  }

  .mini-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .mini-team li:nth-child(even) {
    margin-top: var(--space-8);
  }

  .mini-team img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-md);
    display: block;
  }

  @media (max-width: 1023px) {
    .facts {
      padding-top: var(--space-6);
    }

    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact:nth-child(3) {
      border-left: none;
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .what-grid,
    .editorial-split,
    .team-row {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .donate-band-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .facts-strip {
      grid-template-columns: 1fr;
    }

    .fact,
    .fact:nth-child(3) {
      border-left: none;
      padding: var(--space-3) var(--space-4);
    }

    .fact + .fact {
      border-top: 1px solid var(--line);
    }

    .step {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-6) 0;
    }

    .step-num {
      font-size: 2.5rem;
    }

    .step-title {
      font-size: 1.25rem;
    }

    .step-icon {
      width: 36px;
      height: 36px;
    }

    .what-header p,
    .split-text p,
    .team-text p {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .split-figure img {
      border-radius: var(--radius-lg);
    }

    .mini-team {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mini-team li:nth-child(even) {
      margin-top: 0;
    }

    .donate-actions .btn {
      width: 100%;
    }

    .donate-stats {
      padding: var(--space-4);
    }
  }
</style>
