---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatusChip from '../components/StatusChip.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import GoalProgress from '../components/GoalProgress.astro';
import { CAMPAIGN_PROJECT, DONATION_ACCOUNT, DONATION_LEDGER, PLANNED_SESSIONS, TEAM_MEMBERS, PROJECT_PROGRESS } from '../data/campaign';
import { getPublishedJournalEntries } from '../data/journal';
import { summarizeLedger, formatViDate } from '../lib/donations';
import { formatVND } from '../lib/finance';

const donationSummary = summarizeLedger(DONATION_LEDGER, DONATION_ACCOUNT.goalAmount);
const sessionText = PLANNED_SESSIONS.map((s) => formatViDate(s.date).slice(0, 5)).join(' và ');
const recentJournalEntries = getPublishedJournalEntries().slice(0, 2);

const tintFor: Record<string, string> = {
  'chuon-chuon-tre': 'sun',
  'to-tuong': 'rose',
  'hat-cung-nhau': 'sky',
  'tro-choi-nhe': 'mint',
};

const iconFor: Record<string, IconName> = {
  'chuon-chuon-tre': 'chuon-chuon',
  'to-tuong': 'to-tuong',
  'hat-cung-nhau': 'hat',
  'tro-choi-nhe': 'tro-choi',
};

const steps = [
  {
    icon: 'moc-khoa' as const,
    title: 'Gây quỹ',
    text: `Mục tiêu ${formatVND(DONATION_ACCOUNT.goalAmount)} từ ủng hộ qua chuyển khoản (sao kê công bố sau đối soát); tiền bán quà lưu niệm gây quỹ được ghi sổ riêng.`,
  },
  {
    icon: 'chuon-chuon' as const,
    title: 'Một buổi chơi tại Mái ấm',
    text: 'Dự kiến chiều Thứ Bảy 24/10, khoảng 180 phút với bốn góc hoạt động. Mỗi em có thể lựa chọn cách tham gia phù hợp với sở thích và thể trạng, quan sát hoặc nghỉ ngơi.',
  },
  {
    icon: 'banh' as const,
    title: 'Trao quà đúng nhu cầu',
    text: 'Dự kiến chiều Thứ Bảy 31/10, trao tặng vật phẩm theo danh mục Mái ấm xác nhận, kèm hóa đơn và biên bản bàn giao.',
  },
];
---

<Layout
  title="Trang chủ"
  description="Mang Theo Một Nét Vẽ — Nhóm Lăng Kính tổ chức một buổi vui chơi sáng tạo cho các em tại Mái ấm Thánh Tâm và gây quỹ trao tặng cho các em nhỏ tại Mái ấm."
  currentPath="/"
>
  <Hero />

  <section class="facts" aria-label="Thông tin chính của dự án">
    <div class="container">
      <dl class="facts-strip facts-card">
        <div class="fact">
          <dt>Ai thực hiện</dt>
          <dd>Nhóm Lăng Kính</dd>
        </div>
        <div class="fact">
          <dt>Dành cho</dt>
          <dd>Các em nhỏ & người cao tuổi tại Mái ấm</dd>
        </div>
        <div class="fact">
          <dt>Hai buổi tại Mái ấm</dt>
          <dd>14:00 Thứ Bảy, {sessionText}/2026 (dự kiến)</dd>
        </div>
        <div class="fact">
          <dt>Trạng thái</dt>
          <dd><StatusChip kind="da-xac-nhan" label={CAMPAIGN_PROJECT.statusNotice} /></dd>
        </div>
        <div class="fact">
          <dt>Tiến độ</dt>
          <dd>Tuần {PROJECT_PROGRESS.currentWeek}/{PROJECT_PROGRESS.totalWeeks} (kế hoạch 5 tuần)</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section-what" aria-labelledby="what-heading">
    <div class="container">
      <div class="section-header what-header">
        <span class="eyebrow">Dự án làm gì</span>
        <h2 id="what-heading">Ba việc, một mục tiêu</h2>
        <p>Mang niềm vui đến cho các em bằng buổi chơi vừa sức, và gửi tặng Mái ấm những vật phẩm thiết thực theo danh mục Mái ấm xác nhận.</p>
      </div>

      <ol class="stepline">
        {
          steps.map((s, i) => (
            <li>
              <span class="stepline-num" aria-hidden="true">{i + 1}</span>
              <h3 class="stepline-title">{s.title}</h3>
              <p class="stepline-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Kế hoạch trong một cái nhìn: dải xanh ngọc phẳng; chỉ dùng số liệu kế hoạch đã có -->
  <section class="section band section-tight" aria-labelledby="plan-glance-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kế hoạch</span>
        <h2 id="plan-glance-heading">Kế hoạch trong một cái nhìn</h2>
      </div>
      <ul class="stat-grid">
        <li class="stat">
          <span class="stat-num">{formatVND(DONATION_ACCOUNT.goalAmount)}</span>
          <p class="stat-label">Mục tiêu ủng hộ</p>
          <p class="stat-note">Qua chuyển khoản, sao kê công bố sau đối soát</p>
        </li>
        <li class="stat">
          <span class="stat-num">{PLANNED_SESSIONS.length}</span>
          <p class="stat-label">Buổi tại Mái ấm</p>
          <p class="stat-note">Dự kiến {sessionText}/2026</p>
        </li>
        <li class="stat">
          <span class="stat-num">{CAMPAIGN_PROJECT.activities.length}</span>
          <p class="stat-label">Góc hoạt động</p>
          <p class="stat-note">Mỗi em được chọn, đổi lượt, quan sát hoặc nghỉ</p>
        </li>
        <li class="stat">
          <span class="stat-num">{TEAM_MEMBERS.length}</span>
          <p class="stat-label">Sinh viên Lăng Kính</p>
          <p class="stat-note">Lớp AI2015, Đại học FPT Hà Nội</p>
        </li>
      </ul>
      <p class="band-note">Đây là số liệu kế hoạch, chưa phải kết quả đã đạt.</p>
    </div>
  </section>

  <!-- Bốn góc: Dải 4 ô ngang gọn gàng (Kiểu A Áp phích) -->
  <section class="section section-corners-strip" aria-labelledby="play-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="play-heading">Bốn góc, mỗi em một cách chơi</h2>
        <p>Các em có thể tự do chọn góc hoạt động, đổi lượt, quan sát hoặc nghỉ ngơi; không giao chỉ tiêu hoàn thành sản phẩm.</p>
      </div>

      <div class="corners-strip">
        {CAMPAIGN_PROJECT.activities.map((a) => (
          <div class={`corner-strip-item tint-${tintFor[a.id] ?? 'sun'}`}>
            <span class="corner-strip-icon">
              <Icon name={iconFor[a.id] ?? 'chuon-chuon'} size={24} />
            </span>
            <div class="corner-strip-text">
              <span class="corner-strip-badge">{a.badge}</span>
              <h3 class="corner-strip-title">{a.title}</h3>
              <p class="corner-strip-desc">{a.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="section-actions">
        <a href="/du-an/mang-theo-mot-net-ve#corners-heading" class="link-arrow">Xem chi tiết kế hoạch bốn góc chơi <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Dải ủng hộ tối (Poster style) -->
  <section class="donate-band" aria-labelledby="donate-heading">
    <div class="container donate-band-inner reveal">
      <div class="donate-text">
        <span class="eyebrow eyebrow--light">Ủng hộ</span>
        <h2 id="donate-heading">Cùng góp một món quà</h2>
        <p>
          Mục tiêu {formatVND(DONATION_ACCOUNT.goalAmount)} từ nguồn ủng hộ chuyển khoản cho buổi chơi và quà tặng. Mỗi khoản được đối soát với sao kê ngân hàng rồi công bố minh bạch trên website.
        </p>
        <div class="donate-actions">
          <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
          <a href="/dong-hanh#sao-ke" class="link-arrow link-arrow--light">Xem sao kê <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="donate-stats">
        <GoalProgress summary={donationSummary} tone="dark" />
      </div>
    </div>
  </section>

  <!-- Quà lưu niệm + Mới trên nhật ký: Gộp lưới 12 cột 7/5 -->
  <section class="section section-craft-journal" aria-labelledby="gift-heading">
    <div class="container craft-journal-grid">
      <!-- Cột Trái 7: Quà lưu niệm gây quỹ -->
      <div class="craft-col">
        <figure class="split-figure">
          <div class="split-img-wrap">
            <img
              src="/images/san-pham/chuon-chuon-tre.webp"
              alt="Những chú chuồn chuồn tre sơn nhiều màu đặt trên khay mây, có chân đế"
              width="1117"
              height="541"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>Ảnh chuồn chuồn tre do nhóm cung cấp để tham khảo; mẫu thực tế có thể khác.</figcaption>
        </figure>
        <div class="craft-text">
          <span class="eyebrow">Quà lưu niệm gây quỹ</span>
          <h2 id="gift-heading" class="split-title">Chuồn chuồn tre và móc khóa</h2>
          <p>Sản phẩm gây quỹ do nhóm tự làm. Hoạt động tại Mái ấm hoàn toàn là vui chơi sáng tạo; các em giữ lại toàn bộ sản phẩm do mình làm ra.</p>
          <a href="/san-pham" class="link-arrow">Xem quà lưu niệm <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <!-- Cột Phải 5: Mới trên nhật ký -->
      <div class="journal-col" aria-labelledby="journal-home-heading">
        <div class="journal-col-head">
          <span class="eyebrow">Cập nhật mới</span>
          <h2 id="journal-home-heading" class="journal-col-title">Nhật ký dự án</h2>
          <p class="journal-col-lead">Ghi chép hành trình chuẩn bị buổi chơi và kế hoạch gây quỹ.</p>
        </div>

        {recentJournalEntries.length > 0 && (
          <ul class="journal-col-list">
            {recentJournalEntries.map((entry) => (
              <li class="journal-col-item">
                <div class="journal-col-meta">
                  <span class={`journal-tag tag-${entry.category}`}>{entry.categoryLabel}</span>
                  <time datetime={entry.publishedAt}>{entry.publishedAt.split('-').reverse().join('/')}</time>
                </div>
                <h3 class="journal-col-item-title">
                  <a href={`/nhat-ky/${entry.slug}`}>{entry.title}</a>
                </h3>
                <p class="journal-col-item-summary">{entry.summary}</p>
                <a href={`/nhat-ky/${entry.slug}`} class="link-arrow">
                  Đọc chi tiết <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        <div class="journal-col-actions">
          <a href="/nhat-ky" class="btn btn-secondary">Xem tất cả bài viết nhật ký →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Nhóm Lăng Kính -->
  <section class="section section-soft" aria-labelledby="team-heading">
    <div class="container team-row">
      <div class="team-text">
        <span class="eyebrow">Nhóm thực hiện</span>
        <h2 id="team-heading" class="split-title">Lăng Kính</h2>
        <p>Nhóm Lăng Kính gồm bảy sinh viên Đại học FPT Hà Nội phụ trách điều phối, tài chính, hậu cần, truyền thông, thiết kế và đối ngoại.</p>
        <a href="/ve-nhom" class="link-arrow">Về nhóm Lăng Kính <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="mini-team reveal" aria-label="Thành viên nhóm">
        {TEAM_MEMBERS.map((m) => (
          <li><img src={m.photo} alt={m.name} width="96" height="120" loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* Khối thông tin chính: trên desktop nổi chồng lên đáy hero */
  .facts {
    position: relative;
    z-index: 2;
    background: #ffffff;
  }

  .facts-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
  }

  .facts-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
  }

  @media (min-width: 1024px) {
    .facts {
      background: transparent;
    }

    .facts .container {
      margin-top: -64px;
    }
  }

  .fact {
    padding: var(--space-5);
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:first-child {
    border-left: none;
  }

  .fact dt {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.4;
  }


  /* Bốn góc: Dải ngang */
  .corners-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .corner-strip-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface-alt);
    transition: transform var(--transition-fast);
  }

  .corner-strip-item:hover {
    transform: translateY(-2px);
  }

  .corner-strip-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: #ffffff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand);
  }

  .corner-strip-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .corner-strip-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--brand);
    letter-spacing: 0.05em;
  }

  .corner-strip-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .corner-strip-desc {
    font-size: var(--font-size-small);
    line-height: 1.4;
    color: var(--ink-2);
    margin: 0;
  }

  /* Dải Ủng hộ tối */
  .donate-band {
    background-color: var(--brand-ink);
    color: var(--on-dark);
    padding: var(--space-18) 0;
  }

  .donate-band-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
  }

  .donate-text h2 {
    color: var(--on-dark);
    margin-bottom: var(--space-3);
  }

  .donate-text p {
    color: var(--on-dark-2);
    max-width: 56ch;
  }

  .eyebrow--light {
    color: var(--cta);
  }

  .donate-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
  }

  .link-arrow--light {
    color: var(--on-dark);
  }

  .donate-actions .link-arrow--light:focus-visible {
    outline-color: var(--on-dark);
  }

  .donate-stats {
    padding: var(--space-6);
    border: 1px solid var(--on-dark-line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Quà + Nhật ký (12 cột: 7/5) */
  .section-craft-journal {
    padding-top: var(--space-14);
    padding-bottom: var(--space-14);
  }

  .craft-journal-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: start;
  }

  .craft-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .split-figure {
    margin: 0;
  }

  .split-img-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-soft);
  }

  .split-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .split-figure figcaption {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--font-size-small);
  }

  .craft-text,
  .team-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .craft-text p,
  .team-text p {
    margin: 0;
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
    color: var(--ink-2);
  }

  .split-title {
    margin: 0;
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: 800;
    color: var(--ink);
  }

  /* Journal Column */
  .journal-col {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .journal-col-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .journal-col-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }

  .journal-col-lead {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
  }

  .journal-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .journal-col-item {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .journal-col-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .journal-col-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .journal-tag {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--status-plan-bg);
    color: var(--status-plan-text);
  }

  .journal-col-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
  }

  .journal-col-item-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .journal-col-item-title a:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .journal-col-item-summary {
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }

  .journal-col-actions {
    margin-top: var(--space-2);
  }

  /* Team Row */
  .team-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: center;
  }

  .mini-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .mini-team li:nth-child(even) {
    margin-top: var(--space-8);
  }

  .mini-team img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-md);
    display: block;
  }

  /* Responsive Stacking */
  @media (max-width: 1023px) {
    .facts {
      padding-top: var(--space-6);
    }

    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact:nth-child(even) {
      border-left: 1px solid var(--line);
    }

    .fact:nth-child(odd) {
      border-left: none;
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .craft-journal-grid,
    .team-row {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .corners-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .donate-band-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .facts-strip {
      grid-template-columns: 1fr;
