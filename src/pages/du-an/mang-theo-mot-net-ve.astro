---
import Layout from '../../layouts/Layout.astro';
import PlaceholderIllustration from '../../components/PlaceholderIllustration.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import StageCard from '../../components/StageCard.astro';
import { CAMPAIGN_PROJECT } from '../../data/campaign';

const activityIllustrationTypes = ['chuon-chuon', 'to-tuong', 'hat', 'tro-choi'] as const;
---

<Layout
  title="Câu chuyện dự án"
  description="Câu chuyện đề xuất, các góc hoạt động vui chơi có lựa chọn và 4 giai đoạn dự kiến tại Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/du-an/mang-theo-mot-net-ve"
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Dự án</span>
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="project-hero" aria-labelledby="project-heading">
    <div class="container">
      <div class="project-hero-grid">
        <div class="project-hero-content">
          <div class="badge-row">
            <span class="status-badge">Bản xem trước — nội dung đề xuất</span>
          </div>

          <h1 id="project-heading" class="project-title">
            {CAMPAIGN_PROJECT.title}
          </h1>

          <p class="project-slogan">
            {CAMPAIGN_PROJECT.slogan}
          </p>

          <p class="project-intro">
            {CAMPAIGN_PROJECT.summary}
          </p>

          <div class="project-meta-box">
            <p class="meta-item">
              <strong>Địa điểm dự kiến:</strong> {CAMPAIGN_PROJECT.location}
            </p>
            <p class="meta-item">
              <strong>Trạng thái thực tế:</strong> {CAMPAIGN_PROJECT.statusNotice}
            </p>
          </div>

          <div class="project-hero-actions">
            <a href="/san-pham" class="btn btn-primary">
              Xem sản phẩm gây quỹ
            </a>
            <a href="#buoi-choi" class="btn btn-secondary">
              Xem các góc hoạt động
            </a>
          </div>
        </div>

        <div class="project-hero-visual">
          <PlaceholderIllustration
            type="hero"
            ratio="4:3"
            caption="Minh họa cho bản xem trước — chưa phải ảnh hoạt động"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Câu chuyện từ đề xuất -->
  <section class="section section-story" aria-labelledby="story-heading">
    <div class="container">
      <div class="story-wrapper">
        <div class="section-header">
          <span class="section-kicker">Kế hoạch dự kiến</span>
          <h2 id="story-heading">Câu chuyện từ đề xuất</h2>
        </div>

        <div class="story-prose">
          <p>
            Trong đề xuất ban đầu, sau khi lắng nghe những góp ý từ người chăm sóc tại Mái ấm Thánh Tâm Xuy Xá, nhóm Lăng Kính dự kiến điều chỉnh các hoạt động để tạo ra một không gian có nhiều góc vui chơi khác nhau. Mục tiêu là giúp mỗi em nhỏ và người tham gia đều có quyền tự do lựa chọn cách trải nghiệm phù hợp nhất với thể trạng, tâm trạng và sở thích riêng.
          </p>
          <p>
            Tại các góc chơi, người tham gia có thể thỏa sức chọn màu vẽ, tô tượng, hòa giọng ca hát, lăn bóng nhẹ nhàng hoặc chỉ đơn giản là ngồi quan sát và nghỉ ngơi trong sự tôn trọng. Song song đó, các thành viên nhóm chịu trách nhiệm chuẩn bị họa cụ an toàn, trực tiếp hoàn thiện các sản phẩm lưu niệm gây quỹ và bảo đảm quá trình đối soát nguồn lực diễn ra minh bạch, rõ ràng.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Buổi chơi có lựa chọn -->
  <section id="buoi-choi" class="section section-soft" aria-labelledby="activities-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Không gian trải nghiệm</span>
        <h2 id="activities-heading">Buổi chơi có nhiều lựa chọn</h2>
        <p class="section-lead">
          Không gian hoạt động tôn trọng quyền tham gia, quan sát hoặc nghỉ ngơi của từng người; không đặt chỉ tiêu sản xuất hay áp lực biểu diễn.
        </p>
      </div>

      <div class="activities-grid">
        {
          CAMPAIGN_PROJECT.activities.map((activity, index) => (
            <ActivityCard
              activity={activity}
              illustrationType={activityIllustrationTypes[index]}
            />
          ))
        }
      </div>

      <div class="section-footer-note">
        <p>
          Lưu ý: Hoạt động tô tượng là trải nghiệm vui chơi tại chỗ cho các em, không phải hàng hoá mang đi bán gây quỹ.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Hành trình dự kiến -->
  <section class="section section-stages" aria-labelledby="stages-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Lộ trình 4 giai đoạn</span>
        <h2 id="stages-heading">Hành trình dự kiến của dự án</h2>
        <p class="section-lead">
          Đề xuất dự kiến 4 tuần, với 2 buổi tại Mái ấm; lịch cụ thể chờ xác nhận.
        </p>
      </div>

      <div class="stages-grid">
        {
          CAMPAIGN_PROJECT.plannedStages.map((stage) => (
            <StageCard stage={stage} />
          ))
        }
      </div>

      <div class="timeline-note-box">
        <p class="timeline-note-text">
          Quy trình trao tặng và lịch trình cụ thể phụ thuộc vào sự thống nhất chính thức với đại diện Mái ấm; đề xuất dự kiến theo dõi phản hồi 7–10 ngày sau bàn giao hiện vật và không tự ý ấn định ngày tháng hay đánh dấu hoàn thành trước khi được kiểm chứng.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Nguồn lực và minh bạch -->
  <section class="section section-soft" aria-labelledby="resources-heading">
    <div class="container">
      <div class="resources-layout">
        <div class="resources-content">
          <span class="section-kicker">Quản lý nguồn quỹ</span>
          <h2 id="resources-heading">Nguồn lực và nguyên tắc minh bạch</h2>
          <p class="resources-desc">
            Theo đề xuất, nhóm sinh viên phụ trách chuẩn bị vật tư cho buổi chơi, hoàn thiện móc khóa lưu niệm, chuồn chuồn tre mộc và chuẩn bị phương án ẩm thực gây quỹ theo kế hoạch; nguồn gốc trang trí chuồn chuồn tre chờ xác nhận. Kế hoạch dự kiến tách bạch chi phí trải nghiệm với nguồn thu bán hàng; tiền và hiện vật hỗ trợ sẽ được lưu trữ chứng từ và đối soát cẩn trọng trước khi công bố.
          </p>
          <div class="resources-actions">
            <a href="/minh-bach" class="btn btn-secondary">
              Xem nguyên tắc minh bạch thu chi
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Cập nhật và kết quả -->
  <section class="section section-updates" aria-labelledby="updates-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-kicker">Báo cáo thực tế</span>
        <h2 id="updates-heading">Cập nhật và kết quả</h2>
      </div>

      <div class="empty-state-card card">
        <div class="empty-badge">
          <span class="status-badge">Chờ xác nhận</span>
        </div>
        <h3 class="empty-title">
          Chưa có cập nhật thực tế được xác nhận. Kết quả và báo cáo sẽ được công bố sau khi đối soát và được phép.
        </h3>
        <p class="empty-desc">
          Kế hoạch, lịch trình chi tiết và báo cáo hoạt động sẽ được cập nhật sau khi hoàn tất đối soát và được phép công bố.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb-bar {
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: var(--space-2) 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
  }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Hero */
  .project-hero {
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
    background-color: var(--color-canvas);
  }

  .project-hero-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-12);
    align-items: center;
  }

  .project-hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .badge-row {
    margin-bottom: var(--space-1);
  }

  .project-title {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .project-slogan {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-accent);
    text-wrap: balance;
  }

  .project-intro {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
  }

  .project-meta-box {
    background-color: var(--color-canvas-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-item {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .project-hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .project-hero-visual {
    width: 100%;
  }

  /* Section Story */
  .story-wrapper {
    max-width: 760px;
    margin: 0 auto;
  }

  .section-kicker {
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .section-lead {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .story-prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* Activities */
  .activities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .section-footer-note {
    margin-top: var(--space-8);
  }

  .section-footer-note p {
    font-size: var(--font-size-sm) !important;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Stages */
  .stages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .timeline-note-box {
    margin-top: var(--space-6);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }

  .timeline-note-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--line-height-sm);
  }

  /* Resources */
  .resources-layout {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .resources-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .resources-desc {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  .resources-actions {
    margin-top: var(--space-3);
  }

  /* Empty state */
  .empty-state-card {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface-card);
  }

  .empty-title {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    max-width: 60ch;
  }

  .empty-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: 55ch;
    line-height: var(--line-height-sm);
    margin: 0;
  }

  /* Responsive */
  @media (min-width: 768px) and (max-width: 1023px) {
    .project-hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .project-hero-visual {
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .project-hero {
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
    }

    .project-hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .project-hero-visual {
      order: -1;
      max-width: 100%;
    }

    .project-hero-visual :global(.illustration-wrapper .svg-container) {
      height: 150px;
      max-height: 150px !important;
      aspect-ratio: auto !important;
    }

    .project-hero-content {
      gap: var(--space-2);
    }

    .project-title {
      font-size: 2rem;
      line-height: 1.15;
    }

    .project-slogan {
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .project-intro {
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .project-hero-actions {
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .project-hero-actions .btn {
      width: 100%;
    }

    .activities-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .stages-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .empty-state-card {
      padding: var(--space-5);
    }
  }
</style>
