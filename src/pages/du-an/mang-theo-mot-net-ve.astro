---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ActivityList from '../../components/ActivityList.astro';
import Timeline from '../../components/Timeline.astro';
import ProjectProgress from '../../components/ProjectProgress.astro';
import { CAMPAIGN_PROJECT, PROJECT_NEEDS, SAFETY_PRACTICES, PLAY_FLOW, PLANNED_SESSIONS, PROJECT_PROGRESS } from '../../data/campaign';
import { formatViDate } from '../../lib/donations';

const sessionLine = (id: string) => {
  const s = PLANNED_SESSIONS.find((x) => x.id === id);
  return s ? `${s.time} ${s.weekday} ${formatViDate(s.date)} (dự kiến)` : 'Chưa cập nhật';
};

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Dự án' }];

const summaryItems = [
  { label: 'Địa điểm', value: 'Mái ấm Thánh Tâm Xuy Xá, Mỹ Đức, Hà Nội' },
  { label: 'Người tham gia', value: 'Các em nhỏ và người cao tuổi tại Mái ấm' },
  { label: 'Buổi chơi (khoảng 180 phút)', value: sessionLine('buoi-choi') },
  { label: 'Trao quà (30–45 phút)', value: sessionLine('trao-qua') },
  {
    label: 'Tiến độ',
    value: `Tuần ${PROJECT_PROGRESS.currentWeek} trong khoảng ${PROJECT_PROGRESS.totalWeeks} tuần`,
    chip: { kind: 'da-xac-nhan' as const, label: 'Đang triển khai' },
  },
];
---

<Layout
  title="Dự án"
  description="Mang Theo Một Nét Vẽ: một buổi chơi có lựa chọn tại Mái ấm Thánh Tâm Xuy Xá — bốn góc hoạt động, an toàn và lộ trình của dự án."
  currentPath="/du-an/mang-theo-mot-net-ve"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Dự án"
    chip={{ kind: 'da-xac-nhan', label: CAMPAIGN_PROJECT.statusNotice }}
    title="Một buổi chơi có lựa chọn"
    titleId="project-heading"
    lead={CAMPAIGN_PROJECT.slogan}
    description="Một buổi vui chơi sáng tạo tại Mái ấm, tạo điều kiện để mỗi em nhỏ tham gia phù hợp với sở thích và thể trạng, cùng hoạt động gây quỹ trao tặng vật phẩm thiết thực theo danh mục Mái ấm cần."
    summaryTitle="Thông tin chính"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Vì sao</span>
        <h2 id="why-heading">Không phải em nào cũng chơi theo một cách</h2>
        <p>
          Các em ở Mái ấm có độ tuổi, khả năng vận động và giao tiếp khác nhau, nên một hoạt động chung khó phù hợp với tất cả. Nhóm xây dựng kế hoạch dự án dựa trên ba định hướng chính.
        </p>
      </div>

      <ol class="needs">
        {
          PROJECT_NEEDS.map((n, i) => (
            <li class="need lift">
              <span class="need-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="need-title">{n.title}</h3>
              <p class="need-desc">{n.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="home-heading">
    <div class="container">
      <div class="shelter">
        <div class="shelter-text reveal">
          <span class="eyebrow">Nơi dự án đến</span>
          <h2 id="home-heading" class="col-title">Mái ấm Thánh Tâm Xuy Xá</h2>
          <p>
            Mái ấm ở Mỹ Đức, Hà Nội, chăm sóc các em nhỏ ở nhiều độ tuổi cùng người cao tuổi. Mọi kế hoạch về thời gian, nội dung hoạt động, vật liệu, phạm vi ghi hình và danh mục quà tặng đều cần sự thống nhất và phê duyệt từ Mái ấm.
          </p>
        </div>
        <div class="shelter-photos">
          <figure class="shelter-photo reveal">
            <img src="/images/mai-am/mai-am-1.webp" alt="Các em và người chăm sóc ngồi trước dãy nhà của Mái ấm Thánh Tâm" width="640" height="480" loading="lazy" decoding="async" />
          </figure>
          <figure class="shelter-photo reveal">
            <img src="/images/mai-am/mai-am-2.webp" alt="Các em và khách đến thăm vỗ tay trò chuyện tại hiên Mái ấm Thánh Tâm" width="640" height="488" loading="lazy" decoding="async" />
          </figure>
          <p class="shelter-caption">Ảnh giới thiệu Mái ấm do nhóm cung cấp, được phép công bố. Đây không phải ảnh hoạt động của dự án.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="corners-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi chơi</span>
        <h2 id="corners-heading">Bốn góc hoạt động</h2>
        <p>Các em có thể tự do chọn góc hoạt động, đổi lượt, quan sát hoặc nghỉ ngơi; không giao chỉ tiêu hoàn thành sản phẩm.</p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} showNotes />

      <h3 class="flow-title">Nội dung buổi chơi dự kiến</h3>
      <ol class="flow">
        {
          PLAY_FLOW.map((f, i) => (
            <li class="flow-step">
              <span class="flow-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h4 class="flow-step-title">{f.title}</h4>
                <p class="flow-step-desc">{f.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="source-note">Khoảng 180 phút, có hai lần nghỉ chung; Mái ấm có thể rút ngắn khi các em mệt.</p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="safety-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">An toàn</span>
          <h2 id="safety-heading" class="col-title">Chuẩn bị kỹ trước buổi chơi</h2>
          <ul class="check-list">
            {SAFETY_PRACTICES.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="respect reveal">
          <span class="eyebrow">Tôn trọng</span>
          <h3 class="col-title col-title--sm">Mái ấm là người quyết định</h3>
          <p>
            Thời gian, nội dung hoạt động, vật liệu an toàn, phạm vi ghi hình và danh mục quà tặng đều cần được Mái ấm thống nhất và phê duyệt trước khi triển khai. Người chăm sóc hỗ trợ hướng dẫn tương tác phù hợp cho từng em.
          </p>
          <p>
            Hoạt động tại Mái ấm hoàn toàn là trải nghiệm vui chơi sáng tạo; các em giữ lại toàn bộ sản phẩm do mình làm ra. Sản phẩm bán gây quỹ do nhóm Lăng Kính tự chuẩn bị và hoàn thiện.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình</span>
        <h2 id="timeline-heading">Bốn chặng của dự án</h2>
      </div>
      <div class="reveal"><ProjectProgress compact /></div>
      <div class="timeline-wrap">
        <Timeline stages={CAMPAIGN_PROJECT.plannedStages} />
      </div>
      <p class="source-note">
        Lịch hai buổi do nhóm công bố, có thể điều chỉnh theo Mái ấm. Sau dự án, nhóm công bố hoạt động đã diễn ra, sao kê đã đối soát và vật phẩm đã trao.
      </p>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="project-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="project-cta-heading">Cùng mang buổi chơi này đến các em</h2>
        <p>Ủng hộ qua chuyển khoản, sao kê công khai từng khoản.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
        <a href="/minh-bach" class="link-arrow">Minh bạch <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .needs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .need {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #ffffff;
  }

  .need-num {
    font-weight: 700;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .need-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .need-desc {
    margin: 0;
  }

  .shelter {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: center;
  }

  .shelter-text p {
    margin: 0;
  }

  .shelter-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .shelter-photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
    aspect-ratio: 4 / 3;
    background: var(--surface-alt);
  }

  .shelter-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    display: block;
  }

  .shelter-caption {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .timeline-wrap {
    margin-top: var(--space-8);
  }

  .flow-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: var(--space-12) 0 var(--space-5);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .flow-step {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-5);
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }

  .flow-num {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--brand-ink);
    color: #ffffff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .flow-step-title {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    margin: 0;
  }

  .flow-step-desc {
    margin: 0;
  }

  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-3);
  }

  .respect p + p {
    margin-top: var(--space-3);
  }

  @media (max-width: 1023px) {
    .shelter {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .needs,
    .flow {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .need {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      padding: var(--space-4);
    }

    .need-num {
      grid-row: span 2;
    }
  }

  @media (max-width: 767px) {
    .flow-title {
      margin-top: var(--space-10);
    }

    .flow-step {
      padding: var(--space-4);
    }
  }
</style>
