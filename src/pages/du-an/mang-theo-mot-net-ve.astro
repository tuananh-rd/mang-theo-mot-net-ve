---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ActivityList from '../../components/ActivityList.astro';
import Timeline from '../../components/Timeline.astro';
import StatusChip from '../../components/StatusChip.astro';
import Icon from '../../components/Icon.astro';
import {
  CAMPAIGN_PROJECT,
  PROJECT_NEEDS,
  SAFETY_PRACTICES,
  WORKSHOP_AGENDA,
  EVALUATION_CRITERIA,
  COURSE_TARGETS,
} from '../../data/campaign';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Dự án' }];

const summaryItems = [
  { label: 'Địa điểm dự kiến', value: 'Mái ấm Thánh Tâm Xuy Xá (Mỹ Đức, Hà Nội)' },
  { label: 'Người tham gia', value: 'Trẻ em và người cao tuổi tại Mái ấm; số người do Mái ấm quyết định' },
  { label: 'Hai buổi tại Mái ấm', value: 'Buổi chơi khoảng 180 phút (tuần 8); buổi trao quà 30–45 phút (tuần 9)' },
  {
    label: 'Thời gian',
    value: '5 tuần học phần, tuần 5–9',
    chip: { kind: 'cho-xac-nhan' as const, label: 'Lịch chờ chốt' },
  },
];
---

<Layout
  title="Dự án"
  description="Kế hoạch buổi chơi có lựa chọn tại Mái ấm Thánh Tâm Xuy Xá: bốn góc hoạt động, agenda dự kiến, nguyên tắc an toàn và lộ trình 5 tuần."
  currentPath="/du-an/mang-theo-mot-net-ve"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Dự án"
    chip={{ kind: 'cho-xac-nhan', label: 'Đề xuất, chờ Mái ấm xác nhận' }}
    title="Một buổi chơi có lựa chọn"
    titleId="project-heading"
    lead={CAMPAIGN_PROJECT.slogan}
    description="Nhóm Lăng Kính đề xuất một buổi vui chơi sáng tạo tại Mái ấm, được thiết kế để em nào cũng có thể tham gia theo khả năng của mình, và gây quỹ để trao những vật phẩm Mái ấm thực sự cần."
    summaryTitle="Tóm tắt kế hoạch"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Vì sao có dự án</span>
        <h2 id="why-heading">Từ trao đổi với Mái ấm</h2>
        <p>
          Qua trao đổi trực tiếp với quản lý Mái ấm, nhóm ghi nhận các em ở nhiều độ tuổi, khả năng vận động và giao tiếp khác nhau, nên một hoạt động chung khó phù hợp với tất cả. Vì vậy nhóm mang chuồn chuồn tre, tượng tô, những bài hát quen và trò chơi nhẹ để mỗi em chọn cách vui chơi vừa sức.
        </p>
      </div>

      <ol class="needs">
        {
          PROJECT_NEEDS.map((n, i) => (
            <li class="need">
              <span class="need-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="need-title">{n.title}</h3>
              <p class="need-desc">{n.description}</p>
            </li>
          ))
        }
      </ol>
      <p class="source-note">
        Hoạt động giao lưu cộng đồng, không mang tính trị liệu. Nhóm không suy đoán thêm về mong muốn của từng em ngoài thông tin đã trao đổi với Mái ấm.
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="corners-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Buổi 1 · tuần 8</span>
        <h2 id="corners-heading">Bốn góc hoạt động</h2>
        <p>
          Hai bàn sáng tạo, các trò chơi theo lượt và một góc nghỉ. Các em được chọn hoạt động, chuyển lượt hoặc nghỉ; không ai phải hoàn thành sản phẩm giống nhau.
        </p>
      </div>

      <ActivityList activities={CAMPAIGN_PROJECT.activities} showNotes />

      <div class="corners-extra">
        <p class="note">
          Tranh và đồ các em làm được giữ lại cho các em và Mái ấm. Nhóm chuẩn bị 20 phôi chuồn chuồn dành riêng cho Mái ấm; hàng bán gây quỹ do nhóm tự hoàn thiện.
        </p>

        <details class="disclosure">
          <summary>
            <span class="disclosure-label">
              Agenda dự kiến 180 phút
              <span class="disclosure-meta">150 phút hoạt động, 2 lần nghỉ 15 phút; có thể rút ngắn nếu các em mệt</span>
            </span>
            <span class="disclosure-aside">
              <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
            </span>
          </summary>
          <div class="disclosure-body">
            <table class="data-table agenda-table">
              <caption class="sr-only">Agenda dự kiến của buổi chơi tại Mái ấm</caption>
              <thead>
                <tr>
                  <th scope="col">Mốc thời gian</th>
                  <th scope="col">Nội dung</th>
                </tr>
              </thead>
              <tbody>
                {
                  WORKSHOP_AGENDA.map((a) => (
                    <tr>
                      <th scope="row" class="agenda-time">{a.time}</th>
                      <td>{a.content}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="source-note">
              Theo đề xuất trang 12–13. Ngoài hai lần nghỉ chung, các em được nghỉ thêm theo nhu cầu; người điều phối điều chỉnh lượt cùng người chăm sóc.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="safety-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">An toàn</span>
          <h2 id="safety-heading" class="safety-title">Chuẩn bị trước buổi chơi</h2>
          <ul class="check-list">
            {SAFETY_PRACTICES.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <span class="eyebrow">Quyền quyết định</span>
          <h3 class="safety-title">Mái ấm duyệt trước mọi thứ</h3>
          <p>
            Lịch, chỗ chơi, bài hát, người chăm sóc, từng trò chơi và vật liệu, danh mục quà, quyền dùng sản phẩm và hình ảnh đều do Mái ấm duyệt. Không phát sinh hoạt động hay vật liệu chưa được cơ sở đồng ý.
          </p>
          <p class="safety-p">
            Người chăm sóc quyết định cách hỗ trợ từng em. Cộng tác viên chỉ tham gia khi Mái ấm đồng ý.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình</span>
        <h2 id="timeline-heading">Bốn chặng trong 5 tuần</h2>
        <p>Gây quỹ trước buổi chơi; quà được mua sau khi chốt quỹ và đối chiếu danh mục với Mái ấm.</p>
      </div>

      <Timeline stages={CAMPAIGN_PROJECT.plannedStages} />

      <p class="source-note">
        Tuần 5–9 là tuần của học phần, chưa phải ngày cụ thể. Một số phần của đề xuất còn ghi 4 tuần; nhóm sẽ thống nhất lịch chính thức. Phản hồi bổ sung sau 7–10 ngày, nếu có, được ghi thành cập nhật riêng.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="results-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Kết quả</span>
        <h2 id="results-heading">Cách nhóm sẽ đánh giá</h2>
        <p class="results-status">
          <StatusChip kind="cho-xac-nhan" label="Chưa có kết quả thực tế" />
          <span>Kết quả chỉ được công bố sau hoạt động, kèm minh chứng. Chỉ tiêu thiếu dữ liệu ghi “chưa đủ cơ sở đánh giá”.</span>
        </p>
      </div>

      <ul class="ruled-list">
        {
          EVALUATION_CRITERIA.map((c) => (
            <li>
              <h3 class="ruled-title">{c.title}</h3>
              <p class="ruled-desc">{c.method}</p>
            </li>
          ))
        }
      </ul>

      <details class="disclosure results-more">
        <summary>
          <span class="disclosure-label">
            Chỉ tiêu học phần và truyền thông
            <span class="disclosure-meta">Mục tiêu trong đề xuất, không phải thành tích</span>
          </span>
          <span class="disclosure-aside">
            <span class="disclosure-chevron"><Icon name="chevron" size={18} /></span>
          </span>
        </summary>
        <div class="disclosure-body">
          <ul class="check-list">
            {COURSE_TARGETS.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </details>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="project-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="project-cta-heading">Nguồn lực cho buổi chơi đến từ đâu?</h2>
        <p>Dự toán 24 khoản, kịch bản doanh thu và những điểm còn cần làm rõ.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch thu chi</a>
        <a href="/san-pham" class="link-arrow">Sản phẩm gây quỹ →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .needs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .need {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .need-num {
    font-weight: 700;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .need-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .need-desc {
    margin: 0;
  }

  .corners-extra {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .agenda-time {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    width: 140px;
  }

  .safety-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  h3.safety-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-3);
  }

  .safety-p {
    margin-top: var(--space-3);
  }

  .results-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .results-more {
    margin-top: var(--space-6);
  }

  @media (max-width: 1023px) {
    .needs {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .need {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      padding: var(--space-4);
    }

    .need-num {
      grid-row: span 2;
    }
  }

  @media (max-width: 767px) {
    .agenda-time {
      width: 104px;
      white-space: normal;
    }

    .agenda-table th,
    .agenda-table td {
      padding: var(--space-2) var(--space-2);
    }

    .corners-extra {
      margin-top: var(--space-8);
    }
  }
</style>
