---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import StageCard from '../../components/StageCard.astro';
import StatusChip from '../../components/StatusChip.astro';
import { CAMPAIGN_PROJECT } from '../../data/campaign';

const activityIllustrationTypes = ['chuon-chuon', 'to-tuong', 'hat', 'tro-choi'] as const;

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Dự án' },
];

const summaryItems = [
  {
    label: 'Địa điểm dự kiến',
    value: CAMPAIGN_PROJECT.location,
  },
  {
    label: 'Người tham gia',
    value: 'Do Mái ấm quyết định theo điều kiện thực tế của cơ sở',
  },
  {
    label: 'Quy mô hoạt động',
    value: '2 buổi dự kiến với 4 góc chơi có lựa chọn (chưa chốt ngày)',
  },
  {
    label: 'Tình trạng đề xuất',
    value: 'Kế hoạch học phần — chờ thống nhất chính thức',
    chip: {
      kind: 'cho-xac-nhan' as const,
      label: 'Chờ xác nhận',
    },
  },
];

const anchorNavItems = [
  { href: '#muc-tieu', label: '1. Mục tiêu & An toàn' },
  { href: '#buoi-choi', label: '2. Bốn góc chơi' },
  { href: '#giai-doan', label: '3. Hành trình triển khai' },
  { href: '#cap-nhat', label: '4. Cập nhật kết quả' },
  { href: '#nguon-luc', label: '5. Nguồn lực & Tài chính' },
];
---

<Layout
  title="Câu chuyện dự án"
  description="Câu chuyện đề xuất, các góc hoạt động vui chơi có lựa chọn và 4 giai đoạn dự kiến tại Mái ấm Thánh Tâm Xuy Xá."
  currentPath="/du-an/mang-theo-mot-net-ve"
>
  <!-- Shared PageHero (7 cột trái / 5 cột phải panel Tóm tắt kế hoạch) -->
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Đề xuất hoạt động"
    chip={{
      kind: 'cho-xac-nhan',
      label: 'Đề xuất — chưa có xác nhận chính thức',
    }}
    title="Dự án Mang Theo Một Nét Vẽ"
    titleId="project-heading"
    lead={CAMPAIGN_PROJECT.slogan}
    description="Dự án học phần SSG105 của nhóm Lăng Kính (Đại học FPT Hà Nội), đề xuất kết nối một buổi vui chơi an toàn, có lựa chọn với việc hỗ trợ hiện vật theo nhu cầu thực tế của Mái ấm."
    summaryTitle="Tóm tắt kế hoạch"
    summaryItems={summaryItems}
  />

  <!-- Mục lục neo (5 mục link nhãn rõ ràng, cuộn ngang mobile) -->
  <nav class="project-anchor-nav" aria-label="Mục lục các phần dự án">
    <div class="container">
      <ul class="anchor-nav-list">
        {
          anchorNavItems.map((item) => (
            <li>
              <a href={item.href} class="anchor-nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- Section 1: Mục tiêu và nguyên tắc an toàn (2 cột list) -->
  <section id="muc-tieu" class="section section-soft" aria-labelledby="objectives-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Định hướng cốt lõi</span>
        <h2 id="objectives-heading">Mục tiêu &amp; Nguyên tắc an toàn</h2>
        <p class="section-lead">
          Các nguyên tắc đề xuất nhằm bảo đảm buổi chơi an toàn, vừa sức và tôn trọng trọn vẹn quyền lựa chọn của từng người tham gia.
        </p>
      </div>

      <div class="objectives-grid">
        <div class="objective-card">
          <div class="badge-row">
            <span class="eyebrow">Mục tiêu đề xuất</span>
            <StatusChip kind="ke-hoach" label="Kế hoạch" />
          </div>
          <h3 class="objective-title">Buổi chơi theo lựa chọn</h3>
          <p class="objective-text">
            Theo đề xuất, nhóm hướng đến một buổi chơi có lựa chọn và hỗ trợ hiện vật đúng nhu cầu. Mỗi người có thể tham gia theo khả năng, quan sát hoặc nghỉ; không có chỉ tiêu sản phẩm dành cho trẻ. Nhóm dự kiến hoàn thiện, kiểm tra sản phẩm và theo dõi làm/bán/tồn trước khi công bố thu chi.
          </p>
        </div>

        <div class="objective-card">
          <div class="badge-row">
            <span class="eyebrow">An toàn &amp; Phối hợp</span>
            <StatusChip kind="cho-xac-nhan" label="Chờ thống nhất" />
          </div>
          <h3 class="objective-title">An toàn, phối hợp &amp; Quyền cơ sở</h3>
          <p class="objective-text">
            Lịch, không gian, vật liệu và hoạt động dự kiến cần được thống nhất với Mái ấm trước khi tổ chức. Nhóm dự kiến kiểm tra cạnh và chi tiết nhỏ, điều chỉnh trò chơi nhẹ phù hợp; người chăm sóc hỗ trợ lựa chọn và điều kiện an toàn. Người tham gia vẫn có quyền chọn hoạt động, quan sát hoặc nghỉ. Phương án bowling dự kiến có thể điều chỉnh lăn bóng hoặc chuyền bóng nhẹ không tính điểm loại trừ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Câu chuyện từ đề xuất (Cột 720px) -->
  <section id="cau-chuyen" class="section section-story" aria-labelledby="story-heading">
    <div class="container">
      <div class="story-wrapper">
        <div class="section-header">
          <span class="eyebrow">Bối cảnh hình thành</span>
          <h2 id="story-heading">Câu chuyện từ đề xuất</h2>
        </div>

        <div class="story-prose">
          <p>
            Xuất phát từ mong muốn mang lại niềm vui nhẹ nhàng và thiết thực, nhóm Lăng Kính lên ý tưởng tổ chức một không gian vui chơi có nhiều góc hoạt động tại Mái ấm Thánh Tâm Xuy Xá. Mỗi góc chơi được bố trí để người tham gia tự do lựa chọn trải nghiệm phù hợp với thể trạng và sở thích riêng — từ tô tượng, trang trí chuồn chuồn tre mộc, ca hát đến trò chơi vận động nhẹ — trong khi nhóm sinh viên dự kiến tự chịu trách nhiệm chuẩn bị vật tư, trực tiếp hoàn thiện hàng lưu niệm gây quỹ và quản lý thu chi minh bạch sau đối soát.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Buổi chơi có nhiều lựa chọn (4 góc chơi) -->
  <section id="buoi-choi" class="section section-soft" aria-labelledby="activities-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Không gian trải nghiệm</span>
        <h2 id="activities-heading">Buổi chơi có nhiều lựa chọn</h2>
        <p class="section-lead">
          Không gian hoạt động tôn trọng quyền tham gia, quan sát hoặc nghỉ ngơi của từng người; không đặt chỉ tiêu sản xuất hay áp lực biểu diễn.
        </p>
      </div>

      <div class="activities-grid">
        {
          CAMPAIGN_PROJECT.activities.map((activity, index) => (
            <ActivityCard
              activity={activity}
              illustrationType={activityIllustrationTypes[index]}
            />
          ))
        }
      </div>

      <div class="section-footer-note">
        <p>
          * Ghi chú bản xem trước: Biểu tượng minh họa hoạt động dự kiến. Mẫu chuồn chuồn, tượng và nhạc cụ thực tế chờ xác nhận; tô tượng là trải nghiệm tại chỗ cho các em, không phải hàng hoá mang đi bán gây quỹ.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Hành trình dự kiến (4 giai đoạn) -->
  <section id="giai-doan" class="section section-stages" aria-labelledby="stages-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Lộ trình 4 giai đoạn</span>
        <h2 id="stages-heading">Hành trình dự kiến của dự án</h2>
        <p class="section-lead">
          Đề xuất dự kiến 4 tuần, với 2 buổi tại Mái ấm; lịch cụ thể chờ xác nhận.
        </p>
      </div>

      <div class="stages-grid">
        {
          CAMPAIGN_PROJECT.plannedStages.map((stage) => (
            <StageCard stage={stage} />
          ))
        }
      </div>

      <div class="timeline-note-box">
        <p class="timeline-note-text">
          Quy trình trao tặng và lịch trình cụ thể phụ thuộc vào sự thống nhất chính thức với đại diện Mái ấm; đề xuất dự kiến theo dõi phản hồi 7–10 ngày sau bàn giao hiện vật và không tự ý ấn định ngày tháng hay đánh dấu hoàn thành trước khi được kiểm chứng.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Cập nhật rỗng planned -->
  <section id="cap-nhat" class="section section-updates" aria-labelledby="updates-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Báo cáo thực tế</span>
        <h2 id="updates-heading">Cập nhật và kết quả</h2>
      </div>

      <div class="empty-state-card">
        <div class="empty-badge">
          <StatusChip kind="cho-xac-nhan" label="Chưa có dữ liệu" />
        </div>
        <p class="empty-desc">
          Chưa có cập nhật thực tế được xác nhận; kết quả và báo cáo sẽ được công bố sau khi đối soát và được phép.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 6: Nguồn lực & Tài chính -->
  <section id="nguon-luc" class="section section-soft" aria-labelledby="resources-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quản lý nguồn quỹ</span>
        <h2 id="resources-heading">Nguồn lực và nguyên tắc minh bạch</h2>
      </div>

      <div class="resources-layout">
        <div class="resources-content">
          <p class="resources-desc">
            Theo đề xuất, nhóm sinh viên dự kiến phụ trách chuẩn bị vật tư các góc chơi, hoàn thiện quà lưu niệm và phương án ẩm thực gây quỹ; nguồn lực được dự kiến theo dõi và đối soát độc lập giữa tiền mặt và hiện vật. Chi tiết dự toán 19 khoản và cơ cấu số dư được công khai minh bạch tại trang Minh bạch.
          </p>
          <div class="resources-actions">
            <a href="/minh-bach" class="btn btn-secondary">
              Xem minh bạch thu chi &rarr;
            </a>
            <a href="/san-pham" class="btn btn-primary">
              Xem sản phẩm gây quỹ dự kiến
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Mục lục neo (Anchor Navigation Bar) */
  .project-anchor-nav {
    background-color: var(--surface-alt);
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) 0;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .anchor-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }

  .anchor-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .anchor-nav-link:hover {
    background-color: var(--color-canvas);
    border-color: var(--line);
  }

  /* Objectives Grid (2 Cột List) */
  .objectives-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .objective-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .objective-card .badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .objective-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--ink);
    margin: 0;
  }

  .objective-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  /* Section Story (Cột 720px) */
  .story-wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  .story-prose p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink);
    margin: 0;
  }

  /* Activities Grid */
  .activities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .section-footer-note {
    margin-top: var(--space-8);
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  /* Stages Grid */
  .stages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .timeline-note-box {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--surface-alt);
    border-left: 3px solid var(--line-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .timeline-note-text {
    font-size: var(--font-size-small);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  /* Updates Section (Empty state) */
  .empty-state-card {
    background-color: var(--surface-alt);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .empty-title {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  .empty-desc {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink-2);
    margin: 0;
  }

  /* Resources Section */
  .resources-layout {
    max-width: 760px;
  }

  .resources-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-2);
    margin-bottom: var(--space-6);
  }

  .resources-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Scroll Margin cho neo */
  section[id] {
    scroll-margin-top: 60px;
  }

  /* Responsive Adjustments */
  @media (max-width: 1023px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .objectives-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .activities-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .stages-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .story-prose {
      text-align: left;
    }

    .resources-actions {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }
  }
</style>
