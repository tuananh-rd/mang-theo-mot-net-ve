---
import Layout from '../../layouts/Layout.astro';
import StatusChip from '../../components/StatusChip.astro';
import Icon from '../../components/Icon.astro';
import { OFFICIAL_CONTACT } from '../../data/campaign';
import {
  CRAFT_PRODUCT_DETAILS,
  getCraftProductBySlug,
  getEffectiveProductSaleModel,
  formatPurchaseInquiry,
} from '../../lib/products';

export function getStaticPaths() {
  const paths: { params: { slug: string } }[] = [];
  for (const detail of CRAFT_PRODUCT_DETAILS) {
    paths.push({ params: { slug: detail.slug } });
    if (detail.aliases) {
      for (const alias of detail.aliases) {
        paths.push({ params: { slug: alias } });
      }
    }
  }
  return paths;
}

const { slug } = Astro.params;
const detail = getCraftProductBySlug(slug!);

if (!detail) {
  throw new Error(`Product not found for slug: ${slug}`);
}

const { product } = detail;
const saleModel = getEffectiveProductSaleModel(product);
const isPurchaseEligible = saleModel.canPurchase;
const otherDetail = CRAFT_PRODUCT_DETAILS.find((d) => d.slug !== detail.slug);

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Quà lưu niệm', href: '/san-pham' },
  { label: product.name },
];

const initialInquiryText = formatPurchaseInquiry({
  product,
  quantity: 1,
});

const fanpageUrl = OFFICIAL_CONTACT.fanpageUrl;
const contactPeople = OFFICIAL_CONTACT.people;

let lockedPillLabel = 'Trạng thái: Đang chuẩn bị mẫu — Chưa mở bán';
let lockedDescText =
  'Sản phẩm hiện đang trong giai đoạn chuẩn bị và hoàn thiện mẫu; nhóm chưa tiếp nhận đơn đặt hàng hay thu tiền trước. Khi có thông báo chính thức, tính năng soạn yêu cầu mua sẽ được mở ngay tại đây.';

if (saleModel.preorderOpen) {
  lockedPillLabel = 'Trạng thái: Đang nhận đặt trước';
  lockedDescText = 'Đặt trước chưa phải thanh toán online. Nhóm sẽ liên hệ xác nhận cách thức và lịch nhận hàng sau khi đặt trước; hiện chưa cam kết ngày giao. Vui lòng dùng biểu mẫu đặt trước tại trang quà lưu niệm.';
} else if (saleModel.saleStatus === 'closed') {
  lockedPillLabel = 'Trạng thái: Đã kết thúc đợt mở bán';
  lockedDescText =
    'Sản phẩm hiện đã kết thúc đợt mở bán gây quỹ; nhóm tạm thời dừng tiếp nhận yêu cầu mua mới. Bạn có thể liên hệ trực tiếp với nhóm qua Fanpage hoặc số điện thoại bên dưới để biết thêm thông tin.';
} else if (saleModel.stockAvailable === 0) {
  lockedPillLabel = 'Trạng thái: Tạm hết số lượng có sẵn';
  lockedDescText =
    'Sản phẩm hiện đã tạm hết số lượng có sẵn trong đợt này; nhóm tạm dừng tiếp nhận yêu cầu mua mới. Bạn có thể liên hệ trực tiếp với nhóm qua Fanpage hoặc số điện thoại bên dưới nếu muốn đăng ký trước khi có đợt bổ sung.';
}
---

<Layout
  title={`${product.name} — Quà lưu niệm gây quỹ`}
  description={`${product.description} ${saleModel.priceTypeLabel}: ${saleModel.priceText}. Quà lưu niệm do nhóm Lăng Kính chuẩn bị gây quỹ cho Mái ấm Thánh Tâm.`}
  currentPath="/san-pham"
>
  <!-- Breadcrumb Bar trên nền trắng phẳng -->
  <div class="product-page-nav">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((item, index) => {
            const isLast = index === breadcrumbs.length - 1;
            return (
              <li class="breadcrumb-item">
                {isLast || !item.href ? (
                  <span class="breadcrumb-current" aria-current={isLast ? 'page' : undefined}>
                    {item.label}
                  </span>
                ) : (
                  <a href={item.href} class="breadcrumb-link">
                    {item.label}
                  </a>
                )}
                {!isLast && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
              </li>
            );
          })}
        </ol>
      </nav>
    </div>
  </div>

  <!-- Phiếu sản phẩm chính (Kiểu C: ảnh 7 / thông tin và form 5 trên desktop) -->
  <section class="section product-sheet-section" aria-labelledby="product-title">
    <div class="container">
      <div class="product-sheet-grid">
        <!-- Vùng Tóm tắt & Tiêu đề (DOM thứ tự mobile: H1 -> giá -> chip trước) -->
        <div class="product-summary-area">
          <div class="product-meta">
            <span class="eyebrow">Quà lưu niệm gây quỹ</span>
            <StatusChip kind={saleModel.statusChipKind} label={saleModel.statusLabel} />
          </div>

          <h1 id="product-title" class="product-sheet-title">{product.name}</h1>
          <p class="product-sheet-lead">{product.description}</p>

          <div class="product-price-box">
            <div class="price-main-row">
              <span class="price-amount">{saleModel.priceText}</span>
              <span class="price-unit">/ {saleModel.unitSuffix}</span>
            </div>
            <div class="price-meta-row">
              <span class="price-type-pill">{saleModel.priceTypeLabel}</span>
              <span class="price-note">{saleModel.priceNote}</span>
            </div>
            {product.plannedQuantity.value !== null && (
              <p class="price-planned-info">
                Dự kiến chuẩn bị: <strong>{product.plannedQuantity.value} {saleModel.unitSuffix}</strong> (theo kế hoạch)
              </p>
            )}
          </div>
        </div>

        <!-- Vùng Hình ảnh / Khung trực quan (Trái 7 trên desktop) -->
        <div class="product-visual-area">
          {detail.image ? (
            <figure class="product-figure-main">
              <div class="product-img-wrap">
                <img
                  src={detail.image.src}
                  alt={detail.image.alt}
                  width={detail.image.width}
                  height={detail.image.height}
                  loading="eager"
                  decoding="async"
                />
              </div>
              <figcaption class="product-caption">
                <strong>Lưu ý:</strong> {detail.image.caption}
              </figcaption>
            </figure>
          ) : (
            <div class="product-placeholder product-placeholder--dashed">
              <div class="placeholder-icon">
                <Icon name="moc-khoa" size={48} />
              </div>
              <p class="placeholder-title">Chưa có ảnh chụp mẫu</p>
              <p class="placeholder-desc">{detail.imagePendingNote}</p>
            </div>
          )}
        </div>

        <!-- Vùng Biểu mẫu Soạn yêu cầu mua (Dưới thông tin tóm tắt trên desktop) -->
        <div class="product-inquiry-area">
          <div class="inquiry-card" id="inquiry-section">
            <div class="inquiry-card-header">
              <span class="eyebrow">Quy trình đăng ký</span>
              <h2 class="inquiry-title">Soạn yêu cầu mua quà lưu niệm</h2>
            </div>

            {isPurchaseEligible ? (
              <div
                class="inquiry-interactive"
                data-unit-price={saleModel.effectivePrice}
                data-product-name={product.name}
                data-unit-suffix={saleModel.unitSuffix}
                data-sales-channel={saleModel.salesChannel}
                data-max-qty={saleModel.maxPurchasableQuantity}
              >
                <p class="inquiry-lead">
                  Chọn số lượng bạn mong muốn để hệ thống tự động soạn sẵn nội dung tin nhắn. Bạn sao chép nội dung và gửi đến Fanpage hoặc liên hệ trực tiếp thành viên nhóm.
                </p>

                <div class="calc-row">
                  <div class="calc-qty-group">
                    <label for="product-qty-input" class="calc-label">Số lượng:</label>
                    <div class="qty-control">
                      <button type="button" class="qty-btn" id="qty-dec" aria-label="Giảm số lượng">-</button>
                      <input type="number" id="product-qty-input" min="1" max={saleModel.maxPurchasableQuantity} value="1" class="qty-input" />
                      <button type="button" class="qty-btn" id="qty-inc" aria-label="Tăng số lượng">+</button>
                    </div>
                  </div>
                  <div class="calc-subtotal">
                    <span class="subtotal-label">Tạm tính:</span>
                    <strong class="subtotal-val" id="subtotal-val">{saleModel.priceText}</strong>
                  </div>
                </div>

                <div class="inquiry-textarea-wrap">
                  <label for="inquiry-text-output" class="inquiry-text-label">Nội dung yêu cầu gửi nhóm:</label>
                  <textarea id="inquiry-text-output" class="inquiry-textarea" rows="8" readonly>{initialInquiryText}</textarea>
                </div>

                <div class="inquiry-actions">
                  <button type="button" class="btn btn-primary" id="copy-inquiry-btn">
                    Sao chép nội dung yêu cầu
                  </button>
                  {fanpageUrl && (
                    <a href={fanpageUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                      Gửi qua Fanpage Lăng Kính ↗
                    </a>
                  )}
                </div>

                <div class="copy-alert" id="copy-alert" role="status" aria-live="polite" hidden>
                  Đã sao chép nội dung yêu cầu mua vào bộ nhớ tạm!
                </div>

                <p class="inquiry-footer-note">
                  <strong>Bước tiếp theo:</strong> Gửi nội dung đã sao chép cho nhóm Lăng Kính. Đơn hàng chỉ được xác nhận sau khi nhóm liên hệ lại và thống nhất cách thức giao nhận. Website không xử lý thanh toán tự động và không thu tiền trước.
                </p>
              </div>
            ) : (
              <div class="inquiry-pending-state">
                <div class="pending-pill">{lockedPillLabel}</div>
                <p>
                  {lockedDescText}
                </p>
                <div class="pending-contacts">
                  <p class="pending-contacts-title">Nếu bạn quan tâm hoặc muốn đăng ký số lượng lớn trước:</p>
                  <ul class="contact-links">
                    {fanpageUrl && (
                      <li>
                        <a href={fanpageUrl} target="_blank" rel="noopener noreferrer" class="link-arrow">
                          Nhắn tin qua Fanpage Mang Theo Một Nét Vẽ <span class="arrow" aria-hidden="true">↗</span>
                        </a>
                      </li>
                    )}
                    {contactPeople.map((p) => (
                      <li>
                        <a href={`tel:${p.phoneE164}`} class="link-arrow">
                          Liên hệ trực tiếp: {p.name} ({p.role}): {p.phone} <span class="arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Thông số và quy cách chế tác (Section nền surface-alt) -->
  <section class="section section-specs" aria-labelledby="specs-heading">
    <div class="container">
      <div class="spec-card">
        <h2 id="specs-heading" class="spec-card-title">Thông số và quy cách chế tác</h2>
        <dl class="spec-list">
          <div class="spec-item">
            <dt>Chất liệu và phôi</dt>
            <dd>{detail.materialInfo}</dd>
          </div>

          {detail.dimensionInfo && (
            <div class="spec-item">
              <dt>Kích thước</dt>
              <dd>{detail.dimensionInfo}</dd>
            </div>
          )}

          <div class="spec-item">
            <dt>Nguồn gốc và chế tác</dt>
            <dd>{detail.originDetails}</dd>
          </div>

          <div class="spec-item">
            <dt>Địa điểm và kế hoạch nhận quà</dt>
            <dd>{saleModel.salesChannel}</dd>
          </div>

          <div class="spec-item">
            <dt>Chính sách đổi / trả / hủy</dt>
            <dd>{saleModel.returnPolicy}</dd>
          </div>
        </dl>
      </div>

      <div class="product-callout">
        <h3 class="callout-title">Nguyên tắc gây quỹ và quản lý tài chính</h3>
        <p>
          Toàn bộ doanh thu bán quà lưu niệm được quản lý và ghi sổ riêng biệt với các khoản ủng hộ qua chuyển khoản ngân hàng. Lãi thu được từ hoạt động bán quà dùng để hỗ trợ chi phí buổi trải nghiệm và chuẩn bị các phần quà cho các em tại Mái ấm Thánh Tâm.
        </p>
        <p>
          Hoạt động tại Mái ấm hoàn toàn là buổi chơi vui vẻ và sáng tạo cho các em; <strong>các em giữ lại toàn bộ sản phẩm mình làm ra</strong>. Nhóm Lăng Kính tự chịu trách nhiệm chuẩn bị và hoàn thiện sản phẩm bán gây quỹ, tuyệt đối không giao chỉ tiêu sản xuất cho các em.
        </p>
      </div>
    </div>
  </section>

  <!-- Điều hướng cuối trang (Thay dải CTA mơ theo review RC15) -->
  <section class="section-nav-strip">
    <div class="container nav-strip">
      <a href="/san-pham" class="link-arrow">
        <span class="arrow" aria-hidden="true">←</span> Quay lại danh mục quà lưu niệm
      </a>
      <div class="nav-strip-links">
        <a href="/nhat-ky/gioi-thieu-qua-luu-niem-gay-quy" class="link-inline">
          Đọc bài nhật ký về quà lưu niệm →
        </a>
        {otherDetail && (
          <a href={`/san-pham/${otherDetail.slug}`} class="link-inline">
            Xem {otherDetail.product.name} →
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupProductInquiry() {
    const container = document.querySelector<HTMLElement>('.inquiry-interactive');
    if (!container) return;

    const unitPrice = Number(container.getAttribute('data-unit-price') || '0');
    const productName = container.getAttribute('data-product-name') || '';
    const unitSuffix = container.getAttribute('data-unit-suffix') || 'chiếc';
    const salesChannel =
      container.getAttribute('data-sales-channel') ||
      'Khuôn viên Đại học FPT Hà Nội (Hòa Lạc) hoặc theo thỏa thuận với nhóm';
    const maxQty = Number(container.getAttribute('data-max-qty') || '50');

    const qtyInput = document.getElementById('product-qty-input') as HTMLInputElement | null;
    const btnInc = document.getElementById('qty-inc');
    const btnDec = document.getElementById('qty-dec');
    const subtotalEl = document.getElementById('subtotal-val');
    const textareaEl = document.getElementById('inquiry-text-output') as HTMLTextAreaElement | null;
    const copyBtn = document.getElementById('copy-inquiry-btn');
    const copyAlert = document.getElementById('copy-alert');

    function updateInquiry() {
      if (!qtyInput || !subtotalEl || !textareaEl) return;
      let qty = parseInt(qtyInput.value, 10);
      if (isNaN(qty) || qty < 1) qty = 1;
      if (qty > maxQty) qty = maxQty;
      qtyInput.value = qty.toString();

      const subtotal = unitPrice * qty;
      const formattedSubtotal = new Intl.NumberFormat('vi-VN').format(subtotal) + 'đ';
      subtotalEl.textContent = formattedSubtotal;

      const lines = [
        `[YÊU CẦU MUA QUÀ LƯU NIỆM GÂY QUỸ]`,
        `Dự án: Mang Theo Một Nét Vẽ — Nhóm sinh viên Lăng Kính`,
        `Sản phẩm: ${productName}`,
        `Số lượng: ${qty} ${unitSuffix}`,
        `Đơn giá: ${new Intl.NumberFormat('vi-VN').format(unitPrice)}đ`,
        `Tạm tính: ${formattedSubtotal}`,
        `Địa điểm nhận dự kiến: ${salesChannel}`,
        `---`,
        `Lưu ý: Đây là tin nhắn soạn mẫu gửi đến Fanpage hoặc thành viên nhóm Lăng Kính. Yêu cầu mua chỉ được xác nhận sau khi nhóm phản hồi và thống nhất cách nhận quà.`,
      ];
      textareaEl.value = lines.join('\n');
    }

    btnInc?.addEventListener('click', () => {
      if (qtyInput) {
        const cur = parseInt(qtyInput.value || '1', 10);
        if (cur < maxQty) {
          qtyInput.value = (cur + 1).toString();
          updateInquiry();
        }
      }
    });

    btnDec?.addEventListener('click', () => {
      if (qtyInput) {
        const cur = parseInt(qtyInput.value || '1', 10);
        if (cur > 1) {
          qtyInput.value = (cur - 1).toString();
          updateInquiry();
        }
      }
    });

    qtyInput?.addEventListener('input', updateInquiry);

    copyBtn?.addEventListener('click', async () => {
      if (!textareaEl) return;
      try {
        await navigator.clipboard.writeText(textareaEl.value);
        if (copyAlert) {
          copyAlert.removeAttribute('hidden');
          copyAlert.textContent = 'Đã sao chép nội dung yêu cầu vào bộ nhớ tạm!';
          setTimeout(() => {
            copyAlert.setAttribute('hidden', '');
          }, 3500);
        }
      } catch (err) {
        if (copyAlert) {
          copyAlert.removeAttribute('hidden');
          copyAlert.textContent = 'Không thể sao chép tự động. Bạn hãy bôi đen đoạn văn bản và chọn Sao chép.';
        }
      }
    });
  }

  setupProductInquiry();
  document.addEventListener('astro:page-load', setupProductInquiry);
</script>

<style>
  /* Navigation & Breadcrumb Header */
  .product-page-nav {
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) 0;
  }

  .breadcrumb-nav {
    font-size: var(--font-size-small);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb-link {
    color: var(--ink-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--line-strong);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--ink);
    font-weight: 600;
  }

  /* Product Sheet Layout (Kiểu C: Phiếu sản phẩm) */
  .product-sheet-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
    background: #ffffff;
  }

  .product-sheet-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      "visual summary"
      "visual inquiry";
    gap: var(--space-6) var(--space-10);
    align-items: start;
  }

  .product-summary-area {
    grid-area: summary;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    max-width: 100%;
  }

  .product-visual-area {
    grid-area: visual;
    min-width: 0;
    max-width: 100%;
  }

  .product-inquiry-area {
    grid-area: inquiry;
    min-width: 0;
    max-width: 100%;
  }

  .product-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .product-sheet-title {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .product-sheet-lead {
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
    color: var(--ink-2);
    margin: 0;
    text-wrap: balance;
  }

  /* Hộp hiển thị giá nổi bật */
  .product-price-box {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .price-main-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .price-amount {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.1;
  }

  .price-unit {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .price-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .price-type-pill {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .price-note {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .price-planned-info {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
    border-top: 1px dashed var(--line);
    padding-top: var(--space-2);
  }

  /* Khung hình ảnh 4:3 chuẩn mực */
  .product-figure-main {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #ffffff;
    box-shadow: var(--shadow-raised);
  }

  .product-img-wrap {
    width: 100%;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .product-figure-main img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

