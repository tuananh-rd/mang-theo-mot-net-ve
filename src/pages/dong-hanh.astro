---
import Layout from '../layouts/Layout.astro';
import { SUPPORT_METHODS } from '../data/campaign';
---

<Layout
  title="Đồng hành cùng dự án"
  description="Các phương thức đồng hành và hỗ trợ dự án Mang Theo Một Nét Vẽ."
  currentPath="/dong-hanh"
>
  <div class="shell-container container section">
    <div class="shell-card card">
      <div class="badge-wrap">
        <span class="status-badge">Bản xem trước</span>
      </div>

      <h1 class="shell-title">Đồng hành cùng dự án</h1>
      <p class="shell-subtitle">Các cách tiếp nhận hỗ trợ đúng nhu cầu thực tế</p>

      <div class="support-list">
        {
          SUPPORT_METHODS.map((method) => (
            <div class="support-item">
              <h2 class="method-title">{method.title}</h2>
              <p class="method-desc">{method.description}</p>
              <span class="method-status">{method.statusText}</span>
            </div>
          ))
        }
      </div>

      <div class="shell-notice">
        <p>
          <strong>Kênh liên hệ chính thức đang được cập nhật.</strong>
        </p>
        <p>
          Để đảm bảo tính xác thực và an toàn, nhóm không cung cấp số tài khoản, mã QR hoặc form thu thập thông tin khi chưa có sự xác nhận chính thức từ nhà trường và Mái ấm.
        </p>
      </div>

      <div class="shell-actions">
        <a href="/" class="btn btn-primary">
          &larr; Quay lại trang chủ
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .shell-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .shell-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .shell-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
  }

  .shell-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .support-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-2) 0;
  }

  .support-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background-color: var(--color-canvas-subtle);
  }

  .method-title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .method-desc {
    font-size: 0.9375rem;
    margin-bottom: var(--space-2);
  }

  .method-status {
    font-size: 0.8125rem;
    color: var(--color-text-accent);
    font-weight: 500;
  }

  .shell-notice {
    background-color: var(--color-canvas-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .shell-actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .shell-card {
      padding: var(--space-5);
    }
  }
</style>
