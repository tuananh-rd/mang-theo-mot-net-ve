---
import Layout from '../layouts/Layout.astro';
import {
  SUPPORT_WORKFLOW,
  SUPPORT_FAQS,
  OFFICIAL_CONTACT,
} from '../data/campaign';
---

<Layout
  title="Đồng hành cùng dự án"
  description="Các phương thức đồng hành, quy trình tiếp nhận hỗ trợ đúng nhu cầu thực tế của chiến dịch Mang Theo Một Nét Vẽ."
  currentPath="/dong-hanh"
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Trang chủ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
          <li class="breadcrumb-item">
            <span class="breadcrumb-current" aria-current="page">Đồng hành</span>
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="support-hero" aria-labelledby="support-heading">
    <div class="container">
      <div class="support-hero-card">
        <div class="badge-row">
          <span class="status-badge">Tiếp nhận có lựa chọn</span>
          <span class="status-badge status-badge-neutral">Chưa mở tiếp nhận trực tuyến</span>
        </div>

        <h1 id="support-heading" class="support-title">
          Đồng hành cùng dự án
        </h1>

        <p class="support-slogan">
          Một buổi chơi phù hợp, một món quà đúng nhu cầu.
        </p>

        <p class="support-lead">
          Nhóm Lăng Kính hướng đến việc kết nối những tấm lòng đồng hành với nhu cầu thiết thực tại Mái ấm Thánh Tâm Xuy Xá. Mọi sự hỗ trợ đều được lên kế hoạch chu đáo, minh bạch và tôn trọng quyền riêng tư của các em.
        </p>

        <!-- Notice Box -->
        <div class="support-section-notice">
          <p>
            <strong>Lưu ý:</strong> {OFFICIAL_CONTACT.notice}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: 3 Phương thức đồng hành -->
  <section class="section section-soft" aria-labelledby="methods-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Hình thức hỗ trợ</span>
        </div>
        <h2 id="methods-heading" class="section-title">
          Ba phương thức đồng hành dự kiến
        </h2>
        <p class="section-subtitle">
          Các hình thức hỗ trợ được đề xuất nhằm đảm bảo đúng nhu cầu, an toàn và thiết thực.
        </p>
      </div>

      <div class="methods-grid">
        <!-- Phương thức 1: Vật tư -->
        <div class="method-card card">
          <div class="method-icon-wrap">
            <span class="method-badge">Hiện vật</span>
          </div>
          <h3 class="method-title">Hỗ trợ vật tư thiết yếu</h3>
          <p class="method-desc">
            Chiến dịch chỉ tiếp nhận hiện vật theo danh mục do nhóm và Mái ấm thống nhất xác nhận. Hiện danh mục chính thức đang chờ đối chiếu thực tế.
          </p>
          <div class="method-example-box">
            <span class="example-label">Ví dụ vật tư theo đề xuất (chưa phải yêu cầu chính thức):</span>
            <p class="example-text">
              Phôi chuồn chuồn tre mộc, chân đế, tượng thạch cao, màu nước, cọ vẽ, mút xốp hoặc dụng cụ trò chơi an toàn.
            </p>
          </div>
          <div class="method-action">
            <a href="/minh-bach" class="btn btn-secondary btn-sm">
              Xem dự toán chi tiết &rarr;
            </a>
          </div>
        </div>

        <!-- Phương thức 2: Sản phẩm gây quỹ -->
        <div class="method-card card">
          <div class="method-icon-wrap">
            <span class="method-badge">Gây quỹ</span>
          </div>
          <h3 class="method-title">Tìm hiểu sản phẩm gây quỹ</h3>
          <p class="method-desc">
            Nhóm lên kế hoạch gây quỹ bằng các sản phẩm thủ công lưu niệm (chuồn chuồn tre, túi bút, túi vải). Mức giá, số lượng và kênh mở bán đang chờ phê duyệt.
          </p>
          <div class="method-example-box">
            <span class="example-label">Trạng thái bán:</span>
            <p class="example-text">
              Trạng thái mở bán chưa được xác nhận. Bản xem trước chưa nhận đơn hàng hay thanh toán trực tuyến.
            </p>
          </div>
          <div class="method-action">
            <a href="/san-pham" class="btn btn-primary btn-sm">
              Xem kế hoạch sản phẩm &rarr;
            </a>
          </div>
        </div>

        <!-- Phương thức 3: Kết nối & Truyền thông -->
        <div class="method-card card">
          <div class="method-icon-wrap">
            <span class="method-badge">Lan tỏa</span>
          </div>
          <h3 class="method-title">Kết nối và hỗ trợ truyền thông</h3>
          <p class="method-desc">
            Lan tỏa thông điệp vui chơi an toàn và tích cực của chiến dịch trong cộng đồng sinh viên và bạn bè theo các nội dung đã được nhóm thống nhất.
          </p>
          <div class="method-example-box">
            <span class="example-label">Nguyên tắc bảo vệ:</span>
            <p class="example-text">
              Không khai thác chuyện riêng, hoàn cảnh cá nhân hay hình ảnh chưa được phép của các em nhỏ tại Mái ấm.
            </p>
          </div>
          <div class="method-action">
            <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-secondary btn-sm">
              Tìm hiểu câu chuyện &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Quy trình tiếp nhận dự kiến -->
  <section class="section" aria-labelledby="workflow-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Kế hoạch phối hợp</span>
        </div>
        <h2 id="workflow-heading" class="section-title">
          Quy trình tiếp nhận dự kiến
        </h2>
        <p class="section-subtitle">
          Ba bước tiếp nhận hỗ trợ chặt chẽ, đảm bảo món quà trao tặng đúng người và đúng thời điểm.
        </p>
      </div>

      <div class="workflow-grid">
        {
          SUPPORT_WORKFLOW.map((item) => (
            <div class="workflow-card card">
              <div class="workflow-step-badge">{item.step}</div>
              <h3 class="workflow-title">{item.title}</h3>
              <p class="workflow-desc">{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="workflow-note card">
        <p>
          <strong>Lưu ý:</strong> Quy trình trên nằm trong đề xuất kế hoạch của nhóm Lăng Kính; các bước tiếp nhận và danh mục nhu cầu thực tế sẽ được triển khai sau khi đạt được sự thống nhất cùng Mái ấm.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Kênh liên hệ chính thức -->
  <section class="section section-soft" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge status-badge-neutral">Liên hệ</span>
        </div>
        <h2 id="contact-heading" class="section-title">
          Kênh liên hệ chính thức
        </h2>
        <p class="section-subtitle">
          Thông tin liên hệ phục vụ phối hợp và hỗ trợ chiến dịch.
        </p>
      </div>

      <div class="contact-box card">
        <div class="contact-status-header">
          <span class="contact-indicator" aria-hidden="true"></span>
          <h3 class="contact-status-title">Thông báo trạng thái liên hệ</h3>
        </div>

        <p class="contact-notice-text">
          {OFFICIAL_CONTACT.notice}
        </p>

        <div class="contact-explanation">
          <p>
            Để đảm bảo an toàn thông tin và tính chuẩn xác của chiến dịch:
          </p>
          <ul>
            <li>Bản xem trước chưa mở biểu mẫu đăng ký hay hệ thống nhận đóng góp trực tuyến.</li>
            <li>Không sử dụng số tài khoản cá nhân, mã QR hay các liên kết chuyển tiền chưa được xác thực.</li>
            <li>Kênh liên hệ chính thức của nhóm sẽ được đăng tải sau khi hoàn tất xác nhận và được cấp quyền công bố.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: FAQs -->
  <section class="section" aria-labelledby="support-faq-heading">
    <div class="container">
      <div class="section-header">
        <div class="badge-wrap">
          <span class="status-badge">Giải đáp thắc mắc</span>
        </div>
        <h2 id="support-faq-heading" class="section-title">
          Câu hỏi thường gặp về đồng hành
        </h2>
        <p class="section-subtitle">
          Giải đáp các thắc mắc phổ biến về việc tham gia hỗ trợ và phối hợp cùng nhóm Lăng Kính.
        </p>
      </div>

      <div class="faq-list">
        {
          SUPPORT_FAQS.map((faq) => (
            <details class="faq-item card">
              <summary class="faq-question">
                <span>{faq.question}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Navigation CTA Section -->
  <section class="section section-soft navigation-cta-section" aria-labelledby="nav-cta-heading">
    <div class="container">
      <div class="navigation-cta-card card">
        <h2 id="nav-cta-heading" class="navigation-cta-title">
          Tìm hiểu thêm về chiến dịch
        </h2>
        <p class="navigation-cta-desc">
          Khám phá chi tiết dự toán minh bạch hoặc tìm hiểu về các thành viên và nguyên tắc hoạt động của nhóm Lăng Kính.
        </p>
        <div class="navigation-cta-actions">
          <a href="/minh-bach" class="btn btn-primary">
            Xem minh bạch thu chi &rarr;
          </a>
          <a href="/ve-nhom" class="btn btn-secondary">
            Tìm hiểu nhóm Lăng Kính
          </a>
          <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-secondary">
            Xem câu chuyện dự án
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Breadcrumb Bar */
  .breadcrumb-bar {
    background-color: var(--color-surface-card);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--color-text-accent);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-text-muted);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Hero Section */
  .support-hero {
    padding: var(--space-8) 0 var(--space-6);
  }

  .support-hero-card {
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .badge-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .status-badge-neutral {
    background-color: var(--color-canvas-soft);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .support-title {
    font-size: var(--font-size-h1);
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0;
  }

  .support-slogan {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-accent);
    margin: 0;
  }

  .support-lead {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 720px;
  }

  .support-section-notice {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    line-height: 1.5;
  }

  .support-section-notice p {
    margin: 0;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .section-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Methods Grid */
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .method-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .method-icon-wrap {
    display: flex;
  }

  .method-badge {
    display: inline-block;
    padding: 3px 10px;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-accent);
  }

  .method-title {
    font-size: 1.1875rem;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.35;
  }

  .method-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }

  .method-example-box {
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .example-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .example-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  .method-action {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: 0.875rem;
  }

  /* Workflow Grid */
  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .workflow-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .workflow-step-badge {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background-color: var(--color-text-accent);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    font-weight: 800;
  }

  .workflow-title {
    font-size: 1.125rem;
    color: var(--color-text-primary);
    margin: 0;
  }

  .workflow-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .workflow-note {
    padding: var(--space-5);
    background-color: var(--color-surface-card);
    border-left: 4px solid var(--color-text-accent);
  }

  .workflow-note p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Contact Box */
  .contact-box {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
  }

  .contact-status-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-indicator {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background-color: #F59E0B;
    display: inline-block;
  }

  .contact-status-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .contact-notice-text {
    font-size: 1.0625rem;
    color: var(--color-text-accent);
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
  }

  .contact-explanation {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .contact-explanation p {
    margin: 0 0 var(--space-2) 0;
  }

  .contact-explanation ul {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* FAQs */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-item {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-card);
  }

  .faq-question {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-text-accent);
    transition: transform var(--transition-fast);
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }

  /* Navigation CTA */
  .navigation-cta-section {
    padding: var(--space-8) 0;
  }

  .navigation-cta-card {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .navigation-cta-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
    margin: 0;
  }

  .navigation-cta-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .navigation-cta-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Responsive Rules */
  @media (max-width: 1023px) {
    .methods-grid {
      grid-template-columns: 1fr;
    }

    .workflow-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .support-hero-card {
      padding: var(--space-5);
    }

    .contact-box {
      padding: var(--space-5);
    }

    .navigation-cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .navigation-cta-actions .btn {
      width: 100%;
    }
  }
</style>
