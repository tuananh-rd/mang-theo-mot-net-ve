---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import DonationPanel from '../components/DonationPanel.astro';
import DonationLedger from '../components/DonationLedger.astro';
import { SUPPORT_FAQS, DONATION_ACCOUNT, DONATIONS } from '../data/campaign';
import { isDonationOpen } from '../lib/donations';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Ủng hộ' }];
const open = isDonationOpen(DONATION_ACCOUNT);

const steps = [
  { title: 'Chuyển khoản', text: 'Quét mã QR hoặc chuyển tới tài khoản của dự án, ghi nội dung theo hướng dẫn.' },
  { title: 'Nhóm đối soát', text: 'Hai thành viên tài chính đối chiếu từng khoản với sao kê ngân hàng.' },
  { title: 'Công khai', text: 'Khoản của bạn xuất hiện trong bảng sao kê bên dưới, ai cũng kiểm tra được.' },
  { title: 'Trao quà', text: 'Tiền dùng cho buổi chơi và quà theo danh mục Mái ấm cần; báo cáo cuối có hóa đơn.' },
];

const otherWays = [
  { title: 'Mua quà lưu niệm', text: 'Chuồn chuồn tre và móc khóa do nhóm tự làm, khi mở bán.', href: '/san-pham', label: 'Xem quà lưu niệm' },
  { title: 'Góp vật phẩm', text: 'Theo đúng danh mục Mái ấm xác nhận, để món đồ đến đúng nơi cần.', href: '/minh-bach', label: 'Xem kế hoạch sử dụng' },
  { title: 'Chia sẻ dự án', text: 'Gửi trang này tới bạn bè để nhiều người biết đến buổi chơi.', href: '/du-an/mang-theo-mot-net-ve', label: 'Đọc về dự án' },
];
---

<Layout
  title="Ủng hộ dự án"
  description="Ủng hộ dự án Mang Theo Một Nét Vẽ qua chuyển khoản, với bảng sao kê công khai từng khoản ủng hộ."
  currentPath="/dong-hanh"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Ủng hộ"
    chip={open ? { kind: 'da-xac-nhan', label: 'Đang nhận ủng hộ' } : { kind: 'cho-xac-nhan', label: 'Sắp mở nhận ủng hộ' }}
    title="Ủng hộ một buổi chơi, một món quà"
    titleId="support-heading"
    lead="Mỗi khoản ủng hộ được ghi công khai, đối soát với ngân hàng và dùng đúng cho các em tại Mái ấm."
    description="Bạn chuyển khoản qua mã QR, nhóm đối soát rồi đăng lên bảng sao kê ngay tại trang này."
  />

  <section class="section section-first" aria-labelledby="donate-heading">
    <div class="container">
      <h2 id="donate-heading" class="sr-only">Thông tin chuyển khoản</h2>
      <DonationPanel account={DONATION_ACCOUNT} />
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Minh bạch từng khoản</span>
        <h2 id="steps-heading">Khoản ủng hộ của bạn đi đâu</h2>
      </div>
      <ol class="flow">
        {
          steps.map((s, i) => (
            <li class="flow-step lift">
              <span class="flow-num" aria-hidden="true">{i + 1}</span>
              <h3 class="flow-title">{s.title}</h3>
              <p class="flow-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="ledger-heading" id="sao-ke">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Sao kê</span>
        <h2 id="ledger-heading">Danh sách người ủng hộ</h2>
        <p>Chỉ hiển thị tên bạn chọn, số tiền, ngày và mã giao dịch rút gọn. Không hiển thị số tài khoản của người ủng hộ.</p>
      </div>
      <DonationLedger account={DONATION_ACCOUNT} entries={DONATIONS} />
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="ways-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Cách khác</span>
        <h2 id="ways-heading">Bạn cũng có thể</h2>
      </div>
      <ul class="ways">
        {
          otherWays.map((w) => (
            <li class="way lift">
              <h3 class="way-title">{w.title}</h3>
              <p class="way-text">{w.text}</p>
              <a href={w.href} class="link-arrow">{w.label} <span class="arrow" aria-hidden="true">→</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="support-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="support-faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion faqs={SUPPORT_FAQS} idPrefix="support-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="support-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="support-cta-heading">Tiền được sử dụng thế nào?</h2>
        <p>Kế hoạch chi cho buổi chơi, quà và báo cáo sau dự án.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/minh-bach" class="btn btn-primary">Xem minh bạch</a>
        <a href="/ve-nhom" class="link-arrow">Về nhóm Lăng Kính <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-first {
    padding-top: var(--space-10);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .flow-num {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--brand-ink);
    color: #ffffff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .flow-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .flow-text {
    margin: 0;
  }

  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .way-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .way-text {
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 1023px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ways {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 767px) {
    .section-first {
      padding-top: var(--space-6);
    }

    .flow {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .flow-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: 2px;
      padding: var(--space-4);
    }

    .flow-num {
      grid-row: span 2;
    }

    .way {
      padding: var(--space-4);
    }
  }
</style>
