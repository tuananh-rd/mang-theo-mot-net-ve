---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import StatusChip from '../components/StatusChip.astro';
import { SUPPORT_FAQS, SUPPORT_RULES, SUPPORT_WORKFLOW, OFFICIAL_CONTACT } from '../data/campaign';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Cách đồng hành' }];
const contactReady = OFFICIAL_CONTACT.status === 'confirmed' && (OFFICIAL_CONTACT.email || OFFICIAL_CONTACT.phone);

const ways = [
  {
    tag: 'Hiện vật',
    title: 'Góp vật tư',
    text: 'Vật tư cho buổi chơi hoặc nguyên liệu gây quỹ, theo đúng danh mục nhóm và Mái ấm đã thống nhất.',
    link: { href: '/minh-bach#expenses-heading', label: 'Xem chi phí dự kiến' },
  },
  {
    tag: 'Mua hàng',
    title: 'Mua sản phẩm gây quỹ',
    text: 'Chuồn chuồn tre, móc khóa và đồ ăn do nhóm chuẩn bị, khi mở bán.',
    link: { href: '/san-pham', label: 'Xem sản phẩm' },
  },
  {
    tag: 'Lan tỏa',
    title: 'Chia sẻ câu chuyện',
    text: 'Chia sẻ nội dung chính thức của nhóm để nhiều người biết đến dự án.',
    link: { href: '/du-an/mang-theo-mot-net-ve', label: 'Đọc về dự án' },
  },
];
---

<Layout
  title="Cách đồng hành cùng dự án"
  description="Các cách đồng hành cùng dự án Mang Theo Một Nét Vẽ và cách nhóm Lăng Kính tiếp nhận hỗ trợ."
  currentPath="/dong-hanh"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Đồng hành"
    title="Cùng mang quà đúng nhu cầu"
    titleId="support-heading"
    lead="Mỗi sự hỗ trợ đều đi đúng vào thứ Mái ấm cần, và được ghi nhận minh bạch."
    description="Nhóm sẽ nhận hỗ trợ khi danh mục nhu cầu và kênh liên hệ được xác nhận. Hiện website chưa nhận tiền, hiện vật hay đơn hàng."
    summaryTitle="Bạn có thể làm ngay"
  >
    <div slot="panel-extra" class="now">
      <ul class="now-list">
        <li class="now-yes"><a href="/du-an/mang-theo-mot-net-ve">Tìm hiểu buổi chơi</a></li>
        <li class="now-yes"><a href="/san-pham">Xem sản phẩm và giá tham khảo</a></li>
        <li class="now-yes"><a href="/minh-bach">Xem kế hoạch tài chính</a></li>
        <li class="now-wait">Gửi hỗ trợ, đặt hàng: khi có kênh chính thức</li>
      </ul>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="ways-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Ba cách</span>
        <h2 id="ways-heading">Bạn có thể đồng hành bằng</h2>
      </div>
      <ul class="ways">
        {
          ways.map((w) => (
            <li class="way lift">
              <span class="way-tag">{w.tag}</span>
              <h3 class="way-title">{w.title}</h3>
              <p class="way-text">{w.text}</p>
              <a href={w.link.href} class="link-arrow">{w.link.label} <span class="arrow" aria-hidden="true">→</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="rules-heading">
    <div class="container">
      <div class="two-col">
        <div class="reveal">
          <span class="eyebrow">Quy trình</span>
          <h2 id="rules-heading" class="col-title">Nhóm tiếp nhận thế nào</h2>
          <ol class="steps">
            {
              SUPPORT_WORKFLOW.map((s) => (
                <li class="step">
                  <span class="step-num" aria-hidden="true">{s.step}</span>
                  <div>
                    <h3 class="step-title">{s.title}</h3>
                    <p class="step-desc">{s.description}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="reveal">
          <span class="eyebrow">Cam kết</span>
          <h3 class="col-title col-title--sm">Mỗi đóng góp đều rõ ràng</h3>
          <ul class="check-list">
            {SUPPORT_RULES.map((r) => <li>{r}</li>)}
          </ul>
          <div class="contact">
            {contactReady ? (
              <StatusChip kind="da-xac-nhan" label="Kênh liên hệ đã xác nhận" />
            ) : (
              <StatusChip kind="cho-xac-nhan" label="Kênh liên hệ sắp công bố" />
            )}
            <p>Nhóm chưa có tài khoản nhận tiền, mã QR hay biểu mẫu nào đang hoạt động. Thông tin liên hệ sẽ được đăng tại đây khi được duyệt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="support-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="support-faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion faqs={SUPPORT_FAQS} idPrefix="support-faq" />
    </div>
  </section>

  <section class="cta-band" aria-labelledby="support-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="support-cta-heading">Ai đứng sau dự án?</h2>
        <p>Bảy sinh viên FPT Hà Nội và cách nhóm làm việc.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/ve-nhom" class="btn btn-primary">Về nhóm Lăng Kính</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow > :global(*) {
    max-width: 880px;
  }

  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .now-list li {
    position: relative;
    padding: var(--space-2) 0 var(--space-2) 28px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .now-list li:last-child {
    border-bottom: none;
  }

  .now-list a {
    color: var(--ink);
    font-weight: 600;
    text-underline-offset: 3px;
    display: inline-flex;
    min-height: 28px;
    align-items: center;
  }

  .now-list a:hover {
    color: var(--brand);
  }

  .now-yes::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 15px;
    width: 13px;
    height: 7px;
    border-left: 2px solid var(--status-confirmed-text);
    border-bottom: 2px solid var(--status-confirmed-text);
    transform: rotate(-45deg);
  }

  .now-wait {
    color: var(--status-pending-text) !important;
    font-weight: 600;
  }

  .now-wait::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 13px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--status-pending-text);
  }

  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .way-tag {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--brand);
  }

  .way-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .way-text {
    margin: 0;
    flex-grow: 1;
  }

  .col-title {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    margin-bottom: var(--space-5);
  }

  .col-title--sm {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: var(--space-4);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .step {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: var(--space-4);
  }

  .step-num {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--brand);
    color: var(--brand);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
    background: #ffffff;
  }

  .step-title {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    margin: 0;
  }

  .step-desc {
    margin: 0;
  }

  .contact {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .contact p {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .ways {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 767px) {
    .way {
      padding: var(--space-4);
    }
  }
</style>
