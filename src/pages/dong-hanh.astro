---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import DonationPanel from '../components/DonationPanel.astro';
import DonationLedger from '../components/DonationLedger.astro';
import ContactCard from '../components/ContactCard.astro';
import { SUPPORT_FAQS, DONATION_ACCOUNT, DONATION_LEDGER } from '../data/campaign';
import { isDonationOpen } from '../lib/donations';
import { formatVND } from '../lib/finance';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Ủng hộ' }];
const open = isDonationOpen(DONATION_ACCOUNT);

const steps = [
  { title: 'Chuyển khoản', text: 'Quét mã QR hoặc chuyển tới tài khoản của dự án, ghi nội dung theo hướng dẫn.' },
  { title: 'Nhóm đối soát', text: 'Thành viên tài chính cùng một thành viên khác đối chiếu từng khoản với sao kê ngân hàng.' },
  { title: 'Công bố sao kê', text: 'Danh sách ủng hộ được cập nhật công khai tại bảng sao kê sau mỗi lần đối soát.' },
  { title: 'Trao quà', text: 'Tiền dùng cho buổi chơi và quà theo danh mục Mái ấm cần; báo cáo cuối có hóa đơn.' },
];

const otherWays = [
  { title: 'Mua quà lưu niệm', text: 'Chuồn chuồn tre và móc khóa do nhóm tự làm, khi mở bán.', href: '/san-pham', label: 'Xem quà lưu niệm' },
  { title: 'Góp vật phẩm', text: 'Theo đúng danh mục Mái ấm xác nhận; hãy liên hệ nhóm trước khi gửi.', href: '#lien-he', label: 'Liên hệ nhóm' },
  { title: 'Chia sẻ dự án', text: 'Gửi trang này tới bạn bè để nhiều người biết đến buổi chơi.', href: '/du-an/mang-theo-mot-net-ve', label: 'Đọc về dự án' },
];
---

<Layout
  title="Ủng hộ dự án"
  description="Ủng hộ dự án Mang Theo Một Nét Vẽ qua chuyển khoản, với bảng sao kê công khai từng khoản ủng hộ."
  currentPath="/dong-hanh"
>
  <PageHero
    variant="plain"
    breadcrumbs={breadcrumbs}
    eyebrow="Ủng hộ"
    chip={open ? { kind: 'da-xac-nhan', label: 'Đang nhận ủng hộ' } : { kind: 'cho-xac-nhan', label: 'Sắp mở nhận ủng hộ' }}
    title="Ủng hộ một buổi chơi, một món quà"
    titleId="support-heading"
    lead={`Mục tiêu gây quỹ ${formatVND(DONATION_ACCOUNT.goalAmount)} cho buổi chơi và quà tặng các em tại Mái ấm.`}
    image={{ src: '/images/trang/dong-hanh-800.webp', srcset: '/images/trang/dong-hanh-480.webp 480w, /images/trang/dong-hanh-800.webp 800w, /images/trang/dong-hanh-1200.webp 1200w', sizes: '(max-width: 1023px) 100vw, 60vw', alt: 'Hai người cùng đẩy một chiếc xe và mỉm cười; ảnh do chủ dự án cung cấp.', position: '50% 45%', layout: 'support', width: 1280, height: 960 }}
  >
    <div slot="hero-bottom" class="transfer-stepper-wrap">
      <ol class="transfer-stepper" aria-label="Ba bước ủng hộ">
        <li class="stepper-item">
          <span class="stepper-num" aria-hidden="true">01</span>
          <div class="stepper-content">
            <strong class="stepper-title">Quét hoặc tải QR</strong>
            <p class="stepper-desc">Quét trực tiếp hoặc tải ảnh về máy (nếu app ngân hàng hỗ trợ quét từ thư viện).</p>
          </div>
        </li>
        <li class="stepper-item">
          <span class="stepper-num" aria-hidden="true">02</span>
          <div class="stepper-content">
            <strong class="stepper-title">Ghi đúng nội dung</strong>
            <p class="stepper-desc">Ghi đúng cú pháp <code>MTMNV Tên của bạn</code> để nhóm đối soát chính xác.</p>
          </div>
        </li>
        <li class="stepper-item">
          <span class="stepper-num" aria-hidden="true">03</span>
          <div class="stepper-content">
            <strong class="stepper-title">Theo dõi sao kê</strong>
            <p class="stepper-desc">Khoản ủng hộ xuất hiện tại bảng sao kê sau các đợt đối soát của nhóm.</p>
          </div>
        </li>
      </ol>
    </div>
  </PageHero>

  <section class="section section-first" aria-labelledby="donate-heading">
    <div class="container">
      <h2 id="donate-heading" class="sr-only">Thông tin chuyển khoản</h2>
      <DonationPanel account={DONATION_ACCOUNT} />
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="ledger-heading" id="sao-ke">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Sao kê</span>
        <h2 id="ledger-heading">Tiến độ và danh sách ủng hộ</h2>
        <p>Bảng sao kê chỉ ghi nhận các khoản ủng hộ qua tài khoản đã xác minh với ngân hàng (hiện là một phần, ghi rõ phạm vi bên dưới); tiền bán quà lưu niệm gây quỹ được ghi sổ riêng. Thông tin hiển thị gồm tên bạn đồng ý hiển thị, số tiền và ngày nhận.</p>
      </div>
      <DonationLedger account={DONATION_ACCOUNT} ledger={DONATION_LEDGER} />
      <div class="section-actions">
        <a href="/minh-bach#quy-trinh" class="link-arrow">Xem quy trình đối soát và công bố <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Khoản ủng hộ của bạn đi đâu: Dòng tiến trình 4 bước sáng (Thay thế dải dark lặp lại) -->
  <section class="section section-process" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Minh bạch từng khoản</span>
        <h2 id="steps-heading">Khoản ủng hộ của bạn đi đâu</h2>
        <p>Quy trình khép kín từ lúc nhận khoản ủng hộ tới khi trao quà tận tay các em.</p>
      </div>
      <div class="flow-chain-wrap">
        <ol class="flow-chain">
          {
            steps.map((s, i) => (
              <li class="chain-step">
                <span class="chain-badge" aria-hidden="true">0{i + 1}</span>
                <div class="chain-text">
                  <h3 class="chain-title">{s.title}</h3>
                  <p class="chain-desc">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="process-actions">
        <a href="/minh-bach#dong-tien" class="link-arrow">Xem quy trình nhận, đối soát, công bố và trao quà <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="ways-heading" id="lien-he">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Cách khác</span>
        <h2 id="ways-heading">Bạn cũng có thể</h2>
      </div>
      <ul class="ways">
        {
          otherWays.map((w) => (
            <li class="way lift">
              <h3 class="way-title">{w.title}</h3>
              <p class="way-text">{w.text}</p>
              <a href={w.href} class="link-arrow">{w.label} <span class="arrow" aria-hidden="true">→</span></a>
            </li>
          ))
        }
      </ul>
      <div class="contact-wrap reveal">
        <ContactCard />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="support-faq-heading">
    <div class="container narrow">
      <div class="section-header">
        <span class="eyebrow">Hỏi đáp</span>
        <h2 id="support-faq-heading">Câu hỏi thường gặp</h2>
      </div>
      <FaqAccordion faqs={SUPPORT_FAQS} idPrefix="support-faq" />
    </div>
  </section>
</Layout>

<style>
  .transfer-stepper-wrap {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .transfer-stepper {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .stepper-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-subtle);
  }

  .stepper-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stepper-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stepper-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .stepper-desc {
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }

  .stepper-desc code {
    background: var(--surface-alt);
    padding: 2px 4px;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--brand);
    font-weight: 600;
  }

  .section-first {
    padding-top: var(--space-10);
  }

  .narrow > :global(*) {
    max-width: 880px;
  }

  /* 4-Step Process Section (Replaced section-dark) */
  .section-process {
    background: #ffffff;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-top: 1px solid var(--line);
  }

  .flow-chain-wrap {
    margin-top: var(--space-6);
  }

  .flow-chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .chain-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .chain-badge {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--cta);
  }

  .chain-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-2) 0;
  }

  .chain-desc {
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }

  .process-actions {
    margin-top: var(--space-8);
    text-align: center;
  }

  .contact-wrap {
    margin-top: var(--space-6);
  }

  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .way {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .way-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .way-text {
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 1023px) {
    .transfer-stepper {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .flow-chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ways {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  @media (max-width: 767px) {
    .transfer-stepper-wrap {
      margin-top: var(--space-2);
      padding-top: var(--space-2);
    }

    .transfer-stepper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .stepper-item {
      padding: var(--space-2) var(--space-1);
      flex-direction: column;
      gap: 2px;
      text-align: center;
      align-items: center;
      border-radius: var(--radius-sm);
      box-shadow: none;
    }

    .stepper-num {
      font-size: 0.9375rem;
      line-height: 1;
    }

    .stepper-content {
      gap: 2px;
    }

    .stepper-title {
      font-size: 0.75rem;
      line-height: 1.25;
    }

    .stepper-desc {
      display: none;
    }

    .section-first {
      padding-top: var(--space-2);
    }

    .flow-chain {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .chain-step {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: var(--space-3);
      row-gap: 2px;
      padding: var(--space-4);
    }

    .chain-badge {
      grid-row: span 2;
    }

    .way {
      padding: var(--space-4);
    }
  }
</style>
