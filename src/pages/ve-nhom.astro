---
import Layout from '../layouts/Layout.astro';
import { TEAM_INFO } from '../data/campaign';
---

<Layout
  title="Về nhóm Lăng Kính"
  description="Giới thiệu nhóm Lăng Kính, 7 sinh viên lớp AI2015, học phần SSG105, Đại học FPT Hà Nội."
  currentPath="/ve-nhom"
>
  <div class="shell-container container section">
    <div class="shell-card card">
      <div class="badge-wrap">
        <span class="status-badge">Bản xem trước</span>
      </div>

      <h1 class="shell-title">Về nhóm {TEAM_INFO.name}</h1>
      <p class="shell-subtitle">{TEAM_INFO.course}</p>

      <div class="shell-notice">
        <p>
          <strong>Trang đang được hoàn thiện trong bản xem trước.</strong>
        </p>
        <p>
          Thông tin chi tiết về các thành viên, phân công nhiệm vụ và nhật ký thực hiện dự án sẽ được cập nhật sau khi chủ dự án xác nhận quyền công bố thông tin cá nhân theo đúng quy định.
        </p>
      </div>

      <div class="shell-actions">
        <a href="/" class="btn btn-primary">
          &larr; Quay lại trang chủ
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .shell-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .shell-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .shell-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
  }

  .shell-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .shell-notice {
    background-color: var(--color-canvas-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .shell-actions {
    margin-top: var(--space-4);
  }

  @media (max-width: 767px) {
    .shell-card {
      padding: var(--space-5);
    }
  }
</style>
