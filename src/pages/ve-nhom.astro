---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCard from '../components/ContactCard.astro';
import { TEAM_INFO, TEAM_PRINCIPLES, TEAM_MEMBERS, CAMPAIGN_PROJECT } from '../data/campaign';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Về nhóm' }];

const summaryItems = [
  { label: 'Thành viên', value: `${TEAM_MEMBERS.length} sinh viên lớp ${TEAM_INFO.classId}` },
  { label: 'Trường', value: 'Đại học FPT Hà Nội' },
  {
    label: 'Dự án',
    value: 'Mang Theo Một Nét Vẽ',
    chip: { kind: 'da-xac-nhan' as const, label: CAMPAIGN_PROJECT.statusNotice },
  },
];
---

<Layout
  title="Về nhóm Lăng Kính"
  description="Nhóm Lăng Kính: 7 sinh viên lớp AI2015, Đại học FPT Hà Nội — thành viên, vai trò và những nguyên tắc nhóm giữ."
  currentPath="/ve-nhom"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Về nhóm"
    title="Nhóm Lăng Kính"
    titleId="team-heading"
    lead="Bảy sinh viên muốn mang đến một buổi chơi phù hợp và một món quà đúng nhu cầu."
    description="Nhóm tự chuẩn bị buổi chơi, làm quà lưu niệm gây quỹ, ghi sổ ủng hộ và công bố báo cáo kết quả. Kế hoạch tổ chức và cách hỗ trợ cần được thống nhất với Mái ấm trước khi triển khai."
    summaryTitle="Thông tin nhóm"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="members-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Thành viên</span>
        <h2 id="members-heading">Gặp gỡ nhóm Lăng Kính</h2>
      </div>

      <ul class="members">
        {
          TEAM_MEMBERS.map((m) => (
            <li class="member">
              <div class="member-photo">
                <img src={m.photo} alt={`Ảnh ${m.name}`} width="480" height="600" loading="lazy" decoding="async" />
              </div>
              <div class="member-body">
                <span class="member-role">{m.role}</span>
                <h3 class="member-name">{m.name}</h3>
                <p class="member-desc">{m.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="principles-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Nguyên tắc hoạt động</span>
        <h2 id="principles-heading">Năm nguyên tắc của nhóm</h2>
      </div>
      <ul class="ruled-list">
        {
          TEAM_PRINCIPLES.map((p) => (
            <li>
              <h3 class="ruled-title">{p.title}</h3>
              <p class="ruled-desc">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <h2 id="contact-heading" class="sr-only">Liên hệ nhóm</h2>
      <div class="reveal"><ContactCard /></div>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="team-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="team-cta-heading">Nhóm sẽ tổ chức buổi chơi thế nào?</h2>
        <p>Bốn góc hoạt động, lịch hai buổi và tiến độ dự án.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary">Xem dự án</a>
        <a href="/dong-hanh" class="link-arrow">Ủng hộ dự án <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hàng cuối được căn giữa để 7 thẻ không để ô trống lệch */
  .members {
    --cols: 4;
    --gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }

  .member {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .member-photo {
    aspect-ratio: 4 / 5;
    background: var(--surface-alt);
    overflow: hidden;
  }

  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .member-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .member-role {
    align-self: flex-start;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--tint-rose-ink);
    background: var(--tint-rose);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-1);
  }

  .member-name {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .member-desc {
    margin: 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  @media (hover: hover) {
    .member:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-raised);
      border-color: transparent;
    }

    .member:hover .member-photo img {
      transform: scale(1.04);
    }
  }

  @media (max-width: 1023px) {
    .members {
      --cols: 3;
    }
  }

  @media (max-width: 767px) {
    .members {
      --cols: 2;
      --gap: var(--space-3);
    }

    .member-body {
      padding: var(--space-3);
    }

    .member-name {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }
  }
</style>
