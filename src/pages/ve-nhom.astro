---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCard from '../components/ContactCard.astro';
import { TEAM_PRINCIPLES, TEAM_MEMBERS, TEAM_INFO } from '../data/campaign';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Về nhóm' }];
---

<Layout
  title="Về nhóm Lăng Kính"
  description="Nhóm Lăng Kính: 7 sinh viên lớp AI2015, Đại học FPT Hà Nội — thành viên, vai trò và những nguyên tắc nhóm giữ."
  currentPath="/ve-nhom"
>
  <PageHero
    variant="masthead"
    breadcrumbs={breadcrumbs}
    eyebrow="Về nhóm"
    title={TEAM_INFO.name ? `Nhóm ${TEAM_INFO.name}` : "Nhóm Lăng Kính"}
    titleId="team-heading"
    lead="Bảy sinh viên muốn mang đến một buổi chơi phù hợp và một món quà đúng nhu cầu."
    description={TEAM_INFO.description || "7 sinh viên lớp AI2015 · Đại học FPT Hà Nội · Nhóm tự chuẩn bị buổi chơi, làm quà lưu niệm gây quỹ, ghi sổ ủng hộ và công bố báo cáo kết quả."}
    image={{ src: '/images/trang/ve-nhom-800.webp', srcset: '/images/trang/ve-nhom-480.webp 480w, /images/trang/ve-nhom-800.webp 800w, /images/trang/ve-nhom-1200.webp 1200w', sizes: '(max-width: 1023px) 100vw, 42vw', alt: 'Một em nhỏ cầm micro trong không gian sinh hoạt; ảnh do chủ dự án cung cấp.', position: '55% 45%', width: 2000, height: 1330 }}
  />

  <section class="section section-members" aria-labelledby="members-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Thành viên</span>
        <h2 id="members-heading">Gương mặt và trách nhiệm</h2>
        <p>Mỗi thành viên phụ trách một phần việc cụ thể trong khâu tổ chức, hậu cần và tài chính của dự án.</p>
      </div>

      <!-- Lưới 4 cột desktop (hàng 1: 4 người, hàng 2: 3 người căn trái), 2 cột mobile -->
      <ul class="members-grid">
        {
          TEAM_MEMBERS.map((m) => (
            <li class="member-card">
              <div class="member-photo-frame">
                <img
                  src={m.photo}
                  alt={`Ảnh ${m.name}`}
                  width="480"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="member-info">
                <span class="member-role-badge">{m.role}</span>
                <h3 class="member-full-name">{m.name}</h3>
                <p class="member-bio">{m.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Năm nguyên tắc trên dải xanh ngọc phẳng, đánh số 01-05 lớn -->
  <section class="section section-principles band" aria-labelledby="principles-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Nguyên tắc hoạt động</span>
        <h2 id="principles-heading">Năm cam kết của nhóm Lăng Kính</h2>
        <p>Những nguyên tắc cốt lõi được nhóm thống nhất ngay từ đề xuất kế hoạch ban đầu.</p>
      </div>

      <ul class="principles-list">
        {
          TEAM_PRINCIPLES.map((p, idx) => (
            <li class="principle-item">
              <span class="principle-number" aria-hidden="true">0{idx + 1}</span>
              <div class="principle-body">
                <h3 class="principle-title">{p.title}</h3>
                <p class="principle-desc">{p.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-contact" aria-labelledby="contact-heading">
    <div class="container">
      <h2 id="contact-heading" class="sr-only">Liên hệ nhóm</h2>
      <div class="reveal"><ContactCard /></div>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="team-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="team-cta-heading">Nhóm sẽ tổ chức buổi chơi thế nào?</h2>
        <p>Bốn góc hoạt động, lịch hai buổi và tiến độ dự án.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary">Xem dự án</a>
        <a href="/dong-hanh" class="link-arrow">Ủng hộ dự án <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-members {
    background: #ffffff;
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  /* Lưới thành viên 4 cột desktop, người lẻ căn trái tự nhiên */
  .members-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  /* Thẻ thành viên không khung viền hộp nặng */
  .member-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .member-photo-frame {
    aspect-ratio: 4 / 5;
    background: var(--surface-alt);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .member-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  @media (hover: hover) {
    .member-card:hover .member-photo-frame img {
      transform: scale(1.04);
    }
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .member-role-badge {
    align-self: flex-start;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 700;
    color: var(--brand);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 2px;
  }

  .member-full-name {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .member-bio {
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }

  /* Năm nguyên tắc trên nền surface-alt với số đánh dấu lớn */
  .section-principles {
    border-top: none;
    padding-top: var(--space-12);
    padding-bottom: var(--space-14);
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .principle-item {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: baseline;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid rgba(19, 38, 75, 0.28);
  }

  .principle-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .principle-number {
    font-size: 3rem;
    line-height: 1;
    font-weight: 800;
    color: var(--brand-ink);
    font-feature-settings: 'tnum';
    user-select: none;
  }

  .principle-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .principle-title {
    font-size: 1.375rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0;
  }

  .principle-desc {
    font-size: var(--font-size-body);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    max-width: var(--prose-max-width);
  }

  .section-contact {
    background: #ffffff;
    border-top: 1px solid var(--line);
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
  }

  @media (max-width: 1023px) {
    .members-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .members-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-3);
    }

    .principle-item {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .principle-number {
      font-size: 2.25rem;
    }

    .member-full-name {
      font-size: 1.125rem;
    }
  }
</style>
