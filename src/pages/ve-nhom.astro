---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { TEAM_INFO, TEAM_PRINCIPLES, TEAM_AREAS } from '../data/campaign';

const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Về nhóm' }];
const totalMembers = TEAM_AREAS.reduce((sum, a) => sum + a.members, 0);

const summaryItems = [
  { label: 'Thành viên', value: `${TEAM_INFO.size} sinh viên lớp ${TEAM_INFO.classId}` },
  { label: 'Trường', value: 'Đại học FPT Hà Nội' },
  { label: 'Dự án', value: 'Mang Theo Một Nét Vẽ' },
];
---

<Layout
  title="Về nhóm Lăng Kính"
  description="Nhóm Lăng Kính: 7 sinh viên lớp AI2015, Đại học FPT Hà Nội — cách nhóm làm việc và những nguyên tắc nhóm giữ."
  currentPath="/ve-nhom"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Về nhóm"
    title="Nhóm Lăng Kính"
    titleId="team-heading"
    lead="Bảy sinh viên muốn mang đến một buổi chơi phù hợp và một món quà đúng nhu cầu."
    description="Nhóm tự chuẩn bị buổi chơi, làm hàng gây quỹ, giữ sổ thu chi và báo cáo kết quả. Mái ấm đồng hành và quyết định cách hỗ trợ các em."
    summaryTitle="Thông tin nhóm"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Cách nhóm làm việc</span>
        <h2 id="areas-heading">{totalMembers} thành viên, năm mảng việc</h2>
        <p>Tên và hình ảnh từng thành viên sẽ được giới thiệu khi mỗi người đồng ý công bố.</p>
      </div>

      <ul class="areas">
        {
          TEAM_AREAS.map((a) => (
            <li class="area lift">
              <span class="area-count">{a.members} thành viên</span>
              <h3 class="area-title">{a.title}</h3>
              <p class="area-desc">{a.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="principles-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Điều nhóm giữ</span>
        <h2 id="principles-heading">Năm nguyên tắc</h2>
      </div>
      <ul class="ruled-list">
        {
          TEAM_PRINCIPLES.map((p) => (
            <li>
              <h3 class="ruled-title">{p.title}</h3>
              <p class="ruled-desc">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="team-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="team-cta-heading">Nhóm sẽ tổ chức buổi chơi thế nào?</h2>
        <p>Bốn góc hoạt động, cách chuẩn bị và lộ trình của dự án.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary">Xem dự án</a>
        <a href="/dong-hanh" class="link-arrow">Cách đồng hành <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .area {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  /* 3 + 2: hai thẻ cuối rộng hơn, không để ô trống */
  .area:nth-child(4),
  .area:nth-child(5) {
    grid-column: span 3;
  }

  .area-count {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--brand);
  }

  .area-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .area-desc {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .area,
    .area:nth-child(4) {
      grid-column: span 1;
    }

    .area:nth-child(5) {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .areas {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .area,
    .area:nth-child(4),
    .area:nth-child(5) {
      grid-column: auto;
      padding: var(--space-4);
    }
  }
</style>
