---
import Layout from '../../layouts/Layout.astro';
import { getPublishedJournalEntries, type JournalEntry } from '../../data/journal';

export function getStaticPaths() {
  const publishedEntries = getPublishedJournalEntries();
  return publishedEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: JournalEntry;
}

const { entry } = Astro.props;

function formatDate(d: string): string {
  const parts = d.split('-');
  if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
  return d;
}

const breadcrumbs = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Nhật ký', href: '/nhat-ky' },
  { label: entry.title },
];

const eventStatusSuffix = entry.eventStatus === 'planned' ? ' (dự kiến)' : '';

const allPublished = getPublishedJournalEntries();
const otherEntries = allPublished.filter((e) => e.slug !== entry.slug).slice(0, 2);
---

<Layout
  title={`${entry.title} — Nhật ký`}
  description={entry.summary}
  currentPath="/nhat-ky"
>
  <!-- Breadcrumb Navigation Bar -->
  <div class="article-page-nav">
    <div class="container article-container-narrow">
      <nav class="breadcrumb-nav" aria-label="Đường dẫn trang">
        <ol class="breadcrumb-list">
          {breadcrumbs.map((item, index) => {
            const isLast = index === breadcrumbs.length - 1;
            return (
              <li class="breadcrumb-item">
                {isLast || !item.href ? (
                  <span class="breadcrumb-current" aria-current={isLast ? 'page' : undefined}>
                    {item.label}
                  </span>
                ) : (
                  <a href={item.href} class="breadcrumb-link">
                    {item.label}
                  </a>
                )}
                {!isLast && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
              </li>
            );
          })}
        </ol>
      </nav>
    </div>
  </div>

  <!-- Đầu bài trong cột đọc căn giữa, nền canvas phẳng (Kiểu E) -->
  <header class="article-header">
    <div class="container article-container-narrow">
      <div class="article-meta-row">
        <span class="article-category-tag">{entry.categoryLabel}</span>
        <span class="article-meta-sep" aria-hidden="true">·</span>
        <span class="article-meta-date">Biên tập: {formatDate(entry.publishedAt)}</span>
        {entry.eventDate && (
          <>
            <span class="article-meta-sep" aria-hidden="true">·</span>
            <span class="article-event-chip">
              Sự kiện: {formatDate(entry.eventDate)}{eventStatusSuffix}
            </span>
          </>
        )}
      </div>

      <h1 id="article-heading" class="article-title">
        {entry.title}
      </h1>

      <p class="article-lead">
        {entry.summary}
      </p>
    </div>
  </header>

  <!-- Ảnh bìa bài viết (rộng 960px, lớn hơn cột đọc nhưng vừa vặn khung hình) -->
  {
    entry.coverImage && (
      <div class="container article-cover-container">
        <figure class="article-featured-image">
          <div class="article-cover-img-wrap">
            <img
              src={entry.coverImage.src}
              alt={entry.coverImage.alt}
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="article-image-caption">
            <span>{entry.coverImage.caption}</span>
            {entry.coverImage.creditName && (
              <span class="article-credit">
                Nguồn:{' '}
                {entry.coverImage.creditUrl ? (
                  <a
                    href={entry.coverImage.creditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-link"
                  >
                    {entry.coverImage.creditName} ({entry.coverImage.creditSource || 'Stock'})
                  </a>
                ) : (
                  `${entry.coverImage.creditName} (${entry.coverImage.creditSource || 'Stock'})`
                )}
              </span>
            )}
          </figcaption>
        </figure>
      </div>
    )
  }

  <!-- Thân bài đọc 68ch và điều hướng cuối bài -->
  <article class="article-body-section">
    <div class="container article-container-narrow">
      <!-- Khối nội dung có cấu trúc -->
      <div class="article-content prose">
        {
          entry.content.map((block) => {
            if (block.type === 'paragraph') {
              return <p class="article-p">{block.text}</p>;
            }
            if (block.type === 'heading') {
              if (block.level === 3) {
                return <h3 class="article-h3">{block.text}</h3>;
              }
              return <h2 class="article-h2">{block.text}</h2>;
            }
            if (block.type === 'list') {
              return (
                <ul class="article-list">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              );
            }
            if (block.type === 'callout') {
              return (
                <aside class="article-callout" role="note">
                  <p class="article-callout-text">{block.text}</p>
                </aside>
              );
            }
            if (block.type === 'quote') {
              return (
                <blockquote class="article-quote">
                  <p>{block.text}</p>
                  {block.cite && <cite>— {block.cite}</cite>}
                </blockquote>
              );
            }
            if (block.type === 'image') {
              return (
                <figure class="article-inline-figure">
                  <img src={block.src} alt={block.alt} loading="lazy" decoding="async" />
                  <figcaption class="article-image-caption">
                    <span>{block.caption}</span>
                    {block.creditName && (
                      <span class="article-credit">Nguồn: {block.creditName}</span>
                    )}
                  </figcaption>
                </figure>
              );
            }
            return null;
          })
        }
      </div>

      <!-- Khối bài viết khác (Thay thế CTA mơ theo review RC15) -->
      {
        otherEntries.length > 0 && (
          <section class="other-articles-section" aria-labelledby="other-articles-heading">
            <h2 id="other-articles-heading" class="other-articles-title">Bài viết khác trên nhật ký</h2>
            <div class="other-articles-list">
              {otherEntries.map((other) => (
                <a href={`/nhat-ky/${other.slug}`} class="other-article-card">
                  <div class="other-article-meta">
                    <span class="other-category">{other.categoryLabel}</span>
                    <span class="other-date">{formatDate(other.publishedAt)}</span>
                  </div>
                  <h3 class="other-title">{other.title}</h3>
                  <p class="other-summary">{other.summary}</p>
                  <span class="other-read-more">Đọc bài <span aria-hidden="true">→</span></span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Điều hướng cuối bài -->
      <div class="article-footer-nav">
        <a href="/nhat-ky" class="btn btn-secondary">
          ← Danh sách nhật ký
        </a>
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-secondary">
          Xem thông tin toàn bộ dự án
        </a>
        <a href="/dong-hanh" class="btn btn-primary">
          Ủng hộ quỹ dự án →
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Breadcrumbs */
  .article-page-nav {
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) 0;
  }

  .breadcrumb-nav {
    font-size: var(--font-size-small);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb-link {
    color: var(--ink-2);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--line-strong);
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--ink);
    font-weight: 600;
  }

  /* Khung chiều rộng đọc tối ưu 68ch ~ 760px */
  .article-container-narrow {
    max-width: 760px;
    margin: 0 auto;
  }

  /* Article Header (Masthead Kiểu E) */
  .article-header {
    background: #ffffff;
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .article-category-tag {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-meta-sep {
    color: var(--line-strong);
  }

  .article-meta-date {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .article-event-chip {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--status-plan-text);
    background: var(--status-plan-bg);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .article-title {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 var(--space-4) 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article-lead {
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
    color: var(--ink-2);
    margin: 0;
    text-wrap: balance;
  }

  /* Cover Image Wrap: rộng 960px */
  .article-cover-container {
    max-width: 960px;
    margin: 0 auto;
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .article-featured-image {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-alt);
    box-shadow: var(--shadow-raised);
  }

  .article-cover-img-wrap {
    width: 100%;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .article-featured-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .article-image-caption {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--ink-2);
    background: var(--surface-alt);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .article-credit {
    font-style: italic;
  }

  /* Body Content: Chữ lớn 18px dễ đọc, tương phản cao */
  .article-body-section {
    background: #ffffff;
    padding-top: var(--space-4);
    padding-bottom: var(--space-18);
  }

  .article-content {
    margin-bottom: var(--space-12);
  }

  .article-p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--ink);
    margin: 0 0 var(--space-5) 0;
  }

  .article-h2 {
    font-size: 2rem;
    line-height: 1.3;
    color: var(--ink);
    margin: var(--space-10) 0 var(--space-4) 0;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .article-h3 {
    font-size: 1.375rem;
    line-height: 1.4;
    color: var(--ink);
    margin: var(--space-8) 0 var(--space-3) 0;
    font-weight: 700;
  }

  .article-list {
    margin: 0 0 var(--space-6) var(--space-6);
    padding: 0;
    color: var(--ink);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .article-list li {
    margin-bottom: var(--space-2);
  }

  .article-callout {
    background: var(--surface-alt);
    border-left: 4px solid var(--cta);
    padding: var(--space-4) var(--space-5);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: var(--space-6) 0;
  }

  .article-callout-text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    font-weight: 500;
  }

  .article-quote {
    border-left: 4px solid var(--brand);
    margin: var(--space-8) 0;
    padding: var(--space-3) var(--space-6);
    background: var(--surface-alt);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .article-quote p {
    font-size: 1.25rem;
    line-height: 1.6;
    font-style: italic;
    color: var(--ink);
    margin: 0;
  }

  .article-quote cite {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--font-size-small);
    font-style: normal;
    color: var(--ink-2);
    font-weight: 600;
  }

  .article-inline-figure {
    margin: var(--space-8) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-alt);
  }

  .article-inline-figure img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Khối Bài viết khác */
  .other-articles-section {
    border-top: 2px solid var(--line);
    padding-top: var(--space-8);
    margin-top: var(--space-12);
    margin-bottom: var(--space-8);
  }

  .other-articles-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--ink);
    margin: 0 0 var(--space-6) 0;
    font-weight: 700;
  }

  .other-articles-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .other-article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .other-article-card:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
  }

  .other-article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-small);
  }

  .other-category {
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
  }

  .other-date {
    color: var(--ink-2);
  }

  .other-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .other-summary {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
    line-height: 1.5;
  }

  .other-read-more {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--brand);
    margin-top: var(--space-1);
  }

  /* Navigation Footer */
  .article-footer-nav {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
  }

  @media (max-width: 767px) {
    .article-title {
      font-size: 2rem;
      line-height: 2.25rem;
    }

    .article-lead {
      font-size: 1.125rem;
      line-height: 1.6;
    }

    .article-p {
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    .article-footer-nav {
      flex-direction: column;
      align-items: stretch;
    }

    .article-footer-nav .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
</style>
