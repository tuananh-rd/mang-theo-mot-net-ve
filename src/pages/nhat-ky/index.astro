---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getPublishedJournalEntries, JOURNAL_CATEGORIES } from '../../data/journal';
import { CAMPAIGN_PROJECT, PROJECT_PROGRESS, PLANNED_SESSIONS } from '../../data/campaign';

const entries = getPublishedJournalEntries();
const breadcrumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Nhật ký' }];

function formatDate(d: string): string {
  const parts = d.split('-');
  if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
  return d;
}

const stageIdx = PROJECT_PROGRESS?.currentStageIndex ?? 0;
const currentStageTitle = CAMPAIGN_PROJECT.plannedStages[stageIdx]?.title ?? 'Giai đoạn chuẩn bị';
const nextSession = PLANNED_SESSIONS?.[0];
const sessionDateDisplay = nextSession?.date ? `${formatDate(nextSession.date)} (dự kiến)` : 'Chờ xác nhận';

const summaryItems = [
  { label: 'Số bài công bố', value: `${entries.length} bài viết` },
  { label: 'Tiến độ dự án', value: currentStageTitle },
  { label: 'Buổi chơi dự kiến', value: sessionDateDisplay },
];

// Chỉ hiển thị các danh mục có bài viết thực tế
const activeCategories = JOURNAL_CATEGORIES.filter((cat) =>
  entries.some((e) => e.category === cat.id)
);
---

<Layout
  title="Nhật ký dự án"
  description="Nhật ký kế hoạch, tiến độ chuẩn bị và các hoạt động của dự án thiện nguyện Mang Theo Một Nét Vẽ."
  currentPath="/nhat-ky"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Nhật ký dự án"
    chip={{ kind: 'ke-hoach', label: 'Cập nhật dự án' }}
    title="Từng bước chuẩn bị, từng nét vẽ sẻ chia"
    titleId="journal-heading"
    lead="Cập nhật chi tiết kế hoạch các góc hoạt động, quà lưu niệm gây quỹ và quá trình chuẩn bị cho buổi chơi tại Mái ấm Thánh Tâm."
    description="Các bài viết ghi nhận thông tin kế hoạch do nhóm Lăng Kính công bố. Mọi sự kiện và hoạt động tại Mái ấm đều là dự kiến và cần được Mái ấm thống nhất trước khi triển khai."
    summaryTitle="Thông tin nhật ký"
    summaryItems={summaryItems}
  />

  <section class="section" aria-labelledby="journal-list-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Dòng sự kiện</span>
        <h2 id="journal-list-heading">Bài viết mới nhất</h2>
        <p>Theo dõi quá trình chuẩn bị buổi chơi và kế hoạch gây quỹ của nhóm sinh viên Lăng Kính.</p>
      </div>

      <!-- Category Filter Pills -->
      <div class="journal-filter" aria-label="Lọc bài viết theo danh mục">
        <button
          type="button"
          class="filter-pill is-active"
          data-category="all"
          aria-pressed="true"
        >
          Tất cả ({entries.length})
        </button>
        {
          activeCategories.map((cat) => {
            const count = entries.filter((e) => e.category === cat.id).length;
            return (
              <button
                type="button"
                class="filter-pill"
                data-category={cat.id}
                aria-pressed="false"
              >
                {cat.label} ({count})
              </button>
            );
          })
        }
      </div>

      <!-- Journal Grid -->
      <div class="journal-grid" id="journal-entries-grid">
        {
          entries.map((entry) => (
            <article class="journal-card" data-category={entry.category}>
              {entry.coverImage && (
                <figure class="journal-card-figure">
                  <div class="journal-card-img-wrap">
                    <img
                      src={entry.coverImage.src}
                      alt={entry.coverImage.alt}
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="360"
                    />
                  </div>
                  <figcaption class="journal-card-caption">
                    <span class="caption-text">{entry.coverImage.caption}</span>
                    {entry.coverImage.creditName && (
                      <span class="caption-credit">
                        Nguồn ảnh: {entry.coverImage.creditName} ({entry.coverImage.creditSource || 'Pexels'})
                      </span>
                    )}
                  </figcaption>
                </figure>
              )}
              <div class="journal-card-body">
                <div class="journal-card-meta">
                  <span class={`journal-tag tag-${entry.category}`}>{entry.categoryLabel}</span>
                  <span class="journal-date">Ngày đăng: {formatDate(entry.publishedAt)}</span>
                  {entry.eventDate && (
                    <span class="journal-event-badge">
                      Sự kiện: {formatDate(entry.eventDate)} {entry.eventStatus === 'planned' ? '(dự kiến)' : ''}
                    </span>
                  )}
                </div>
                <h3 class="journal-card-title">
                  <a href={`/nhat-ky/${entry.slug}`} class="journal-card-link">
                    {entry.title}
                  </a>
                </h3>
                <p class="journal-card-desc">{entry.summary}</p>
                <div class="journal-card-footer">
                  <a href={`/nhat-ky/${entry.slug}`} class="link-arrow">
                    Đọc chi tiết <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Empty State (hidden by default) -->
      <div id="journal-empty" class="journal-empty" hidden>
        <p class="journal-empty-title">Chưa có bài viết trong danh mục này</p>
        <p>Nhóm Lăng Kính sẽ cập nhật bài viết mới khi có thông tin kế hoạch hoặc hoạt động tiếp theo.</p>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" aria-labelledby="journal-cta-heading">
    <div class="container cta-band-inner">
      <div class="cta-band-text">
        <h2 id="journal-cta-heading">Cùng đồng hành với dự án</h2>
        <p>Mỗi sự ủng hộ hoặc chia sẻ đều góp phần mang đến buổi chơi trọn vẹn cho các em.</p>
      </div>
      <div class="cta-band-actions">
        <a href="/dong-hanh" class="btn btn-primary">Ủng hộ dự án</a>
        <a href="/du-an/mang-theo-mot-net-ve" class="link-arrow">Tìm hiểu dự án <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupJournalFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.journal-filter .filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.journal-card');
    const emptyState = document.getElementById('journal-empty');

    if (!filterButtons.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';

        filterButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');

        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.removeAttribute('hidden');
            visibleCount++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.removeAttribute('hidden');
          } else {
            emptyState.setAttribute('hidden', '');
          }
        }
      });
    });
  }

  setupJournalFilters();
  document.addEventListener('astro:page-load', setupJournalFilters);
</script>

<style>
  .journal-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter-pill {
    appearance: none;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .filter-pill:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .filter-pill.is-active {
    background: var(--brand);
    color: #ffffff;
    border-color: var(--brand);
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .journal-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .journal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(13, 107, 99, 0.08);
  }

  .journal-card-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
  }

  .journal-card-img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-soft);
  }

  .journal-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .journal-card-caption {
    padding: var(--space-2) var(--space-4);
    font-size: 0.8125rem;
    color: var(--ink-2);
    background: var(--surface-soft);
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .caption-text {
    font-weight: 500;
  }

  .caption-credit {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .journal-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-3);
  }

  .journal-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-small);
  }

  .journal-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--status-plan-bg);
    color: var(--status-plan-text);
  }

  .tag-chuan-bi {
    background: var(--status-pending-bg);
    color: var(--status-pending-text);
  }

  .tag-hoat-dong {
    background: var(--status-confirmed-bg);
    color: var(--status-confirmed-text);
  }

  .tag-ban-giao {
    background: var(--tint-sky);
    color: var(--tint-sky-ink);
  }

  .journal-date {
    color: var(--ink-2);
  }

  .journal-event-badge {
    background: var(--surface-alt);
    color: var(--brand);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    font-weight: 500;
  }

  .journal-card-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .journal-card-link {
    color: var(--ink);
    text-decoration: none;
  }

  .journal-card-link:hover {
    color: var(--brand);
  }

  .journal-card-desc {
    color: var(--ink-2);
    margin: 0;
    line-height: var(--line-height-base);
    flex-grow: 1;
  }

  .journal-card-footer {
    margin-top: var(--space-2);
  }

  .journal-empty {
    padding: var(--space-8) var(--space-4);
    text-align: center;
    background: var(--surface-alt);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
  }

  .journal-empty-title {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  @media (max-width: 767px) {
    .journal-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
