---
import type { DonationAccount, DonationLedger } from '../data/campaign';
import GoalProgress from './GoalProgress.astro';
import { summarizeLedger, sortDonationsNewestFirst, formatViDate, isLedgerReconciled } from '../lib/donations';
import { formatVND } from '../lib/finance';

interface Props {
  account: DonationAccount;
  ledger: DonationLedger;
}

const { account, ledger } = Astro.props;
const summary = summarizeLedger(ledger, account.goalAmount);
const reconciled = isLedgerReconciled(ledger);
const rows = sortDonationsNewestFirst(ledger.entries);
---

<div class="ledger-box">
  <GoalProgress summary={summary} />

  {rows.length > 0 ? (
    <>
      <div class="ledger-search">
        <label for="donor-search" class="search-label">Tìm khoản ủng hộ của bạn</label>
        <input id="donor-search" type="search" class="search-input" placeholder="Nhập tên hoặc mã giao dịch" autocomplete="off" />
      </div>
      <table class="data-table data-table--stack donor-table">
        <caption class="sr-only">Sao kê các khoản ủng hộ đã đối soát đến {formatViDate(ledger.reconciledAt)}</caption>
        <thead>
          <tr>
            <th scope="col">Ngày</th>
            <th scope="col">Người ủng hộ</th>
            <th scope="col">Mã giao dịch</th>
            <th scope="col" class="num">Số tiền</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr data-search={`${r.donor} ${r.reference ?? ''}`.toLowerCase()}>
              <td data-label="Ngày">{formatViDate(r.date)}</td>
              <th scope="row">{r.donor}</th>
              <td data-label="Mã giao dịch">{r.reference ?? '—'}</td>
              <td class="num" data-label="Số tiền">{formatVND(r.amount)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="no-match" hidden>Không tìm thấy khoản phù hợp. Khoản mới chuyển có thể chưa qua đối soát.</p>
    </>
  ) : (
    <div class="ledger-empty">
      <p class="ledger-empty-title">
        {reconciled ? `Chưa có khoản ủng hộ nào trong sổ đối soát đến ${formatViDate(ledger.reconciledAt)}` : 'Sao kê chưa được cập nhật'}
      </p>
      <p>
        {reconciled
          ? 'Khoản mới chuyển sau ngày đối soát sẽ xuất hiện ở lần cập nhật tiếp theo.'
          : 'Sổ ủng hộ đã đối soát chưa được công bố. Các khoản và tổng tiền sẽ được cập nhật sau khi thành viên tài chính cùng một thành viên khác đối chiếu với ngân hàng. Trạng thái này không đồng nghĩa với việc chưa nhận được ủng hộ.'}
      </p>
    </div>
  )}
</div>

<script>
  const input = document.getElementById('donor-search') as HTMLInputElement | null;
  if (input) {
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.donor-table tbody tr'));
    const empty = document.querySelector<HTMLElement>('.no-match');
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      rows.forEach((row) => {
        const match = !q || (row.dataset.search ?? '').includes(q);
        row.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  }
</script>

<style>
  .ledger-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .ledger-search {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 420px;
  }

  .search-label {
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--ink);
  }

  .search-input {
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    color: var(--ink);
  }

  .search-input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .ledger-empty {
    padding: var(--space-6);
    border: 2px dashed var(--line);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .ledger-empty p {
    margin: 0 auto;
    max-width: 600px;
  }

  .ledger-empty-title {
    font-weight: 700;
    color: var(--ink) !important;
    margin-bottom: var(--space-2) !important;
  }

  .no-match {
    margin: 0;
  }

  @media (max-width: 767px) {
    .ledger-box {
      padding: var(--space-4);
    }

    .ledger-empty {
      padding: var(--space-4);
      text-align: left;
    }
  }
</style>
