---
import Icon, { type IconName } from './Icon.astro';
import type { Activity } from '../data/campaign';

interface Props {
  activities: Activity[];
  /** Hiện ghi chú từng góc (trang Dự án); Trang chủ chỉ hiện mô tả */
  showNotes?: boolean;
  headingLevel?: 'h3' | 'h4';
}

const { activities, showNotes = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const iconFor: Record<string, IconName> = {
  'chuon-chuon-tre': 'chuon-chuon',
  'to-tuong': 'to-tuong',
  'hat-cung-nhau': 'hat',
  'tro-choi-nhe': 'tro-choi',
};
---

<ul class="activity-list">
  {
    activities.map((a) => (
      <li class="activity-item">
        <span class="activity-icon">
          <Icon name={iconFor[a.id] ?? 'chuon-chuon'} size={28} />
        </span>
        <div class="activity-text">
          <span class="activity-badge">{a.badge}</span>
          <Heading class="activity-title">{a.title}</Heading>
          <p class="activity-desc">{a.description}</p>
          {showNotes && a.note && <p class="activity-note">{a.note}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .activity-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 2px solid var(--brand-ink);
  }

  .activity-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--surface-alt);
    color: var(--brand-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .activity-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .activity-badge {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--brand);
  }

  .activity-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .activity-desc {
    margin: 0;
  }

  .activity-note {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  @media (max-width: 1023px) {
    .activity-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .activity-list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .activity-item {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top-width: 1px;
      border-top-color: var(--line);
    }

    .activity-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
    }
  }
</style>
