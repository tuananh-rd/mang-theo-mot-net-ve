---
import Icon, { type IconName } from './Icon.astro';
import type { Activity } from '../data/campaign';

interface Props {
  activities: Activity[];
  /** Hiện ghi chú từng góc (trang Dự án); Trang chủ chỉ hiện mô tả */
  showNotes?: boolean;
  headingLevel?: 'h3' | 'h4';
}

const { activities, showNotes = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const tintFor: Record<string, string> = {
  'chuon-chuon-tre': 'sun',
  'to-tuong': 'rose',
  'hat-cung-nhau': 'sky',
  'tro-choi-nhe': 'mint',
};

const iconFor: Record<string, IconName> = {
  'chuon-chuon-tre': 'chuon-chuon',
  'to-tuong': 'to-tuong',
  'hat-cung-nhau': 'hat',
  'tro-choi-nhe': 'tro-choi',
};
---

<ul class="activity-list">
  {
    activities.map((a) => (
      <li class={`activity-item tint-${tintFor[a.id] ?? 'sun'}`}>
        <span class="activity-icon">
          <Icon name={iconFor[a.id] ?? 'chuon-chuon'} size={28} />
        </span>
        <div class="activity-text">
          <span class="activity-badge">{a.badge}</span>
          <Heading class="activity-title">{a.title}</Heading>
          <p class="activity-desc">{a.description}</p>
          {showNotes && a.note && <p class="activity-note">{a.note}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .activity-item {
    --tint: var(--tint-sun);
    --tint-ink: var(--tint-sun-ink);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  /* Dải màu mảnh trên đầu thẻ theo màu của góc */
  .activity-item::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--tint-ink);
    opacity: 0.85;
  }

  .tint-rose { --tint: var(--tint-rose); --tint-ink: var(--tint-rose-ink); }
  .tint-sky { --tint: var(--tint-sky); --tint-ink: var(--tint-sky-ink); }
  .tint-mint { --tint: var(--tint-mint); --tint-ink: var(--tint-mint-ink); }

  .activity-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--tint-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .activity-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .activity-badge {
    align-self: flex-start;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--tint-ink);
    background: var(--tint);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-1);
  }

  .activity-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .activity-desc {
    margin: 0;
  }

  .activity-note {
    margin: var(--space-2) 0 0;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  @media (hover: hover) {
    .activity-item:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-raised);
      border-color: transparent;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .activity-item:hover .activity-icon {
      animation: wiggle 520ms var(--ease-out) 1;
    }
  }

  @keyframes wiggle {
    0% { transform: rotate(0); }
    30% { transform: rotate(-10deg) scale(1.06); }
    60% { transform: rotate(6deg) scale(1.06); }
    100% { transform: rotate(0) scale(1); }
  }

  @media (max-width: 1023px) {
    .activity-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (max-width: 767px) {
    .activity-list {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .activity-item {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    }

    .activity-item::before {
      inset: 0 auto 0 0;
      width: 4px;
      height: auto;
    }

    .activity-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
    }
  }
</style>
