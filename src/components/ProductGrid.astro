---
import Icon, { type IconName } from './Icon.astro';
import StatusChip from './StatusChip.astro';
import type { Product } from '../data/campaign';
import { buildProductCatalog } from '../lib/finance';
import { CRAFT_PRODUCT_DETAILS, getEffectiveProductSaleModel } from '../lib/products';

interface Props {
  products: Product[];
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { products, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const iconFor: Record<string, IconName> = {
  'chuon-chuon-tre-kem-de': 'chuon-chuon',
  'moc-khoa': 'moc-khoa',
  'set-do-an': 'set-do-an',
  'combo-nem-gion': 'combo',
  'combo-nem-xu': 'combo',
  'combo-nem-pho-mai': 'combo',
  'banh-su-kem': 'banh',
};

const rows = buildProductCatalog(products);

/** Ảnh và ghi chú chờ ảnh lấy từ nguồn chung CRAFT_PRODUCT_DETAILS (cùng nguồn với trang chi tiết). */
const detailFor = (productId: string) => CRAFT_PRODUCT_DETAILS.find((d) => d.product.id === productId);
---

<ul class="catalogue-grid">
  {
    rows.map((r) => {
      const saleModel = r.product.category === 'craft' ? getEffectiveProductSaleModel(r.product) : null;
      const priceVal = saleModel && saleModel.effectivePrice !== null ? saleModel.priceText : r.priceText;
      const unitVal = saleModel ? saleModel.unitSuffix : 'chiếc';
      const noteVal = saleModel ? saleModel.priceTypeLabel : 'Giá tham khảo';
      const detail = detailFor(r.product.id);
      const photo = detail?.image;
      const pendingNote = detail?.imagePendingNote;

      return (
        <li class="catalogue-card">
          <div class="catalogue-visual">
            {photo ? (
              <figure class:list={['catalogue-figure', { 'catalogue-figure--contain': photo.fit === 'contain' }]}>
                <div class="catalogue-img-wrap">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="catalogue-caption">{photo.caption}</figcaption>
              </figure>
            ) : (
              <div class="catalogue-placeholder">
                <div class="placeholder-icon">
                  <Icon name={iconFor[r.product.id] ?? 'moc-khoa'} size={48} />
                </div>
                <p class="placeholder-label">Chưa có ảnh mẫu</p>
                {pendingNote && (
                  <p class="placeholder-note">{pendingNote}</p>
                )}
              </div>
            )}
          </div>

          <div class="catalogue-body">
            {saleModel && (
              <div class="catalogue-status-meta">
                <StatusChip kind={saleModel.statusChipKind} label={saleModel.statusLabel} />
              </div>
            )}

            <Heading class="catalogue-title">
              <a href={`/san-pham/${r.product.id}`} class="catalogue-title-link">
                {r.product.name}
              </a>
            </Heading>

            <p class="catalogue-desc">{r.product.description}</p>

            <div class="catalogue-price-box">
              <div class="price-row">
                <span class="catalogue-price-amount">{priceVal}</span>
                <span class="catalogue-price-unit">/ {unitVal}</span>
              </div>
              <span class="catalogue-price-badge">{noteVal}</span>
            </div>

            <p class="catalogue-qty">
              {r.product.plannedQuantity.value === null
                ? 'Số lượng chưa xác nhận'
                : `Dự kiến ${r.quantityText.replace(' dự kiến', '').replace(' bán', '')}`}
            </p>

            <div class="catalogue-actions">
              <a href={`/san-pham/${r.product.id}`} class="btn btn-secondary">
                Xem chi tiết sản phẩm <span aria-hidden="true">→</span>
              </a>
              {saleModel?.preorderOpen && (
                <a class="btn btn-primary catalogue-preorder-btn" href={`/san-pham?sanpham=${encodeURIComponent(r.product.id)}#dat-truoc`} aria-label={`Đặt trước ${r.product.name}`}>
                  Đặt trước
                </a>
              )}
            </div>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .catalogue-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .catalogue-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .catalogue-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .catalogue-visual {
    width: 100%;
    background: var(--surface-alt);
  }

  .catalogue-figure {
    margin: 0;
  }

  .catalogue-img-wrap {
    width: 100%;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .catalogue-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* Ảnh cần hiện trọn vật phẩm: không cắt 4:3, giữ nguyên tỉ lệ ảnh gốc trong khung nền nhạt */
  .catalogue-figure--contain img {
    aspect-ratio: auto;
    max-height: 420px;
    object-fit: contain;
    margin-inline: auto;
  }

  .catalogue-caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--ink-2);
    border-top: 1px solid var(--line);
    background: var(--surface-alt);
  }

  .catalogue-placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: var(--surface-alt);
    border: 2px dashed var(--line-strong);
    margin: var(--space-4);
    border-radius: var(--radius-md);
    text-align: center;
    padding: var(--space-4);
  }

  .placeholder-icon {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    background: #ffffff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand);
  }

  .placeholder-label {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .placeholder-note {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
    max-width: 320px;
    line-height: 1.4;
  }

  .catalogue-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .catalogue-status-meta {
    display: flex;
    align-items: center;
  }

  .catalogue-preorder-btn {
    min-height: 48px;
  }

  .catalogue-title {
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }

  .catalogue-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .catalogue-title-link:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .catalogue-desc {
    font-size: var(--font-size-body);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }

  .catalogue-price-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-1);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .catalogue-price-amount {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.1;
  }

  .catalogue-price-unit {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .catalogue-price-badge {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .catalogue-qty {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    margin: 0;
  }

  .catalogue-actions {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .catalogue-actions .btn {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .catalogue-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
