---
import StatusChip from './StatusChip.astro';
import type { DonationAccount } from '../data/campaign';
import { isDonationOpen } from '../lib/donations';

interface Props {
  account: DonationAccount;
}

const { account } = Astro.props;
const open = isDonationOpen(account);
const transferExample = `${account.transferPrefix} Ten cua ban`;
const publicUrl = 'https://mangtheomotnetve.website/';
---

<div class:list={['donate', { 'donate--pending': !open }]} id="chuyen-khoan">
  <div class="donate-qr">
    {open ? (
      <img
        src={account.qrImage!}
        alt={`Mã QR chuyển khoản tới tài khoản ${account.accountHolder} tại ${account.bankName}`}
        width="815"
        height="932"
        class="qr-img"
        loading="eager"
      />
    ) : (
      <div class="qr-placeholder" role="img" aria-label="Mã QR sẽ hiển thị tại đây khi tài khoản được công bố">
        <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3">
          <rect x="6" y="6" width="18" height="18" rx="3" />
          <rect x="40" y="6" width="18" height="18" rx="3" />
          <rect x="6" y="40" width="18" height="18" rx="3" />
          <path d="M40 40h8v8M58 40v18H40M48 58v-6" stroke-linecap="round" />
        </svg>
        <span>Mã QR sẽ hiển thị tại đây</span>
      </div>
    )}
  </div>

  {open && (
    <a class="qr-download" href={account.qrImage!} download="QR-ung-ho-Mang-Theo-Mot-Net-Ve.png">
      Tải ảnh QR để quét từ thư viện ảnh
    </a>
  )}

  <div class="donate-info">
    {open ? (
      <StatusChip kind="da-xac-nhan" label="Đang nhận ủng hộ" />
    ) : (
      <StatusChip kind="cho-xac-nhan" label="Sắp mở nhận ủng hộ" />
    )}

    <dl class="account">
      <div class="account-row">
        <dt>Ngân hàng</dt>
        <dd>{open ? account.bankName : 'Sẽ công bố'}</dd>
      </div>
      <div class="account-row">
        <dt>Số tài khoản</dt>
        <dd>
          {open ? (
            <>
              <span class="account-number">{account.accountNumber}</span>
              <button type="button" class="copy-btn" data-copy={account.accountNumber}>Sao chép</button>
            </>
          ) : (
            'Sẽ công bố'
          )}
        </dd>
      </div>
      <div class="account-row">
        <dt>Chủ tài khoản</dt>
        <dd>{open ? account.accountHolder : 'Sẽ công bố'}</dd>
      </div>
      <div class="account-row">
        <dt>Nội dung chuyển khoản</dt>
        <dd>
          <code class="transfer-code">{transferExample}</code>
          {open && (
            <button type="button" class="copy-btn" data-copy={`${account.transferPrefix} `}>Sao chép</button>
          )}
        </dd>
      </div>
    </dl>

    <div class="mobile-transfer-guide">
      <h3 class="guide-heading">Cách chuyển khoản tiện lợi trên cùng một điện thoại:</h3>
      <ol class="guide-steps">
        <li>
          <strong>Cách 1 (Quét QR):</strong> Bấm nút <em>"Tải ảnh QR để quét từ thư viện ảnh"</em> ở trên &rarr; Mở ứng dụng ngân hàng &rarr; Chọn tính năng <em>"Quét QR"</em> &rarr; Chọn ảnh QR vừa tải về máy.
        </li>
        <li>
          <strong>Cách 2 (Chuyển khoản thủ công):</strong> Bấm nút <em>"Sao chép"</em> số tài khoản và nội dung ở trên để dán vào ứng dụng ngân hàng.
        </li>
      </ol>
    </div>

    <p class="donate-hint">
      {open
        ? 'Ghi tên bạn muốn hiển thị sau mã dự án; không ghi tên hoặc ghi “An danh” sẽ hiển thị là Ẩn danh. Khoản ủng hộ được cập nhật trong bảng sao kê bên dưới sau khi đối soát với ngân hàng (không cập nhật tức thời).'
        : 'Website chưa công bố tài khoản nhận ủng hộ đã được nhóm xác nhận. Thông tin sẽ được đăng tại đây khi sẵn sàng.'}
    </p>
    <p class="copy-status" aria-live="polite"></p>

    <div class="donate-actions-footer">
      <a href="#sao-ke" class="link-arrow">
        Xem tiến độ và sổ đối soát bên dưới <span class="arrow" aria-hidden="true">&darr;</span>
      </a>
      <button
        type="button"
        class="btn btn-secondary share-page-btn"
        data-share-url={publicUrl}
        data-share-title="Mang Theo Một Nét Vẽ"
        data-share-text="Dự án thiện nguyện mang buổi vui chơi sáng tạo và quà tặng đến Mái ấm Thánh Tâm Xuy Xá."
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>Chia sẻ trang này tới bạn bè</span>
      </button>
      <span class="share-page-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</div>

<script>
  // 1. Copy Buttons
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      const status = btn.closest('.donate-info')?.querySelector('.copy-status');
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Đã sao chép';
        if (status) status.textContent = 'Đã sao chép vào bộ nhớ tạm.';
        setTimeout(() => {
          btn.textContent = 'Sao chép';
        }, 1800);
      } catch {
        if (status) status.textContent = 'Không sao chép được, vui lòng chọn và sao chép thủ công.';
      }
    });
  });

  // 2. Share Page Button
  document.querySelectorAll<HTMLButtonElement>('.share-page-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.shareUrl || 'https://mangtheomotnetve.website/';
      const title = btn.dataset.shareTitle || document.title;
      const text = btn.dataset.shareText || '';
      const status = btn.closest('.donate-actions-footer')?.querySelector('.share-page-status');

      if (navigator.share && window.location.protocol.startsWith('http')) {
        try {
          await navigator.share({ title, text, url });
          if (status) status.textContent = 'Đã mở hộp thoại chia sẻ.';
          return;
        } catch (err: any) {
          if (err?.name === 'AbortError') return;
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        if (status) {
          status.textContent = 'Đã sao chép liên kết chia sẻ!';
          setTimeout(() => {
            if (status) status.textContent = '';
          }, 3000);
        }
      } catch {
        if (status) status.textContent = 'Không thể sao chép liên kết tự động.';
      }
    });
  });
</script>

<style>
  .donate {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
    padding: var(--space-8);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
  }

  /* QR giữ nguyên tỷ lệ gốc, không cắt, nền trắng đủ lề để quét */
  .donate-qr {
    border-radius: var(--radius-md);
    background: var(--surface-alt);
  }

  .donate:not(.donate--pending) .donate-qr {
    background: #ffffff;
    border: 1px solid var(--line);
    padding: var(--space-2);
  }

  .qr-download {
    grid-column: 1;
    grid-row: 2;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .donate-info {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .donate--pending .donate-qr {
    aspect-ratio: 1;
  }

  .qr-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .qr-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--line-strong);
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius-md);
    text-align: center;
    padding: var(--space-4);
  }

  .qr-placeholder span {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .donate-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .account {
    margin: 0;
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .account-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    align-items: center;
  }

  .account-row dt {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    font-weight: 600;
  }

  .account-row dd {
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--ink);
    font-weight: 600;
  }

  .donate--pending .account-row dd {
    color: var(--ink-2);
    font-weight: 500;
  }

  .account-number {
    font-size: var(--font-size-h3);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .transfer-code {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: var(--font-size-body);
    background: var(--surface-alt);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  .copy-btn {
    min-height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line-strong);
    background: #ffffff;
    color: var(--ink);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .copy-btn:hover {
    background: var(--surface-alt);
    border-color: var(--ink);
  }

  .donate-hint {
    margin: 0;
  }

  .copy-status {
    margin: 0;
    min-height: 0;
    font-size: var(--font-size-small);
    color: var(--status-confirmed-text);
  }

  .copy-status:empty {
    display: none;
  }

  @media (max-width: 1023px) {
    .donate {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-6);
      padding: var(--space-6);
    }

    .account-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (max-width: 767px) {
    .donate {
      grid-template-columns: 1fr;
      padding: var(--space-4);
    }

    .donate-qr {
      width: min(260px, 100%);
      justify-self: center;
    }

    .qr-download,
    .donate-info {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .mobile-transfer-guide {
    background: var(--band);
    border: 0;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-top: var(--space-4);
  }

  .guide-heading {
    font-size: var(--font-size-small);
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0 0 var(--space-2) 0;
  }

  .guide-steps {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--brand-ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .donate-actions-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .share-page-btn {
    min-height: 40px;
    height: 40px;
    padding: 0 var(--space-4);
    font-size: var(--font-size-small);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .share-page-status {
    font-size: var(--font-size-small);
    color: var(--status-confirmed-text);
  }

  .share-page-status:empty {
    display: none;
  }
</style>
