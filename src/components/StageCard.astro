---
import type { PlannedStage } from '../data/campaign';

interface Props {
  stage: PlannedStage;
}

const { stage } = Astro.props;
---

<article class="stage-card card">
  <div class="stage-step">
    {stage.step}
  </div>
  <div class="stage-content">
    <h3 class="stage-title">{stage.title}</h3>
    <p class="stage-desc">{stage.description}</p>
  </div>
</article>

<style>
  .stage-card {
    height: 100%;
    padding: var(--space-5);
    background-color: var(--color-surface-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
    border-top: 4px solid var(--color-accent);
  }

  .stage-step {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stage-title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .stage-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .stage-card {
      padding: var(--space-4);
      gap: var(--space-2);
    }

    .stage-desc {
      font-size: 0.875rem;
      line-height: 1.45;
    }
  }
</style>
