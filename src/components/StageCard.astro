---
import type { PlannedStage } from '../data/campaign';

interface Props {
  stage: PlannedStage;
}

const { stage } = Astro.props;
---

<article class="stage-card card" data-step={stage.step}>
  <div class="stage-header">
    <div class="stage-step-circle">
      <span class="stage-step-num">{stage.step}</span>
    </div>
    <div class="stage-connector-line" aria-hidden="true"></div>
  </div>

  <div class="stage-body">
    <div class="stage-meta">
      <span class="stage-plan-label">Kế hoạch dự kiến</span>
    </div>
    <h3 class="stage-title">{stage.title}</h3>
    <p class="stage-desc">{stage.description}</p>
  </div>
</article>

<style>
  .stage-card {
    height: 100%;
    padding: var(--space-5);
    background-color: var(--color-surface-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--brand);
  }

  .stage-header {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
  }

  .stage-step-circle {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-alt);
    border: 2px solid var(--brand);
    color: var(--brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    z-index: 2;
    flex-shrink: 0;
  }

  /* Đường nối trang trí nối giữa các giai đoạn 01–04 */
  .stage-connector-line {
    position: absolute;
    left: 44px;
    right: calc(-1 * var(--space-6) - 1px);
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      var(--line-strong) 0,
      var(--line-strong) 6px,
      transparent 6px,
      transparent 12px
    );
    z-index: 1;
  }

  /* Ẩn đường nối ở bước cuối 04 */
  .stage-card[data-step="04"] .stage-connector-line,
  .stage-card:last-child .stage-connector-line {
    display: none;
  }

  .stage-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-grow: 1;
  }

  .stage-meta {
    margin-top: var(--space-1);
  }

  .stage-plan-label {
    display: inline-block;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--status-plan-text);
    background-color: var(--status-plan-bg);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .stage-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
    margin: 0;
  }

  .stage-desc {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink-2);
    margin: 0;
    flex-grow: 1;
  }

  @media (max-width: 1023px) {
    /* Khi responsive xếp 2 cột hoặc 1 cột, ẩn đường nối ngang để tránh cắt thẻ */
    .stage-connector-line {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .stage-card {
      padding: var(--space-4);
      gap: var(--space-2);
    }

    .stage-step-circle {
      width: 38px;
      height: 38px;
      font-size: 1rem;
    }

    .stage-title {
      font-size: 1.0625rem;
    }

    .stage-desc {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }
  }
</style>
