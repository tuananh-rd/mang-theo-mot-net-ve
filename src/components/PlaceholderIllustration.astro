---
import { STOCK_ILLUSTRATIONS, type StockIllustration } from '../data/illustrations';

interface Props {
  type:
    | 'hero'
    | 'chuon-chuon'
    | 'to-tuong'
    | 'hat'
    | 'tro-choi'
    | 'moc-khoa'
    | 'set-do-an'
    | 'combo-nem'
    | 'combo-nem-gion'
    | 'combo-nem-xu'
    | 'combo-nem-pho-mai'
    | 'banh-su-kem'
    | 'tui-but'
    | 'tui-vai';
  caption?: string;
  ratio?: '4:3' | '16:9' | '1:1';
  context?: 'hero' | 'activity' | 'product';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  type,
  caption,
  ratio = '4:3',
  context = 'product',
  loading,
  fetchpriority,
} = Astro.props;

// A01 chỉ render duy nhất một lần ở hero Trang chủ theo spec C04 (hướng B P0)
let stockItem: StockIllustration | undefined = undefined;

if (type === 'hero') {
  stockItem = STOCK_ILLUSTRATIONS.hero;
}

const isHero = type === 'hero';
const imgLoading = loading || (isHero ? 'eager' : 'lazy');
const imgFetchPriority = fetchpriority || (isHero ? 'high' : 'auto');

const defaultCaption = stockItem
  ? stockItem.caption
  : context === 'product'
  ? 'Chưa có ảnh mẫu chính thức'
  : 'Minh họa hoạt động dự kiến';

const finalCaption = caption || defaultCaption;
---

<figure class:list={['illustration-wrapper', `ratio-${ratio.replace(':', '-')}`, `context-${context}`]}>
  <div class:list={['svg-container', stockItem ? 'has-stock-image' : '']}>
    {stockItem ? (
      <img
        src={stockItem.src}
        alt={stockItem.alt}
        width={stockItem.width}
        height={stockItem.height}
        loading={imgLoading}
        fetchpriority={imgFetchPriority}
        decoding="async"
        class="illustration-img"
        style={`object-position: ${stockItem.objectPosition};`}
      />
    ) : context === 'product' ? (
      <div class="product-placeholder" aria-hidden="true">
        <svg
          viewBox="0 0 200 150"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="placeholder-icon"
        >
          <rect x="20" y="20" width="160" height="110" rx="10" stroke="var(--line-strong)" stroke-width="2" stroke-dasharray="4 4" fill="none" />
          <path d="M70 75 L100 50 L130 75" stroke="var(--ink-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="80" y="70" width="40" height="35" rx="4" stroke="var(--ink-2)" stroke-width="2" fill="none" />
          <line x1="100" y1="70" x2="100" y2="105" stroke="var(--ink-2)" stroke-width="1.5" />
          <line x1="80" y1="85" x2="120" y2="85" stroke="var(--ink-2)" stroke-width="1.5" />
        </svg>
      </div>
    ) : (
      <>
        {type === 'chuon-chuon' && (
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="illustration-svg" aria-hidden="true">
            <rect width="400" height="300" fill="var(--surface-alt)" />
            <g transform="translate(200, 150)" stroke="var(--brand-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="0" cy="80" rx="36" ry="12" stroke="var(--line-strong)" fill="none" />
              <line x1="0" y1="20" x2="0" y2="80" />
              <ellipse cx="0" cy="0" rx="8" ry="40" fill="none" />
              <circle cx="0" cy="-45" r="10" fill="none" />
              <path d="M-60 -8 Q-30 -20 0 -5" fill="none" />
              <path d="M60 -8 Q30 -20 0 -5" fill="none" />
              <path d="M-55 10 Q-30 0 0 8" fill="none" />
              <path d="M55 10 Q30 0 0 8" fill="none" />
            </g>
          </svg>
        )}

        {type === 'to-tuong' && (
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="illustration-svg" aria-hidden="true">
            <rect width="400" height="300" fill="var(--surface-alt)" />
            <g transform="translate(200, 150)" stroke="var(--brand-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M-30 50 C-30 0 -20 -30 0 -30 C20 -30 30 0 30 50 Z" fill="none" />
              <circle cx="0" cy="-50" r="20" fill="none" />
              <path d="M45 -10 L70 -35 L80 -25 L55 0 Z" fill="none" stroke="var(--brand)" />
              <path d="M70 -35 L75 -45 L85 -35 L80 -25 Z" fill="none" stroke="var(--brand)" />
              <circle cx="-10" cy="15" r="5" stroke="var(--line-strong)" fill="none" />
              <circle cx="12" cy="30" r="4" stroke="var(--line-strong)" fill="none" />
            </g>
          </svg>
        )}

        {type === 'hat' && (
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="illustration-svg" aria-hidden="true">
            <rect width="400" height="300" fill="var(--surface-alt)" />
            <g transform="translate(200, 150)" stroke="var(--brand-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="-30" cy="30" r="16" fill="none" />
              <line x1="-14" y1="30" x2="-14" y2="-40" />
              <circle cx="30" cy="10" r="16" fill="none" />
              <line x1="46" y1="10" x2="46" y2="-60" />
              <path d="M-14 -40 L46 -60" stroke-width="5" />
              <path d="M-60 65 Q0 90 60 65" stroke="var(--line-strong)" fill="none" />
            </g>
          </svg>
        )}

        {type === 'tro-choi' && (
          <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="illustration-svg" aria-hidden="true">
            <rect width="400" height="300" fill="var(--surface-alt)" />
            <g transform="translate(200, 150)" stroke="var(--brand-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="-30" cy="20" r="32" fill="none" />
              <path d="M-50 20 Q-30 0 -10 20" stroke="var(--line-strong)" fill="none" />
              <path d="M-30 0 Q-10 20 -30 40" stroke="var(--line-strong)" fill="none" />
              <path d="M30 45 C20 45 22 15 26 -5 C24 -15 28 -25 35 -25 C42 -25 46 -15 44 -5 C48 15 50 45 40 45 Z" fill="none" stroke="var(--brand)" />
              <line x1="25" y1="-5" x2="45" y2="-5" stroke="var(--line-strong)" />
            </g>
          </svg>
        )}
      </>
    )}
  </div>

  <figcaption class="illustration-caption">
    <span class="caption-text">{finalCaption}</span>
    {stockItem && (
      <span class="caption-credit">
        Ảnh: <a href={stockItem.creditUrl} target="_blank" rel="noreferrer noopener" class="credit-link">{stockItem.creditName}</a> / {stockItem.creditSource}
      </span>
    )}
  </figcaption>
</figure>

<style>
  .illustration-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--surface-alt);
    border: 1px solid var(--line);
  }

  .ratio-4-3 .svg-container {
    aspect-ratio: 4 / 3;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ratio-16-9 .svg-container {
    aspect-ratio: 16 / 9;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ratio-1-1 .svg-container {
    aspect-ratio: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .svg-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--surface-alt);
  }

  .illustration-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .illustration-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Product Placeholder trung tính */
  .product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--surface-alt);
  }

  .placeholder-icon {
    width: 64px;
    height: 48px;
  }

  .placeholder-label {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    font-weight: 500;
  }

  .illustration-caption {
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-small);
    color: var(--ink-2);
    background-color: var(--surface-alt);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.4;
    text-align: left;
  }

  .caption-text {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .caption-credit {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .credit-link {
    color: var(--brand);
    text-decoration: underline;
  }

  .credit-link:hover {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .ratio-4-3 .svg-container {
      aspect-ratio: 4 / 3;
    }

    .illustration-caption {
      padding: 6px var(--space-3);
      font-size: var(--font-size-small);
    }

    .caption-text,
    .caption-credit {
      font-size: var(--font-size-small);
    }
  }
</style>
