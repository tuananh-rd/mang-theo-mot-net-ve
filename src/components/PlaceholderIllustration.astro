---
interface Props {
  type:
    | 'hero'
    | 'chuon-chuon'
    | 'to-tuong'
    | 'hat'
    | 'tro-choi'
    | 'moc-khoa'
    | 'set-do-an'
    | 'combo-nem'
    | 'banh-su-kem'
    | 'tui-but'
    | 'tui-vai';
  caption?: string;
  ratio?: '4:3' | '16:9' | '1:1';
}

const {
  type,
  caption = 'Minh họa cho bản xem trước — chưa phải ảnh thật',
  ratio = '4:3',
} = Astro.props;
---

<figure class:list={['illustration-wrapper', `ratio-${ratio.replace(':', '-')}`]}>
  <div class="svg-container">
    {type === 'hero' && (
      <svg
        viewBox="0 0 600 450"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="600" height="450" rx="16" fill="#FFF9E6" />
        <!-- Soft decorative shapes & brushstrokes -->
        <circle cx="480" cy="100" r="80" fill="#FDE68A" opacity="0.6" />
        <circle cx="100" cy="360" r="110" fill="#FEF3C7" opacity="0.8" />
        <path d="M40 80 Q180 40 320 90 T560 60" stroke="#F59E0B" stroke-width="12" stroke-linecap="round" opacity="0.4" />
        <path d="M80 380 Q240 340 400 390 T540 360" stroke="#38BDF8" stroke-width="10" stroke-linecap="round" opacity="0.4" />
        
        <!-- Bamboo dragonfly stylized motif -->
        <g transform="translate(300, 210)">
          <!-- Wooden base -->
          <ellipse cx="0" cy="140" rx="55" ry="18" fill="#D97706" opacity="0.7" />
          <path d="M-6 140 L-3 50 L3 50 L6 140 Z" fill="#B45309" />
          <polygon points="0,46 -4,52 4,52" fill="#92400E" />
          
          <!-- Dragonfly Body -->
          <ellipse cx="0" cy="10" rx="10" ry="60" fill="#EAB308" stroke="#CA8A04" stroke-width="3" />
          <circle cx="0" cy="-55" r="14" fill="#F59E0B" stroke="#D97706" stroke-width="3" />
          <!-- Head / beak balancing point -->
          <polygon points="0,50 -6,40 6,40" fill="#CA8A04" />
          
          <!-- Wings Left -->
          <ellipse cx="-75" cy="-20" rx="75" ry="16" transform="rotate(-15 -75 -20)" fill="#38BDF8" opacity="0.85" stroke="#0284C7" stroke-width="2" />
          <ellipse cx="-70" cy="5" rx="65" ry="13" transform="rotate(10 -70 5)" fill="#7DD3FC" opacity="0.8" stroke="#0284C7" stroke-width="2" />
          
          <!-- Wings Right -->
          <ellipse cx="75" cy="-20" rx="75" ry="16" transform="rotate(15 75 -20)" fill="#38BDF8" opacity="0.85" stroke="#0284C7" stroke-width="2" />
          <ellipse cx="70" cy="5" rx="65" ry="13" transform="rotate(-10 70 5)" fill="#7DD3FC" opacity="0.8" stroke="#0284C7" stroke-width="2" />
        </g>
        
        <!-- Palette & Brush accents -->
        <g transform="translate(120, 200) rotate(-15)">
          <path d="M0 0 C40 -30 90 10 70 60 C50 100 10 90 -20 60 C-40 30 -20 20 0 0 Z" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="3" />
          <circle cx="15" cy="20" r="8" fill="#EF4444" />
          <circle cx="45" cy="25" r="8" fill="#F59E0B" />
          <circle cx="50" cy="55" r="8" fill="#10B981" />
          <circle cx="20" cy="65" r="8" fill="#3B82F6" />
        </g>
      </svg>
    )}

    {type === 'chuon-chuon' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FEF9C3" />
        <!-- Bamboo craft stylized -->
        <circle cx="200" cy="150" r="90" fill="#FEF08A" opacity="0.6" />
        <g transform="translate(200, 150)">
          <!-- Base -->
          <ellipse cx="0" cy="90" rx="40" ry="12" fill="#B45309" opacity="0.8" />
          <rect x="-4" y="30" width="8" height="60" fill="#92400E" rx="2" />
          <!-- Dragonfly -->
          <ellipse cx="0" cy="0" rx="8" ry="45" fill="#FBBF24" />
          <ellipse cx="-55" cy="-10" rx="55" ry="12" transform="rotate(-12 -55 -10)" fill="#60A5FA" opacity="0.85" />
          <ellipse cx="55" cy="-10" rx="55" ry="12" transform="rotate(12 55 -10)" fill="#60A5FA" opacity="0.85" />
        </g>
      </svg>
    )}

    {type === 'to-tuong' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#EFF6FF" />
        <circle cx="200" cy="150" r="90" fill="#DBEAFE" opacity="0.6" />
        <!-- Plaster statue cute shape -->
        <g transform="translate(200, 140)">
          <path d="M-40 60 C-40 0 -30 -40 0 -40 C30 -40 40 0 40 60 Z" fill="#FFFFFF" stroke="#94A3B8" stroke-width="4" />
          <circle cx="0" cy="-60" r="28" fill="#FFFFFF" stroke="#94A3B8" stroke-width="4" />
          <!-- Paint splashes -->
          <circle cx="-15" cy="10" r="10" fill="#F87171" opacity="0.9" />
          <circle cx="18" cy="30" r="12" fill="#FBBF24" opacity="0.9" />
          <circle cx="5" cy="-15" r="8" fill="#34D399" opacity="0.9" />
        </g>
      </svg>
    )}

    {type === 'hat' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FDF2F8" />
        <circle cx="200" cy="150" r="90" fill="#FCE7F3" opacity="0.6" />
        <!-- Music notes & cheerful shapes -->
        <g transform="translate(180, 120)">
          <circle cx="0" cy="40" r="16" fill="#EC4899" />
          <circle cx="50" cy="20" r="16" fill="#EC4899" />
          <rect x="12" y="-30" width="6" height="70" fill="#BE185D" />
          <rect x="62" y="-50" width="6" height="70" fill="#BE185D" />
          <polygon points="12,-30 68,-50 68,-38 12,-18" fill="#BE185D" />
        </g>
        <path d="M120 220 Q200 250 280 220" stroke="#DB2777" stroke-width="5" stroke-linecap="round" />
      </svg>
    )}

    {type === 'tro-choi' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#ECFDF5" />
        <circle cx="200" cy="150" r="90" fill="#D1FAE5" opacity="0.6" />
        <!-- Bowling / soft ball interactive -->
        <g transform="translate(200, 150)">
          <circle cx="-40" cy="30" r="35" fill="#34D399" />
          <circle cx="-50" cy="20" r="6" fill="#059669" />
          <circle cx="-35" cy="15" r="6" fill="#059669" />
          <circle cx="-40" cy="35" r="6" fill="#059669" />
          <!-- Mini bowling pin -->
          <path d="M40 50 C25 50 30 10 35 -10 C33 -20 37 -30 45 -30 C53 -30 57 -20 55 -10 C60 10 65 50 50 50 Z" fill="#F87171" />
        </g>
      </svg>
    )}

    {type === 'tui-but' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#F5F3FF" />
        <circle cx="200" cy="150" r="90" fill="#EDE9FE" opacity="0.6" />
        <!-- Pencil pouch -->
        <g transform="translate(140, 110)">
          <rect x="0" y="20" width="130" height="70" rx="14" fill="#8B5CF6" />
          <rect x="10" y="10" width="110" height="12" rx="4" fill="#6D28D9" />
          <circle cx="20" cy="16" r="5" fill="#FCD34D" />
          <line x1="20" y1="45" x2="110" y2="45" stroke="#A78BFA" stroke-width="4" stroke-dasharray="6 4" />
        </g>
      </svg>
    )}

    {type === 'tui-vai' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FFFBEB" />
        <circle cx="200" cy="150" r="90" fill="#FEF3C7" opacity="0.6" />
        <!-- Canvas tote bag -->
        <g transform="translate(140, 70)">
          <!-- Handles -->
          <path d="M35 60 C35 0 85 0 85 60" stroke="#78350F" stroke-width="8" stroke-linecap="round" fill="none" />
          <!-- Bag body -->
          <path d="M10 60 L110 60 L100 170 L20 170 Z" fill="#D97706" rx="6" />
          <path d="M25 60 L95 60 L88 170 L32 170 Z" fill="#F59E0B" />
        </g>
      </svg>
    )}
    {type === 'moc-khoa' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FDF4FF" />
        <circle cx="200" cy="150" r="90" fill="#FAE8FF" opacity="0.6" />
        <!-- Keychain loop & tag -->
        <g transform="translate(200, 140)">
          <!-- Metal ring -->
          <circle cx="0" cy="-60" r="22" stroke="#94A3B8" stroke-width="6" fill="none" />
          <circle cx="0" cy="-35" r="8" stroke="#94A3B8" stroke-width="4" fill="none" />
          <!-- Acrylic / wood tag -->
          <rect x="-45" y="-20" width="90" height="110" rx="16" fill="#C084FC" />
          <rect x="-38" y="-13" width="76" height="96" rx="12" fill="#F3E8FF" />
          <!-- Prism symbol inside tag -->
          <polygon points="0,5 -22,48 22,48" fill="#A855F7" opacity="0.9" />
          <polygon points="0,5 22,48 10,25" fill="#38BDF8" opacity="0.75" />
          <polygon points="0,5 -22,48 -10,25" fill="#F59E0B" opacity="0.75" />
          <circle cx="0" cy="65" r="4" fill="#9333EA" />
        </g>
      </svg>
    )}

    {type === 'set-do-an' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FFFBEB" />
        <circle cx="200" cy="150" r="90" fill="#FEF3C7" opacity="0.6" />
        <!-- Snack box / set combo -->
        <g transform="translate(200, 150)">
          <!-- Tray plate -->
          <ellipse cx="0" cy="50" rx="110" ry="24" fill="#FDE68A" />
          <ellipse cx="0" cy="46" rx="100" ry="20" fill="#FEF08A" />
          <!-- Snack cup / box -->
          <path d="M-60 30 L-70 -25 L-20 -25 L-30 30 Z" fill="#F87171" rx="4" />
          <!-- Fries / sticks sticking out -->
          <line x1="-50" y1="-25" x2="-55" y2="-55" stroke="#FBBF24" stroke-width="6" stroke-linecap="round" />
          <line x1="-42" y1="-25" x2="-40" y2="-62" stroke="#F59E0B" stroke-width="6" stroke-linecap="round" />
          <line x1="-34" y1="-25" x2="-28" y2="-52" stroke="#FBBF24" stroke-width="6" stroke-linecap="round" />
          <!-- Crispy roll snacks -->
          <rect x="0" y="5" width="65" height="18" rx="8" transform="rotate(-15 0 5)" fill="#D97706" />
          <rect x="10" y="22" width="60" height="18" rx="8" transform="rotate(-5 10 22)" fill="#B45309" />
          <!-- Dipping cup -->
          <circle cx="50" cy="5" r="16" fill="#EF4444" />
          <circle cx="50" cy="5" r="12" fill="#DC2626" />
        </g>
      </svg>
    )}

    {type === 'combo-nem' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FEF2F2" />
        <circle cx="200" cy="150" r="90" fill="#FEE2E2" opacity="0.6" />
        <!-- Spring rolls combo -->
        <g transform="translate(200, 150)">
          <!-- Plate -->
          <ellipse cx="0" cy="40" rx="115" ry="26" fill="#E2E8F0" />
          <ellipse cx="0" cy="36" rx="105" ry="22" fill="#F8FAFC" />
          <!-- 5 Nem rolls stacked -->
          <rect x="-65" y="10" width="70" height="16" rx="8" fill="#D97706" />
          <rect x="-10" y="15" width="70" height="16" rx="8" fill="#B45309" />
          <rect x="-45" y="-5" width="68" height="16" rx="8" fill="#F59E0B" />
          <rect x="5" y="0" width="65" height="16" rx="8" fill="#D97706" />
          <rect x="-20" y="-20" width="65" height="16" rx="8" fill="#B45309" />
          <!-- Sauce dish -->
          <circle cx="-65" cy="35" r="18" fill="#EF4444" opacity="0.85" />
          <circle cx="-65" cy="35" r="13" fill="#DC2626" />
        </g>
      </svg>
    )}

    {type === 'banh-su-kem' && (
      <svg
        viewBox="0 0 400 300"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="illustration-svg"
        aria-hidden="true"
      >
        <rect width="400" height="300" rx="12" fill="#FFF7ED" />
        <circle cx="200" cy="150" r="90" fill="#FFEDD5" opacity="0.6" />
        <!-- Cream puff choux -->
        <g transform="translate(200, 150)">
          <!-- Plate -->
          <ellipse cx="0" cy="50" rx="90" ry="20" fill="#FDE68A" />
          <!-- Choux bottom -->
          <ellipse cx="0" cy="25" rx="55" ry="30" fill="#D97706" />
          <!-- Cream filling layer -->
          <ellipse cx="0" cy="15" rx="50" ry="20" fill="#FEF9C3" />
          <circle cx="-25" cy="15" r="12" fill="#FEF08A" />
          <circle cx="0" cy="12" r="14" fill="#FEF9C3" />
          <circle cx="25" cy="15" r="12" fill="#FEF08A" />
          <!-- Choux top cap -->
          <ellipse cx="0" cy="-5" rx="48" ry="25" fill="#F59E0B" />
          <!-- Powdered sugar dust -->
          <circle cx="-15" cy="-12" r="3" fill="#FFFFFF" />
          <circle cx="5" cy="-18" r="3" fill="#FFFFFF" />
          <circle cx="20" cy="-10" r="2.5" fill="#FFFFFF" />
          <circle cx="-5" cy="-6" r="2.5" fill="#FFFFFF" />
        </g>
      </svg>
    )}
  </div>

  <figcaption class="illustration-caption">
    {caption}
  </figcaption>
</figure>

<style>
  .illustration-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-canvas-subtle);
    border: 1px dashed var(--color-border);
  }

  .ratio-4-3 .svg-container {
    aspect-ratio: 4 / 3;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ratio-16-9 .svg-container {
    aspect-ratio: 16 / 9;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ratio-1-1 .svg-container {
    aspect-ratio: 1 / 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .illustration-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .illustration-caption {
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    background-color: #f8fafc;
    border-top: 1px solid var(--color-border-subtle);
    text-align: center;
    font-style: italic;
  }

  @media (max-width: 767px) {
    .ratio-4-3 .svg-container {
      aspect-ratio: 16 / 9;
      max-height: 165px;
      overflow: hidden;
    }

    .svg-container {
      max-height: 165px;
      overflow: hidden;
    }

    .illustration-svg {
      max-height: 165px;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .illustration-caption {
      padding: 4px var(--space-2);
      font-size: var(--font-size-sm);
    }
  }
</style>
