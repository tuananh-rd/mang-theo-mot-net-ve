---
import PlaceholderIllustration from './PlaceholderIllustration.astro';
import type { Activity } from '../data/campaign';

interface Props {
  activity: Activity;
  illustrationType: 'chuon-chuon' | 'to-tuong' | 'hat' | 'tro-choi';
}

const { activity, illustrationType } = Astro.props;
---

<article class="activity-card card">
  <div class="card-visual">
    <PlaceholderIllustration
      type={illustrationType}
      context="activity"
      ratio="4:3"
    />
  </div>

  <div class="card-body">
    <div class="badge-row">
      <span class="activity-badge">{activity.badge}</span>
    </div>

    <h3 class="card-title">{activity.title}</h3>

    <p class="card-desc">{activity.description}</p>

    {activity.note && (
      <p class="card-note">
        {activity.note}
      </p>
    )}
  </div>
</article>

<style>
  .activity-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .card-visual {
    margin-bottom: var(--space-4);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-2);
  }

  .badge-row {
    margin-bottom: var(--space-1);
  }

  .activity-badge {
    display: inline-block;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--status-plan-text);
    background-color: var(--status-plan-bg);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
  }

  .card-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .card-desc {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink-2);
    margin: 0;
    flex-grow: 1;
  }

  .card-note {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--ink-2);
    font-style: normal;
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
    margin-top: var(--space-2);
  }

  @media (max-width: 767px) {
    .activity-card {
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .card-visual {
      margin-bottom: 0;
    }

    /* Thu gọn ô minh họa placeholder trên mobile để không làm trang dài */
    .card-visual :global(.illustration-wrapper .svg-container) {
      aspect-ratio: 16 / 9 !important;
      max-height: 88px !important;
      overflow: hidden !important;
    }

    .card-visual :global(.illustration-wrapper .illustration-svg) {
      max-height: 100% !important;
      object-fit: contain !important;
    }

    .card-title {
      font-size: 1.125rem;
      line-height: 1.4;
    }

    /* Giữ đúng chuẩn body16 và notes14 trên mobile */
    .card-desc {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .card-note {
      font-size: var(--font-size-small);
      line-height: var(--line-height-small);
    }
  }
</style>
