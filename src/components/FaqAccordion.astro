---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items?: FaqItem[];
  faqs?: FaqItem[];
  idPrefix?: string;
}

const { items: propItems, faqs: propFaqs, idPrefix = 'faq' } = Astro.props;
const items = propItems || propFaqs || [];
---

<div class="faq-accordion-list">
  {
    items.map((faq, index) => (
      <details class="faq-item card" id={`${idPrefix}-${index}`}>
        <summary class="faq-question">
          <span class="faq-q-text">{faq.question}</span>
          <span class="faq-icon" aria-hidden="true">
            <svg
              class="chevron-svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-card);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    overflow: hidden;
  }

  .faq-item:hover {
    border-color: var(--line-strong);
  }

  /* Mở: border-left 4px màu brand để phân biệt rõ với focus blue */
  .faq-item[open] {
    border-color: var(--line-strong);
    border-left: 4px solid var(--brand);
    box-shadow: var(--shadow-subtle);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    cursor: pointer;
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--ink);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  /* Focus: outline xanh 3px chuẩn tiếp cận */
  .faq-question:focus,
  .faq-question:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -2px;
    background-color: var(--surface-alt);
  }

  .faq-q-text {
    flex: 1;
    text-align: left;
    line-height: 1.45;
  }

  .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-alt);
    color: var(--ink-2);
    flex-shrink: 0;
    transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .chevron-svg {
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .chevron-svg,
  details[open] .chevron-svg {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-icon,
  details[open] .faq-icon {
    background-color: var(--focus) !important;
    color: #ffffff !important;
  }

  .faq-answer {
    padding: 0 var(--space-4) var(--space-4);
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }

  /* Câu trả lời chuẩn 16px body trên toàn bộ màn hình */
  .faq-answer p {
    margin: 0;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink-2);
    text-align: left;
  }

  @media (max-width: 767px) {
    .faq-accordion-list {
      gap: 8px;
    }

    .faq-question {
      padding: var(--space-3) var(--space-4);
    }

    .faq-answer {
      padding: 0 var(--space-4) var(--space-4);
      padding-top: var(--space-3);
    }

    .faq-answer p {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }
  }
</style>
