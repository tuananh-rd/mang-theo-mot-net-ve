---
import PlaceholderIllustration from './PlaceholderIllustration.astro';
import type { Product } from '../data/campaign';
import { formatProductPrice, formatProductQuantity } from '../lib/finance';

interface Props {
  product: Product;
  ratio?: '4:3' | '16:9' | '1:1';
}

const { product, ratio = '16:9' } = Astro.props;

const getIllustrationType = (id: string) => {
  if (id === 'chuon-chuon-tre-kem-de') return 'chuon-chuon' as const;
  if (id === 'moc-khoa') return 'moc-khoa' as const;
  if (id === 'set-do-an') return 'set-do-an' as const;
  if (id === 'combo-nem-gion') return 'combo-nem-gion' as const;
  if (id === 'combo-nem-xu') return 'combo-nem-xu' as const;
  if (id === 'combo-nem-pho-mai') return 'combo-nem-pho-mai' as const;
  if (id === 'banh-su-kem') return 'banh-su-kem' as const;
  return 'chuon-chuon' as const;
};

const illType = getIllustrationType(product.id);
const getSaleStatusLabel = (status: string | null | undefined): string => {
  switch (status) {
    case 'unconfirmed':
      return 'Chưa xác nhận';
    case 'draft':
      return 'Bản thảo';
    case 'available':
      return 'Đang mở bán';
    case 'sold_out':
      return 'Đã hết';
    case 'paused':
      return 'Tạm dừng';
    default:
      return 'Chưa xác nhận';
  }
};
const statusLabel = getSaleStatusLabel(product.saleStatus);
---

<article class="product-card card" id={`product-${product.id}`}>
  <div class="card-visual">
    <PlaceholderIllustration
      type={illType}
      ratio={ratio}
      context="product"
      caption={product.id === 'banh-su-kem' ? undefined : `Minh họa: ${product.name}`}
    />
  </div>

  <div class="card-body">
    <div class="card-header-row">
      <h3 class="product-name">{product.name}</h3>
      <span class="status-badge status-badge-warning">{statusLabel}</span>
    </div>

    <div class="price-box">
      <span class="price-label">Giá tham khảo đề xuất:</span>
      <strong class="price-val">{formatProductPrice(product)}</strong>
    </div>

    <p class="product-desc">{product.description}</p>

    <div class="product-meta-grid">
      <div class="meta-row">
        <span class="meta-label">Số lượng kế hoạch:</span>
        <span class="meta-val">{formatProductQuantity(product)}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Trạng thái bán:</span>
        <span class="meta-val meta-val-status">{statusLabel}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Nguồn gốc:</span>
        <span class="meta-val">{product.originText}</span>
      </div>
    </div>

    {product.notes && (
      <p class="product-notes">
        <span class="notes-label">Ghi chú:</span> {product.notes}
      </p>
    )}
  </div>
</article>

<style>
  .product-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .product-card:hover {
    box-shadow: var(--shadow-sm);
  }

  .card-visual {
    margin-bottom: var(--space-3);
    width: 100%;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-2);
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .product-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.35;
  }

  .status-badge-warning {
    background-color: #fff7ed;
    color: #c2410c;
    border: 1px solid #fed7aa;
    font-size: 0.875rem;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .price-box {
    display: flex;
    flex-direction: column;
    background-color: var(--color-canvas-soft);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
    gap: 2px;
    margin: 2px 0;
  }

  .price-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .price-val {
    font-size: 1.125rem;
    color: var(--color-text-accent);
    font-weight: 700;
  }

  .product-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .product-meta-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-top: auto;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-size: 0.875rem;
  }

  .meta-label {
    color: var(--color-text-muted);
    font-weight: 500;
    flex-shrink: 0;
  }

  .meta-val {
    color: var(--color-text-primary);
    font-weight: 600;
    text-align: right;
  }

  .meta-val-status {
    color: #c2410c;
  }

  .product-notes {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 4px 0 0;
    border-top: 1px dashed var(--color-border-subtle);
    padding-top: 6px;
  }

  .notes-label {
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .product-card {
      padding: var(--space-3);
    }

    .product-name {
      font-size: 1.0625rem;
    }

    .product-desc {
      font-size: 0.875rem;
    }
  }
</style>
