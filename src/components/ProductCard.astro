---
import PlaceholderIllustration from './PlaceholderIllustration.astro';
import StatusChip from './StatusChip.astro';
import type { Product } from '../data/campaign';
import { formatProductPrice, formatProductQuantity } from '../lib/finance';

interface Props {
  product: Product;
  ratio?: '4:3' | '16:9' | '1:1';
}

const { product, ratio = '16:9' } = Astro.props;

const getIllustrationType = (id: string) => {
  if (id === 'chuon-chuon-tre-kem-de') return 'chuon-chuon' as const;
  if (id === 'moc-khoa') return 'moc-khoa' as const;
  if (id === 'set-do-an') return 'set-do-an' as const;
  if (id === 'combo-nem-gion') return 'combo-nem-gion' as const;
  if (id === 'combo-nem-xu') return 'combo-nem-xu' as const;
  if (id === 'combo-nem-pho-mai') return 'combo-nem-pho-mai' as const;
  if (id === 'banh-su-kem') return 'banh-su-kem' as const;
  return 'chuon-chuon' as const;
};

const illType = getIllustrationType(product.id);
const getSaleStatusLabel = (status: string | null | undefined): string => {
  switch (status) {
    case 'unconfirmed':
      return 'Chưa xác nhận';
    case 'draft':
      return 'Bản thảo';
    case 'available':
      return 'Đang mở bán';
    case 'sold_out':
      return 'Đã hết';
    case 'paused':
      return 'Tạm dừng';
    default:
      return 'Chưa xác nhận';
  }
};
const statusLabel = getSaleStatusLabel(product.saleStatus);
---

<article class="product-card card" id={`product-${product.id}`}>
  <div class="card-visual">
    <PlaceholderIllustration
      type={illType}
      ratio={ratio}
      context="product"
      caption="Chưa có ảnh mẫu"
    />
  </div>

  <div class="card-body">
    <div class="card-header-row">
      <h3 class="product-name">{product.name}</h3>
      <StatusChip kind="cho-xac-nhan" label={statusLabel} />
    </div>

    <div class="price-row">
      <span class="price-val">{formatProductPrice(product)}</span>
      <span class="price-label">Giá tham khảo trong đề xuất</span>
    </div>

    <p class="product-desc">{product.description}</p>

    <div class="product-meta-grid">
      <div class="meta-row">
        <span class="meta-label">Số lượng kế hoạch:</span>
        <span class="meta-val">{formatProductQuantity(product)}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Nguồn gốc:</span>
        <span class="meta-val">{product.originText}</span>
      </div>
    </div>

    {product.notes && (
      <p class="product-notes">
        <span class="notes-label">Ghi chú:</span> {product.notes}
      </p>
    )}
  </div>
</article>

<style>
  .product-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background-color: var(--color-surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .product-card:hover {
    box-shadow: var(--shadow-subtle);
  }

  .card-visual {
    margin-bottom: var(--space-3);
    width: 100%;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--space-2);
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .product-name {
    font-size: var(--font-size-h3);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: var(--line-height-h3);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 2px 0;
    flex-wrap: wrap;
  }

  .price-val {
    font-size: var(--font-size-h3);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .price-label {
    font-size: var(--font-size-small);
    color: var(--ink-2);
  }

  .product-desc {
    font-size: var(--font-size-body);
    color: var(--ink-2);
    line-height: var(--line-height-body);
    margin: 0;
  }

  .product-meta-grid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--surface-alt);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-top: auto;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--font-size-small);
  }

  .meta-label {
    color: var(--ink-2);
    font-weight: 500;
    flex-shrink: 0;
  }

  .meta-val {
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }

  .product-notes {
    font-size: var(--font-size-small);
    color: var(--ink-2);
    line-height: 1.4;
    margin: 4px 0 0;
    border-top: 1px dashed var(--line);
    padding-top: 6px;
  }

  .notes-label {
    font-weight: 600;
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .product-card {
      padding: var(--space-3);
    }

    .price-row {
      gap: var(--space-1);
    }
  }
</style>
