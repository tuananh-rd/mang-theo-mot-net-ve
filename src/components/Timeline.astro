---
import type { PlannedStage } from '../data/campaign';

interface Props {
  stages: PlannedStage[];
  showDescriptions?: boolean;
}

const { stages, showDescriptions = true } = Astro.props;

// Tách "(Tuần x)" khỏi tiêu đề để hiển thị mốc tuần như nhãn riêng
const parsed = stages.map((s) => {
  const m = s.title.match(/^(.*?)\s*\((Tuần[^)]*)\)\s*$/);
  return {
    ...s,
    label: m ? m[1] : s.title,
    week: m ? m[2] : null,
  };
});
---

<ol class="timeline">
  {
    parsed.map((s) => (
      <li class="timeline-step">
        <div class="timeline-marker" aria-hidden="true">
          <span class="timeline-num">{s.step}</span>
        </div>
        <div class="timeline-body">
          {s.week && <span class="timeline-week">{s.week} · dự kiến</span>}
          <h3 class="timeline-title">{s.label}</h3>
          {showDescriptions && <p class="timeline-desc">{s.description}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    counter-reset: none;
  }

  .timeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .timeline-marker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .timeline-marker::after {
    content: "";
    flex: 1;
    height: 2px;
    background: var(--line);
  }

  .timeline-step:last-child .timeline-marker::after {
    display: none;
  }

  .timeline-num {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--brand);
    color: var(--brand);
    background: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .timeline-week {
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--status-plan-text);
  }

  .timeline-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin: 0;
  }

  .timeline-desc {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline-step {
      flex-direction: row;
      gap: var(--space-4);
      padding-bottom: var(--space-6);
    }

    .timeline-marker {
      flex-direction: column;
      align-self: stretch;
    }

    .timeline-marker::after {
      width: 2px;
      height: auto;
      flex: 1;
    }

    .timeline-step:last-child {
      padding-bottom: 0;
    }
  }
</style>
