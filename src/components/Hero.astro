---
import PlaceholderIllustration from './PlaceholderIllustration.astro';
import { CAMPAIGN_PROJECT } from '../data/campaign';
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="status-badge" role="status">
            {CAMPAIGN_PROJECT.statusNotice}
          </span>
        </div>

        <h1 id="hero-heading" class="hero-title">
          {CAMPAIGN_PROJECT.title}
        </h1>

        <p class="hero-slogan">
          {CAMPAIGN_PROJECT.slogan}
        </p>

        <p class="hero-summary">
          {CAMPAIGN_PROJECT.summary}
        </p>

        <div class="hero-actions">
          <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary hero-btn">
            Khám phá dự án
          </a>
          <a href="/san-pham" class="btn btn-secondary hero-btn">
            Xem sản phẩm gây quỹ
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <PlaceholderIllustration
          type="hero"
          ratio="4:3"
          caption="Minh họa cho bản xem trước — chưa phải ảnh hoạt động"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-14);
    background-color: var(--color-canvas);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-badge-wrap {
    margin-bottom: var(--space-2);
  }

  .hero-title {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .hero-slogan {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-accent);
  }

  .hero-summary {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text-secondary);
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-btn {
    min-height: 48px;
    padding: var(--space-3) var(--space-6);
  }

  .hero-visual {
    width: 100%;
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-section {
      padding-top: var(--space-8);
      padding-bottom: var(--space-10);
    }
  }

  @media (max-width: 767px) {
    .hero-actions {
      flex-direction: column;
      gap: var(--space-3);
    }

    .hero-btn {
      width: 100%;
    }

    .hero-slogan {
      font-size: 1.125rem;
    }
  }
</style>
