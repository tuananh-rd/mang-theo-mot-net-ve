---
import PlaceholderIllustration from './PlaceholderIllustration.astro';
import { CAMPAIGN_PROJECT } from '../data/campaign';
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="eyebrow">Nhóm Lăng Kính · SSG105</span>

        <h1 id="hero-heading" class="hero-title">
          {CAMPAIGN_PROJECT.title}
        </h1>

        <p class="hero-slogan">
          {CAMPAIGN_PROJECT.slogan}
        </p>

        <p class="hero-summary">
          {CAMPAIGN_PROJECT.summary}
        </p>

        <div class="hero-actions">
          <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-primary hero-btn">
            Khám phá dự án
          </a>
          <a href="/san-pham" class="btn btn-secondary hero-btn">
            Xem sản phẩm gây quỹ
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <PlaceholderIllustration
          type="hero"
          ratio="4:3"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    background-color: var(--color-canvas);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-title {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    color: var(--ink);
    word-break: break-word;
    text-wrap: balance;
  }

  .hero-slogan {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--brand);
    text-wrap: balance;
  }

  .hero-summary {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink-2);
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .hero-btn {
    min-height: 48px;
    padding: var(--space-3) var(--space-6);
  }

  .hero-visual {
    width: 100%;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-section {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .hero-visual {
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding-top: var(--space-6);
      padding-bottom: var(--space-8);
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    /* P0-7: Mobile chữ trước ảnh (bỏ order: -1), H1 nằm đầu trang dưới header */
    .hero-visual {
      max-width: 100%;
      margin-top: var(--space-2);
    }

    .hero-visual :global(.illustration-wrapper .svg-container) {
      aspect-ratio: 16 / 9;
      height: auto;
      max-height: none;
    }

    .hero-visual :global(.illustration-caption) {
      font-size: var(--font-size-small);
      padding: var(--space-2) var(--space-3);
    }

    .hero-content {
      gap: var(--space-3);
    }

    .hero-title {
      font-size: var(--font-size-display);
      line-height: var(--line-height-display);
    }

    .hero-slogan {
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .hero-summary {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .hero-actions {
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .hero-btn {
      width: 100%;
    }
  }
</style>
