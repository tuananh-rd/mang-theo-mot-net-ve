---
import Icon from './Icon.astro';
import { CAMPAIGN_PROJECT } from '../data/campaign';

// Tách phần "Một Nét Vẽ" để gạch chân bằng nét cọ; nếu tiêu đề đổi thì hiển thị nguyên văn.
const HIGHLIGHT = 'Một Nét Vẽ';
const title = CAMPAIGN_PROJECT.title;
const hlIndex = title.indexOf(HIGHLIGHT);
const titleBefore = hlIndex >= 0 ? title.slice(0, hlIndex).trim() : title;
const titleHighlight = hlIndex >= 0 ? HIGHLIGHT : null;

// C16: ảnh nền đầu trang do chủ dự án cung cấp (11–12/10/2026). Đây là ảnh minh họa, chưa phải sản phẩm thực tế của nhóm.
const HERO_PHOTO = {
  src: '/images/hero/chuon-chuon-go-xanh.webp',
  srcSmall: '/images/hero/chuon-chuon-go-xanh-900.webp',
  width: 1672,
  height: 941,
  alt: 'Chú chuồn chuồn gỗ sơn xanh họa tiết dân gian dang cánh, phía sau là các món đồ thủ công bằng gỗ nhòe nền',
  caption: 'Ảnh minh họa chuồn chuồn gỗ họa tiết dân gian do chủ dự án cung cấp — chưa phải sản phẩm thực tế của nhóm.',
};
---

<section class="hero-section" aria-labelledby="hero-heading">
  <figure class="hero-media">
    <img
      src={HERO_PHOTO.src}
      srcset={`${HERO_PHOTO.srcSmall} 900w, ${HERO_PHOTO.src} 1672w`}
      sizes="(min-width: 1360px) 125vw, 100vw"
      width={HERO_PHOTO.width}
      height={HERO_PHOTO.height}
      alt={HERO_PHOTO.alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <figcaption class="hero-caption">{HERO_PHOTO.caption}</figcaption>
  </figure>

  <div class="container hero-inner">
    <div class="hero-card enter">
      <span class="hero-kicker">
        <Icon name="chuon-chuon" size={18} />
        Dự án của nhóm Lăng Kính
      </span>

      <h1 id="hero-heading" class="hero-title">
        {titleBefore}
        {titleHighlight && (
          <>
            {' '}
            <span class="hl">
              {titleHighlight}
              <svg class="hl-stroke" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path d="M4 16 C 60 6, 120 20, 180 11 S 270 8, 296 14" pathLength="1" />
              </svg>
            </span>
          </>
        )}
      </h1>

      <p class="hero-slogan">{CAMPAIGN_PROJECT.slogan}</p>

      <p class="hero-summary">{CAMPAIGN_PROJECT.summary}</p>

      <div class="hero-actions">
        <a href="/dong-hanh" class="btn btn-primary btn-arrow hero-btn">
          Ủng hộ dự án <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/du-an/mang-theo-mot-net-ve" class="btn btn-secondary hero-btn">Tìm hiểu dự án</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* C16: ảnh chuồn chuồn làm nền đầu trang, thẻ nội dung trắng phẳng nằm bên trái.
   * Không phủ lớp màu hay bộ lọc lên ảnh; chữ nằm hoàn toàn trên thẻ trắng. */
  .hero-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--surface-alt);
  }

  .hero-media {
    margin: 0;
    background-color: var(--surface-alt);
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-caption {
    padding: var(--space-2) var(--container-gutter);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    color: var(--ink-2);
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-6);
    padding-bottom: var(--space-10);
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    background: #ffffff;
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-raised);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 14px 6px 10px;
    border-radius: var(--radius-pill);
    background: var(--surface-alt);
    border: 1px solid var(--line);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 600;
    color: var(--ink);
  }

  .hero-kicker :global(svg) {
    color: var(--brand);
  }

  .hero-title {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    color: var(--brand-ink);
    text-wrap: balance;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .hl {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    z-index: 0;
    color: var(--brand);
  }

  .hl-stroke {
    position: absolute;
    left: -2%;
    bottom: -0.3em;
    width: 104%;
    height: 0.32em;
    z-index: -1;
    overflow: visible;
  }

  .hl-stroke path {
    fill: none;
    stroke: var(--cta);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hero-slogan {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero-summary {
    font-size: var(--font-size-lead);
    line-height: var(--line-height-lead);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .hero-btn {
    min-height: 56px;
    padding: var(--space-3) var(--space-8);
    font-size: 1.0625rem;
  }

  /* Nét cọ tự vẽ một lần khi vào trang */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .hl-stroke path {
      stroke-dashoffset: 1;
      animation: draw 900ms var(--ease-out) 450ms forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Desktop rộng (>= 1360px): ảnh phủ toàn dải, thẻ nội dung bên trái, nhãn ảnh góc phải */
  @media (min-width: 1360px) {
    .hero-section {
      min-height: 700px;
      display: flex;
      align-items: center;
      padding-top: var(--space-18);
      padding-bottom: calc(var(--space-18) + 64px);
    }

    .hero-media {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    /* Ảnh phóng 125%, neo trái: chuồn chuồn nằm bên phải thẻ nội dung, thẻ chỉ chạm đầu cánh trái */
    .hero-media img {
      position: absolute;
      left: 0;
      top: 0;
      width: 125%;
      min-width: 100%;
      max-width: 2200px; /* tránh phóng quá nhiều so với ảnh nguồn 1672 px */
      height: 100%;
      object-fit: cover;
      object-position: 0% 32%;
    }

    .hero-caption {
      position: absolute;
      right: max(var(--container-gutter), calc((100% - var(--container-max-width)) / 2 + var(--container-gutter)));
      bottom: calc(64px + var(--space-6));
      max-width: 340px;
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-subtle);
    }

    .hero-inner {
      width: 100%;
      padding-top: 0;
      padding-bottom: 0;
    }

    .hero-card {
      max-width: 480px;
      padding: var(--space-8);
    }

    .hero-summary {
      font-size: 1.0625rem;
      line-height: 1.7;
    }
  }

  /* Máy tính bảng và desktop hẹp: ảnh trên, thẻ nội dung dưới, nhãn ảnh ngay dưới ảnh */
  @media (min-width: 768px) and (max-width: 1359px) {
    .hero-media img {
      aspect-ratio: 2 / 1;
      object-fit: cover;
      object-position: 52% 36%;
    }

    .hero-card {
      padding: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .hero-media img {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: 51% 24%;
    }

    .hero-title {
      font-size: var(--font-size-display);
      line-height: var(--line-height-display);
    }

    .hero-card {
      gap: var(--space-3);
      border-radius: var(--radius-lg);
    }

    .hero-slogan {
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .hero-summary {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .hero-actions {
      flex-direction: column;
      align-self: stretch;
      gap: var(--space-2);
    }

    .hero-btn {
      width: 100%;
    }
  }
</style>
