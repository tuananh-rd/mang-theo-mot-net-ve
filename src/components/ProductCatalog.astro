---
import Icon, { type IconName } from './Icon.astro';
import StatusChip from './StatusChip.astro';
import type { Product } from '../data/campaign';
import { buildProductCatalog, sumCatalogScenarioRevenue, formatVND } from '../lib/finance';

interface Props {
  products: Product[];
  /** full: bảng đủ mô tả + nhóm combo; summary: chỉ mặt hàng cơ sở, gọn cho Trang chủ */
  variant?: 'full' | 'summary';
  caption: string;
}

const { products, variant = 'full', caption } = Astro.props;

const iconFor: Record<string, IconName> = {
  'chuon-chuon-tre-kem-de': 'chuon-chuon',
  'moc-khoa': 'moc-khoa',
  'set-do-an': 'set-do-an',
  'combo-nem-gion': 'combo',
  'combo-nem-xu': 'combo',
  'combo-nem-pho-mai': 'combo',
  'banh-su-kem': 'banh',
};

const rows = buildProductCatalog(products);
const baseRows = rows.filter((r) => r.inBaseScenario);
const comboRows = rows.filter((r) => !r.inBaseScenario);
const baseTotal = sumCatalogScenarioRevenue(rows);
const isFull = variant === 'full';
---

<div class:list={['catalog', `catalog--${variant}`]}>
  <table class="data-table data-table--stack catalog-table">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Sản phẩm</th>
        <th scope="col" class="num">Giá tham khảo</th>
        <th scope="col" class="num">Số lượng kế hoạch</th>
        <th scope="col" class="num">Doanh thu nếu bán đủ</th>
      </tr>
    </thead>
    <tbody>
      {isFull && (
        <tr class="catalog-group">
          <th scope="colgroup" colspan="4">
            Danh mục cơ sở
            <span class="cell-sub">Được tính vào kịch bản doanh thu</span>
          </th>
        </tr>
      )}
      {
        baseRows.map((r) => (
          <tr id={isFull ? `sp-${r.product.id}` : undefined}>
            <th scope="row">
              <span class="catalog-name">
                <span class="catalog-icon"><Icon name={iconFor[r.product.id] ?? 'combo'} size={22} /></span>
                <span>
                  {r.product.name}
                  {isFull && <span class="cell-sub">{r.product.description}</span>}
                  {isFull && <span class="cell-sub catalog-origin">Nguồn gốc: {r.product.originText}</span>}
                </span>
              </span>
            </th>
            <td class="num" data-label="Giá tham khảo">{r.priceText}</td>
            <td class="num" data-label="Số lượng kế hoạch">{r.quantityText}</td>
            <td class="num" data-label="Doanh thu nếu bán đủ">{formatVND(r.scenarioRevenue)}</td>
          </tr>
        ))
      }
      {isFull && comboRows.length > 0 && (
        <tr class="catalog-group">
          <th scope="colgroup" colspan="4">
            Ba combo trong đề xuất
            <span class="cell-sub">Chưa rõ bán thêm hay thay cho 50 set — không tính vào doanh thu cơ sở</span>
          </th>
        </tr>
      )}
      {isFull &&
        comboRows.map((r) => (
          <tr id={`sp-${r.product.id}`} class="catalog-combo">
            <th scope="row">
              <span class="catalog-name">
                <span class="catalog-icon"><Icon name={iconFor[r.product.id] ?? 'combo'} size={22} /></span>
                <span>
                  {r.product.name}
                  <span class="cell-sub">{r.product.description}</span>
                </span>
              </span>
            </th>
            <td class="num" data-label="Giá tham khảo">{r.priceText}</td>
            <td class="num" data-label="Số lượng kế hoạch">{r.quantityText}</td>
            <td class="num" data-label="Doanh thu nếu bán đủ">
              <StatusChip kind="can-lam-ro" label="Không tính" />
            </td>
          </tr>
        ))}
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="3">
          Tổng doanh thu kịch bản cơ sở
          <span class="cell-sub">Giả định bán đủ theo giá tham khảo; không phải tiền đã nhận</span>
        </th>
        <td class="num" data-label="Tổng">{formatVND(baseTotal)}</td>
      </tr>
    </tfoot>
  </table>
</div>

<style>
  .catalog-table {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }

  .catalog-table tbody th {
    width: 52%;
  }

  .catalog-name {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .catalog-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--surface-alt);
    color: var(--brand-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .catalog-origin {
    margin-top: 2px;
  }

  .catalog-group th {
    background: #ffffff;
    padding-top: var(--space-5);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand);
  }

  .catalog-group .cell-sub {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }

  .catalog-combo th,
  .catalog-combo td {
    color: var(--ink-2);
  }

  .catalog-table tfoot th,
  .catalog-table tfoot td {
    font-size: var(--font-size-body);
  }

  .catalog-table tfoot td.num {
    font-size: var(--font-size-h3);
    vertical-align: middle;
  }

  .catalog--summary .catalog-table tbody th {
    width: auto;
  }

  @media (max-width: 767px) {
    .catalog-table {
      border: none;
      border-radius: 0;
      overflow: visible;
    }

    .catalog-table tbody th {
      width: 100%;
      padding-bottom: var(--space-2);
    }

    .catalog-group th {
      padding-top: var(--space-4);
    }

    .catalog-table tbody td[data-label] {
      padding-left: 52px;
    }

    .catalog-table tfoot td[data-label] {
      padding-left: 0;
    }
  }
</style>
