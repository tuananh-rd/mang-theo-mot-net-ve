---
import { DONATION_ACCOUNT, OFFICIAL_CONTACT, CAMPAIGN_PROJECT, PROJECT_PROGRESS } from '../data/campaign';
import { isDonationOpen, formatViDate } from '../lib/donations';

const donationOpen = isDonationOpen(DONATION_ACCOUNT);
const contactReady = OFFICIAL_CONTACT.status === 'confirmed';
const navLinks = [
  { href: '/', label: 'Trang chủ' },
  { href: '/du-an/mang-theo-mot-net-ve', label: 'Dự án' },
  { href: '/san-pham', label: 'Quà lưu niệm' },
  { href: '/minh-bach', label: 'Minh bạch' },
  { href: '/ve-nhom', label: 'Về nhóm Lăng Kính' },
  { href: '/dong-hanh', label: 'Ủng hộ dự án' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <!-- Vùng 1: Thông tin nhóm & logo gốc -->
      <div class="footer-brand">
        <div class="footer-brand-header">
          <img
            src="/images/logo_lang_kinh_2048.png"
            alt=""
            class="footer-brand-icon"
            width="2048"
            height="2048"
          />
          <h2 class="footer-title">Lăng Kính</h2>
        </div>
        <p class="footer-desc">
          Nhóm sinh viên lớp AI2015, Đại học FPT Hà Nội.
        </p>
        <p class="footer-campaign">
          Chiến dịch: <strong>Mang Theo Một Nét Vẽ</strong>
        </p>
      </div>

      <!-- Vùng 2: Điều hướng trang -->
      <nav class="footer-nav" aria-label="Liên kết chân trang">
        <h3 class="footer-nav-title">Danh mục trang</h3>
        <ul class="footer-links">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Vùng 3: Trạng thái & liên hệ -->
      <div class="footer-notes">
        <h3 class="footer-nav-title">Liên hệ</h3>
        {contactReady && (
          <ul class="footer-contacts">
            {OFFICIAL_CONTACT.people.map((p) => (
              <li>
                <span class="footer-contact-role">{p.role} · {p.name}</span>
                <a class="footer-link footer-tel" href={`tel:${p.phoneE164}`}>{p.phone}</a>
              </li>
            ))}
            {OFFICIAL_CONTACT.fanpageUrl && (
              <li>
                <a class="footer-link" href={OFFICIAL_CONTACT.fanpageUrl} target="_blank" rel="noopener noreferrer">
                  Fanpage Facebook ↗<span class="sr-only"> (mở trong thẻ mới)</span>
                </a>
              </li>
            )}
          </ul>
        )}
        <ul class="footer-status-list">
          <li class="status-item">
            <span class="status-bullet" aria-hidden="true">•</span>
            <span>{CAMPAIGN_PROJECT.statusNotice} (cập nhật {formatViDate(PROJECT_PROGRESS.updatedAt)})</span>
          </li>
          <li class="status-item">
            <span class="status-bullet" aria-hidden="true">•</span>
            <span>{donationOpen ? 'Nhận ủng hộ qua chuyển khoản; sao kê đăng sau đối soát' : 'Website chưa công bố tài khoản nhận ủng hộ'}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--brand-ink);
    color: #c9d2dc;
    margin-top: auto;
    padding-top: var(--space-14);
    padding-bottom: var(--space-10);
  }

  /* Viền màu thương hiệu mảnh trên đầu footer */
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background-color: var(--brand);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.6fr;
    gap: var(--space-8);
  }

  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .footer-brand-icon {
    width: 40px;
    height: 40px;
    padding: 4px;
    background: #ffffff;
    border-radius: var(--radius-sm);
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .footer-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #c9d2dc;
    margin-bottom: var(--space-3);
    max-width: 340px;
  }

  .footer-campaign {
    font-size: 0.9375rem;
    color: #c9d2dc;
    margin: 0;
  }

  .footer-campaign strong {
    color: #ffffff;
  }

  .footer-nav-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: #ffffff;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-1) 0;
    text-decoration: none;
    font-size: 0.9375rem;
    color: #c9d2dc;
    transition: color var(--transition-fast), transform var(--transition-normal);
  }

  .footer-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    transform: translateX(3px);
  }

  .footer-link:focus-visible {
    outline-color: #ffffff;
  }

  .footer-contacts {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer-contact-role {
    display: block;
    font-size: 0.875rem;
    color: #c9d2dc;
  }

  .footer-tel {
    min-height: 36px;
    color: #ffffff;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .footer-status-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .status-item {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #c9d2dc;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .status-item strong {
    color: #ffffff;
  }

  .status-bullet {
    color: var(--cta);
    font-weight: 700;
    line-height: 1.4;
  }


  @media (max-width: 1023px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .footer-notes {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-notes {
      grid-column: span 1;
    }

    .site-footer {
      padding-top: var(--space-8);
      padding-bottom: var(--space-6);
    }
  }
</style>
