---
const navLinks = [
  { href: '/', label: 'Trang chủ' },
  { href: '/du-an/mang-theo-mot-net-ve', label: 'Dự án' },
  { href: '/san-pham', label: 'Sản phẩm gây quỹ' },
  { href: '/minh-bach', label: 'Minh bạch thu chi' },
  { href: '/ve-nhom', label: 'Về nhóm Lăng Kính' },
  { href: '/dong-hanh', label: 'Cách đồng hành' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <!-- Vùng 1: Thông tin nhóm & logo gốc -->
      <div class="footer-brand">
        <div class="footer-brand-header">
          <img
            src="/images/logo_lang_kinh_2048.png"
            alt=""
            class="footer-brand-icon"
            width="2048"
            height="2048"
          />
          <h2 class="footer-title">Lăng Kính</h2>
        </div>
        <p class="footer-desc">
          Nhóm sinh viên lớp AI2015, Đại học FPT Hà Nội.
        </p>
        <p class="footer-campaign">
          Chiến dịch: <strong>Mang Theo Một Nét Vẽ</strong>
        </p>
      </div>

      <!-- Vùng 2: Điều hướng trang -->
      <nav class="footer-nav" aria-label="Liên kết chân trang">
        <h3 class="footer-nav-title">Danh mục trang</h3>
        <ul class="footer-links">
          {
            navLinks.map((item) => (
              <li>
                <a href={item.href} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Vùng 3: Trạng thái & giới hạn website -->
      <div class="footer-notes">
        <h3 class="footer-nav-title">Trạng thái website</h3>
        <ul class="footer-status-list">
          <li class="status-item">
            <span class="status-bullet" aria-hidden="true">•</span>
            <span>Bản xem trước</span>
          </li>
          <li class="status-item">
            <span class="status-bullet" aria-hidden="true">•</span>
            <span>Chưa nhận đơn hàng, tiền hay hiện vật qua website</span>
          </li>
          <li class="status-item">
            <span class="status-bullet" aria-hidden="true">•</span>
            <span>Kênh liên hệ: chờ xác nhận</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--surface-alt);
    border-top: 1px solid var(--line);
    margin-top: auto;
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.6fr;
    gap: var(--space-8);
  }

  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .footer-brand-icon {
    width: 38px;
    height: 38px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
  }

  .footer-desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: var(--space-3);
    max-width: 340px;
  }

  .footer-campaign {
    font-size: 0.9375rem;
    color: var(--ink);
    margin: 0;
  }

  .footer-nav-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--ink);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-1) 0;
    text-decoration: none;
    font-size: 0.9375rem;
    color: var(--ink-2);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-status-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .status-item {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .status-item strong {
    color: var(--ink);
  }

  .status-bullet {
    color: var(--brand);
    font-weight: 700;
    line-height: 1.4;
  }


  @media (max-width: 1023px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .footer-notes {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-notes {
      grid-column: span 1;
    }

    .site-footer {
      padding-top: var(--space-8);
      padding-bottom: var(--space-6);
    }
  }
</style>
