+  const result: any = { ...baseline };
+  for (const [id, conf] of Object.entries(snapProds)) {
+    if (result[id]) {
+      result[id] = { ...result[id], ...conf };
+    } else {
+      result[id] = conf;
+    }
+  }
+  return result as T;
+}
