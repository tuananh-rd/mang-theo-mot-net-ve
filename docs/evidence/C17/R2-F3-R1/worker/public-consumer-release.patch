+
+/**
+ * Áp dụng cấu hình sản phẩm từ bản chụp xuất bản lên danh mục baseline
+ */
+export function getPublishedProducts<T extends Record<string, any>>(baseline: T): T {
+  const snap = getActiveSnapshot();
+  if (!snap?.modules?.products) {
